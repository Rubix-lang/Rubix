            return l;
        }
        if (src_t == TYPE_I32) | (src_t == TYPE_CHAR) {
            # cvtsi2sd xmm0, eax (F2 0F 2A C0)
            l = emit_byte(buf, l, 242); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 42); l = emit_byte(buf, l, 192);
            # movq rax, xmm0
            l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 126); l = emit_byte(buf, l, 192);
            return l;
        }
        if src_t == TYPE_F32 {
            # movd xmm0, eax (66 0F 6E C0)
            l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 110); l = emit_byte(buf, l, 192);
            # cvtss2sd xmm0, xmm0 (F3 0F 5A C0)
            l = emit_byte(buf, l, 243); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 90); l = emit_byte(buf, l, 192);
            # movq rax, xmm0
            l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 126); l = emit_byte(buf, l, 192);
            return l;
        }
        if (src_t == TYPE_U8) | (src_t == TYPE_BOOL) {
            l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 192);
            l = emit_byte(buf, l, 242); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 42); l = emit_byte(buf, l, 192);
            l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 126); l = emit_byte(buf, l, 192);
            return l;
        }
    }

    if dst_t == TYPE_F32 {
        if (src_t == TYPE_I64) | (src_t == TYPE_INT_LIT) {
            # cvtsi2ss xmm0, rax (F3 48 0F 2A C0)
            l = emit_byte(buf, l, 243); l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 42); l = emit_byte(buf, l, 192);
            # movd eax, xmm0 (66 0F 7E C0)
            l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 126); l = emit_byte(buf, l, 192);
            return l;
