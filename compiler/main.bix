# main.bix - Rubix native compiler driver and code generator
# Direct machine-code generation for x86-64, ARM64, and REX targets.

use std.string;
use webbix.ir.types;
use webbix.ir.style;
use rcs.ast;
use rcs.tokens;
use rcs.motion;
use rcs.lexer;
use rcs.parser;
use rcs.resolver;
use rcs.bake;
use rcs.emit_css;

# Target architectures, ELF machine types, and memory layout

# ------------------------------------------------------------------------------
# Target Architecture Identifiers
# ------------------------------------------------------------------------------
let TARGET_X86_64    = 1;
let TARGET_ARM64     = 2;
let TARGET_RISCV64   = 3;
let TARGET_REX       = 4;
let TARGET_WINDOWS   = 5;
let TARGET_MACOS     = 6;
let TARGET_WASM      = 7;
let TARGET_SYNTHETIC = 99;

# ------------------------------------------------------------------------------
# ELF Architecture Machine Types (e_machine)
# ------------------------------------------------------------------------------
let EM_X86_64  = 62;
let EM_AARCH64 = 183;
let EM_RISCV   = 243;

# ------------------------------------------------------------------------------
# ELF Layout, Headers & Virtual Memory
# ------------------------------------------------------------------------------
let ELF_HEADER_SIZE              = 64;
let ELF_PHDR_SIZE                = 56;
let ELF_BASE_VADDR               = 4194304; # 0x400000 standard 64-bit Linux load base
let ELF_HEADERS_TOTAL_SIZE       = 120;     # 64 + 56 (aligned to code load offset)

# ------------------------------------------------------------------------------
# Symbolic Hashes
# ------------------------------------------------------------------------------
# Precomputed hash of the "main" function identifier:
# Derived via hash_token("main", 4) = 6385467242
let FN_HASH_MAIN = 6385467242;

# ------------------------------------------------------------------------------
# Instruction Encoding & Control Flow Offsets
# ------------------------------------------------------------------------------
# Maps x86 SETcc opcode byte (0x90..0x9F / 144..159) to Jcc opcode byte (0x80..0x8F / 128..143):
# e.g., SETNE (0x95 / 149) - 16 = JNE (0x85 / 133)
let JCC_FROM_SETCC_OFFSET = 16;


