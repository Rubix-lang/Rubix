# parser.bix - recursive descent parser and direct machine-code generation

use compiler.common.constants;

# ------------------------------------------------------------------------------
# Builtin Call Emission & Semantic Validation
# ------------------------------------------------------------------------------

fn emit_print_val_rdi(code_buf: i64, l: i64, val_t: i64, is_nl: i64): i64 {
    if val_t == 8 { # TYPE_STR == 8
        if is_nl == 1 {
            # test %rdi, %rdi
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 255);
            # je 34 (offset 0x2f = 47 bytes)
            l = emit_byte(code_buf, l, 116); l = emit_byte(code_buf, l, 47);
            # mov (%rdi), %rdx
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 23);
            # test %rdx, %rdx
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 210);
            # je 1d (offset 0x10 = 16 bytes)
            l = emit_byte(code_buf, l, 116); l = emit_byte(code_buf, l, 16);
            # lea 8(%rdi), %rsi
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 141); l = emit_byte(code_buf, l, 119); l = emit_byte(code_buf, l, 8);
            # mov $1, %edi
            l = emit_byte(code_buf, l, 191); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
            # mov $1, %eax
            l = emit_byte(code_buf, l, 184); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
            # syscall
            l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 5);
            # .Lnl_only:
            # push $10
            l = emit_byte(code_buf, l, 106); l = emit_byte(code_buf, l, 10);
            # mov %rsp, %rsi
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 230);
            # mov $1, %edi
            l = emit_byte(code_buf, l, 191); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
            # mov $1, %edx
            l = emit_byte(code_buf, l, 186); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
            # mov $1, %eax
            l = emit_byte(code_buf, l, 184); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
            # syscall
            l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 5);
            # pop %rax
            l = emit_byte(code_buf, l, 88);
            # .Ldone_nl:
            # xor %eax, %eax
            l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 192);
            return l;
        } else {
            # test %rdi, %rdi
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 255);
            # je 53 (offset 0x18 = 24 bytes)
            l = emit_byte(code_buf, l, 116); l = emit_byte(code_buf, l, 24);
            # mov (%rdi), %rdx
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 23);
            # test %rdx, %rdx
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 210);
            # je 53 (offset 0x10 = 16 bytes)
            l = emit_byte(code_buf, l, 116); l = emit_byte(code_buf, l, 16);
            # lea 8(%rdi), %rsi
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 141); l = emit_byte(code_buf, l, 119); l = emit_byte(code_buf, l, 8);
            # mov $1, %edi
            l = emit_byte(code_buf, l, 191); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
            # mov $1, %eax
            l = emit_byte(code_buf, l, 184); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
            # syscall
            l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 5);
            # .Ldone_nonl:
            # xor %eax, %eax
            l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 192);
            return l;
        }
    }
    # Integer printing:
    # sub rsp, 48 (48 83 ec 30)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 236); l = emit_byte(code_buf, l, 48);
    # lea rcx, [rsp + 32] (48 8d 4c 24 20)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 141); l = emit_byte(code_buf, l, 76); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, 32);
    if is_nl == 1 {
        # mov byte ptr [rcx], 10 (c6 01 0a)
        l = emit_byte(code_buf, l, 198); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 10);
        # lea r8, [rsp + 33] (4c 8d 44 24 21)
        l = emit_byte(code_buf, l, 76); l = emit_byte(code_buf, l, 141); l = emit_byte(code_buf, l, 68); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, 33);
    } else {
        # lea r8, [rsp + 32] (4c 8d 44 24 20)
        l = emit_byte(code_buf, l, 76); l = emit_byte(code_buf, l, 141); l = emit_byte(code_buf, l, 68); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, 32);
    }
    # mov rax, rdi (48 89 f8)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 248);
    # xor r10d, r10d (45 31 d2)
    l = emit_byte(code_buf, l, 69); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 210);
    # test rax, rax (48 85 c0)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192);
    # jns .Lnonneg (79 09) (9 bytes forward)
    l = emit_byte(code_buf, l, 121); l = emit_byte(code_buf, l, 9);
    # neg rax (48 f7 d8) (3 bytes)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 216);
    # mov r10d, 1 (41 ba 01 00 00 00) (6 bytes)
    l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 186); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
    # .Lnonneg:
    # mov r9d, 10 (41 b9 0a 00 00 00) (6 bytes)
    l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 185); l = emit_byte(code_buf, l, 10); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
    # .Lloop:
    # xor edx, edx (31 d2) (2 bytes)
    l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 210);
    # div r9 (49 f7 f1) (3 bytes)
    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 241);
    # add dl, 48 (80 c2 30) (3 bytes)
    l = emit_byte(code_buf, l, 128); l = emit_byte(code_buf, l, 194); l = emit_byte(code_buf, l, 48);
    # dec rcx (48 ff c9) (3 bytes)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 201);
    # mov [rcx], dl (88 11) (2 bytes)
    l = emit_byte(code_buf, l, 136); l = emit_byte(code_buf, l, 17);
    # test rax, rax (48 85 c0) (3 bytes)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192);
    # jnz .Lloop (75 ee) (2 bytes; -18 bytes back)
    l = emit_byte(code_buf, l, 117); l = emit_byte(code_buf, l, 238);
    # test r10d, r10d (45 85 d2) (3 bytes)
    l = emit_byte(code_buf, l, 69); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 210);
    # jz .Lwrite (74 06) (2 bytes; 6 bytes forward)
    l = emit_byte(code_buf, l, 116); l = emit_byte(code_buf, l, 6);
    # dec rcx (48 ff c9) (3 bytes)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 201);
    # mov byte ptr [rcx], 45 (c6 01 2d) (3 bytes)
    l = emit_byte(code_buf, l, 198); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 45);
    # .Lwrite:
    # mov rdx, r8 (4c 89 c2) (3 bytes)
    l = emit_byte(code_buf, l, 76); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 194);
    # sub rdx, rcx (48 29 ca) (3 bytes)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 41); l = emit_byte(code_buf, l, 202);
    # mov rsi, rcx (48 89 ce) (3 bytes)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 206);
    # mov edi, 1 (bf 01 00 00 00) (5 bytes)
    l = emit_byte(code_buf, l, 191); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
    # mov eax, 1 (b8 01 00 00 00) (5 bytes)
    l = emit_byte(code_buf, l, 184); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
    # syscall (0f 05) (2 bytes)
    l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 5);
    # add rsp, 48 (48 83 c4 30) (4 bytes)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 196); l = emit_byte(code_buf, l, 48);
    # xor eax, eax (31 c0) (2 bytes)
    l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 192);
    return l;
}

fn emit_print_val_rax(code_buf: i64, l: i64, val_t: i64, is_nl: i64): i64 {
    # mov rdi, rax (48 89 c7)
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 199);
    return emit_print_val_rdi(code_buf, l, val_t, is_nl);
}

fn emit_call_or_builtin(s: i64, name_offset: i64, name_len: i64, name_hash: i64, arg_count: i64): i64 {
    let src = get_qword(s, 0);
    let code_buf = get_qword(s, 3);
    let l = get_qword(s, 4);
    let tbl = get_qword(s, 5);
    set_qword(s, 27, 1); # mark side-effect for DCE

    # Check maximum supported arguments
    if arg_count > 16 {
        set_qword(s, 7, -36);
        return -36;
    }

    # Semantic Validation against Function Declaration in func_tbl
    let exp_count = func_tbl_get(tbl, name_hash, 2);
    if exp_count < 0 {
        let gt_idx = gen_tbl_op(tbl, 4, name_hash, 0, 0, 0, 0, 0, 0);
        if gt_idx >= 0 {
            let gp_cnt = gen_tbl_op(tbl, 6, gt_idx, 1, 0, 0, 0, 0, 0);
            let it0 = get_qword(tbl, 10240);
            let it1 = TYPE_NONE;
            let it2 = TYPE_NONE;
            let it3 = TYPE_NONE;
            if gp_cnt >= 2 { it1 = get_qword(tbl, 10241); }
            if gp_cnt >= 3 { it2 = get_qword(tbl, 10242); }
            if gp_cnt >= 4 { it3 = get_qword(tbl, 10243); }
            let mangled_h = mangle_generic_hash(name_hash, gp_cnt, it0, it1, it2, it3);
            let spec_idx = gen_tbl_op(tbl, 7, mangled_h, 0, 0, 0, 0, 0, 0);
            if spec_idx < 0 {
                gen_tbl_op(tbl, 8, gt_idx, mangled_h, it0, it1, it2, it3, 0);
                func_tbl_add(tbl, mangled_h, -1, arg_count, it0);
            }
            name_hash = mangled_h;
            exp_count = arg_count;
        }
    }
    if exp_count >= 0 {
        if arg_count != exp_count {
            set_qword(s, 7, -35); # ERR_ARG_COUNT_MISMATCH
            return -35;
        }
        let fn_idx = func_tbl_find_index(tbl, name_hash);
        let i = 0;
        while i < arg_count {
            let exp_type = func_tbl_get_param_info(tbl, name_hash, i, 0);
            let act_type = get_qword(tbl, 10240 + i); # from offset 81920
            let act_pointee = get_qword(tbl, 10272 + i);
            let act_prov = get_qword(tbl, 10304 + i);
            let act_len = get_qword(tbl, 10336 + i); # from offset 82688
            if exp_type == TYPE_ARRAY {
                if act_type != TYPE_ARRAY {
                    set_qword(s, 7, -42); # ERR_TYPE_MISMATCH_ARG
                    return -42;
                }
                let exp_elem_t = func_tbl_get_param_info(tbl, name_hash, i, 1);
                if exp_elem_t != act_pointee {
                    set_qword(s, 7, -42); # ERR_TYPE_MISMATCH_ARG
                    return -42;
                }
                let exp_len = func_tbl_get_param_info(tbl, name_hash, i, 2);
                if exp_len > 0 {
                    if exp_len != act_len {
                        set_qword(s, 7, -42); # ERR_TYPE_MISMATCH_ARG
                        return -42;
                    }
                }
            } else {
                if (name_hash != 210724587794) & (name_hash != 229479076111340) {
                    if act_type == TYPE_ARRAY {
                        set_qword(s, 7, -42); # ERR_TYPE_MISMATCH_ARG
                        return -42;
                    }
                    if act_type >= TYPE_STRUCT {
                        set_qword(s, 7, -42); # ERR_TYPE_MISMATCH_ARG
                        return -42;
                    }
                    if exp_type >= TYPE_STRUCT {
                        set_qword(s, 7, -42); # ERR_TYPE_MISMATCH_ARG
                        return -42;
                    }
                    if type_is_compatible(exp_type, act_type) == 0 {
                        set_qword(s, 7, -42); # ERR_TYPE_MISMATCH_ARG
                        return -42;
                    }
                }
                if exp_type == TYPE_PTR {
                    if fn_idx >= 0 {
                        let cur_p_pointee = func_tbl_get_param_info(tbl, name_hash, i, 1);
                        if cur_p_pointee == TYPE_NONE {
                            if act_pointee != TYPE_NONE {
                                func_tbl_set_param_metadata(tbl, fn_idx, i, act_pointee, PROV_UNKNOWN);
                            }
                        } else {
                            if act_pointee != TYPE_NONE {
                                if cur_p_pointee != act_pointee {
                                    set_qword(s, 7, -42); # ERR_TYPE_MISMATCH_ARG (incompatible pointee)
                                    return -42;
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    # Pop arguments into ABI registers in reverse order:
    # arg 0 -> RDI (5F), arg 1 -> RSI (5E), arg 2 -> RDX (5A), arg 3 -> RCX (59), arg 4 -> R8 (41 58), arg 5 -> R9 (41 59)
    let cur_d = get_qword(s, 12);
    let start_depth = cur_d - arg_count;

    if arg_count <= 6 {
        set_qword(s, 12, start_depth);

        if arg_count == 1 {
            l = emit_byte(code_buf, l, 95); # pop rdi
        }
        if arg_count == 2 {
            l = emit_byte(code_buf, l, 94); # pop rsi
            l = emit_byte(code_buf, l, 95); # pop rdi
        }
        if arg_count == 3 {
            l = emit_byte(code_buf, l, 90); # pop rdx
            l = emit_byte(code_buf, l, 94); # pop rsi
            l = emit_byte(code_buf, l, 95); # pop rdi
        }
        if arg_count == 4 {
            l = emit_byte(code_buf, l, 89); # pop rcx
            l = emit_byte(code_buf, l, 90); # pop rdx
            l = emit_byte(code_buf, l, 94); # pop rsi
            l = emit_byte(code_buf, l, 95); # pop rdi
        }
        if arg_count == 5 {
            l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 88); # pop r8
            l = emit_byte(code_buf, l, 89);                                 # pop rcx
            l = emit_byte(code_buf, l, 90);                                 # pop rdx
            l = emit_byte(code_buf, l, 94);                                 # pop rsi
            l = emit_byte(code_buf, l, 95);                                 # pop rdi
        }
        if arg_count == 6 {
            l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 89); # pop r9
            l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 88); # pop r8
            l = emit_byte(code_buf, l, 89);                                 # pop rcx
            l = emit_byte(code_buf, l, 90);                                 # pop rdx
            l = emit_byte(code_buf, l, 94);                                 # pop rsi
            l = emit_byte(code_buf, l, 95);                                 # pop rdi
        }
    }

    # Check Builtins
    if name_hash == 4858138384542055882 { # sys_mmap_page
        l = isel_emit_builtin_buffer(code_buf, l, 0, 1);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 7572409568671928 { # get_byte
        l = isel_emit_builtin_mem_access(code_buf, l, 0, 0);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 7572920989987652 { # set_byte
        l = isel_emit_builtin_mem_access(code_buf, l, 1, 0);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 249889515783885649 { # get_qword
        l = isel_emit_builtin_mem_access(code_buf, l, 0, 1);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 249906392687304541 { # set_qword
        l = isel_emit_builtin_mem_access(code_buf, l, 1, 1);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 7572946780668533 { # sys_open
        l = isel_emit_syscall(code_buf, l, 2);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 7572946780764223 { # sys_read
        l = isel_emit_syscall(code_buf, l, 0);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 249907243771625486 { # sys_write
        l = isel_emit_syscall(code_buf, l, 1);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 249907243747697945 { # sys_close
        l = isel_emit_syscall(code_buf, l, 3);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == -2647744904066970959 { # sys_mprotect
        l = isel_emit_syscall(code_buf, l, 10);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 4858123823083711801 { # sys_call_code
        let depth = get_qword(s, 12);
        let need_align = 0;
        if (depth % 2) != 0 {
            need_align = 1;
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 236); l = emit_byte(code_buf, l, 8); # sub rsp, 8
        }
        l = emit_byte(code_buf, l, 72);
        l = emit_byte(code_buf, l, 137);
        l = emit_byte(code_buf, l, 248); # mov rax, rdi
        l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 208); # call rax (FF D0)
        if need_align == 1 {
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 196); l = emit_byte(code_buf, l, 8); # add rsp, 8
        }
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 7529887214154863653 { # sys_call_code_args
        let depth = get_qword(s, 12);
        let need_align = 0;
        if (depth % 2) != 0 {
            need_align = 1;
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 236); l = emit_byte(code_buf, l, 8); # sub rsp, 8
        }
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 248); # mov rax, rdi
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 247); # mov rdi, rsi
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 214); # mov rsi, rdx
        l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 208); # call rax (FF D0)
        if need_align == 1 {
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 196); l = emit_byte(code_buf, l, 8); # add rsp, 8
        }
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 7572946780318013 { # sys_exit
        l = isel_emit_syscall(code_buf, l, 60);
        set_qword(s, 4, l);
        return TYPE_VOID;
    }
    if name_hash == 7572946780593262 { # sys_mmap
        l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 202); # mov r10, rcx
        l = isel_emit_syscall(code_buf, l, 9);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == 193505547 { # sar
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 248); # mov rax, rdi
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 241); # mov rcx, rsi
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 211); l = emit_byte(code_buf, l, 248); # sar rax, cl
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if name_hash == -3577716174734351287 { # alloc_buffer
        l = isel_emit_builtin_buffer(code_buf, l, 0, 0);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_PTR;
    }
    if name_hash == -4572427511160034080 { # free_buffer
        l = isel_emit_builtin_buffer(code_buf, l, 1, 0);
        set_qword(s, 4, l);
        return TYPE_I64;
    }
    if (name_hash == 210724587794) | (name_hash == 229479076111340) { # print or println
        let is_nl = 0;
        if name_hash == 229479076111340 { is_nl = 1; }
        let act_t = get_qword(tbl, 10240);
        l = emit_print_val_rdi(code_buf, l, act_t, is_nl);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_I64;
    }
    if name_hash == 229461282205997 { # byte_at
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_U8;
    }
    if name_hash == 6071565643712696392 { # int_to_string
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_U8);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_STR;
    }
    if name_hash == 249907052122048006 { # substring
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_U8);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_STR;
    }
    if name_hash == 4604361536122115656 { # string_to_int
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_I64;
    }
    if name_hash == 4604361535797710365 { # string_length
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_I64;
    }
    if name_hash == 4369978079523077955 { # string_byte_at
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_U8;
    }
    if name_hash == -2655435116151803629 { # string_equal
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_BOOL;
    }
    if name_hash == 4369978080415288578 { # string_compare
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_I64;
    }
    if name_hash == 4604361535457346067 { # string_concat
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_U8);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_STR;
    }
    if name_hash == -4552405688055474698 { # string_copy
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_I64;
    }
    if name_hash == -3364675804167515880 { # string_from_raw
        l = isel_emit_builtin_string(code_buf, l, name_hash);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_U8);
        set_qword(s, 15, PROV_UNKNOWN);
        return TYPE_STR;
    }

    # Not a builtin -> User defined function call
    if arg_count <= 6 {
        let need_align = 0;
        if (start_depth % 2) != 0 {
            need_align = 1;
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 236); l = emit_byte(code_buf, l, 8); # sub rsp, 8
        }

        let fn_idx = func_tbl_find_index(tbl, name_hash);
        if fn_idx >= 0 {
            let target = func_tbl_get(tbl, name_hash, 1);
            if target >= 0 {
                let disp = target - (l + 5);
                l = emit_call_rel32(code_buf, l, disp);
            } else {
                l = emit_call_rel32(code_buf, l, 0);
                patch_tbl_add(tbl, l - 4, name_hash);
            }
        } else {
            let v_slot = var_tbl_get(tbl, name_hash, 1);
            if v_slot > 0 {
                let v_slot_idx = (v_slot / 8) % 128;
                let v_fn_idx = get_qword(s, 16);
                let cur_cnt = get_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (v_fn_idx * 128) + v_slot_idx);
                if cur_cnt < 250 {
                    set_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (v_fn_idx * 128) + v_slot_idx, cur_cnt + 1);
                }
                let r_cnt = get_qword(tbl, 10380);
                if r_cnt < 10 {
                    set_qword(tbl, 10381 + r_cnt, v_slot_idx);
                    set_qword(tbl, 10380, r_cnt + 1);
                }
                l = emit_load_slot_typed(code_buf, l, v_slot, TYPE_PTR);
                l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 208); # call *rax
            } else {
                l = emit_call_rel32(code_buf, l, 0);
                patch_tbl_add(tbl, l - 4, name_hash);
            }
        }

        if need_align == 1 {
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 196); l = emit_byte(code_buf, l, 8); # add rsp, 8
        }
    } else {
        # arg_count > 6: SysV AMD64 Stack Arguments
        # 1. Load arguments 0..5 into registers from stack
        l = emit_mov_reg_rsp_disp(code_buf, l, 0, (arg_count - 1) * 8); # arg 0 -> RDI
        l = emit_mov_reg_rsp_disp(code_buf, l, 1, (arg_count - 2) * 8); # arg 1 -> RSI
        l = emit_mov_reg_rsp_disp(code_buf, l, 2, (arg_count - 3) * 8); # arg 2 -> RDX
        l = emit_mov_reg_rsp_disp(code_buf, l, 3, (arg_count - 4) * 8); # arg 3 -> RCX
        l = emit_mov_reg_rsp_disp(code_buf, l, 4, (arg_count - 5) * 8); # arg 4 -> R8
        l = emit_mov_reg_rsp_disp(code_buf, l, 5, (arg_count - 6) * 8); # arg 5 -> R9

        # 2. Allocate stack arguments area with 16-byte alignment
        let num_stack = arg_count - 6;
        let pad = start_depth % 2;
        let alloc_slots = num_stack + pad;
        let alloc_bytes = alloc_slots * 8;
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 129); l = emit_byte(code_buf, l, 236);
        l = emit_disp32(code_buf, l, alloc_bytes);

        # 3. Copy stack arguments to [rsp + 0], [rsp + 8], ...
        let i = 0;
        while i < num_stack {
            let src_disp = alloc_bytes + ((num_stack - 1 - i) * 8);
            let dst_disp = i * 8;
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139);
            if src_disp <= 127 {
                l = emit_byte(code_buf, l, 68); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, src_disp);
            } else {
                l = emit_byte(code_buf, l, 132); l = emit_byte(code_buf, l, 36); l = emit_disp32(code_buf, l, src_disp);
            }
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137);
            if dst_disp == 0 {
                l = emit_byte(code_buf, l, 4); l = emit_byte(code_buf, l, 36);
            } else {
                if dst_disp <= 127 {
                    l = emit_byte(code_buf, l, 68); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, dst_disp);
                } else {
                    l = emit_byte(code_buf, l, 132); l = emit_byte(code_buf, l, 36); l = emit_disp32(code_buf, l, dst_disp);
                }
            }
            i = i + 1;
        }

        # 4. Emit the call
        let fn_idx2 = func_tbl_find_index(tbl, name_hash);
        if fn_idx2 >= 0 {
            let target = func_tbl_get(tbl, name_hash, 1);
            if target >= 0 {
                let disp = target - (l + 5);
                l = emit_call_rel32(code_buf, l, disp);
            } else {
                l = emit_call_rel32(code_buf, l, 0);
                patch_tbl_add(tbl, l - 4, name_hash);
            }
        } else {
            let v_slot = var_tbl_get(tbl, name_hash, 1);
            if v_slot > 0 {
                let v_slot_idx = (v_slot / 8) % 128;
                let v_fn_idx = get_qword(s, 16);
                let cur_cnt = get_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (v_fn_idx * 128) + v_slot_idx);
                if cur_cnt < 250 {
                    set_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (v_fn_idx * 128) + v_slot_idx, cur_cnt + 1);
                }
                let r_cnt = get_qword(tbl, 10380);
                if r_cnt < 10 {
                    set_qword(tbl, 10381 + r_cnt, v_slot_idx);
                    set_qword(tbl, 10380, r_cnt + 1);
                }
                l = emit_load_slot_typed(code_buf, l, v_slot, TYPE_PTR);
                l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 208); # call *rax
            } else {
                l = emit_call_rel32(code_buf, l, 0);
                patch_tbl_add(tbl, l - 4, name_hash);
            }
        }

        # 5. Clean up stack arguments and expression stack
        let cleanup_bytes = alloc_bytes + (arg_count * 8);
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 129); l = emit_byte(code_buf, l, 196);
        l = emit_disp32(code_buf, l, cleanup_bytes);
        set_qword(s, 12, start_depth);
    }

    set_qword(s, 4, l);
    let ret_t = func_tbl_get(tbl, name_hash, 3);
    if ret_t <= 0 { ret_t = TYPE_I64; }
    if ret_t == TYPE_PTR {
        set_qword(s, 14, func_tbl_get(tbl, name_hash, 22));
        set_qword(s, 15, func_tbl_get(tbl, name_hash, 23));
    } else {
        if ret_t == TYPE_TUPLE {
            set_qword(s, 14, func_tbl_get(tbl, name_hash, 22));
            set_qword(s, 18, func_tbl_get(tbl, name_hash, 23));
            set_qword(s, 19, 2);
            set_qword(s, 15, PROV_UNKNOWN);
        } else {
            set_qword(s, 14, TYPE_NONE);
            set_qword(s, 15, PROV_UNKNOWN);
        }
    }
    return ret_t;
}

# ------------------------------------------------------------------------------
# Expression Parser (Precedence: Comparisons < Additive < Multiplicative < Primary)
# Returns expression type (TYPE_*)
# ------------------------------------------------------------------------------

fn emit_wrap_nested_payload(s: i64, code_buf: i64, len: i64, outer_tag: i64): i64 {
    let l = len;
    let cur_stk = get_qword(s, 20);
    let inner_slot = cur_stk + 16;
    set_qword(s, 20, inner_slot);
    l = emit_store_slot_typed(code_buf, l, inner_slot, TYPE_I64);
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 208); # mov rax, rdx
    l = emit_store_slot_typed(code_buf, l, inner_slot - 8, TYPE_I64);
    if inner_slot < 128 {
        let disp8 = (256 - inner_slot) % 256;
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 141); l = emit_byte(code_buf, l, 85); l = emit_byte(code_buf, l, disp8);
    } else {
        let disp32 = 4294967296 - inner_slot;
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 141); l = emit_byte(code_buf, l, 149);
        l = emit_disp32(code_buf, l, disp32);
    }
    if outer_tag == 1 {
        l = emit_mov_imm64(code_buf, l, 0, 1);
    } else {
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 192);
    }
    return l;
}

fn parse_arm_payload(s: i64, src: i64, tbl: i64, target_slot: i64, out_info: i64): i64 {
    advance_token(s); # skip '('
    set_qword(out_info, 0, 0); # has_nested = 0
    set_qword(out_info, 1, 0); # nested_val = 0
    set_qword(out_info, 2, 0); # nested_bind_hash = 0
    set_qword(out_info, 3, 0); # nested_bind_slot = 0
    set_qword(out_info, 4, 0); # leaf_bind_slot = 0
    let in_k = cur_tok_kind(s);
    if in_k == TOKEN_IDENT {
        let in_off = cur_tok_offset(s);
        let in_len = cur_tok_len(s);
        let in_h = hash_token(src, in_off, in_len);
        advance_token(s);
        if (in_h == 5862623) | (in_h == 6384548249) { # 'Ok' or 'Some'
            if cur_tok_kind(s) == TOKEN_LPAREN {
                advance_token(s); # skip inner '('
                let v_off = cur_tok_offset(s);
                let v_len = cur_tok_len(s);
                let v_h = hash_token(src, v_off, v_len);
                expect(s, TOKEN_IDENT);
                expect(s, TOKEN_RPAREN); # close inner ')'
                expect(s, TOKEN_RPAREN); # close outer ')'
                set_qword(out_info, 0, 1);
                set_qword(out_info, 1, 1);
                let v_slot = get_qword(s, 20) + 8;
                set_qword(s, 20, v_slot);
                set_qword(out_info, 2, v_h);
                set_qword(out_info, 3, v_slot);
                var_tbl_add(tbl, v_h, v_slot, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
                return 0;
            } else {
                expect(s, TOKEN_RPAREN);
                let v_slot = get_qword(s, 20) + 8;
                set_qword(s, 20, v_slot);
                set_qword(out_info, 4, v_slot);
                var_tbl_add(tbl, in_h, v_slot, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
                return 0;
            }
        }
        if (in_h == 193456014) | (in_h == 6384368597) { # 'Err' or 'None'
            if cur_tok_kind(s) == TOKEN_LPAREN {
                advance_token(s); # skip '('
                let v_off = cur_tok_offset(s);
                let v_len = cur_tok_len(s);
                let v_h = hash_token(src, v_off, v_len);
                expect(s, TOKEN_IDENT);
                expect(s, TOKEN_RPAREN); # close inner ')'
                expect(s, TOKEN_RPAREN); # close outer ')'
                set_qword(out_info, 0, 1);
                set_qword(out_info, 1, 0);
                let v_slot = get_qword(s, 20) + 8;
                set_qword(s, 20, v_slot);
                set_qword(out_info, 2, v_h);
                set_qword(out_info, 3, v_slot);
                var_tbl_add(tbl, v_h, v_slot, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
                return 0;
            } else {
                if in_h == 6384368597 { # None with no parens
                    expect(s, TOKEN_RPAREN);
                    set_qword(out_info, 0, 1);
                    set_qword(out_info, 1, 0);
                    return 0;
                } else {
                    expect(s, TOKEN_RPAREN);
                    let v_slot = get_qword(s, 20) + 8;
                    set_qword(s, 20, v_slot);
                    set_qword(out_info, 4, v_slot);
                    var_tbl_add(tbl, in_h, v_slot, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
                    return 0;
                }
            }
        }
        # Regular leaf binding: Ok(v) or Err(e)
        expect(s, TOKEN_RPAREN);
        let v_slot = get_qword(s, 20) + 8;
        set_qword(s, 20, v_slot);
        set_qword(out_info, 4, v_slot);
        var_tbl_add(tbl, in_h, v_slot, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
        return 0;
    }
    return -1;
}

fn parse_primary(s: i64): i64 {
    let src = get_qword(s, 0);
    let code_buf = get_qword(s, 3);
    let l = get_qword(s, 4);
    let tbl = get_qword(s, 5);

    let start_l = get_qword(s, 4);
    let start_d = get_qword(s, 12);
    set_qword(s, 24, 0);
    set_qword(s, 25, 0);

    let k = cur_tok_kind(s);

    if k == TOKEN_MINUS {
        advance_token(s);
        let t = parse_primary(s);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        if t == TYPE_PTR {
            set_qword(s, 7, -44); # ERR_INVALID_PTR_OP
            return -44;
        }
        if (type_is_integer(t) == 0) & (type_is_float(t) == 0) {
            set_qword(s, 7, -43); # ERR_INVALID_BIN_OP_TYPE
            return -43;
        }
        if type_is_float(t) == 1 {
            l = get_qword(s, 4);
            if t == TYPE_F32 {
                # xor eax, 0x80000000 (35 00 00 00 80)
                l = emit_byte(code_buf, l, 53);
                l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 128);
            } else {
                # Invert sign bit of float in rax: mov r10, 0x8000000000000000 (49 BA ...); xor rax, r10 (4C 31 D0)
                l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 186);
                l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
                l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 128);
                l = emit_byte(code_buf, l, 76); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 208);
            }
            set_qword(s, 4, l);
            set_qword(s, 14, TYPE_NONE);
            set_qword(s, 15, PROV_UNKNOWN);
            set_qword(s, 24, 0);
            return t;
        }
        if get_qword(s, 22) == 1 {
            if get_qword(s, 24) == 1 {
                let v = get_qword(s, 25);
                let folded = 0 - v;
                if t == TYPE_I32 {
                    let m = folded % 4294967296;
                    if m >= 2147483648 { m = m - 4294967296; }
                    folded = m;
                }
                if t == TYPE_U8 {
                    let m = folded % 256;
                    if m < 0 { m = m + 256; }
                    folded = m;
                }
                set_qword(s, 4, start_l);
                set_qword(s, 12, start_d);
                l = emit_mov_imm64(code_buf, start_l, 0, folded);
                set_qword(s, 4, l);
                set_qword(s, 24, 1);
                set_qword(s, 25, folded);
                let opt_ctx = get_qword(s, 23);
                if opt_ctx > 0 {
                    let p2_ch = get_qword(opt_ctx + 96, 2);
                    set_qword(opt_ctx + 96, 2, p2_ch + 1);
                    let tot_ch = get_qword(opt_ctx, 2);
                    set_qword(opt_ctx, 2, tot_ch + 1);
                }
                return t;
            }
        }
        l = get_qword(s, 4);
        if t == TYPE_I32 {
            l = emit_byte(code_buf, l, 247);
            l = emit_byte(code_buf, l, 216); # neg eax (F7 D8)
        } else {
            if t == TYPE_U8 {
                l = emit_byte(code_buf, l, 246);
                l = emit_byte(code_buf, l, 216); # neg al (F6 D8)
            } else {
                l = emit_byte(code_buf, l, 72);
                l = emit_byte(code_buf, l, 247);
                l = emit_byte(code_buf, l, 216); # neg rax (48 F7 D8)
            }
        }
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        set_qword(s, 24, 0);
        return t;
    }

    if k == TOKEN_BANG {
        advance_token(s);
        let t = parse_postfix(s);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        let is_valid = 0;
        if t == TYPE_BOOL { is_valid = 1; }
        if type_is_integer(t) == 1 { is_valid = 1; }
        if is_valid == 0 {
            set_qword(s, 7, -43); # ERR_INVALID_BIN_OP_TYPE
            return -43;
        }
        if get_qword(s, 22) == 1 {
            if get_qword(s, 24) == 1 {
                let v = get_qword(s, 25);
                let folded = 0;
                if v == 0 { folded = 1; }
                set_qword(s, 4, start_l);
                set_qword(s, 12, start_d);
                l = emit_mov_imm64(code_buf, start_l, 0, folded);
                set_qword(s, 4, l);
                set_qword(s, 24, 1);
                set_qword(s, 25, folded);
                let opt_ctx = get_qword(s, 23);
                if opt_ctx > 0 {
                    let p2_ch = get_qword(opt_ctx + 96, 2);
                    set_qword(opt_ctx + 96, 2, p2_ch + 1);
                    let tot_ch = get_qword(opt_ctx, 2);
                    set_qword(opt_ctx, 2, tot_ch + 1);
                }
                return TYPE_BOOL;
            }
        }
        l = get_qword(s, 4);
        # test rax, rax (48 85 C0)
        l = emit_byte(code_buf, l, 72);
        l = emit_byte(code_buf, l, 133);
        l = emit_byte(code_buf, l, 192);
        # sete al (0F 94 C0)
        l = emit_byte(code_buf, l, 15);
        l = emit_byte(code_buf, l, 148);
        l = emit_byte(code_buf, l, 192);
        # movzx rax, al (48 0F B6 C0)
        l = emit_byte(code_buf, l, 72);
        l = emit_byte(code_buf, l, 15);
        l = emit_byte(code_buf, l, 182);
        l = emit_byte(code_buf, l, 192);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        set_qword(s, 24, 0);
        return TYPE_BOOL;
    }

    if k == TOKEN_TILDE {
        advance_token(s);
        let t = parse_postfix(s);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        if type_is_integer(t) == 0 {
            set_qword(s, 7, -43); # ERR_INVALID_BIN_OP_TYPE
            return -43;
        }
        if get_qword(s, 22) == 1 {
            if get_qword(s, 24) == 1 {
                let v = get_qword(s, 25);
                let folded = 0 - 1 - v;
                if t == TYPE_I32 {
                    let m = folded % 4294967296;
                    if m >= 2147483648 { m = m - 4294967296; }
                    folded = m;
                }
                if t == TYPE_U8 {
                    let m = folded % 256;
                    if m < 0 { m = m + 256; }
                    folded = m;
                }
                set_qword(s, 4, start_l);
                set_qword(s, 12, start_d);
                l = emit_mov_imm64(code_buf, start_l, 0, folded);
                set_qword(s, 4, l);
                set_qword(s, 24, 1);
                set_qword(s, 25, folded);
                let opt_ctx = get_qword(s, 23);
                if opt_ctx > 0 {
                    let p2_ch = get_qword(opt_ctx + 96, 2);
                    set_qword(opt_ctx + 96, 2, p2_ch + 1);
                    let tot_ch = get_qword(opt_ctx, 2);
                    set_qword(opt_ctx, 2, tot_ch + 1);
                }
                return t;
            }
        }
        l = get_qword(s, 4);
        if t == TYPE_I32 {
            l = emit_byte(code_buf, l, 247);
            l = emit_byte(code_buf, l, 208); # not eax (F7 D0)
        } else {
            if t == TYPE_U8 {
                l = emit_byte(code_buf, l, 246);
                l = emit_byte(code_buf, l, 208); # not al (F6 D0)
            } else {
                l = emit_byte(code_buf, l, 72);
                l = emit_byte(code_buf, l, 247);
                l = emit_byte(code_buf, l, 208); # not rax (48 F7 D0)
            }
        }
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        set_qword(s, 24, 0);
        return t;
    }

    if k == TOKEN_AMP {
        advance_token(s); # skip '&'
        if cur_tok_kind(s) != TOKEN_IDENT {
            set_qword(s, 7, -1); # syntax error
            return -1;
        }
        let offset = cur_tok_offset(s);
        let slen = cur_tok_len(s);
        let hash = hash_token(src, offset, slen);
        advance_token(s); # skip ident
        let slot = var_tbl_get(tbl, hash, 1);
        if slot == 0 {
            set_qword(s, 7, -2); # undefined identifier or not a local variable
            set_qword(s, 10, offset);
            set_qword(s, 11, hash);
            return -1;
        }
        let slot_idx = (slot / 8) % 128;
        let fn_idx = get_qword(s, 16);
        set_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + slot_idx, 1);
        set_qword(s, 27, 1);
        set_qword(tbl, 110000 + (slot_idx * 2), 0);
        set_qword(s, 24, 0);
        let target_var_type = var_tbl_get(tbl, hash, 2);

        if cur_tok_kind(s) == TOKEN_DOT {
            let curr_struct_id = -1;
            let prov = PROV_UNKNOWN;
            let l = get_qword(s, 4);
            if target_var_type >= TYPE_STRUCT {
                prov = var_tbl_get(tbl, hash, 4);
                if prov == PROV_STACK_LOCAL {
                    l = emit_lea_slot(code_buf, l, slot);
                } else {
                    l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
                }
                curr_struct_id = target_var_type - TYPE_STRUCT;
            } else {
                if target_var_type == TYPE_PTR {
                    let p_pointee = var_tbl_get(tbl, hash, 3);
                    if p_pointee >= TYPE_STRUCT {
                        l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
                        curr_struct_id = p_pointee - TYPE_STRUCT;
                        prov = var_tbl_get(tbl, hash, 4);
                    }
                }
            }
            if curr_struct_id < 0 {
                set_qword(s, 7, -51);
                return -51;
            }
            let f_type = TYPE_NONE;
            let f_pointee = TYPE_NONE;
            while cur_tok_kind(s) == TOKEN_DOT {
                advance_token(s); # skip '.'
                if cur_tok_kind(s) != TOKEN_IDENT {
                    set_qword(s, 7, -51);
                    return -51;
                }
                let f_hash = hash_token(src, cur_tok_offset(s), cur_tok_len(s));
                advance_token(s);
                let f_idx = struct_tbl_find_field(tbl, curr_struct_id, f_hash);
                if f_idx < 0 {
                    set_qword(s, 7, -51);
                    return -51;
                }
                f_type = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 1);
                f_pointee = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 2);
                let f_off = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 3);
                l = emit_add_rax_imm32(code_buf, l, f_off);
                if cur_tok_kind(s) == TOKEN_DOT {
                    if f_type >= TYPE_STRUCT {
                        curr_struct_id = f_type - TYPE_STRUCT;
                    } else {
                        if f_type == TYPE_PTR {
                            if f_pointee >= TYPE_STRUCT {
                                l = emit_field_load_typed(code_buf, l, 0, TYPE_PTR);
                                curr_struct_id = f_pointee - TYPE_STRUCT;
                                prov = PROV_UNKNOWN;
                            } else {
                                set_qword(s, 7, -51);
                                return -51;
                            }
                        } else {
                            set_qword(s, 7, -51);
                            return -51;
                        }
                    }
                }
            }
            set_qword(s, 4, l);
            set_qword(s, 14, f_type);
            set_qword(s, 15, prov);
            set_qword(s, 18, f_pointee);
            return TYPE_PTR;
        }

        if cur_tok_kind(s) == TOKEN_LBRACKET {
            if target_var_type == TYPE_ARRAY {
                let elem_pointee = var_tbl_get(tbl, hash, 3);
                let elem_prov = var_tbl_get(tbl, hash, 4);
                let arr_len = var_tbl_get(tbl, hash, 5);
                let l = get_qword(s, 4);
                if elem_prov == PROV_STACK_LOCAL {
                    l = emit_lea_slot(code_buf, l, slot);
                } else {
                    l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
                }
                set_qword(s, 4, l);
                parser_push_rax(s);
                advance_token(s); # skip '['
                let idx_t = parse_expr(s);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                if type_is_integer(idx_t) == 0 {
                    set_qword(s, 7, -43);
                    return -43;
                }
                expect(s, TOKEN_RBRACKET);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                l = get_qword(s, 4);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
                l = emit_bounds_check(code_buf, l, arr_len);
                l = emit_byte(code_buf, l, 95); # pop rdi
                let cur_d = get_qword(s, 12);
                set_qword(s, 12, cur_d - 1);
                let elem_sz = type_size(elem_pointee);
                if elem_pointee >= TYPE_STRUCT {
                    elem_sz = struct_tbl_get_meta(tbl, elem_pointee - TYPE_STRUCT, 1);
                }
                l = emit_index_lea_sized(code_buf, l, elem_sz);
                set_qword(s, 4, l);
                set_qword(s, 14, elem_pointee);
                set_qword(s, 15, elem_prov);
                return TYPE_PTR;
            }
            if target_var_type != TYPE_PTR {
                set_qword(s, 7, -47); # ERR_INVALID_PTR_DEREF
                return -47;
            }
            let elem_pointee = var_tbl_get(tbl, hash, 3);
            if elem_pointee == TYPE_NONE {
                if get_qword(s, 17) == 1 {
                    set_qword(s, 7, -47); # ERR_INVALID_PTR_DEREF
                    return -47;
                }
                elem_pointee = TYPE_I64;
            }
            let elem_prov = var_tbl_get(tbl, hash, 4);
            l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
            set_qword(s, 4, l);
            parser_push_rax(s);
            advance_token(s); # skip '['
            let idx_t = parse_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            if type_is_integer(idx_t) == 0 {
                set_qword(s, 7, -43);
                return -43;
            }
            expect(s, TOKEN_RBRACKET);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            l = get_qword(s, 4);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
            l = emit_byte(code_buf, l, 95); # pop rdi
            let cur_d = get_qword(s, 12);
            set_qword(s, 12, cur_d - 1);
            let elem_sz2 = type_size(elem_pointee);
            if elem_pointee >= TYPE_STRUCT {
                elem_sz2 = struct_tbl_get_meta(tbl, elem_pointee - TYPE_STRUCT, 1);
            }
            l = emit_index_lea_sized(code_buf, l, elem_sz2);
            set_qword(s, 4, l);
            set_qword(s, 14, elem_pointee);
            set_qword(s, 15, elem_prov);
            return TYPE_PTR;
        }

        l = emit_lea_slot(code_buf, l, slot);
        set_qword(s, 4, l);
        set_qword(s, 14, target_var_type);     # pointee type
        set_qword(s, 15, PROV_STACK_LOCAL);    # provenance: local stack variable!
        set_qword(s, 18, var_tbl_get(tbl, hash, 3)); # secondary pointee
        return TYPE_PTR;
    }

    if k == TOKEN_STAR {
        advance_token(s); # skip '*'
        set_qword(s, 27, 1); # dereference load is a side effect
        let p_t = parse_postfix(s);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        if p_t != TYPE_PTR {
            set_qword(s, 7, -47); # ERR_INVALID_PTR_DEREF
            return -47;
        }
        let pointee_t = get_qword(s, 14);
        if pointee_t == TYPE_VOID {
            set_qword(s, 7, -45); # ERR_VOID_EXPR_USED
            return -45;
        }
        if pointee_t == TYPE_NONE {
            if get_qword(s, 17) == 1 {
                set_qword(s, 7, -47); # ERR_INVALID_PTR_DEREF
                return -47;
            }
            pointee_t = TYPE_INT_LIT;
        }
        l = get_qword(s, 4);
        if pointee_t >= TYPE_STRUCT {
            set_qword(s, 14, pointee_t - TYPE_STRUCT);
            set_qword(s, 15, PROV_UNKNOWN);
            return pointee_t;
        }
        l = emit_deref_load_typed(code_buf, l, pointee_t);
        set_qword(s, 4, l);
        if pointee_t == TYPE_PTR {
            set_qword(s, 14, get_qword(s, 18));
        } else {
            set_qword(s, 14, TYPE_NONE);
        }
        set_qword(s, 15, PROV_UNKNOWN);
        return pointee_t;
    }

    if k == TOKEN_LPAREN {
        advance_token(s);
        if cur_tok_kind(s) == TOKEN_RPAREN {
            advance_token(s); # unit literal ()
            l = emit_mov_imm64(code_buf, l, 0, 0);
            set_qword(s, 4, l);
            set_qword(s, 14, TYPE_NONE);
            set_qword(s, 15, PROV_UNKNOWN);
            set_qword(s, 24, 0);
            return TYPE_VOID;
        }
        let t = parse_expr(s);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        if cur_tok_kind(s) == TOKEN_COMMA {
            advance_token(s); # skip ','
            if cur_tok_kind(s) == TOKEN_RPAREN {
                advance_token(s); # (e0,)
                set_qword(s, 14, t);
                set_qword(s, 18, TYPE_NONE);
                set_qword(s, 19, 1);
                set_qword(s, 24, 0);
                return TYPE_TUPLE;
            }
            parser_push_rax(s);
            let a_t2 = parse_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            if cur_tok_kind(s) == TOKEN_COMMA {
                advance_token(s); # skip ','
                if cur_tok_kind(s) == TOKEN_RPAREN {
                    # Trailing comma: (e0, e1,)
                    advance_token(s);
                    l = get_qword(s, 4);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 194); # mov rdx, rax
                    l = emit_byte(code_buf, l, 88); # pop rax
                    cur_d = get_qword(s, 12);
                    set_qword(s, 12, cur_d - 1);
                    set_qword(s, 4, l);
                    set_qword(s, 14, t);
                    set_qword(s, 18, a_t2);
                    set_qword(s, 19, 2);
                    set_qword(s, 24, 0);
                    return TYPE_TUPLE;
                }
                # Arity >= 3
                parser_push_rax(s);
                let cur_cnt = 2;
                while (cur_tok_kind(s) != TOKEN_RPAREN) & (cur_tok_kind(s) != TOKEN_EOF) {
                    let arm_t = parse_expr(s);
                    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                    parser_push_rax(s);
                    cur_cnt = cur_cnt + 1;
                    if cur_tok_kind(s) == TOKEN_COMMA {
                        advance_token(s);
                    }
                }
                expect(s, TOKEN_RPAREN);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                let cur_bytes = get_qword(s, 20);
                slot = cur_bytes + (cur_cnt * 8);
                set_qword(s, 20, slot);
                l = get_qword(s, 4);
                let i = cur_cnt - 1;
                while i >= 0 {
                    l = emit_byte(code_buf, l, 88); # pop rax
                    cur_d = get_qword(s, 12);
                    set_qword(s, 12, cur_d - 1);
                    let disp = slot - (i * 8);
                    l = emit_store_slot_typed(code_buf, l, disp, TYPE_I64);
                    i = i - 1;
                }
                l = emit_lea_slot(code_buf, l, slot);
                set_qword(s, 4, l);
                set_qword(s, 14, t);
                set_qword(s, 18, a_t2);
                set_qword(s, 19, cur_cnt);
                set_qword(s, 24, 0);
                return TYPE_TUPLE;
            }
            expect(s, TOKEN_RPAREN);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            l = get_qword(s, 4);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 194); # mov rdx, rax
            l = emit_byte(code_buf, l, 88); # pop rax
            cur_d = get_qword(s, 12);
            set_qword(s, 12, cur_d - 1);
            set_qword(s, 4, l);
            set_qword(s, 14, t);
            set_qword(s, 18, a_t2);
            set_qword(s, 19, 2);
            set_qword(s, 24, 0);
            return TYPE_TUPLE;
        }
        expect(s, TOKEN_RPAREN);
        return t;
    }

    if k == TOKEN_KW_TRUE {
        advance_token(s);
        l = emit_mov_imm64(code_buf, l, 0, 1);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        set_qword(s, 24, 1);
        set_qword(s, 25, 1);
        return TYPE_BOOL;
    }

    if k == TOKEN_KW_FALSE {
        advance_token(s);
        l = emit_mov_imm64(code_buf, l, 0, 0);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        set_qword(s, 24, 1);
        set_qword(s, 25, 0);
        return TYPE_BOOL;
    }

    if k == TOKEN_KW_NULL {
        advance_token(s);
        l = emit_mov_imm64(code_buf, l, 0, 0);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        set_qword(s, 24, 1);
        set_qword(s, 25, 0);
        return TYPE_PTR;
    }

    if k == TOKEN_INT_LIT {
        let val = cur_tok_val(s);
        advance_token(s);
        l = emit_mov_imm64(code_buf, l, 0, val);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        set_qword(s, 24, 1);
        set_qword(s, 25, val);
        return TYPE_INT_LIT;
    }

    if k == TOKEN_CHAR_LIT {
        let val = cur_tok_val(s);
        advance_token(s);
        l = emit_mov_imm64(code_buf, l, 0, val);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        set_qword(s, 24, 1);
        set_qword(s, 25, val);
        return TYPE_CHAR;
    }

    if k == TOKEN_FLOAT_LIT {
        let val = cur_tok_val(s);
        advance_token(s);
        l = emit_mov_imm64(code_buf, l, 0, val);
        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        set_qword(s, 24, 1);
        set_qword(s, 25, val);
        return TYPE_FLOAT_LIT;
    }

    if k == TOKEN_STR_LIT {
        let offset = cur_tok_offset(s);
        let slen = cur_tok_len(s);
        advance_token(s);

        # 1. Emit jmp rel32 over data to bypass execution
        let jmp_pos = l;
        l = emit_jmp_rel32(code_buf, l, 0);

        # 2. str_start_pos is where the 8-byte length header begins
        let str_start_pos = l;
        let len_patch_pos = l;
        let k_str = 0;
        while k_str < 8 {
            l = emit_byte(code_buf, l, 0);
            k_str = k_str + 1;
        }

        # 3. Decode escapes and emit payload bytes
        let i_str = 0;
        let dec_len = 0;
        while i_str < slen {
            let b = get_byte(src, offset + i_str);
            if b == 92 { # '\' escape
                i_str = i_str + 1;
                if i_str < slen {
                    let esc = get_byte(src, offset + i_str);
                    if esc == 110 { l = emit_byte(code_buf, l, 10); } # '\n'
                    if esc == 116 { l = emit_byte(code_buf, l, 9);  } # '\t'
                    if esc == 114 { l = emit_byte(code_buf, l, 13); } # '\r'
                    if esc == 48  { l = emit_byte(code_buf, l, 0);  } # '\0'
                    if esc == 92  { l = emit_byte(code_buf, l, 92); } # '\\'
                    if esc == 34  { l = emit_byte(code_buf, l, 34); } # '\"'
                    dec_len = dec_len + 1;
                }
            } else {
                l = emit_byte(code_buf, l, b);
                dec_len = dec_len + 1;
            }
            i_str = i_str + 1;
        }

        # 4. Trailing NUL terminator
        l = emit_byte(code_buf, l, 0);

        # 5. Backpatch 8-byte length header at len_patch_pos
        set_byte(code_buf, len_patch_pos,     dec_len % 256);
        set_byte(code_buf, len_patch_pos + 1, (dec_len / 256) % 256);
        set_byte(code_buf, len_patch_pos + 2, (dec_len / 65536) % 256);
        set_byte(code_buf, len_patch_pos + 3, (dec_len / 16777216) % 256);
        set_byte(code_buf, len_patch_pos + 4, 0);
        set_byte(code_buf, len_patch_pos + 5, 0);
        set_byte(code_buf, len_patch_pos + 6, 0);
        set_byte(code_buf, len_patch_pos + 7, 0);

        # 6. Backpatch jmp rel32 to jump directly to post_pos
        let post_pos = l;
        emit_backpatch32(code_buf, jmp_pos + 1, post_pos);

        # 7. lea rax, [rip + disp32] pointing to str_start_pos (7 bytes)
        let next_ip = l + 7;
        let disp = str_start_pos - next_ip;
        if disp < 0 { disp = disp + 4294967296; }

        l = emit_byte(code_buf, l, 72);
        l = emit_byte(code_buf, l, 141);
        l = emit_byte(code_buf, l, 5);
        l = emit_disp32(code_buf, l, disp);

        set_qword(s, 4, l);
        set_qword(s, 14, TYPE_U8);
        set_qword(s, 15, PROV_UNKNOWN);
        set_qword(s, 24, 0);
        return TYPE_STR;
    }

    if k == TOKEN_IDENT {
        let offset = cur_tok_offset(s);
        let slen = cur_tok_len(s);
        let hash = hash_token(src, offset, slen);
        advance_token(s);

        if hash == 6384368597 { # 'None'
            l = get_qword(s, 4);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 192); # xor rax, rax
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 210); # xor rdx, rdx
            set_qword(s, 4, l);
            set_qword(s, 14, TYPE_NONE);
            set_qword(s, 15, PROV_UNKNOWN);
            set_qword(s, 24, 0);
            return TYPE_OPTION;
        }

        if (hash == 6384548249) & (cur_tok_kind(s) == TOKEN_LPAREN) { # 'Some'
            advance_token(s); # skip '('
            let t = parse_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            expect(s, TOKEN_RPAREN);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            l = get_qword(s, 4);
            if (t == TYPE_RESULT) | (t == TYPE_OPTION) {
                l = emit_wrap_nested_payload(s, code_buf, l, 1);
            } else {
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 194); # mov rdx, rax
                l = emit_mov_imm64(code_buf, l, 0, 1); # mov rax, 1
            }
            set_qword(s, 4, l);
            set_qword(s, 14, t);
            set_qword(s, 15, PROV_UNKNOWN);
            set_qword(s, 24, 0);
            return TYPE_OPTION;
        }

        if (hash == 5862623) & (cur_tok_kind(s) == TOKEN_LPAREN) { # 'Ok'
            advance_token(s); # skip '('
            let t = parse_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            expect(s, TOKEN_RPAREN);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            l = get_qword(s, 4);
            if (t == TYPE_RESULT) | (t == TYPE_OPTION) {
                l = emit_wrap_nested_payload(s, code_buf, l, 1);
            } else {
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 194); # mov rdx, rax
                l = emit_mov_imm64(code_buf, l, 0, 1); # mov rax, 1
            }
            set_qword(s, 4, l);
            set_qword(s, 14, t);
            set_qword(s, 18, TYPE_NONE);
            set_qword(s, 15, PROV_UNKNOWN);
            set_qword(s, 24, 0);
            return TYPE_RESULT;
        }

        if (hash == 193456014) & (cur_tok_kind(s) == TOKEN_LPAREN) { # 'Err'
            advance_token(s); # skip '('
            let t = parse_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            expect(s, TOKEN_RPAREN);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            l = get_qword(s, 4);
            if (t == TYPE_RESULT) | (t == TYPE_OPTION) {
                l = emit_wrap_nested_payload(s, code_buf, l, 0);
            } else {
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 194); # mov rdx, rax
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 192); # xor rax, rax
            }
            set_qword(s, 4, l);
            set_qword(s, 14, TYPE_NONE);
            set_qword(s, 18, t);
            set_qword(s, 15, PROV_UNKNOWN);
            set_qword(s, 24, 0);
            return TYPE_RESULT;
        }

        if (hash == 6952617947198) & (cur_tok_kind(s) == TOKEN_DOT) { # 'Option.'
            advance_token(s); # skip '.'
            offset = cur_tok_offset(s);
            slen = cur_tok_len(s);
            hash = hash_token(src, offset, slen);
            advance_token(s);
            if hash == 6384368597 { # 'None'
                l = get_qword(s, 4);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 192);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 210);
                set_qword(s, 4, l);
                set_qword(s, 14, TYPE_NONE);
                return TYPE_OPTION;
            }
            if hash == 6384548249 { # 'Some'
                expect(s, TOKEN_LPAREN);
                let t = parse_expr(s);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                expect(s, TOKEN_RPAREN);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                l = get_qword(s, 4);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 194);
                l = emit_mov_imm64(code_buf, l, 0, 1);
                set_qword(s, 4, l);
                set_qword(s, 14, t);
                return TYPE_OPTION;
            }
        }

        if (hash == 6952722285284) & (cur_tok_kind(s) == TOKEN_DOT) { # 'Result.'
            advance_token(s); # skip '.'
            offset = cur_tok_offset(s);
            slen = cur_tok_len(s);
            hash = hash_token(src, offset, slen);
            advance_token(s);
            if hash == 5862623 { # 'Ok'
                expect(s, TOKEN_LPAREN);
                let t = parse_expr(s);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                expect(s, TOKEN_RPAREN);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                l = get_qword(s, 4);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 194);
                l = emit_mov_imm64(code_buf, l, 0, 1);
                set_qword(s, 4, l);
                set_qword(s, 14, t);
                return TYPE_RESULT;
            }
            if hash == 193456014 { # 'Err'
                expect(s, TOKEN_LPAREN);
                let t = parse_expr(s);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                expect(s, TOKEN_RPAREN);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                l = get_qword(s, 4);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 194);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 192);
                set_qword(s, 4, l);
                set_qword(s, 14, TYPE_NONE);
                set_qword(s, 18, t);
                return TYPE_RESULT;
            }
        }

        if cur_tok_kind(s) == TOKEN_DOT {
            let enum_id = enum_tbl_find(tbl, hash);
            if enum_id >= 0 {
                advance_token(s); # skip '.'
                let vk = cur_tok_kind(s);
                if (vk == TOKEN_RBRACE) | (vk == TOKEN_SEMICOLON) | (vk == TOKEN_EOF) {
                    set_qword(s, 7, -1);
                    return -1;
                }
                let v_off = cur_tok_offset(s);
                let v_len = cur_tok_len(s);
                let v_h = hash_token(src, v_off, v_len);
                advance_token(s);
                let v_idx = enum_tbl_find_variant(tbl, enum_id, v_h);
                if v_idx < 0 {
                    set_qword(s, 7, -51);
                    return -51;
                }
                let cval = enum_tbl_get_variant_val(tbl, enum_id, v_idx);
                l = get_qword(s, 4);
                l = emit_mov_imm64(code_buf, l, 0, cval);
                set_qword(s, 4, l);
                set_qword(s, 14, TYPE_NONE);
                set_qword(s, 15, PROV_UNKNOWN);
                set_qword(s, 24, 1);
                set_qword(s, 25, cval);
                return TYPE_I64;
            }
        }

        let is_gen_fn = gen_tbl_op(tbl, 4, hash, 0, 0, 0, 0, 0, 0);
        let is_gen_st = gen_tbl_op(tbl, 1, hash, 0, 0, 0, 0, 0, 0);
        if (cur_tok_kind(s) == TOKEN_LBRACKET) & ((is_gen_fn >= 0) | (is_gen_st >= 0)) {
            advance_token(s); # skip '['
            let gt0 = parse_type(s);
            let gt1 = TYPE_NONE;
            let gt2 = TYPE_NONE;
            let gt3 = TYPE_NONE;
            let gt_cnt = 1;
            while cur_tok_kind(s) == TOKEN_COMMA {
                advance_token(s);
                let next_gt = parse_type(s);
                if gt_cnt == 1 { gt1 = next_gt; }
                if gt_cnt == 2 { gt2 = next_gt; }
                if gt_cnt == 3 { gt3 = next_gt; }
                gt_cnt = gt_cnt + 1;
            }
            expect(s, TOKEN_RBRACKET);
            let mangled_h = mangle_generic_hash(hash, gt_cnt, gt0, gt1, gt2, gt3);
            if is_gen_st >= 0 {
                let s_id = struct_tbl_find(tbl, mangled_h);
                if s_id < 0 {
                    s_id = instantiate_generic_struct(s, is_gen_st, mangled_h, gt_cnt, gt0, gt1, gt2, gt3);
                }
            } else {
                let spec_idx = gen_tbl_op(tbl, 7, mangled_h, 0, 0, 0, 0, 0, 0);
                if spec_idx < 0 {
                    gen_tbl_op(tbl, 8, is_gen_fn, mangled_h, gt0, gt1, gt2, gt3, 0);
                    func_tbl_add(tbl, mangled_h, -1, -1, gt0);
                }
            }
            hash = mangled_h;
        }

        if cur_tok_kind(s) == TOKEN_LPAREN {
            # Function Call as expression operand
            set_qword(s, 24, 0);
            advance_token(s); # skip '('
            let arg_count = 0;
            if cur_tok_kind(s) != TOKEN_RPAREN {
                let a_t = parse_expr(s);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                if a_t == TYPE_TUPLE {
                    arr_len = get_qword(s, 19);
                    if arr_len == 0 { arr_len = 2; }
                    if arr_len <= 2 {
                        cur_bytes = get_qword(s, 20);
                        slot = cur_bytes + 16;
                        set_qword(s, 20, slot);
                        l = get_qword(s, 4);
                        l = emit_store_slot_typed(code_buf, l, slot, TYPE_TUPLE);
                        l = emit_lea_slot(code_buf, l, slot);
                        set_qword(s, 4, l);
                    }
                }
                set_qword(tbl, 10240 + arg_count, a_t);
                set_qword(tbl, 10272 + arg_count, get_qword(s, 14));
                set_qword(tbl, 10304 + arg_count, get_qword(s, 15));
                set_qword(tbl, 10336 + arg_count, get_qword(s, 19));
                parser_push_rax(s);
                arg_count = 1;
                while cur_tok_kind(s) == TOKEN_COMMA {
                    advance_token(s);
                    let a_t2 = parse_expr(s);
                    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                    if a_t2 == TYPE_TUPLE {
                        arr_len = get_qword(s, 19);
                        if arr_len == 0 { arr_len = 2; }
                        if arr_len <= 2 {
                            cur_bytes = get_qword(s, 20);
                            slot = cur_bytes + 16;
                            set_qword(s, 20, slot);
                            l = get_qword(s, 4);
                            l = emit_store_slot_typed(code_buf, l, slot, TYPE_TUPLE);
                            l = emit_lea_slot(code_buf, l, slot);
                            set_qword(s, 4, l);
                        }
                    }
                    set_qword(tbl, 10240 + arg_count, a_t2);
                    set_qword(tbl, 10272 + arg_count, get_qword(s, 14));
                    set_qword(tbl, 10304 + arg_count, get_qword(s, 15));
                    set_qword(tbl, 10336 + arg_count, get_qword(s, 19));
                    parser_push_rax(s);
                    arg_count = arg_count + 1;
                }
            }
            expect(s, TOKEN_RPAREN);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            let ret_t = emit_call_or_builtin(s, offset, slen, hash, arg_count);
            if get_qword(s, 7) < 0 {
                return get_qword(s, 7);
            }
            if ret_t == TYPE_VOID {
                set_qword(s, 7, -45); # ERR_VOID_EXPR_USED
                return -45;
            }
            set_qword(s, 24, 0);
            set_qword(s, 25, 0);
            return ret_t;
        }

        if cur_tok_kind(s) == TOKEN_LBRACE {
            let s_id = struct_tbl_find(tbl, hash);
            if s_id >= 0 {
                set_qword(s, 24, 0);
                advance_token(s); # skip '{'
                let tot_bytes = struct_tbl_get_meta(tbl, s_id, 1);
                let alc_bytes = ((tot_bytes + 7) / 8) * 8;
                let cur_b = get_qword(s, 20);
                let s_slot = cur_b + alc_bytes;
                set_qword(s, 20, s_slot);

                let l_s = get_qword(s, 4);
                l_s = emit_zero_bytes(code_buf, l_s, s_slot, tot_bytes);
                set_qword(s, 4, l_s);

                while (cur_tok_kind(s) != TOKEN_RBRACE) & (cur_tok_kind(s) != TOKEN_EOF) {
                    let f_off_tok = cur_tok_offset(s);
                    let f_len_tok = cur_tok_len(s);
                    let f_h = hash_token(src, f_off_tok, f_len_tok);
                    expect(s, TOKEN_IDENT);
                    let f_i = struct_tbl_find_field(tbl, s_id, f_h);
                    if f_i < 0 {
                        set_qword(s, 7, -2);
                        return 0;
                    }
                    let f_t = struct_tbl_get_field_info(tbl, s_id, f_i, 1);
                    let f_disp = struct_tbl_get_field_info(tbl, s_id, f_i, 3);
                    let val_type = 0;
                    if cur_tok_kind(s) == TOKEN_COLON {
                        advance_token(s); # skip ':'
                        val_type = parse_expr(s);
                        if get_qword(s, 7) < 0 { return 0; }
                    } else {
                        let v_s = var_tbl_get(tbl, f_h, 1);
                        if v_s == 0 {
                            set_qword(s, 7, -2);
                            return 0;
                        }
                        let v_slot_idx = (v_s / 8) % 128;
                        let fn_idx = get_qword(s, 16);
                        let cur_cnt = get_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + v_slot_idx);
                        if cur_cnt < 250 {
                            set_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + v_slot_idx, cur_cnt + 1);
                        }
                        let r_cnt = get_qword(tbl, 10380);
                        if r_cnt < 10 {
                            set_qword(tbl, 10381 + r_cnt, v_slot_idx);
                            set_qword(tbl, 10380, r_cnt + 1);
                        }
                        val_type = var_tbl_get(tbl, f_h, 2);
                        l_s = get_qword(s, 4);
                        let did_load = 0;
                        if get_qword(s, 22) == 1 {
                            if get_qword(tbl, 110000 + (v_slot_idx * 2)) == 1 {
                                let cval = get_qword(tbl, 110000 + (v_slot_idx * 2) + 1);
                                l_s = emit_mov_imm64(code_buf, l_s, 0, cval);
                                did_load = 1;
                            }
                        }
                        if did_load == 0 {
                            l_s = emit_load_slot_typed(code_buf, l_s, v_s, val_type);
                        }
                        set_qword(s, 4, l_s);
                    }
                    if type_is_compatible(f_t, val_type) == 0 {
                        set_qword(s, 7, -40);
                        return 0;
                    }
                    l_s = get_qword(s, 4);
                    let f_slot = s_slot - f_disp;
                    if f_t >= TYPE_STRUCT {
                        let f_sz = struct_tbl_get_field_info(tbl, s_id, f_i, 4);
                        l_s = emit_copy_bytes(code_buf, l_s, f_slot, f_sz);
                    } else {
                        l_s = emit_store_slot_typed(code_buf, l_s, f_slot, f_t);
                    }
                    set_qword(s, 4, l_s);
                    if cur_tok_kind(s) == TOKEN_COMMA {
                        advance_token(s);
                    }
                }
                expect(s, TOKEN_RBRACE);
                l_s = get_qword(s, 4);
                l_s = emit_lea_slot(code_buf, l_s, s_slot);
                set_qword(s, 4, l_s);
                set_qword(s, 14, s_id);
                set_qword(s, 15, PROV_STACK_LOCAL);
                return TYPE_STRUCT + s_id;
            }
        }

        # Variable or Constant
        let slot = var_tbl_get(tbl, hash, 1);
        if slot > 0 {
            let slot_idx = (slot / 8) % 128;
            let fn_idx = get_qword(s, 16);
            let cur_cnt = get_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + slot_idx);
            if cur_cnt < 250 {
                set_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + slot_idx, cur_cnt + 1);
            }
            let r_cnt = get_qword(tbl, 10380);
            if r_cnt < 10 {
                set_qword(tbl, 10381 + r_cnt, slot_idx);
                set_qword(tbl, 10380, r_cnt + 1);
            }
            let var_t = var_tbl_get(tbl, hash, 2);
            if var_t == TYPE_ARRAY {
                set_qword(s, 24, 0);
                let p_prov = var_tbl_get(tbl, hash, 4);
                if p_prov == PROV_STACK_LOCAL {
                    l = emit_lea_slot(code_buf, l, slot);
                } else {
                    l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
                }
                set_qword(s, 4, l);
                set_qword(s, 14, var_tbl_get(tbl, hash, 3));
                set_qword(s, 15, p_prov);
                set_qword(s, 19, var_tbl_get(tbl, hash, 5));
                return TYPE_ARRAY;
            }
            if var_t >= TYPE_STRUCT {
                set_qword(s, 24, 0);
                let p_prov = var_tbl_get(tbl, hash, 4);
                if p_prov == PROV_STACK_LOCAL {
                    l = emit_lea_slot(code_buf, l, slot);
                } else {
                    l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
                }
                set_qword(s, 4, l);
                set_qword(s, 14, var_t - TYPE_STRUCT);
                set_qword(s, 15, p_prov);
                return var_t;
            }
            if get_qword(s, 22) == 1 {
                let slot_idx = (slot / 8) % 128;
                if get_qword(tbl, 110000 + (slot_idx * 2)) == 1 {
                    let cval = get_qword(tbl, 110000 + (slot_idx * 2) + 1);
                    l = emit_mov_imm64(code_buf, l, 0, cval);
                    set_qword(s, 4, l);
                    set_qword(s, 24, 1);
                    set_qword(s, 25, cval);
                    set_qword(s, 14, TYPE_NONE);
                    set_qword(s, 15, PROV_UNKNOWN);
                    return var_t;
                }
            }
            set_qword(s, 24, 0);
            l = emit_load_slot_typed(code_buf, l, slot, var_t);
            set_qword(s, 4, l);
            if var_t == TYPE_PTR {
                set_qword(s, 14, var_tbl_get(tbl, hash, 3));
                set_qword(s, 15, var_tbl_get(tbl, hash, 4));
            } else {
                if var_t == TYPE_STR {
                    set_qword(s, 14, TYPE_U8);
                    set_qword(s, 15, var_tbl_get(tbl, hash, 4));
                } else {
                    if var_t == TYPE_TUPLE {
                        arr_len = var_tbl_get(tbl, hash, 5);
                        if arr_len == 0 { arr_len = 2; }
                        if arr_len < 0 {
                            arr_len = 0 - arr_len;
                            if arr_len <= 2 {
                                l = get_qword(s, 4);
                                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 80); l = emit_byte(code_buf, l, 8);
                                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 0);
                                set_qword(s, 4, l);
                            }
                        } else {
                            if arr_len >= 3 {
                                l = get_qword(s, 4);
                                l = emit_lea_slot(code_buf, l, slot);
                                set_qword(s, 4, l);
                            }
                        }
                        set_qword(s, 14, var_tbl_get(tbl, hash, 3));
                        set_qword(s, 18, var_tbl_get(tbl, hash, 4));
                        set_qword(s, 19, arr_len);
                        set_qword(s, 15, PROV_UNKNOWN);
                    } else {
                        set_qword(s, 14, TYPE_NONE);
                        set_qword(s, 15, PROV_UNKNOWN);
                    }
                }
            }
            return var_t;
        }

        let cval = const_tbl_find(tbl, hash);
        if cval != -999999999 {
            l = emit_mov_imm64(code_buf, l, 0, cval);
            set_qword(s, 4, l);
            set_qword(s, 14, TYPE_NONE);
            set_qword(s, 15, PROV_UNKNOWN);
            set_qword(s, 24, 1);
            set_qword(s, 25, cval);
            return TYPE_I64;
        }

        # First-Class Function Pointer Reference
        let fn_idx = func_tbl_find_index(tbl, hash);
        if fn_idx >= 0 {
            l = get_qword(s, 4);
            l = emit_byte(code_buf, l, 72);
            l = emit_byte(code_buf, l, 141);
            l = emit_byte(code_buf, l, 5);
            let patch_pos = l;
            l = emit_disp32(code_buf, l, 0);
            patch_tbl_add(tbl, patch_pos, hash);
            set_qword(s, 4, l);
            set_qword(s, 14, TYPE_NONE);
            set_qword(s, 15, PROV_UNKNOWN);
            set_qword(s, 24, 0);
            set_qword(s, 27, 1); # side effect: prevent dead local elimination of function pointer
            return TYPE_PTR;
        }

        # Undefined identifier
        set_qword(s, 7, -2);
        set_qword(s, 10, offset);
        set_qword(s, 11, hash);
        return -1;
    }

    if k == TOKEN_KW_IF {
        advance_token(s); # skip 'if'
        let cond_t = parse_expr(s);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        if cond_t != TYPE_BOOL {
            if type_is_integer(cond_t) == 0 {
                set_qword(s, 7, -43);
                return -43;
            }
        }
        l = get_qword(s, 4);
        l = emit_cmp_rax_zero(code_buf, l);
        l = emit_je_rel32(code_buf, l, 0);
        let else_branch_patch = l - 4;
        set_qword(s, 4, l);

        expect(s, TOKEN_LBRACE);
        let then_t = parse_expr(s);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        expect(s, TOKEN_RBRACE);

        l = get_qword(s, 4);
        l = emit_jmp_rel32(code_buf, l, 0);
        let join_patch = l - 4;
        set_qword(s, 4, l);

        emit_backpatch32(code_buf, else_branch_patch, l);

        expect(s, TOKEN_KW_ELSE);
        let else_t = 0;
        if cur_tok_kind(s) == TOKEN_KW_IF {
            else_t = parse_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        } else {
            expect(s, TOKEN_LBRACE);
            else_t = parse_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            expect(s, TOKEN_RBRACE);
        }

        let res_t = resolve_binary_op_type(then_t, else_t);
        if res_t == TYPE_INT_LIT { res_t = TYPE_I64; }
        if res_t == TYPE_NONE {
            if type_is_compatible(then_t, else_t) == 1 { res_t = then_t; }
            else {
                if type_is_compatible(else_t, then_t) == 1 { res_t = else_t; }
                else {
                    set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                    return -40;
                }
            }
        }

        l = get_qword(s, 4);
        emit_backpatch32(code_buf, join_patch, l);
        set_qword(s, 4, l);
        set_qword(s, 24, 0);
        return res_t;
    }

    if k == TOKEN_KW_MATCH {
        advance_token(s); # skip 'match'
        let target_t = parse_expr(s);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }

        cur_bytes = get_qword(s, 20);
        let alc_sz = 8;
        if (target_t == TYPE_OPTION) | (target_t == TYPE_RESULT) {
            alc_sz = 16;
        }
        let target_slot = cur_bytes + alc_sz;
        set_qword(s, 20, target_slot);
        let target_h = 999970000 + target_slot;
        var_tbl_add(tbl, target_h, target_slot, target_t, TYPE_NONE, PROV_STACK_LOCAL, 0);

        l = get_qword(s, 4);
        l = emit_store_slot_typed(code_buf, l, target_slot, target_t);
        set_qword(s, 4, l);

        expect(s, TOKEN_LBRACE);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }

        let m_depth = get_qword(s, 29);
        set_qword(s, 29, m_depth + 1);
        set_qword(s, 250 + m_depth, 0);

        let res_t = TYPE_NONE;

        while (cur_tok_kind(s) != TOKEN_RBRACE) & (is_block_end(s) == 0) {
            let is_wildcard = 0;
            let skip_patch1 = 0;
            let skip_patch2 = 0;
            let has_nested = 0;
            let nested_val = 0;
            let nested_bind_hash = 0;
            let nested_bind_slot = 0;
            let leaf_bind_slot = 0;

            if cur_tok_kind(s) == TOKEN_UNDERSCORE {
                advance_token(s);
                is_wildcard = 1;
            } else {
                let is_neg1 = 0;
                if cur_tok_kind(s) == TOKEN_MINUS {
                    advance_token(s);
                    is_neg1 = 1;
                }
                let val1 = 0;
                if (cur_tok_kind(s) == TOKEN_INT_LIT) | (cur_tok_kind(s) == TOKEN_CHAR_LIT) {
                    val1 = cur_tok_val(s);
                    if is_neg1 == 1 { val1 = 0 - val1; }
                    advance_token(s);
                } else {
                    if cur_tok_kind(s) == TOKEN_IDENT {
                        let c_off = cur_tok_offset(s);
                        let c_len = cur_tok_len(s);
                        let c_h = hash_token(src, c_off, c_len);
                        advance_token(s);
                        let val1_found = 0;

                        if (target_t == TYPE_OPTION) | (target_t == TYPE_RESULT) {
                            if c_h == 6384548249 { # Some
                                val1 = 1;
                                val1_found = 1;
                                if cur_tok_kind(s) == TOKEN_LPAREN {
                                    parse_arm_payload(s, src, tbl, target_slot, s + 1024);
                                    has_nested = get_qword(s + 1024, 0);
                                    nested_val = get_qword(s + 1024, 1);
                                    nested_bind_hash = get_qword(s + 1024, 2);
                                    nested_bind_slot = get_qword(s + 1024, 3);
                                    leaf_bind_slot = get_qword(s + 1024, 4);
                                }
                            } else {
                            if c_h == 6384368597 { # None
                                val1 = 0;
                                val1_found = 1;
                            } else {
                            if c_h == 5862623 { # Ok
                                val1 = 1;
                                val1_found = 1;
                                if cur_tok_kind(s) == TOKEN_LPAREN {
                                    parse_arm_payload(s, src, tbl, target_slot, s + 1024);
                                    has_nested = get_qword(s + 1024, 0);
                                    nested_val = get_qword(s + 1024, 1);
                                    nested_bind_hash = get_qword(s + 1024, 2);
                                    nested_bind_slot = get_qword(s + 1024, 3);
                                    leaf_bind_slot = get_qword(s + 1024, 4);
                                }
                            } else {
                            if c_h == 193456014 { # Err
                                val1 = 0;
                                val1_found = 1;
                                if cur_tok_kind(s) == TOKEN_LPAREN {
                                    parse_arm_payload(s, src, tbl, target_slot, s + 1024);
                                    has_nested = get_qword(s + 1024, 0);
                                    nested_val = get_qword(s + 1024, 1);
                                    nested_bind_hash = get_qword(s + 1024, 2);
                                    nested_bind_slot = get_qword(s + 1024, 3);
                                    leaf_bind_slot = get_qword(s + 1024, 4);
                                }
                            }}}}
                        }

                        if (val1_found == 0) & (cur_tok_kind(s) == TOKEN_DOT) {
                            if (c_h == 6952617947198) | (c_h == 6952722285284) { # Option. or Result.
                                advance_token(s); # skip '.'
                                let v_off = cur_tok_offset(s);
                                let v_len = cur_tok_len(s);
                                let v_h = hash_token(src, v_off, v_len);
                                advance_token(s);
                                if (v_h == 6384548249) | (v_h == 5862623) { # Some or Ok
                                    val1 = 1;
                                    val1_found = 1;
                                    if cur_tok_kind(s) == TOKEN_LPAREN {
                                        parse_arm_payload(s, src, tbl, target_slot, s + 1024);
                                        has_nested = get_qword(s + 1024, 0);
                                        nested_val = get_qword(s + 1024, 1);
                                        nested_bind_hash = get_qword(s + 1024, 2);
                                        nested_bind_slot = get_qword(s + 1024, 3);
                                    }
                                }
                                if (v_h == 6384368597) | (v_h == 193456014) { # None or Err
                                    val1 = 0;
                                    val1_found = 1;
                                    if cur_tok_kind(s) == TOKEN_LPAREN {
                                        parse_arm_payload(s, src, tbl, target_slot, s + 1024);
                                        has_nested = get_qword(s + 1024, 0);
                                        nested_val = get_qword(s + 1024, 1);
                                        nested_bind_hash = get_qword(s + 1024, 2);
                                        nested_bind_slot = get_qword(s + 1024, 3);
                                    }
                                }
                            } else {
                                let enum_id = enum_tbl_find(tbl, c_h);
                                if enum_id >= 0 {
                                    advance_token(s); # skip '.'
                                    if cur_tok_kind(s) == TOKEN_IDENT {
                                        let v_off = cur_tok_offset(s);
                                        let v_len = cur_tok_len(s);
                                        let v_h = hash_token(src, v_off, v_len);
                                        let v_idx = enum_tbl_find_variant(tbl, enum_id, v_h);
                                        if v_idx >= 0 {
                                            val1 = enum_tbl_get_variant_val(tbl, enum_id, v_idx);
                                            val1_found = 1;
                                            advance_token(s);
                                        }
                                    }
                                }
                            }
                        }
                        if val1_found == 0 {
                            let cval = const_tbl_find(tbl, c_h);
                            if cval != -999999999 {
                                val1 = cval;
                                val1_found = 1;
                            }
                        }
                        if val1_found == 1 {
                            if is_neg1 == 1 { val1 = 0 - val1; }
                        } else {
                            set_qword(s, 7, -2);
                            set_qword(s, 29, m_depth);
                            return -2;
                        }
                    } else {
                        set_qword(s, 7, -1);
                        set_qword(s, 29, m_depth);
                        return -1;
                    }
                }

                if cur_tok_kind(s) == TOKEN_DOT_DOT {
                    advance_token(s); # skip '..'
                    let is_neg2 = 0;
                    if cur_tok_kind(s) == TOKEN_MINUS {
                        advance_token(s);
                        is_neg2 = 1;
                    }
                    let val2 = 0;
                    if (cur_tok_kind(s) == TOKEN_INT_LIT) | (cur_tok_kind(s) == TOKEN_CHAR_LIT) {
                        val2 = cur_tok_val(s);
                        if is_neg2 == 1 { val2 = 0 - val2; }
                        advance_token(s);
                    } else {
                        if cur_tok_kind(s) == TOKEN_IDENT {
                            let offset = cur_tok_offset(s);
                            let slen = cur_tok_len(s);
                            let hash = hash_token(src, offset, slen);
                            advance_token(s);
                            let val2_found = 0;
                            if cur_tok_kind(s) == TOKEN_DOT {
                                let enum_id = enum_tbl_find(tbl, hash);
                                if enum_id >= 0 {
                                    advance_token(s); # skip '.'
                                    if cur_tok_kind(s) == TOKEN_IDENT {
                                        offset = cur_tok_offset(s);
                                        slen = cur_tok_len(s);
                                        hash = hash_token(src, offset, slen);
                                        let v_idx = enum_tbl_find_variant(tbl, enum_id, hash);
                                        if v_idx >= 0 {
                                            val2 = enum_tbl_get_variant_val(tbl, enum_id, v_idx);
                                            val2_found = 1;
                                            advance_token(s);
                                        }
                                    }
                                }
                            }
                            if val2_found == 0 {
                                let cval = const_tbl_find(tbl, hash);
                                if cval != -999999999 {
                                    val2 = cval;
                                    val2_found = 1;
                                }
                            }
                            if val2_found == 1 {
                                if is_neg2 == 1 { val2 = 0 - val2; }
                            } else {
                                set_qword(s, 7, -2);
                                set_qword(s, 29, m_depth);
                                return -2;
                            }
                        } else {
                            set_qword(s, 7, -1);
                            set_qword(s, 29, m_depth);
                            return -1;
                        }
                    }

                    # Range check: target in val1..val2
                    l = get_qword(s, 4);
                    l = emit_load_slot_typed(code_buf, l, target_slot, target_t);
                    l = emit_mov_imm64(code_buf, l, 1, val1);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 57); l = emit_byte(code_buf, l, 200);
                    # jl skip1 (0F 8C disp32)
                    l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 140);
                    l = emit_disp32(code_buf, l, 0);
                    skip_patch1 = l - 4;

                    l = emit_load_slot_typed(code_buf, l, target_slot, target_t);
                    l = emit_mov_imm64(code_buf, l, 1, val2);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 57); l = emit_byte(code_buf, l, 200);
                    # jg skip2 (0F 8F disp32)
                    l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 143);
                    l = emit_disp32(code_buf, l, 0);
                    skip_patch2 = l - 4;
                    set_qword(s, 4, l);
                } else {
                    # Exact comparison: target == val1
                    l = get_qword(s, 4);
                    l = emit_load_slot_typed(code_buf, l, target_slot, target_t);
                    l = emit_mov_imm64(code_buf, l, 1, val1);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 57); l = emit_byte(code_buf, l, 200);
                    # jne skip1 (0F 85 disp32)
                    l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 133);
                    l = emit_disp32(code_buf, l, 0);
                    skip_patch1 = l - 4;

                    if has_nested == 1 {
                        # Load payload pointer from target_slot - 8 into rsi
                        l = emit_load_slot_typed(code_buf, l, target_slot - 8, TYPE_I64);
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
                        # Load inner tag: mov rax, [rsi] (48 8B 06)
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 6);
                        # Compare inner tag with nested_val: cmp rax, nested_val
                        l = emit_mov_imm64(code_buf, l, 1, nested_val);
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 57); l = emit_byte(code_buf, l, 200);
                        # jne skip2 (0F 85 disp32)
                        l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 133);
                        l = emit_disp32(code_buf, l, 0);
                        skip_patch2 = l - 4;
                        if nested_bind_hash != 0 {
                            # Load inner payload: mov rax, [rsi + 8] (48 8B 46 08)
                            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 70); l = emit_byte(code_buf, l, 8);
                            # Store to nested_bind_slot
                            l = emit_store_slot_typed(code_buf, l, nested_bind_slot, TYPE_I64);
                        }
                    } else {
                        if leaf_bind_slot > 0 {
                            if leaf_bind_slot != (target_slot - 8) {
                                l = emit_load_slot_typed(code_buf, l, target_slot - 8, TYPE_I64);
                                l = emit_store_slot_typed(code_buf, l, leaf_bind_slot, TYPE_I64);
                            }
                        }
                    }
                    set_qword(s, 4, l);
                }
            }

            expect(s, TOKEN_FAT_ARROW);
            if get_qword(s, 7) < 0 { set_qword(s, 29, m_depth); return get_qword(s, 7); }

            let arm_t = parse_expr(s);
            if get_qword(s, 7) < 0 { set_qword(s, 29, m_depth); return get_qword(s, 7); }

            if res_t == TYPE_NONE {
                res_t = arm_t;
            } else {
                res_t = resolve_binary_op_type(res_t, arm_t);
                if res_t == TYPE_INT_LIT { res_t = TYPE_I64; }
            }

            l = get_qword(s, 4);
            l = emit_jmp_rel32(code_buf, l, 0);
            let exit_p = l - 4;
            set_qword(s, 4, l);

            let p_cnt = get_qword(s, 250 + m_depth);
            set_qword(s, 300 + (m_depth * 32) + p_cnt, exit_p);
            set_qword(s, 250 + m_depth, p_cnt + 1);

            l = get_qword(s, 4);
            if skip_patch1 > 0 {
                emit_backpatch32(code_buf, skip_patch1, l);
            }
            if skip_patch2 > 0 {
                emit_backpatch32(code_buf, skip_patch2, l);
            }
            set_qword(s, 4, l);

            if cur_tok_kind(s) == TOKEN_COMMA {
                advance_token(s);
            }
        }

        expect(s, TOKEN_RBRACE);
        set_qword(s, 29, m_depth);

        l = get_qword(s, 4);
        let total_exits = get_qword(s, 250 + m_depth);
        let i = 0;
        while i < total_exits {
            let ep = get_qword(s, 300 + (m_depth * 32) + i);
            emit_backpatch32(code_buf, ep, l);
            i = i + 1;
        }
        set_qword(s, 4, l);
        set_qword(s, 24, 0);
        return res_t;
    }

    set_qword(s, 7, -3); # ERR_INVALID_TOKEN
    set_qword(s, 10, cur_tok_offset(s));
    set_qword(s, 9, k);
    return -1;
}

fn parse_postfix(s: i64): i64 {
    let t = parse_primary(s);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
    let code_buf = get_qword(s, 3);
    let src = get_qword(s, 0);
    let tbl = get_qword(s, 5);

    let postfix_loop = 1;
    let did_postfix = 0;
    while postfix_loop == 1 {
        let is_bracket = 0;
        if cur_tok_kind(s) == TOKEN_LBRACKET { is_bracket = 1; }
        let is_dot = 0;
        if cur_tok_kind(s) == TOKEN_DOT { is_dot = 1; }
        let is_quest = 0;
        if cur_tok_kind(s) == TOKEN_QUESTION { is_quest = 1; }
        let is_qdot = 0;
        if cur_tok_kind(s) == TOKEN_QUESTION_DOT { is_qdot = 1; }
        if is_bracket == 0 {
            if is_dot == 0 {
                if is_quest == 0 {
                    if is_qdot == 0 {
                        postfix_loop = 0;
                    }
                }
            }
        }
        if postfix_loop == 1 {
            did_postfix = 1;
            set_qword(s, 24, 0);
            if cur_tok_kind(s) == TOKEN_QUESTION {
                advance_token(s); # skip '?'
                let cur_fn_ret_t = get_qword(s, 13);
                if (t == TYPE_OPTION) | (t == TYPE_RESULT) {
                    let l = get_qword(s, 4);
                    # test rax, rax (is tag 0?)
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192);
                    # jz rel32 (0F 84) to epilogue
                    l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 132);
                    l = emit_disp32(code_buf, l, 0);
                    epilogue_patches_add(tbl, l - 4);
                    # unwrap payload: mov rax, rdx
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 208);
                    set_qword(s, 4, l);
                    let inner_t = get_qword(s, 14);
                    if inner_t == TYPE_NONE { inner_t = TYPE_I64; }
                    t = inner_t;
                    set_qword(s, 14, TYPE_NONE);
                } else {
                    if cur_fn_ret_t != TYPE_I64 {
                        if cur_fn_ret_t != TYPE_I32 {
                            set_qword(s, 7, -41); # ERR_TYPE_MISMATCH_RETURN
                            return -41;
                        }
                    }
                    let l = get_qword(s, 4);
                    l = emit_byte(code_buf, l, 72);
                    l = emit_byte(code_buf, l, 133);
                    l = emit_byte(code_buf, l, 192); # test rax, rax (48 85 C0)
                    l = emit_byte(code_buf, l, 15);
                    l = emit_byte(code_buf, l, 136); # js rel32 (0F 88)
                    l = emit_disp32(code_buf, l, 0);
                    epilogue_patches_add(tbl, l - 4);
                    set_qword(s, 4, l);
                }
            } else {
            if cur_tok_kind(s) == TOKEN_QUESTION_DOT {
                advance_token(s); # skip '?.'
                if cur_tok_kind(s) != TOKEN_IDENT {
                    set_qword(s, 7, -51);
                    return -51;
                }
                let f_off = cur_tok_offset(s);
                let f_len = cur_tok_len(s);
                let f_hash = hash_token(src, f_off, f_len);
                advance_token(s); # skip field name

                let inner_t = get_qword(s, 14);
                let struct_id = -1;
                if inner_t >= TYPE_STRUCT {
                    struct_id = inner_t - TYPE_STRUCT;
                }
                let f_idx = -1;
                if struct_id >= 0 {
                    f_idx = struct_tbl_find_field(tbl, struct_id, f_hash);
                }
                if f_idx >= 0 {
                    let f_type = struct_tbl_get_field_info(tbl, struct_id, f_idx, 1);
                    let f_off_val = struct_tbl_get_field_info(tbl, struct_id, f_idx, 3);
                    let l = get_qword(s, 4);
                    # test rax, rax
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192);
                    # jz null_path (0F 84)
                    l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 132);
                    l = emit_disp32(code_buf, l, 0);
                    let null_patch = l - 4;
                    # Some: mov rdx, [rdx + f_off_val]
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 82); l = emit_byte(code_buf, l, f_off_val);
                    l = emit_jmp_rel32(code_buf, l, 0);
                    let done_patch = l - 4;
                    # null_path:
                    emit_backpatch32(code_buf, null_patch, l);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 192);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 210);
                    emit_backpatch32(code_buf, done_patch, l);
                    set_qword(s, 4, l);
                    t = TYPE_OPTION;
                    set_qword(s, 14, f_type);
                } else {
                    set_qword(s, 7, -51);
                    return -51;
                }
            } else {
            if cur_tok_kind(s) == TOKEN_DOT {
                advance_token(s); # skip '.'
                if (t == TYPE_TUPLE) & (cur_tok_kind(s) == TOKEN_INT_LIT) {
                    let f_off_val = cur_tok_val(s);
                    advance_token(s); # skip INT_LIT
                    let f_arr_len = get_qword(s, 19);
                    if f_arr_len == 0 { f_arr_len = 2; }
                    if f_off_val >= f_arr_len {
                        set_qword(s, 7, -51);
                        return -51;
                    }
                    let l = get_qword(s, 4);
                    if f_arr_len <= 2 {
                        if f_off_val == 0 {
                            t = get_qword(s, 14);
                            if t == TYPE_NONE { t = TYPE_I64; }
                        } else {
                            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 208); # mov rax, rdx
                            t = get_qword(s, 18);
                            if t == TYPE_NONE { t = TYPE_I64; }
                        }
                    } else {
                        f_off_val = f_off_val * 8;
                        if f_off_val <= 127 {
                            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 64);
                            l = emit_byte(code_buf, l, f_off_val);
                        } else {
                            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 128);
                            l = emit_disp32(code_buf, l, f_off_val);
                        }
                        t = TYPE_I64;
                    }
                    set_qword(s, 4, l);
                    set_qword(s, 14, TYPE_NONE);
                    set_qword(s, 15, PROV_UNKNOWN);
                } else {
                if cur_tok_kind(s) != TOKEN_IDENT {
                    set_qword(s, 7, -51);
                    return -51;
                }
                let f_off = cur_tok_offset(s);
                let f_len = cur_tok_len(s);
                let f_hash = hash_token(src, f_off, f_len);
                advance_token(s); # skip field/method name

                if (t == TYPE_OPTION) | (t == TYPE_RESULT) {
                    if cur_tok_kind(s) == TOKEN_LPAREN {
                        advance_token(s);
                        expect(s, TOKEN_RPAREN);
                        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                    }
                    if f_hash == 229470063286004 { # is_some
                        let l = get_qword(s, 4);
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192);
                        l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 149); l = emit_byte(code_buf, l, 192);
                        l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 182); l = emit_byte(code_buf, l, 192);
                        set_qword(s, 4, l);
                        t = TYPE_BOOL;
                    } else {
                    if f_hash == 229470063106352 { # is_none
                        let l = get_qword(s, 4);
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192);
                        l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 148); l = emit_byte(code_buf, l, 192);
                        l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 182); l = emit_byte(code_buf, l, 192);
                        set_qword(s, 4, l);
                        t = TYPE_BOOL;
                    } else {
                    if f_hash == 210716311418 { # is_ok
                        let l = get_qword(s, 4);
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192);
                        l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 149); l = emit_byte(code_buf, l, 192);
                        l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 182); l = emit_byte(code_buf, l, 192);
                        set_qword(s, 4, l);
                        t = TYPE_BOOL;
                    } else {
                    if f_hash == 6953638266249 { # is_err
                        let l = get_qword(s, 4);
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192);
                        l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 148); l = emit_byte(code_buf, l, 192);
                        l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 182); l = emit_byte(code_buf, l, 192);
                        set_qword(s, 4, l);
                        t = TYPE_BOOL;
                    } else {
                    if f_hash == 6954102837442 { # unwrap
                        let l = get_qword(s, 4);
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192);
                        l = emit_byte(code_buf, l, 117); l = emit_byte(code_buf, l, 2);
                        l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 11);
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 208);
                        set_qword(s, 4, l);
                        let inner_t = get_qword(s, 14);
                        if inner_t == TYPE_NONE { inner_t = TYPE_I64; }
                        t = inner_t;
                    } else {
                        set_qword(s, 7, -51);
                        return -51;
                    }}}}}
                } else {
                let is_len = 0;
                if f_len == 3 {
                    if (get_byte(src, f_off) == 108) & (get_byte(src, f_off + 1) == 101) & (get_byte(src, f_off + 2) == 110) {
                        is_len = 1;
                    }
                }
                if f_len == 6 {
                    if (get_byte(src, f_off) == 108) & (get_byte(src, f_off + 1) == 101) & (get_byte(src, f_off + 2) == 110) & (get_byte(src, f_off + 3) == 103) & (get_byte(src, f_off + 4) == 116) & (get_byte(src, f_off + 5) == 104) {
                        is_len = 1;
                    }
                }

                if (t == TYPE_STR) & (is_len == 1) {
                    if cur_tok_kind(s) == TOKEN_LPAREN {
                        advance_token(s);
                        expect(s, TOKEN_RPAREN);
                        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                    }
                    let l = get_qword(s, 4);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 199); # mov rdi, rax
                    l = isel_emit_builtin_string(code_buf, l, 4604361535797710365);
                    set_qword(s, 4, l);
                    t = TYPE_I64;
                    set_qword(s, 14, TYPE_NONE);
                    set_qword(s, 15, PROV_UNKNOWN);
                    set_qword(s, 24, 0);
                } else {
                    if (t == TYPE_ARRAY) & (is_len == 1) {
                        if cur_tok_kind(s) == TOKEN_LPAREN {
                            advance_token(s);
                            expect(s, TOKEN_RPAREN);
                            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                        }
                        let arr_len = get_qword(s, 19);
                        let l = get_qword(s, 4);
                        l = emit_mov_imm64(code_buf, l, 0, arr_len);
                        set_qword(s, 4, l);
                        t = TYPE_I64;
                        set_qword(s, 14, TYPE_NONE);
                        set_qword(s, 15, PROV_UNKNOWN);
                        set_qword(s, 24, 1);
                        set_qword(s, 25, arr_len);
                    } else {
                        let struct_id = -1;
                        if t >= TYPE_STRUCT {
                            struct_id = t - TYPE_STRUCT;
                        } else {
                            if t == TYPE_PTR {
                                let p_ann = get_qword(s, 14);
                                if p_ann >= TYPE_STRUCT {
                                    struct_id = p_ann - TYPE_STRUCT;
                                }
                            }
                        }
                        let f_idx = -1;
                        if struct_id >= 0 {
                            f_idx = struct_tbl_find_field(tbl, struct_id, f_hash);
                        }

                        if f_idx >= 0 {
                            # Struct field access
                            let f_type = struct_tbl_get_field_info(tbl, struct_id, f_idx, 1);
                            let f_pointee = struct_tbl_get_field_info(tbl, struct_id, f_idx, 2);
                            let f_off = struct_tbl_get_field_info(tbl, struct_id, f_idx, 3);
                            let f_sz = struct_tbl_get_field_info(tbl, struct_id, f_idx, 4);
                            let f_arr_len = struct_tbl_get_field_info(tbl, struct_id, f_idx, 5);

                            let l = get_qword(s, 4);
                            if f_type >= TYPE_STRUCT {
                                l = emit_add_rax_imm32(code_buf, l, f_off);
                                set_qword(s, 4, l);
                                set_qword(s, 14, f_type - TYPE_STRUCT);
                                t = f_type;
                            } else {
                                if f_type == TYPE_ARRAY {
                                    l = emit_add_rax_imm32(code_buf, l, f_off);
                                    set_qword(s, 4, l);
                                    set_qword(s, 14, f_pointee);
                                    set_qword(s, 19, f_arr_len);
                                    t = TYPE_ARRAY;
                                } else {
                                    l = emit_field_load_typed(code_buf, l, f_off, f_type);
                                    set_qword(s, 4, l);
                                    set_qword(s, 14, f_pointee);
                                    set_qword(s, 15, PROV_UNKNOWN);
                                    t = f_type;
                                }
                            }
                        } else {
                            if cur_tok_kind(s) == TOKEN_LPAREN {
                                # Method call syntax / UFCS: x.func(...) -> func(x, ...)
                                advance_token(s); # skip '('
                                parser_push_rax(s);
                                let a0_t = t;
                                let a0_ann = get_qword(s, 14);
                                if t >= TYPE_STRUCT {
                                    a0_t = TYPE_PTR;
                                    a0_ann = t;
                                }
                                set_qword(tbl, 10240 + 0, a0_t);
                                set_qword(tbl, 10272 + 0, a0_ann);
                                set_qword(tbl, 10304 + 0, get_qword(s, 15));
                                set_qword(tbl, 10336 + 0, get_qword(s, 19));
                                let arg_count = 1;
                                if cur_tok_kind(s) != TOKEN_RPAREN {
                                    let a_t = parse_expr(s);
                                    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                                    set_qword(tbl, 10240 + arg_count, a_t);
                                    set_qword(tbl, 10272 + arg_count, get_qword(s, 14));
                                    set_qword(tbl, 10304 + arg_count, get_qword(s, 15));
                                    set_qword(tbl, 10336 + arg_count, get_qword(s, 19));
                                    parser_push_rax(s);
                                    arg_count = arg_count + 1;
                                    while cur_tok_kind(s) == TOKEN_COMMA {
                                        advance_token(s);
                                        let a_t2 = parse_expr(s);
                                        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                                        set_qword(tbl, 10240 + arg_count, a_t2);
                                        set_qword(tbl, 10272 + arg_count, get_qword(s, 14));
                                        set_qword(tbl, 10304 + arg_count, get_qword(s, 15));
                                        set_qword(tbl, 10336 + arg_count, get_qword(s, 19));
                                        parser_push_rax(s);
                                        arg_count = arg_count + 1;
                                    }
                                }
                                expect(s, TOKEN_RPAREN);
                                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                                emit_call_or_builtin(s, f_off, f_len, f_hash, arg_count);
                                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                                t = func_tbl_get(tbl, f_hash, 3);
                            } else {
                                set_qword(s, 7, -51); # ERR_INVALID_FIELD_ACCESS
                                return -51;
                            }
                        }
                    }
                }
                }
                }
            } else {
            if t == TYPE_ARRAY {
                let elem_type = get_qword(s, 14);
                let arr_len = get_qword(s, 19);
                parser_push_rax(s);
                advance_token(s); # skip '['
                let idx_t = parse_expr(s);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                if type_is_integer(idx_t) == 0 {
                    set_qword(s, 7, -43); # ERR_INVALID_BIN_OP_TYPE
                    return -43;
                }
                expect(s, TOKEN_RBRACKET);
                if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                let l = get_qword(s, 4);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
                l = emit_bounds_check(code_buf, l, arr_len);
                l = emit_byte(code_buf, l, 95); # pop rdi
                let cur_d = get_qword(s, 12);
                set_qword(s, 12, cur_d - 1);
                if elem_type >= TYPE_STRUCT {
                    let s_id = elem_type - TYPE_STRUCT;
                    let s_sz = struct_tbl_get_meta(tbl, s_id, 1);
                    l = emit_index_lea_sized(code_buf, l, s_sz);
                    set_qword(s, 4, l);
                    set_qword(s, 14, s_id);
                    set_qword(s, 15, PROV_STACK_LOCAL);
                    t = elem_type;
                } else {
                    l = emit_index_load_typed(code_buf, l, elem_type);
                    set_qword(s, 4, l);
                    if elem_type == TYPE_PTR {
                        set_qword(s, 14, get_qword(s, 18));
                        set_qword(s, 15, PROV_UNKNOWN);
                        t = TYPE_PTR;
                    } else {
                        set_qword(s, 14, TYPE_NONE);
                        set_qword(s, 15, PROV_UNKNOWN);
                        t = elem_type;
                    }
                }
            } else {
                if t == TYPE_STR {
                    parser_push_rax(s);
                    advance_token(s); # skip '['
                    let idx_t = parse_expr(s);
                    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                    if type_is_integer(idx_t) == 0 {
                        set_qword(s, 7, -43); # ERR_INVALID_BIN_OP_TYPE
                        return -43;
                    }
                    expect(s, TOKEN_RBRACKET);
                    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                    let l = get_qword(s, 4);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
                    l = emit_byte(code_buf, l, 95); # pop rdi
                    let cur_d = get_qword(s, 12);
                    set_qword(s, 12, cur_d - 1);
                    l = isel_emit_builtin_string(code_buf, l, 4369978079523077955);
                    set_qword(s, 4, l);
                    set_qword(s, 14, TYPE_NONE);
                    set_qword(s, 15, PROV_UNKNOWN);
                    t = TYPE_U8;
                } else {
                    if t != TYPE_PTR {
                        set_qword(s, 7, -47); # ERR_INVALID_PTR_DEREF
                        return -47;
                    }
                    let p_pointee = get_qword(s, 14);
                    let p_prov = get_qword(s, 15);
                    if p_pointee == TYPE_VOID {
                        set_qword(s, 7, -45); # ERR_VOID_EXPR_USED
                        return -45;
                    }
                    if p_pointee == TYPE_NONE {
                        if get_qword(s, 17) == 1 {
                            set_qword(s, 7, -47); # ERR_INVALID_PTR_DEREF
                            return -47;
                        }
                        p_pointee = TYPE_INT_LIT;
                    }
                    parser_push_rax(s);
                    advance_token(s); # skip '['
                    let idx_t = parse_expr(s);
                    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                    if type_is_integer(idx_t) == 0 {
                        set_qword(s, 7, -43); # ERR_INVALID_BIN_OP_TYPE
                        return -43;
                    }
                    expect(s, TOKEN_RBRACKET);
                    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                    let l = get_qword(s, 4);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
                    l = emit_byte(code_buf, l, 95); # pop rdi
                    let cur_d = get_qword(s, 12);
                    set_qword(s, 12, cur_d - 1);
                    if p_pointee >= TYPE_STRUCT {
                        let s_id = p_pointee - TYPE_STRUCT;
                        let s_sz = struct_tbl_get_meta(tbl, s_id, 1);
                        l = emit_index_lea_sized(code_buf, l, s_sz);
                        set_qword(s, 4, l);
                        set_qword(s, 14, s_id);
                        set_qword(s, 15, p_prov);
                        t = p_pointee;
                    } else {
                        l = emit_index_load_typed(code_buf, l, p_pointee);
                        set_qword(s, 4, l);
                        if p_pointee == TYPE_PTR {
                            set_qword(s, 14, TYPE_NONE);
                            set_qword(s, 15, p_prov);
                            t = TYPE_PTR;
                        } else {
                            set_qword(s, 14, TYPE_NONE);
                            set_qword(s, 15, PROV_UNKNOWN);
                            t = p_pointee;
                        }
                    }
                }
            }
        }
    }
    }
    }
    }
    if did_postfix == 1 {
        set_qword(s, 24, 0);
        set_qword(s, 25, 0);
        set_qword(s, 27, 1);
    }
    return t;
}

fn parse_cast(s: i64): i64 {
    let start_l = get_qword(s, 4);
    let start_d = get_qword(s, 12);
    let t = parse_postfix(s);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
    let code_buf = get_qword(s, 3);
    while cur_tok_kind(s) == TOKEN_KW_AS {
        let src_t = t;
        let is_c = get_qword(s, 24);
        let v = get_qword(s, 25);
        let src_pointee = get_qword(s, 14);
        let src_prov = get_qword(s, 15);
        advance_token(s); # skip 'as'
        let dst_t = parse_type(s);
        let dst_pointee = get_qword(s, 14);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }

        let valid = tir_validate_cast(src_t, dst_t, src_pointee, dst_pointee);
        if valid < 0 {
            set_qword(s, 7, valid);
            return valid;
        }

        let did_fold = 0;
        if get_qword(s, 22) == 1 {
            if is_c == 1 {
                if type_is_integer(src_t) == 1 {
                    if dst_t == TYPE_I64 { did_fold = 1; }
                    if dst_t == TYPE_I32 {
                        did_fold = 1;
                        let m = v % 4294967296;
                        if m >= 2147483648 { m = m - 4294967296; }
                        v = m;
                    }
                    if dst_t == TYPE_U8 {
                        did_fold = 1;
                        let m = v % 256;
                        if m < 0 { m = m + 256; }
                        v = m;
                    }
                    if dst_t == TYPE_BOOL {
                        did_fold = 1;
                        if v != 0 { v = 1; } else { v = 0; }
                    }
                } else {
                    if src_t == TYPE_BOOL {
                        if dst_t == TYPE_I64 { did_fold = 1; }
                        if dst_t == TYPE_I32 { did_fold = 1; }
                        if dst_t == TYPE_U8  { did_fold = 1; }
                        if dst_t == TYPE_BOOL { did_fold = 1; }
                    }
                }
            }
        }

        if did_fold == 1 {
            set_qword(s, 4, start_l);
            set_qword(s, 12, start_d);
            let l = emit_mov_imm64(code_buf, start_l, 0, v);
            set_qword(s, 4, l);
            set_qword(s, 24, 1);
            set_qword(s, 25, v);
            set_qword(s, 14, TYPE_NONE);
            set_qword(s, 15, PROV_UNKNOWN);
            let opt_ctx = get_qword(s, 23);
            if opt_ctx > 0 {
                let p2_ch = get_qword(opt_ctx + 96, 2);
                set_qword(opt_ctx + 96, 2, p2_ch + 1);
                let tot_ch = get_qword(opt_ctx, 2);
                set_qword(opt_ctx, 2, tot_ch + 1);
            }
            t = dst_t;
        } else {
            set_qword(s, 24, 0);
            let l = get_qword(s, 4);
            if src_t == TYPE_STR {
                if dst_t == TYPE_PTR {
                    # s as *u8 or s as ptr: rax = rax + 8 (skip 8-byte length header)
                    # add rax, 8 (48 83 C0 08)
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 192); l = emit_byte(code_buf, l, 8);
                    set_qword(s, 4, l);
                    set_qword(s, 14, dst_pointee);
                    set_qword(s, 15, src_prov);
                    t = dst_t;
                }
            } else {
                if dst_t == TYPE_STR {
                    if src_t == TYPE_PTR {
                        # p as str: call string_from_raw(p)
                        # mov rdi, rax (48 89 C7)
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 199);
                        l = isel_emit_builtin_string(code_buf, l, -3364675804167515880);
                        set_qword(s, 4, l);
                        set_qword(s, 14, TYPE_U8);
                        set_qword(s, 15, src_prov);
                        t = dst_t;
                    }
                } else {
                    l = emit_cast(code_buf, l, src_t, dst_t);
                    set_qword(s, 4, l);
                    if dst_t == TYPE_PTR {
                        set_qword(s, 14, dst_pointee);
                        set_qword(s, 15, src_prov); # Pointer provenance is strictly preserved
                    } else {
                        set_qword(s, 14, TYPE_NONE);
                        set_qword(s, 15, PROV_UNKNOWN);
                    }
                    t = dst_t;
                }
            }
        }
    }
    return t;
}

fn parse_term(s: i64): i64 {
    let start_l = get_qword(s, 4);
    let start_d = get_qword(s, 12);
    let t1 = parse_cast(s);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
    let is_c1 = get_qword(s, 24);
    let v1 = get_qword(s, 25);
    let code_buf = get_qword(s, 3);
    let running = 1;
    while running == 1 {
        let k = cur_tok_kind(s);
        let is_op = 0;
        if k == TOKEN_STAR { is_op = 1; }
        if k == TOKEN_STAR_TRAP { is_op = 1; }
        if k == TOKEN_STAR_SAT { is_op = 1; }
        if k == TOKEN_SLASH { is_op = 1; }
        if k == TOKEN_PERCENT { is_op = 1; }

        if is_op == 1 {
            let op = k;
            advance_token(s);
            # Save code position before emitting push (for retroactive optimization)
            let pre_push_l = get_qword(s, 4);
            let pre_push_d = get_qword(s, 12);
            parser_push_rax(s);
            let t2 = parse_cast(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            if t1 == TYPE_PTR { set_qword(s, 7, -44); return -44; }
            if t2 == TYPE_PTR { set_qword(s, 7, -44); return -44; }
            let common_t = resolve_binary_op_type(t1, t2);
            if common_t == TYPE_NONE { set_qword(s, 7, -43); return -43; }
            if (type_is_integer(common_t) == 0) & (type_is_float(common_t) == 0) { set_qword(s, 7, -43); return -43; }
            if (op == TOKEN_PERCENT) & (type_is_float(common_t) == 1) { set_qword(s, 7, -43); return -43; }
            if (op == TOKEN_STAR_TRAP) & (type_is_float(common_t) == 1) { set_qword(s, 7, -43); return -43; }
            if (op == TOKEN_STAR_SAT) & (type_is_float(common_t) == 1) { set_qword(s, 7, -43); return -43; }
            if common_t == TYPE_INT_LIT { common_t = TYPE_I64; }
            if common_t == TYPE_FLOAT_LIT { common_t = TYPE_F64; }

            let is_c2 = get_qword(s, 24);
            let v2 = get_qword(s, 25);
            let did_fold = 0;
            if (get_qword(s, 22) == 1) & (type_is_integer(common_t) == 1) {
                if is_c1 == 1 {
                    if is_c2 == 1 {
                        let can_fold = 1;
                        if op == TOKEN_STAR_TRAP { can_fold = 0; }
                        if op == TOKEN_STAR_SAT { can_fold = 0; }
                        if op == TOKEN_SLASH {
                            if v2 == 0 { can_fold = 0; }
                            if v1 == -9223372036854775808 { if v2 == -1 { can_fold = 0; } }
                        }
                        if op == TOKEN_PERCENT {
                            if v2 == 0 { can_fold = 0; }
                            if v1 == -9223372036854775808 { if v2 == -1 { can_fold = 0; } }
                        }
                        if can_fold == 1 {
                            let folded = 0;
                            if op == TOKEN_STAR { folded = v1 * v2; }
                            if op == TOKEN_SLASH { folded = v1 / v2; }
                            if op == TOKEN_PERCENT { folded = v1 % v2; }
                            if common_t == TYPE_I32 {
                                let m = folded % 4294967296;
                                if m >= 2147483648 { m = m - 4294967296; }
                                folded = m;
                            }
                            if common_t == TYPE_U8 {
                                let m = folded % 256;
                                if m < 0 { m = m + 256; }
                                folded = m;
                            }
                            set_qword(s, 4, start_l);
                            set_qword(s, 12, start_d);
                            let l = emit_mov_imm64(code_buf, start_l, 0, folded);
                            set_qword(s, 4, l);
                            set_qword(s, 24, 1);
                            set_qword(s, 25, folded);
                            let opt_ctx = get_qword(s, 23);
                            if opt_ctx > 0 {
                                let p2_ch = get_qword(opt_ctx + 96, 2);
                                set_qword(opt_ctx + 96, 2, p2_ch + 1);
                                let tot_ch = get_qword(opt_ctx, 2);
                                set_qword(opt_ctx, 2, tot_ch + 1);
                            }
                            is_c1 = 1;
                            v1 = folded;
                            t1 = common_t;
                            did_fold = 1;
                        }
                    }
                }
            }

            if did_fold == 0 {
                # Peephole: if RHS is a constant, retroactively undo the push and use
                # register-immediate form. This eliminates: push rax / mov rcx,rax / pop rax.
                # At pre_push_l: LHS is in rax (just computed). We rewind past the push
                # and emit op_rax_imm directly — saving 4-9 bytes and 2 memory ops per iteration.
                let did_imm = 0;
                if (is_c2 == 1) & (type_is_integer(common_t) == 1) {
                    if (op != TOKEN_SLASH) & (op != TOKEN_PERCENT) & (op != TOKEN_STAR_TRAP) & (op != TOKEN_STAR_SAT) {
                        let imm_l = emit_bin_op_imm64(code_buf, pre_push_l, op, v2, common_t);
                        if imm_l >= 0 {
                            # SUCCESS: retroactively undo push + RHS load, use imm form
                            set_qword(s, 4, imm_l);
                            set_qword(s, 12, pre_push_d);
                            did_imm = 1;
                        }
                    }
                    # % and / by constant: retroactively undo push+RHS, restore LHS,
                    # then apply magic multiplier (no idiv). Saves 20-80 cycles per operation.
                    if did_imm == 0 {
                        if op == TOKEN_PERCENT {
                            if v2 > 0 {
                                let mod_l = emit_mod_by_const(code_buf, pre_push_l, v2);
                                if mod_l >= 0 {
                                    set_qword(s, 4, mod_l);
                                    set_qword(s, 12, pre_push_d);
                                    did_imm = 1;
                                }
                            }
                        }
                        if op == TOKEN_SLASH {
                            if v2 > 0 {
                                let div_l = emit_div_by_const(code_buf, pre_push_l, v2);
                                if div_l >= 0 {
                                    set_qword(s, 4, div_l);
                                    set_qword(s, 12, pre_push_d);
                                    did_imm = 1;
                                }
                            }
                        }
                    }
                }
                if did_imm == 0 {
                    let l = get_qword(s, 4);
                    if common_t == TYPE_F32 {
                        if t2 == TYPE_FLOAT_LIT {
                            l = emit_cast(code_buf, l, TYPE_FLOAT_LIT, TYPE_F32);
                        }
                    }
                    l = emit_mov_rcx_rax(code_buf, l);
                    set_qword(s, 4, l);
                    parser_pop_reg(s, 88);
                    l = get_qword(s, 4);
                    if common_t == TYPE_F32 {
                        if t1 == TYPE_FLOAT_LIT {
                            l = emit_cast(code_buf, l, TYPE_FLOAT_LIT, TYPE_F32);
                        }
                    }
                    l = emit_bin_op_typed(code_buf, l, op, common_t);
                    set_qword(s, 4, l);
                }
                t1 = common_t;
                is_c1 = 0;
                set_qword(s, 24, 0);
            }
        } else {
            running = 0;
        }
    }
    return t1;
}

fn parse_add_expr(s: i64): i64 {
    let start_l = get_qword(s, 4);
    let start_d = get_qword(s, 12);
    let t1 = parse_term(s);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
    let is_c1 = get_qword(s, 24);
    let v1 = get_qword(s, 25);
    let code_buf = get_qword(s, 3);
    let running = 1;
    while running == 1 {
        let k = cur_tok_kind(s);
        let is_op = 0;
        if k == TOKEN_PLUS { is_op = 1; }
        if k == TOKEN_PLUS_TRAP { is_op = 1; }
        if k == TOKEN_PLUS_SAT { is_op = 1; }
        if k == TOKEN_MINUS { is_op = 1; }
        if k == TOKEN_MINUS_TRAP { is_op = 1; }
        if k == TOKEN_MINUS_SAT { is_op = 1; }

        if is_op == 1 {
            let op = k;
            advance_token(s);
            # Save position before push for retroactive imm optimization
            let pre_push_l2 = get_qword(s, 4);
            let pre_push_d2 = get_qword(s, 12);
            parser_push_rax(s);
            let t2 = parse_term(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            if (op == TOKEN_PLUS) & ((t1 == TYPE_STR) | (t2 == TYPE_STR)) {
                if (t1 == TYPE_STR) & (t2 == TYPE_STR) {
                    let l = get_qword(s, 4);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
                    set_qword(s, 4, l);
                    parser_pop_reg(s, 95); # pop rdi
                    l = get_qword(s, 4);
                    l = isel_emit_builtin_string(code_buf, l, 4604361535457346067);
                    set_qword(s, 4, l);
                    t1 = TYPE_STR;
                    is_c1 = 0;
                    set_qword(s, 24, 0);
                }
                if (t1 == TYPE_STR) & (t2 != TYPE_STR) {
                    if (type_is_integer(t2) == 0) & (t2 != TYPE_INT_LIT) {
                        set_qword(s, 7, -43);
                        return -43;
                    }
                    let l = get_qword(s, 4);
                    # convert rax (int) to str
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 236); l = emit_byte(code_buf, l, 32); # sub rsp, 32
                    l = emit_byte(code_buf, l, 198); l = emit_byte(code_buf, l, 68); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, 31); l = emit_byte(code_buf, l, 0); # mov byte [rsp+31], 0
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 141); l = emit_byte(code_buf, l, 76); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, 31); # lea rcx, [rsp+31]
                    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 192); # mov r8, rax
                    l = emit_byte(code_buf, l, 69); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 201); # xor r9d, r9d
                    l = emit_byte(code_buf, l, 77); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192); # test r8, r8
                    let p_pos = l + 1;
                    l = emit_byte(code_buf, l, 121); l = emit_byte(code_buf, l, 0); # jns .L_pos
                    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 216); # neg r8
                    l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 185); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); # mov r9d, 1
                    emit_patch_rel8(code_buf, p_pos, l);
                    l = emit_byte(code_buf, l, 76); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 192); # mov rax, r8
                    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 199); l = emit_byte(code_buf, l, 194); l = emit_byte(code_buf, l, 10); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); # mov r10, 10
                    let l_div_loop = l;
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 201); # dec rcx
                    l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 210); # xor edx, edx
                    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 242); # div r10
                    l = emit_byte(code_buf, l, 128); l = emit_byte(code_buf, l, 194); l = emit_byte(code_buf, l, 48); # add dl, 48
                    l = emit_byte(code_buf, l, 136); l = emit_byte(code_buf, l, 17); # mov [rcx], dl
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192); # test rax, rax
                    let p_div_loop = l + 1;
                    l = emit_byte(code_buf, l, 117); l = emit_byte(code_buf, l, 0); # jnz .L_div_loop
                    emit_patch_rel8(code_buf, p_div_loop, l_div_loop);
                    l = emit_byte(code_buf, l, 69); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 201); # test r9d, r9d
                    let p_done = l + 1;
                    l = emit_byte(code_buf, l, 116); l = emit_byte(code_buf, l, 0); # jz .L_done
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 201); # dec rcx
                    l = emit_byte(code_buf, l, 198); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 45); # mov byte [rcx], 45
                    emit_patch_rel8(code_buf, p_done, l);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 207); # mov rdi, rcx
                    l = isel_emit_builtin_string(code_buf, l, -3364675804167515880);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 196); l = emit_byte(code_buf, l, 32); # add rsp, 32

                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
                    set_qword(s, 4, l);
                    parser_pop_reg(s, 95); # pop rdi
                    l = get_qword(s, 4);
                    l = isel_emit_builtin_string(code_buf, l, 4604361535457346067);
                    set_qword(s, 4, l);
                    t1 = TYPE_STR;
                    is_c1 = 0;
                    set_qword(s, 24, 0);
                }
                if (t1 != TYPE_STR) & (t2 == TYPE_STR) {
                    if (type_is_integer(t1) == 0) & (t1 != TYPE_INT_LIT) {
                        set_qword(s, 7, -43);
                        return -43;
                    }
                    let l = get_qword(s, 4);
                    l = emit_byte(code_buf, l, 80); # push rax (save t2 str on stack)
                    # mov rax, [rsp + 8] (load t1 int)
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 68); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, 8);
                    # convert rax (int) to str
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 236); l = emit_byte(code_buf, l, 32); # sub rsp, 32
                    l = emit_byte(code_buf, l, 198); l = emit_byte(code_buf, l, 68); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, 31); l = emit_byte(code_buf, l, 0); # mov byte [rsp+31], 0
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 141); l = emit_byte(code_buf, l, 76); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, 31); # lea rcx, [rsp+31]
                    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 192); # mov r8, rax
                    l = emit_byte(code_buf, l, 69); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 201); # xor r9d, r9d
                    l = emit_byte(code_buf, l, 77); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192); # test r8, r8
                    let p_pos2 = l + 1;
                    l = emit_byte(code_buf, l, 121); l = emit_byte(code_buf, l, 0); # jns .L_pos
                    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 216); # neg r8
                    l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 185); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); # mov r9d, 1
                    emit_patch_rel8(code_buf, p_pos2, l);
                    l = emit_byte(code_buf, l, 76); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 192); # mov rax, r8
                    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 199); l = emit_byte(code_buf, l, 194); l = emit_byte(code_buf, l, 10); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); # mov r10, 10
                    let l_div_loop2 = l;
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 201); # dec rcx
                    l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 210); # xor edx, edx
                    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 242); # div r10
                    l = emit_byte(code_buf, l, 128); l = emit_byte(code_buf, l, 194); l = emit_byte(code_buf, l, 48); # add dl, 48
                    l = emit_byte(code_buf, l, 136); l = emit_byte(code_buf, l, 17); # mov [rcx], dl
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192); # test rax, rax
                    let p_div_loop2 = l + 1;
                    l = emit_byte(code_buf, l, 117); l = emit_byte(code_buf, l, 0); # jnz .L_div_loop
                    emit_patch_rel8(code_buf, p_div_loop2, l_div_loop2);
                    l = emit_byte(code_buf, l, 69); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 201); # test r9d, r9d
                    let p_done2 = l + 1;
                    l = emit_byte(code_buf, l, 116); l = emit_byte(code_buf, l, 0); # jz .L_done
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 201); # dec rcx
                    l = emit_byte(code_buf, l, 198); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 45); # mov byte [rcx], 45
                    emit_patch_rel8(code_buf, p_done2, l);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 207); # mov rdi, rcx
                    l = isel_emit_builtin_string(code_buf, l, -3364675804167515880);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 131); l = emit_byte(code_buf, l, 196); l = emit_byte(code_buf, l, 32); # add rsp, 32

                    # pop rsi (t2 str)
                    l = emit_byte(code_buf, l, 94);
                    # pop rcx (discard t1 int)
                    l = emit_byte(code_buf, l, 89);
                    # mov rdi, rax (t1 str)
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 199);
                    l = isel_emit_builtin_string(code_buf, l, 4604361535457346067);
                    set_qword(s, 4, l);
                    let cur_depth = get_qword(s, 12);
                    set_qword(s, 12, cur_depth - 1);
                    t1 = TYPE_STR;
                    is_c1 = 0;
                    set_qword(s, 24, 0);
                }
            } else {
                if t1 == TYPE_PTR { set_qword(s, 7, -44); return -44; }
                if t2 == TYPE_PTR { set_qword(s, 7, -44); return -44; }
                let common_t = resolve_binary_op_type(t1, t2);
                if common_t == TYPE_NONE { set_qword(s, 7, -43); return -43; }
                if (type_is_integer(common_t) == 0) & (type_is_float(common_t) == 0) { set_qword(s, 7, -43); return -43; }
                if ((op == TOKEN_PLUS_TRAP) | (op == TOKEN_PLUS_SAT) | (op == TOKEN_MINUS_TRAP) | (op == TOKEN_MINUS_SAT)) & (type_is_float(common_t) == 1) {
                    set_qword(s, 7, -43);
                    return -43;
                }
                if common_t == TYPE_INT_LIT { common_t = TYPE_I64; }
                if common_t == TYPE_FLOAT_LIT { common_t = TYPE_F64; }

                let is_c2 = get_qword(s, 24);
                let v2 = get_qword(s, 25);
                let did_fold = 0;
                if (get_qword(s, 22) == 1) & (type_is_integer(common_t) == 1) {
                    if is_c1 == 1 {
                        if is_c2 == 1 {
                            let can_fold = 1;
                            if (op == TOKEN_PLUS_TRAP) | (op == TOKEN_PLUS_SAT) | (op == TOKEN_MINUS_TRAP) | (op == TOKEN_MINUS_SAT) {
                                can_fold = 0;
                            }
                            if can_fold == 1 {
                                let folded = 0;
                                if op == TOKEN_PLUS { folded = v1 + v2; }
                                if op == TOKEN_MINUS { folded = v1 - v2; }
                                if common_t == TYPE_I32 {
                                    let m = folded % 4294967296;
                                    if m >= 2147483648 { m = m - 4294967296; }
                                    folded = m;
                                }
                                if common_t == TYPE_U8 {
                                    let m = folded % 256;
                                    if m < 0 { m = m + 256; }
                                    folded = m;
                                }
                                set_qword(s, 4, start_l);
                                set_qword(s, 12, start_d);
                                let l = emit_mov_imm64(code_buf, start_l, 0, folded);
                                set_qword(s, 4, l);
                                set_qword(s, 24, 1);
                                set_qword(s, 25, folded);
                                let opt_ctx = get_qword(s, 23);
                                if opt_ctx > 0 {
                                    let p2_ch = get_qword(opt_ctx + 96, 2);
                                    set_qword(opt_ctx + 96, 2, p2_ch + 1);
                                    let tot_ch = get_qword(opt_ctx, 2);
                                    set_qword(opt_ctx, 2, tot_ch + 1);
                                }
                                is_c1 = 1;
                                v1 = folded;
                                t1 = common_t;
                                did_fold = 1;
                            }
                        }
                    }
                }

                if did_fold == 0 {
                    # Retroactive immediate form: if RHS is constant, rewind past push
                    let did_imm_add = 0;
                    if (is_c2 == 1) & (type_is_integer(common_t) == 1) {
                        if (op == TOKEN_PLUS) | (op == TOKEN_MINUS) {
                            let imm_l2 = emit_bin_op_imm64(code_buf, pre_push_l2, op, v2, common_t);
                            if imm_l2 >= 0 {
                                set_qword(s, 4, imm_l2);
                                set_qword(s, 12, pre_push_d2);
                                did_imm_add = 1;
                            }
                        }
                    }
                    if did_imm_add == 0 {
                        let l = get_qword(s, 4);
                        if common_t == TYPE_F32 {
                            if t2 == TYPE_FLOAT_LIT {
                                l = emit_cast(code_buf, l, TYPE_FLOAT_LIT, TYPE_F32);
                            }
                        }
                        l = emit_mov_rcx_rax(code_buf, l);
                        set_qword(s, 4, l);
                        parser_pop_reg(s, 88);
                        l = get_qword(s, 4);
                        if common_t == TYPE_F32 {
                            if t1 == TYPE_FLOAT_LIT {
                                l = emit_cast(code_buf, l, TYPE_FLOAT_LIT, TYPE_F32);
                            }
                        }
                        l = emit_bin_op_typed(code_buf, l, op, common_t);
                        set_qword(s, 4, l);
                    }
                    t1 = common_t;
                    is_c1 = 0;
                    set_qword(s, 24, 0);
                }
            }
        } else {
            running = 0;
        }
    }
    return t1;
}

fn parse_shift_expr(s: i64): i64 {
    let start_l = get_qword(s, 4);
    let start_d = get_qword(s, 12);
    let t1 = parse_add_expr(s);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
    let is_c1 = get_qword(s, 24);
    let v1 = get_qword(s, 25);
    let code_buf = get_qword(s, 3);
    let running = 1;
    while running == 1 {
        let k = cur_tok_kind(s);
        let is_op = 0;
        if k == TOKEN_SHL { is_op = 1; }
        if k == TOKEN_SHR { is_op = 1; }

        if is_op == 1 {
            let op = k;
            advance_token(s);
            let pre_push_shift_l = get_qword(s, 4);
            let pre_push_shift_d = get_qword(s, 12);
            parser_push_rax(s);
            let t2 = parse_add_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            if type_is_integer(t1) == 0 { set_qword(s, 7, -43); return -43; }
            if type_is_integer(t2) == 0 { set_qword(s, 7, -43); return -43; }
            let emit_t = t1;
            if emit_t == TYPE_INT_LIT { emit_t = TYPE_I64; }

            let is_c2 = get_qword(s, 24);
            let v2 = get_qword(s, 25);
            let did_fold = 0;
            if get_qword(s, 22) == 1 {
                if is_c1 == 1 {
                    if is_c2 == 1 {
                        if v2 >= 0 {
                            if v2 < 64 {
                                let folded = 0;
                                if op == TOKEN_SHL { folded = v1 << v2; }
                                if op == TOKEN_SHR { folded = v1 >> v2; }
                                if emit_t == TYPE_I32 {
                                    let m = folded % 4294967296;
                                    if m >= 2147483648 { m = m - 4294967296; }
                                    folded = m;
                                }
                                if emit_t == TYPE_U8 {
                                    let m = folded % 256;
                                    if m < 0 { m = m + 256; }
                                    folded = m;
                                }
                                set_qword(s, 4, start_l);
                                set_qword(s, 12, start_d);
                                let l = emit_mov_imm64(code_buf, start_l, 0, folded);
                                set_qword(s, 4, l);
                                set_qword(s, 24, 1);
                                set_qword(s, 25, folded);
                                let opt_ctx = get_qword(s, 23);
                                if opt_ctx > 0 {
                                    let p2_ch = get_qword(opt_ctx + 96, 2);
                                    set_qword(opt_ctx + 96, 2, p2_ch + 1);
                                    let tot_ch = get_qword(opt_ctx, 2);
                                    set_qword(opt_ctx, 2, tot_ch + 1);
                                }
                                is_c1 = 1;
                                v1 = folded;
                                t1 = emit_t;
                                did_fold = 1;
                            }
                        }
                    }
                }
            }

            if did_fold == 0 {
                let did_imm_shift = 0;
                if is_c2 == 1 {
                    let imm_shift_l = emit_bin_op_imm64(code_buf, pre_push_shift_l, op, v2, emit_t);
                    if imm_shift_l >= 0 {
                        set_qword(s, 4, imm_shift_l);
                        set_qword(s, 12, pre_push_shift_d);
                        did_imm_shift = 1;
                    }
                }
                if did_imm_shift == 0 {
                    let l = get_qword(s, 4);
                    l = emit_mov_rcx_rax(code_buf, l);
                    set_qword(s, 4, l);
                    parser_pop_reg(s, 88);
                    l = get_qword(s, 4);
                    l = emit_bin_op_typed(code_buf, l, op, emit_t);
                    set_qword(s, 4, l);
                }
                t1 = emit_t;
                is_c1 = 0;
                set_qword(s, 24, 0);
            }
        } else {
            running = 0;
        }
    }
    return t1;
}

fn parse_bitand_expr(s: i64): i64 {
    let start_l = get_qword(s, 4);
    let start_d = get_qword(s, 12);
    let t1 = parse_shift_expr(s);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
    let is_c1 = get_qword(s, 24);
    let v1 = get_qword(s, 25);
    let code_buf = get_qword(s, 3);
    let running = 1;
    while running == 1 {
        let k = cur_tok_kind(s);
        if k == TOKEN_AMP {
            advance_token(s);
            let pre_push_bitand_l = get_qword(s, 4);
            let pre_push_bitand_d = get_qword(s, 12);
            parser_push_rax(s);
            let t2 = parse_shift_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            let common_t = resolve_binary_op_type(t1, t2);
            if common_t == TYPE_NONE {
                if t1 == TYPE_BOOL {
                    if t2 == TYPE_BOOL {
                        common_t = TYPE_BOOL;
                    }
                }
            }
            if common_t == TYPE_NONE { set_qword(s, 7, -43); return -43; }
            if common_t == TYPE_INT_LIT { common_t = TYPE_I64; }

            let is_c2 = get_qword(s, 24);
            let v2 = get_qword(s, 25);
            let did_fold = 0;
            if get_qword(s, 22) == 1 {
                if is_c1 == 1 {
                    if is_c2 == 1 {
                        let folded = v1 & v2;
                        if common_t == TYPE_BOOL {
                            if folded != 0 { folded = 1; } else { folded = 0; }
                        }
                        if common_t == TYPE_I32 {
                            let m = folded % 4294967296;
                            if m >= 2147483648 { m = m - 4294967296; }
                            folded = m;
                        }
                        if common_t == TYPE_U8 {
                            let m = folded % 256;
                            if m < 0 { m = m + 256; }
                            folded = m;
                        }
                        set_qword(s, 4, start_l);
                        set_qword(s, 12, start_d);
                        let l = emit_mov_imm64(code_buf, start_l, 0, folded);
                        set_qword(s, 4, l);
                        set_qword(s, 24, 1);
                        set_qword(s, 25, folded);
                        let opt_ctx = get_qword(s, 23);
                        if opt_ctx > 0 {
                            let p2_ch = get_qword(opt_ctx + 96, 2);
                            set_qword(opt_ctx + 96, 2, p2_ch + 1);
                            let tot_ch = get_qword(opt_ctx, 2);
                            set_qword(opt_ctx, 2, tot_ch + 1);
                        }
                        is_c1 = 1;
                        v1 = folded;
                        t1 = common_t;
                        did_fold = 1;
                    }
                }
            }

            if did_fold == 0 {
                let did_imm_bitand = 0;
                if is_c2 == 1 {
                    let imm_bitand_l = emit_bin_op_imm64(code_buf, pre_push_bitand_l, TOKEN_AMP, v2, common_t);
                    if imm_bitand_l >= 0 {
                        set_qword(s, 4, imm_bitand_l);
                        set_qword(s, 12, pre_push_bitand_d);
                        did_imm_bitand = 1;
                    }
                }
                if did_imm_bitand == 0 {
                    let l = get_qword(s, 4);
                    l = emit_mov_rcx_rax(code_buf, l);
                    set_qword(s, 4, l);
                    parser_pop_reg(s, 88);
                    l = get_qword(s, 4);
                    l = emit_bin_op_typed(code_buf, l, TOKEN_AMP, common_t);
                    set_qword(s, 4, l);
                }
                t1 = common_t;
                is_c1 = 0;
                set_qword(s, 24, 0);
            }
        } else {
            running = 0;
        }
    }
    return t1;
}

fn parse_bitxor_expr(s: i64): i64 {
    let start_l = get_qword(s, 4);
    let start_d = get_qword(s, 12);
    let t1 = parse_bitand_expr(s);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
    let is_c1 = get_qword(s, 24);
    let v1 = get_qword(s, 25);
    let code_buf = get_qword(s, 3);
    let running = 1;
    while running == 1 {
        let k = cur_tok_kind(s);
        if k == TOKEN_CARET {
            advance_token(s);
            let pre_push_caret_l = get_qword(s, 4);
            let pre_push_caret_d = get_qword(s, 12);
            parser_push_rax(s);
            let t2 = parse_bitand_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            let common_t = resolve_binary_op_type(t1, t2);
            if common_t == TYPE_NONE {
                if t1 == TYPE_BOOL {
                    if t2 == TYPE_BOOL {
                        common_t = TYPE_BOOL;
                    }
                }
            }
            if common_t == TYPE_NONE { set_qword(s, 7, -43); return -43; }
            if common_t == TYPE_INT_LIT { common_t = TYPE_I64; }

            let is_c2 = get_qword(s, 24);
            let v2 = get_qword(s, 25);
            let did_fold = 0;
            if get_qword(s, 22) == 1 {
                if is_c1 == 1 {
                    if is_c2 == 1 {
                        let folded = v1 ^ v2;
                        if common_t == TYPE_BOOL {
                            if folded != 0 { folded = 1; } else { folded = 0; }
                        }
                        if common_t == TYPE_I32 {
                            let m = folded % 4294967296;
                            if m >= 2147483648 { m = m - 4294967296; }
                            folded = m;
                        }
                        if common_t == TYPE_U8 {
                            let m = folded % 256;
                            if m < 0 { m = m + 256; }
                            folded = m;
                        }
                        set_qword(s, 4, start_l);
                        set_qword(s, 12, start_d);
                        let l = emit_mov_imm64(code_buf, start_l, 0, folded);
                        set_qword(s, 4, l);
                        set_qword(s, 24, 1);
                        set_qword(s, 25, folded);
                        let opt_ctx = get_qword(s, 23);
                        if opt_ctx > 0 {
                            let p2_ch = get_qword(opt_ctx + 96, 2);
                            set_qword(opt_ctx + 96, 2, p2_ch + 1);
                            let tot_ch = get_qword(opt_ctx, 2);
                            set_qword(opt_ctx, 2, tot_ch + 1);
                        }
                        is_c1 = 1;
                        v1 = folded;
                        t1 = common_t;
                        did_fold = 1;
                    }
                }
            }

            if did_fold == 0 {
                let did_imm_caret = 0;
                if is_c2 == 1 {
                    let imm_caret_l = emit_bin_op_imm64(code_buf, pre_push_caret_l, TOKEN_CARET, v2, common_t);
                    if imm_caret_l >= 0 {
                        set_qword(s, 4, imm_caret_l);
                        set_qword(s, 12, pre_push_caret_d);
                        did_imm_caret = 1;
                    }
                }
                if did_imm_caret == 0 {
                    let l = get_qword(s, 4);
                    l = emit_mov_rcx_rax(code_buf, l);
                    set_qword(s, 4, l);
                    parser_pop_reg(s, 88);
                    l = get_qword(s, 4);
                    l = emit_bin_op_typed(code_buf, l, TOKEN_CARET, common_t);
                    set_qword(s, 4, l);
                }
                t1 = common_t;
                is_c1 = 0;
                set_qword(s, 24, 0);
            }
        } else {
            running = 0;
        }
    }
    return t1;
}

fn parse_bitor_expr(s: i64): i64 {
    let start_l = get_qword(s, 4);
    let start_d = get_qword(s, 12);
    let t1 = parse_bitxor_expr(s);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
    let is_c1 = get_qword(s, 24);
    let v1 = get_qword(s, 25);
    let code_buf = get_qword(s, 3);
    let running = 1;
    while running == 1 {
        let k = cur_tok_kind(s);
        if k == TOKEN_PIPE {
            advance_token(s);
            let pre_push_pipe_l = get_qword(s, 4);
            let pre_push_pipe_d = get_qword(s, 12);
            parser_push_rax(s);
            let t2 = parse_bitxor_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            let common_t = resolve_binary_op_type(t1, t2);
            if common_t == TYPE_NONE {
                if t1 == TYPE_BOOL {
                    if t2 == TYPE_BOOL {
                        common_t = TYPE_BOOL;
                    }
                }
            }
            if common_t == TYPE_NONE { set_qword(s, 7, -43); return -43; }
            if common_t == TYPE_INT_LIT { common_t = TYPE_I64; }

            let is_c2 = get_qword(s, 24);
            let v2 = get_qword(s, 25);
            let did_fold = 0;
            if get_qword(s, 22) == 1 {
                if is_c1 == 1 {
                    if is_c2 == 1 {
                        let folded = v1 | v2;
                        if common_t == TYPE_BOOL {
                            if folded != 0 { folded = 1; } else { folded = 0; }
                        }
                        if common_t == TYPE_I32 {
                            let m = folded % 4294967296;
                            if m >= 2147483648 { m = m - 4294967296; }
                            folded = m;
                        }
                        if common_t == TYPE_U8 {
                            let m = folded % 256;
                            if m < 0 { m = m + 256; }
                            folded = m;
                        }
                        set_qword(s, 4, start_l);
                        set_qword(s, 12, start_d);
                        let l = emit_mov_imm64(code_buf, start_l, 0, folded);
                        set_qword(s, 4, l);
                        set_qword(s, 24, 1);
                        set_qword(s, 25, folded);
                        let opt_ctx = get_qword(s, 23);
                        if opt_ctx > 0 {
                            let p2_ch = get_qword(opt_ctx + 96, 2);
                            set_qword(opt_ctx + 96, 2, p2_ch + 1);
                            let tot_ch = get_qword(opt_ctx, 2);
                            set_qword(opt_ctx, 2, tot_ch + 1);
                        }
                        is_c1 = 1;
                        v1 = folded;
                        t1 = common_t;
                        did_fold = 1;
                    }
                }
            }

            if did_fold == 0 {
                let did_imm_pipe = 0;
                if is_c2 == 1 {
                    let imm_pipe_l = emit_bin_op_imm64(code_buf, pre_push_pipe_l, TOKEN_PIPE, v2, common_t);
                    if imm_pipe_l >= 0 {
                        set_qword(s, 4, imm_pipe_l);
                        set_qword(s, 12, pre_push_pipe_d);
                        did_imm_pipe = 1;
                    }
                }
                if did_imm_pipe == 0 {
                    let l = get_qword(s, 4);
                    l = emit_mov_rcx_rax(code_buf, l);
                    set_qword(s, 4, l);
                    parser_pop_reg(s, 88);
                    l = get_qword(s, 4);
                    l = emit_bin_op_typed(code_buf, l, TOKEN_PIPE, common_t);
                    set_qword(s, 4, l);
                }
                t1 = common_t;
                is_c1 = 0;
                set_qword(s, 24, 0);
            }
        } else {
            running = 0;
        }
    }
    return t1;
}

fn parse_expr(s: i64): i64 {
    let start_l = get_qword(s, 4);
    let start_d = get_qword(s, 12);
    let t1 = parse_bitor_expr(s);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
    let is_c1 = get_qword(s, 24);
    let v1 = get_qword(s, 25);
    let code_buf = get_qword(s, 3);
    let running = 1;
    while running == 1 {
        let k = cur_tok_kind(s);
        let is_cmp = 0;
        if k == TOKEN_LESS { is_cmp = 1; }
        if k == TOKEN_GREATER { is_cmp = 1; }
        if k == TOKEN_LESS_EQ { is_cmp = 1; }
        if k == TOKEN_GREATER_EQ { is_cmp = 1; }
        if k == TOKEN_EQUAL_EQUAL { is_cmp = 1; }
        if k == TOKEN_NOT_EQUAL { is_cmp = 1; }

        if is_cmp == 1 {
            advance_token(s);
            parser_push_rax(s);
            let t2 = parse_bitor_expr(s);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            let cmp_res = resolve_cmp_type(t1, t2, k);
            if cmp_res < 0 {
                set_qword(s, 7, cmp_res);
                return cmp_res;
            }
            let common_t = resolve_binary_op_type(t1, t2);
            if common_t == TYPE_INT_LIT { common_t = TYPE_I64; }
            if common_t == TYPE_NONE {
                if t1 == TYPE_PTR { common_t = TYPE_PTR; }
                if t1 == TYPE_BOOL { common_t = TYPE_BOOL; }
                if t1 == TYPE_STR { common_t = TYPE_STR; }
                if t2 == TYPE_STR { common_t = TYPE_STR; }
            }

            let is_c2 = get_qword(s, 24);
            let v2 = get_qword(s, 25);
            let did_fold = 0;
            if get_qword(s, 22) == 1 {
                if is_c1 == 1 {
                    if is_c2 == 1 {
                        if common_t != TYPE_STR {
                            let folded = 0;
                            if k == TOKEN_LESS { if v1 < v2 { folded = 1; } }
                            if k == TOKEN_GREATER { if v1 > v2 { folded = 1; } }
                            if k == TOKEN_LESS_EQ { if v1 <= v2 { folded = 1; } }
                            if k == TOKEN_GREATER_EQ { if v1 >= v2 { folded = 1; } }
                            if k == TOKEN_EQUAL_EQUAL { if v1 == v2 { folded = 1; } }
                            if k == TOKEN_NOT_EQUAL { if v1 != v2 { folded = 1; } }

                            set_qword(s, 4, start_l);
                            set_qword(s, 12, start_d);
                            let l = emit_mov_imm64(code_buf, start_l, 0, folded);
                            set_qword(s, 4, l);
                            set_qword(s, 24, 1);
                            set_qword(s, 25, folded);
                            let opt_ctx = get_qword(s, 23);
                            if opt_ctx > 0 {
                                let p2_ch = get_qword(opt_ctx + 96, 2);
                                set_qword(opt_ctx + 96, 2, p2_ch + 1);
                                let tot_ch = get_qword(opt_ctx, 2);
                                set_qword(opt_ctx, 2, tot_ch + 1);
                            }
                            is_c1 = 1;
                            v1 = folded;
                            t1 = TYPE_BOOL;
                            did_fold = 1;
                        }
                    }
                }
            }

            if did_fold == 0 {
                let l = get_qword(s, 4);
                if common_t == TYPE_F32 {
                    if t2 == TYPE_FLOAT_LIT {
                        l = emit_cast(code_buf, l, TYPE_FLOAT_LIT, TYPE_F32);
                    }
                }
                l = emit_mov_rcx_rax(code_buf, l);
                set_qword(s, 4, l);
                parser_pop_reg(s, 88);
                l = get_qword(s, 4);
                if common_t == TYPE_F32 {
                    if t1 == TYPE_FLOAT_LIT {
                        l = emit_cast(code_buf, l, TYPE_FLOAT_LIT, TYPE_F32);
                    }
                }
                if common_t == TYPE_STR {
                    if t1 == TYPE_INT_LIT {
                        l = emit_bin_op_typed(code_buf, l, k, TYPE_PTR);
                    } else {
                        if t2 == TYPE_INT_LIT {
                            l = emit_bin_op_typed(code_buf, l, k, TYPE_PTR);
                        } else {
                            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 199); # mov rdi, rax
                            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 206); # mov rsi, rcx
                            l = isel_emit_builtin_string(code_buf, l, -2655435116151803629);
                            if k == TOKEN_NOT_EQUAL {
                                l = emit_byte(code_buf, l, 52); l = emit_byte(code_buf, l, 1); # xor al, 1
                                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 182); l = emit_byte(code_buf, l, 192); # movzx rax, al
                            }
                        }
                    }
                } else {
                    l = emit_bin_op_typed(code_buf, l, k, common_t);
                }
                set_qword(s, 4, l);
                t1 = TYPE_BOOL;
                is_c1 = 0;
                set_qword(s, 24, 0);
            }
        } else {
            running = 0;
        }
    }

    let chaining = 1;
    let src = get_qword(s, 0);
    let tbl = get_qword(s, 5);
    while chaining == 1 {
        let ck = cur_tok_kind(s);
        if ck == TOKEN_PIPE_GREATER {
            advance_token(s); # skip '|>'
            let arg_t = t1;
            let arg_ann_pointee = get_qword(s, 14);
            let arg_ann_prov = get_qword(s, 15);
            let arg_ann_len = get_qword(s, 19);

            parser_push_rax(s);
            set_qword(tbl, 10240, arg_t);
            set_qword(tbl, 10272, arg_ann_pointee);
            set_qword(tbl, 10304, arg_ann_prov);
            set_qword(tbl, 10336, arg_ann_len);
            let pipe_arg_count = 1;

            let fn_offset = cur_tok_offset(s);
            let fn_len = cur_tok_len(s);
            let fn_hash = hash_token(src, fn_offset, fn_len);
            expect(s, TOKEN_IDENT);

            if cur_tok_kind(s) == TOKEN_LPAREN {
                advance_token(s); # skip '('
                if cur_tok_kind(s) != TOKEN_RPAREN {
                    let a_t = parse_expr(s);
                    if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                    set_qword(tbl, 10240 + pipe_arg_count, a_t);
                    set_qword(tbl, 10272 + pipe_arg_count, get_qword(s, 14));
                    set_qword(tbl, 10304 + pipe_arg_count, get_qword(s, 15));
                    set_qword(tbl, 10336 + pipe_arg_count, get_qword(s, 19));
                    parser_push_rax(s);
                    pipe_arg_count = pipe_arg_count + 1;
                    while cur_tok_kind(s) == TOKEN_COMMA {
                        advance_token(s);
                        let a_t2 = parse_expr(s);
                        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                        set_qword(tbl, 10240 + pipe_arg_count, a_t2);
                        set_qword(tbl, 10272 + pipe_arg_count, get_qword(s, 14));
                        set_qword(tbl, 10304 + pipe_arg_count, get_qword(s, 15));
                        set_qword(tbl, 10336 + pipe_arg_count, get_qword(s, 19));
                        parser_push_rax(s);
                        pipe_arg_count = pipe_arg_count + 1;
                    }
                }
                expect(s, TOKEN_RPAREN);
            }
            emit_call_or_builtin(s, fn_offset, fn_len, fn_hash, pipe_arg_count);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            t1 = func_tbl_get(tbl, fn_hash, 3);
            set_qword(s, 24, 0);
        } else {
            if ck == TOKEN_QUESTION {
                advance_token(s); # skip '?'
                let cur_fn_ret_t = get_qword(s, 13);
                if (t1 == TYPE_OPTION) | (t1 == TYPE_RESULT) {
                    let l = get_qword(s, 4);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192);
                    l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 132); # jz rel32
                    l = emit_disp32(code_buf, l, 0);
                    epilogue_patches_add(tbl, l - 4);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 208); # mov rax, rdx
                    set_qword(s, 4, l);
                    let inner_t = get_qword(s, 14);
                    if inner_t == TYPE_NONE { inner_t = TYPE_I64; }
                    t1 = inner_t;
                    set_qword(s, 14, TYPE_NONE);
                } else {
                    if cur_fn_ret_t != TYPE_I64 {
                        if cur_fn_ret_t != TYPE_I32 {
                            set_qword(s, 7, -41); # ERR_TYPE_MISMATCH_RETURN
                            return -41;
                        }
                    }
                    let l = get_qword(s, 4);
                    l = emit_byte(code_buf, l, 72);
                    l = emit_byte(code_buf, l, 133);
                    l = emit_byte(code_buf, l, 192); # test rax, rax
                    l = emit_byte(code_buf, l, 15);
                    l = emit_byte(code_buf, l, 136); # js rel32 (0F 88)
                    l = emit_disp32(code_buf, l, 0);
                    epilogue_patches_add(tbl, l - 4);
                    set_qword(s, 4, l);
                }
            } else {
                if (ck == TOKEN_QUESTION_COLON) | (ck == TOKEN_QUESTION_QUESTION) | (ck == TOKEN_KW_OR) {
                    advance_token(s); # skip '?:', '??', or 'or'
                    let l = get_qword(s, 4);
                    if (t1 == TYPE_OPTION) | (t1 == TYPE_RESULT) {
                        l = emit_cmp_rax_zero(code_buf, l);
                        l = emit_byte(code_buf, l, 15);
                        l = emit_byte(code_buf, l, 132); # jz rel32 to fallback
                        l = emit_disp32(code_buf, l, 0);
                        let jz_patch = l - 4;
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 208); # mov rax, rdx
                        l = emit_jmp_rel32(code_buf, l, 0);
                        let jmp_done = l - 4;
                        emit_backpatch32(code_buf, jz_patch, l);
                        set_qword(s, 4, l);
                        let def_t = parse_bitor_expr(s);
                        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
                        l = get_qword(s, 4);
                        emit_backpatch32(code_buf, jmp_done, l);
                        set_qword(s, 4, l);
                        set_qword(s, 24, 0);
                        let inner_t = get_qword(s, 14);
                        if inner_t == TYPE_NONE { inner_t = def_t; }
                        t1 = inner_t;
                    } else {
                        l = emit_cmp_rax_zero(code_buf, l);
                        l = emit_byte(code_buf, l, 15);
                        l = emit_byte(code_buf, l, 133); # jne rel32 (0F 85)
                        l = emit_disp32(code_buf, l, 0);
                        let elvis_patch = l - 4;
                        set_qword(s, 4, l);

                        let def_t = parse_bitor_expr(s);
                        if get_qword(s, 7) < 0 { return get_qword(s, 7); }

                        l = get_qword(s, 4);
                        emit_backpatch32(code_buf, elvis_patch, l);
                        set_qword(s, 4, l);
                        set_qword(s, 24, 0);
                    }
                } else {
                    chaining = 0;
                }
            }
        }
    }
    return t1;
}

# ------------------------------------------------------------------------------
# Statement & Function Parsers
# ------------------------------------------------------------------------------

fn is_block_end(s: i64): i64 {
    if get_qword(s, 7) < 0 { return 1; }
    let k = cur_tok_kind(s);
    if k == TOKEN_RBRACE { return 1; }
    if k == TOKEN_EOF { return 1; }
    if k == TOKEN_ERROR { return 1; }
    return 0;
}

fn parse_stmt(s: i64): i64 {
    if cur_tok_kind(s) == TOKEN_ERROR {
        set_qword(s, 7, -3); # ERR_INVALID_TOKEN
        return 0;
    }
    if get_qword(s, 7) < 0 {
        return 0;
    }
    let src = get_qword(s, 0);
    let code_buf = get_qword(s, 3);
    let tbl = get_qword(s, 5);
    let k = cur_tok_kind(s);
    set_qword(tbl, 10380, 0);

    # 0. defer stmt;
    if k == TOKEN_KW_DEFER {
        advance_token(s); # skip 'defer'
        let slot = get_qword(s, 461);
        if slot == 0 {
            slot = get_qword(s, 20) + 8;
            set_qword(s, 20, slot);
            set_qword(s, 461, slot);
            # Emit: mov qword ptr [rbp - slot], 0
            let l = get_qword(s, 4);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 199); l = emit_byte(code_buf, l, 69);
            l = emit_byte(code_buf, l, (256 - (slot % 256)) % 256);
            l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
            set_qword(s, 4, l);
        }

        # Set bit in mask: or qword ptr [rbp - slot], (1 << d_cnt)
        let total_d = 1;
        let ci = 0;
        while ci < get_qword(s, 460) {
            total_d = total_d * 2;
            ci = ci + 1;
        }
        let l = get_qword(s, 4);
        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 129); l = emit_byte(code_buf, l, 77);
        l = emit_byte(code_buf, l, (256 - (slot % 256)) % 256);
        l = emit_byte(code_buf, l, total_d % 256);
        l = emit_byte(code_buf, l, (total_d / 256) % 256);
        l = emit_byte(code_buf, l, (total_d / 65536) % 256);
        l = emit_byte(code_buf, l, (total_d / 16777216) % 256);
        set_qword(s, 4, l);

        # Record start pos of the deferred statement directly into s:
        set_qword(s, 462 + (get_qword(s, 460) * 5) + 0, get_qword(s, 2));
        set_qword(s, 462 + (get_qword(s, 460) * 5) + 1, cur_tok_kind(s));
        set_qword(s, 462 + (get_qword(s, 460) * 5) + 2, cur_tok_val(s));
        set_qword(s, 462 + (get_qword(s, 460) * 5) + 3, cur_tok_offset(s));
        set_qword(s, 462 + (get_qword(s, 460) * 5) + 4, cur_tok_len(s));
        set_qword(s, 460, get_qword(s, 460) + 1);

        # Skip over the statement now so the rest of the function compiles normally:
        if cur_tok_kind(s) == TOKEN_LBRACE {
            advance_token(s); # skip '{'
            ci = 1;
            while (ci > 0) & (cur_tok_kind(s) != TOKEN_EOF) {
                if cur_tok_kind(s) == TOKEN_LBRACE { ci = ci + 1; }
                if cur_tok_kind(s) == TOKEN_RBRACE { ci = ci - 1; }
                advance_token(s);
            }
        } else {
            while (cur_tok_kind(s) != TOKEN_SEMICOLON) & (cur_tok_kind(s) != TOKEN_EOF) {
                advance_token(s);
            }
            if cur_tok_kind(s) == TOKEN_SEMICOLON {
                advance_token(s); # skip ';'
            }
        }
        return 0;
    }

    if k == TOKEN_LBRACE {
        advance_token(s);
        while (cur_tok_kind(s) != TOKEN_RBRACE) & (cur_tok_kind(s) != TOKEN_EOF) {
            parse_stmt(s);
            if get_qword(s, 7) < 0 { return 0; }
        }
        expect(s, TOKEN_RBRACE);
        return 0;
    }

    # 1. let ident [: type] [= expr]; or mut ident [: type] [= expr];
    if (k == TOKEN_KW_LET) | (k == TOKEN_KW_MUT) {
        advance_token(s);
        if cur_tok_kind(s) == TOKEN_LPAREN {
            advance_token(s); # skip '('
            let ci = 0;
            while (cur_tok_kind(s) != TOKEN_RPAREN) & (cur_tok_kind(s) != TOKEN_EOF) {
                let offset = cur_tok_offset(s);
                let slen = cur_tok_len(s);
                let hash = hash_token(src, offset, slen);
                expect(s, TOKEN_IDENT);
                if get_qword(s, 7) < 0 { return 0; }
                set_qword(s, 240 + ci, hash);
                ci = ci + 1;
                if cur_tok_kind(s) == TOKEN_COMMA {
                    advance_token(s);
                }
            }
            expect(s, TOKEN_RPAREN);
            expect(s, TOKEN_EQUAL);
            let total_d = ci;
            let val_t = parse_expr(s);
            if get_qword(s, 7) < 0 { return 0; }
            expect(s, TOKEN_SEMICOLON);

            let l = get_qword(s, 4);
            if total_d == 2 {
                let hash = get_qword(s, 240);
                let slot = var_tbl_get(tbl, hash, 1);
                if slot == 0 {
                    let cur_bytes = get_qword(s, 20);
                    slot = cur_bytes + 8;
                    set_qword(s, 20, slot);
                    var_tbl_add(tbl, hash, slot, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
                }
                l = emit_store_slot_typed(code_buf, l, slot, TYPE_I64);

                hash = get_qword(s, 241);
                slot = var_tbl_get(tbl, hash, 1);
                if slot == 0 {
                    let cur_bytes = get_qword(s, 20);
                    slot = cur_bytes + 8;
                    set_qword(s, 20, slot);
                    var_tbl_add(tbl, hash, slot, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
                }
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 208); # mov rax, rdx
                l = emit_store_slot_typed(code_buf, l, slot, TYPE_I64);
                set_qword(s, 4, l);
                return 0;
            }

            let cur_bytes = get_qword(s, 20);
            let slot = cur_bytes + 8;
            set_qword(s, 20, slot);
            var_tbl_add(tbl, 999965000 + slot, slot, TYPE_PTR, TYPE_NONE, PROV_STACK_LOCAL, 0);
            l = emit_store_slot_typed(code_buf, l, slot, TYPE_PTR);
            ci = 0;
            while ci < total_d {
                let hash = get_qword(s, 240 + ci);
                let slot_idx = var_tbl_get(tbl, hash, 1);
                if slot_idx == 0 {
                    cur_bytes = get_qword(s, 20);
                    slot_idx = cur_bytes + 8;
                    set_qword(s, 20, slot_idx);
                    var_tbl_add(tbl, hash, slot_idx, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
                }
                l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 199);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 71);
                l = emit_byte(code_buf, l, ci * 8);
                l = emit_store_slot_typed(code_buf, l, slot_idx, TYPE_I64);
                ci = ci + 1;
            }
            set_qword(s, 4, l);
            return 0;
        }
        if cur_tok_kind(s) == TOKEN_LBRACKET {
            advance_token(s); # skip '['
            let ci = 0;
            while (cur_tok_kind(s) != TOKEN_RBRACKET) & (cur_tok_kind(s) != TOKEN_EOF) {
                let offset = cur_tok_offset(s);
                let slen = cur_tok_len(s);
                let hash = hash_token(src, offset, slen);
                expect(s, TOKEN_IDENT);
                if get_qword(s, 7) < 0 { return 0; }
                set_qword(s, 240 + ci, hash);
                ci = ci + 1;
                if cur_tok_kind(s) == TOKEN_COMMA {
                    advance_token(s);
                }
            }
            expect(s, TOKEN_RBRACKET);
            expect(s, TOKEN_EQUAL);
            if cur_tok_kind(s) == TOKEN_LBRACKET {
                advance_token(s); # skip '['
                let total_d = ci;
                ci = 0;
                while ci < total_d {
                    let val_t = parse_expr(s);
                    if get_qword(s, 7) < 0 { return 0; }
                    let hash = get_qword(s, 240 + ci);
                    let slot_idx = var_tbl_get(tbl, hash, 1);
                    if slot_idx == 0 {
                        let cur_bytes = get_qword(s, 20);
                        slot_idx = cur_bytes + 8;
                        set_qword(s, 20, slot_idx);
                        var_tbl_add(tbl, hash, slot_idx, val_t, TYPE_NONE, PROV_STACK_LOCAL, 0);
                    }
                    let l = get_qword(s, 4);
                    l = emit_store_slot_typed(code_buf, l, slot_idx, val_t);
                    set_qword(s, 4, l);
                    ci = ci + 1;
                    if ci < total_d {
                        expect(s, TOKEN_COMMA);
                        if get_qword(s, 7) < 0 { return 0; }
                    }
                }
                expect(s, TOKEN_RBRACKET);
                expect(s, TOKEN_SEMICOLON);
                return 0;
            }
            let val_t = parse_expr(s);
            if get_qword(s, 7) < 0 { return 0; }
            expect(s, TOKEN_SEMICOLON);

            let cur_bytes = get_qword(s, 20);
            let slot = cur_bytes + 8;
            set_qword(s, 20, slot);
            var_tbl_add(tbl, 999960000 + slot, slot, TYPE_PTR, TYPE_NONE, PROV_STACK_LOCAL, 0);

            let l = get_qword(s, 4);
            l = emit_store_slot_typed(code_buf, l, slot, TYPE_PTR);

            let total_d = ci;
            ci = 0;
            while ci < total_d {
                let hash = get_qword(s, 240 + ci);
                let slot_idx = var_tbl_get(tbl, hash, 1);
                if slot_idx == 0 {
                    cur_bytes = get_qword(s, 20);
                    slot_idx = cur_bytes + 8;
                    set_qword(s, 20, slot_idx);
                    var_tbl_add(tbl, hash, slot_idx, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
                }
                l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 199);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 71);
                l = emit_byte(code_buf, l, ci * 8);
                l = emit_store_slot_typed(code_buf, l, slot_idx, TYPE_I64);
                ci = ci + 1;
            }
            set_qword(s, 4, l);
            return 0;
        }

        let offset = cur_tok_offset(s);
        let slen = cur_tok_len(s);
        let hash = hash_token(src, offset, slen);
        expect(s, TOKEN_IDENT);

        let decl_type = TYPE_NONE;
        let annotated_pointee = TYPE_NONE;
        let annotated_len = 0;
        if cur_tok_kind(s) == TOKEN_COLON {
            advance_token(s);
            decl_type = parse_type(s);
            if (decl_type == TYPE_PTR) | (decl_type == TYPE_OPTION) | (decl_type == TYPE_RESULT) | (decl_type == TYPE_TUPLE) {
                annotated_pointee = get_qword(s, 14);
                annotated_len = get_qword(s, 19);
            }
            if decl_type == TYPE_ARRAY {
                annotated_pointee = get_qword(s, 14);
                annotated_len = get_qword(s, 19);
            }
            if decl_type == TYPE_VOID {
                if cur_tok_kind(s) != TOKEN_EQUAL {
                    set_qword(s, 7, -37); # Variables cannot be void
                    return 0;
                }
            }
        }

        # Case A: Array declaration
        if decl_type == TYPE_ARRAY {
            let elem_type = annotated_pointee;
            let arr_len = annotated_len;
            let elem_sz = type_size(elem_type);
            if elem_type >= TYPE_STRUCT {
                elem_sz = struct_tbl_get_meta(tbl, elem_type - TYPE_STRUCT, 1);
            }
            let total_bytes = elem_sz * arr_len;
            let alloc_bytes = ((total_bytes + 7) / 8) * 8;
            let slot = var_tbl_get(tbl, hash, 1);
            if slot == 0 {
                let cur_bytes = get_qword(s, 20);
                slot = cur_bytes + alloc_bytes;
                set_qword(s, 20, slot);
                var_tbl_add(tbl, hash, slot, decl_type, elem_type, PROV_STACK_LOCAL, arr_len);
            }

            # Check if zero-initialized: let arr: [T; N];
            if cur_tok_kind(s) == TOKEN_SEMICOLON {
                advance_token(s);
                let l = get_qword(s, 4);
                l = emit_zero_bytes(code_buf, l, slot, total_bytes);
                set_qword(s, 4, l);
                return 0;
            }

            expect(s, TOKEN_EQUAL);
            if get_qword(s, 7) < 0 { return 0; }

            # Initializer list: [e0, e1, ...]
            if cur_tok_kind(s) == TOKEN_LBRACKET {
                advance_token(s); # skip '['
                let elem_idx = 0;
                while elem_idx < arr_len {
                    if cur_tok_kind(s) == TOKEN_RBRACKET {
                        # Too few elements!
                        set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                        return 0;
                    }
                    let elem_expr_t = parse_expr(s);
                    if get_qword(s, 7) < 0 { return 0; }
                    if type_is_compatible(elem_type, elem_expr_t) == 0 {
                        set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                        return 0;
                    }
                    let elem_slot = slot - (elem_idx * elem_sz);
                    let l = get_qword(s, 4);
                    l = emit_store_slot_typed(code_buf, l, elem_slot, elem_type);
                    set_qword(s, 4, l);
                    elem_idx = elem_idx + 1;
                    if elem_idx < arr_len {
                        if cur_tok_kind(s) == TOKEN_RBRACKET {
                            set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                            return 0;
                        }
                        expect(s, TOKEN_COMMA);
                        if get_qword(s, 7) < 0 { return 0; }
                    }
                }
                if cur_tok_kind(s) == TOKEN_COMMA {
                    advance_token(s);
                }
                if cur_tok_kind(s) != TOKEN_RBRACKET {
                    # Too many elements!
                    set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                    return 0;
                }
                expect(s, TOKEN_RBRACKET);
                if get_qword(s, 7) < 0 { return 0; }
                expect(s, TOKEN_SEMICOLON);
                return 0;
            }

            # Array value copy: let b: [T; N] = a;
            let expr_type = parse_expr(s);
            if get_qword(s, 7) < 0 { return 0; }
            if expr_type != TYPE_ARRAY {
                set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                return 0;
            }
            let src_elem_t = get_qword(s, 14);
            let src_len = get_qword(s, 19);
            if src_elem_t != elem_type {
                set_qword(s, 7, -40);
                return 0;
            }
            if src_len != arr_len {
                set_qword(s, 7, -40);
                return 0;
            }
            let copy_elem_sz = type_size(src_elem_t);
            if src_elem_t >= TYPE_STRUCT {
                copy_elem_sz = struct_tbl_get_meta(tbl, src_elem_t - TYPE_STRUCT, 1);
            }
            let copy_total_bytes = copy_elem_sz * src_len;
            let l = get_qword(s, 4);
            l = emit_copy_bytes(code_buf, l, slot, copy_total_bytes);
            set_qword(s, 4, l);
            expect(s, TOKEN_SEMICOLON);
            return 0;
        }

        # Case C: Struct declaration
        if decl_type >= TYPE_STRUCT {
            let struct_id = decl_type - TYPE_STRUCT;
            let total_bytes = struct_tbl_get_meta(tbl, struct_id, 1);
            let alloc_bytes = ((total_bytes + 7) / 8) * 8;
            let slot = var_tbl_get(tbl, hash, 1);
            if slot == 0 {
                let cur_bytes = get_qword(s, 20);
                slot = cur_bytes + alloc_bytes;
                set_qword(s, 20, slot);
                var_tbl_add(tbl, hash, slot, decl_type, struct_id, PROV_STACK_LOCAL, 0);
            }

            # Check if zero-initialized: let pt: Point;
            if cur_tok_kind(s) == TOKEN_SEMICOLON {
                advance_token(s);
                let l = get_qword(s, 4);
                l = emit_zero_bytes(code_buf, l, slot, total_bytes);
                set_qword(s, 4, l);
                return 0;
            }

            expect(s, TOKEN_EQUAL);
            if get_qword(s, 7) < 0 { return 0; }

            # Struct value copy: let b: Point = a;
            let expr_type = parse_expr(s);
            if get_qword(s, 7) < 0 { return 0; }
            if expr_type != decl_type {
                set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                return 0;
            }
            let l = get_qword(s, 4);
            l = emit_copy_bytes(code_buf, l, slot, total_bytes);
            set_qword(s, 4, l);
            expect(s, TOKEN_SEMICOLON);
            return 0;
        }

        # Case B: Scalar or Pointer declaration
        expect(s, TOKEN_EQUAL);

        if decl_type == TYPE_NONE {
            if cur_tok_kind(s) == TOKEN_LBRACKET {
                advance_token(s); # skip '['
                let elem_count = 0;
                let elem_type = TYPE_I64;
                if cur_tok_kind(s) != TOKEN_RBRACKET {
                    let e0_t = parse_expr(s);
                    if get_qword(s, 7) < 0 { return 0; }
                    if e0_t == TYPE_INT_LIT { elem_type = TYPE_I64; }
                    else { elem_type = e0_t; }
                    parser_push_rax(s);
                    elem_count = 1;
                    while cur_tok_kind(s) == TOKEN_COMMA {
                        advance_token(s);
                        if cur_tok_kind(s) != TOKEN_RBRACKET {
                            let en_t = parse_expr(s);
                            if get_qword(s, 7) < 0 { return 0; }
                            if type_is_compatible(elem_type, en_t) == 0 {
                                set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                                return 0;
                            }
                            parser_push_rax(s);
                            elem_count = elem_count + 1;
                        }
                    }
                }
                expect(s, TOKEN_RBRACKET);
                let elem_sz = type_size(elem_type);
                let total_bytes = elem_sz * elem_count;
                let alloc_bytes = ((total_bytes + 7) / 8) * 8;
                let cur_bytes = get_qword(s, 20);
                let slot = cur_bytes + alloc_bytes;
                set_qword(s, 20, slot);
                var_tbl_add(tbl, hash, slot, TYPE_ARRAY, elem_type, PROV_STACK_LOCAL, elem_count);

                let elem_idx = elem_count - 1;
                while elem_idx >= 0 {
                    parser_pop_reg(s, 88); # pop rax
                    let elem_slot = slot - (elem_idx * elem_sz);
                    let l = get_qword(s, 4);
                    l = emit_store_slot_typed(code_buf, l, elem_slot, elem_type);
                    set_qword(s, 4, l);
                    elem_idx = elem_idx - 1;
                }
                expect(s, TOKEN_SEMICOLON);
                return 0;
            }
        }

        let let_mark_l = get_qword(s, 4);
        set_qword(s, 27, 0);
        let expr_type = parse_expr(s);
        if get_qword(s, 7) < 0 {
            return 0;
        }
        if decl_type != TYPE_NONE {
            if type_is_compatible(decl_type, expr_type) == 0 {
                set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                return 0;
            }
        } else {
            if expr_type == TYPE_INT_LIT {
                decl_type = TYPE_I64;
            } else {
                if expr_type == TYPE_FLOAT_LIT {
                    decl_type = TYPE_F64;
                } else {
                    decl_type = expr_type;
                }
            }
        }

        if decl_type >= TYPE_STRUCT {
            let s_id = decl_type - TYPE_STRUCT;
            let tot_bytes = struct_tbl_get_meta(tbl, s_id, 1);
            let alc_bytes = ((tot_bytes + 7) / 8) * 8;
            let slot = var_tbl_get(tbl, hash, 1);
            if slot == 0 {
                let cur_bytes = get_qword(s, 20);
                slot = cur_bytes + alc_bytes;
                set_qword(s, 20, slot);
                var_tbl_add(tbl, hash, slot, decl_type, s_id, PROV_STACK_LOCAL, 0);
            }
            let l = get_qword(s, 4);
            l = emit_copy_bytes(code_buf, l, slot, tot_bytes);
            set_qword(s, 4, l);
            expect(s, TOKEN_SEMICOLON);
            return 0;
        }

        if decl_type == TYPE_TUPLE {
            let elem_count = get_qword(s, 19);
            if annotated_len > 0 { elem_count = annotated_len; }
            if elem_count > 2 {
                let tot_bytes = elem_count * 8;
                let slot = var_tbl_get(tbl, hash, 1);
                if slot == 0 {
                    let cur_bytes = get_qword(s, 20);
                    slot = cur_bytes + tot_bytes;
                    set_qword(s, 20, slot);
                    var_tbl_add(tbl, hash, slot, decl_type, get_qword(s, 14), get_qword(s, 18), elem_count);
                }
                let l = get_qword(s, 4);
                l = emit_copy_bytes(code_buf, l, slot, tot_bytes);
                set_qword(s, 4, l);
                expect(s, TOKEN_SEMICOLON);
                return 0;
            }
        }

        let p_pointee = TYPE_NONE;
        let p_prov = PROV_UNKNOWN;
        if decl_type == TYPE_PTR {
            p_pointee = get_qword(s, 14);
            if annotated_pointee != TYPE_NONE {
                p_pointee = annotated_pointee;
            }
            p_prov = get_qword(s, 15);
        }
        if decl_type == TYPE_STR {
            p_pointee = TYPE_U8;
            p_prov = get_qword(s, 15);
        }
        if decl_type == TYPE_TUPLE {
            p_pointee = get_qword(s, 14);
            if annotated_pointee != TYPE_NONE {
                p_pointee = annotated_pointee;
            }
            p_prov = get_qword(s, 18);
            if annotated_len > 0 {
                elem_count = annotated_len;
            } else {
                elem_count = get_qword(s, 19);
                if elem_count == 0 { elem_count = 2; }
            }
        }

        let slot = var_tbl_get(tbl, hash, 1);
        if slot == 0 {
            let cur_bytes = get_qword(s, 20);
            let alc_sz = 8;
            if (decl_type == TYPE_OPTION) | (decl_type == TYPE_RESULT) | (decl_type == TYPE_TUPLE) {
                alc_sz = 16;
                if decl_type == TYPE_TUPLE {
                    if elem_count > 2 { alc_sz = elem_count * 8; }
                }
            }
            slot = cur_bytes + alc_sz;
            set_qword(s, 20, slot);
            var_tbl_add(tbl, hash, slot, decl_type, p_pointee, p_prov, elem_count);
        } else {
            var_tbl_set_metadata(tbl, hash, p_pointee, p_prov, elem_count);
        }

        let is_dead_local = 0;
        let slot_idx = (slot / 8) % 128;
        let fn_idx = get_qword(s, 16);
        let round = get_qword(s, 28);
        if get_qword(s, 22) == 1 {
            if round > 0 {
                let is_used = get_byte(tbl, 400000 + (fn_idx * 128) + slot_idx);
                if is_used == 0 {
                    if get_qword(s, 27) == 0 {
                        is_dead_local = 1;
                    }
                }
            }
        }

        if is_dead_local == 1 {
            set_qword(s, 4, let_mark_l);
            set_qword(tbl, 110000 + (slot_idx * 2), 0);
            let r_cnt = get_qword(tbl, 10380);
            let ri = 0;
            while ri < r_cnt {
                let r_slot = get_qword(tbl, 10381 + ri);
                let cur_c = get_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + r_slot);
                if cur_c > 0 {
                    if cur_c < 250 {
                        set_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + r_slot, cur_c - 1);
                    }
                }
                ri = ri + 1;
            }
        } else {
            let l = get_qword(s, 4);
            if decl_type != expr_type {
                l = emit_cast(code_buf, l, expr_type, decl_type);
            }
            l = emit_store_slot_typed(code_buf, l, slot, decl_type);
            set_qword(s, 4, l);
            if get_qword(s, 22) == 1 {
                if get_qword(s, 24) == 1 {
                    let is_scalar = 0;
                    if decl_type == TYPE_BOOL { is_scalar = 1; }
                    if type_is_integer(decl_type) == 1 { is_scalar = 1; }
                    if is_scalar == 1 {
                        set_qword(tbl, 110000 + (slot_idx * 2), 1);
                        set_qword(tbl, 110000 + (slot_idx * 2) + 1, get_qword(s, 25));
                    } else {
                        set_qword(tbl, 110000 + (slot_idx * 2), 0);
                    }
                } else {
                    set_qword(tbl, 110000 + (slot_idx * 2), 0);
                }
            } else {
                set_qword(tbl, 110000 + (slot_idx * 2), 0);
            }
        }
        expect(s, TOKEN_SEMICOLON);
        return 0;
    }

    # 2. return [expr];
    if k == TOKEN_KW_RETURN {
        advance_token(s);
        let cur_ret_t = get_qword(s, 13);
        if cur_ret_t == TYPE_VOID {
            # Void function must not return a non-void expression
            if cur_tok_kind(s) == TOKEN_LPAREN {
                advance_token(s);
                expect(s, TOKEN_RPAREN);
            }
            if cur_tok_kind(s) != TOKEN_SEMICOLON {
                set_qword(s, 7, -41); # ERR_TYPE_MISMATCH_RETURN
                return 0;
            }
        } else {
            # Non-void function must return a matching expression
            if cur_tok_kind(s) == TOKEN_SEMICOLON {
                set_qword(s, 7, -41); # ERR_TYPE_MISMATCH_RETURN
                return 0;
            }
            let expr_t = parse_expr(s);
            if get_qword(s, 7) < 0 {
                return 0;
            }
            if cur_ret_t >= TYPE_STRUCT {
                set_qword(s, 7, -41); # ERR_TYPE_MISMATCH_RETURN
                return 0;
            }
            if expr_t >= TYPE_STRUCT {
                set_qword(s, 7, -41); # ERR_TYPE_MISMATCH_RETURN
                return 0;
            }
            if type_is_compatible(cur_ret_t, expr_t) == 0 {
                set_qword(s, 7, -41); # ERR_TYPE_MISMATCH_RETURN
                return 0;
            }
            if cur_ret_t == TYPE_PTR {
                let expr_prov = get_qword(s, 15);
                if expr_prov == PROV_STACK_LOCAL {
                    set_qword(s, 7, -46); # ERR_STACK_ESCAPE
                    return 0;
                }
                let cur_fn_idx = get_qword(s, 16);
                let expr_pointee = get_qword(s, 14);
                func_tbl_set_ret_metadata(tbl, cur_fn_idx, expr_pointee, expr_prov);
            }
            if cur_ret_t == TYPE_STR {
                let expr_prov = get_qword(s, 15);
                if expr_prov == PROV_STACK_LOCAL {
                    set_qword(s, 7, -46); # ERR_STACK_ESCAPE
                    return 0;
                }
            }
        }
        let l = get_qword(s, 4);
        l = emit_jmp_rel32(code_buf, l, 0); # placeholder to epilogue
        epilogue_patches_add(tbl, l - 4);
        set_qword(s, 4, l);
        set_qword(s, 26, 1);
        expect(s, TOKEN_SEMICOLON);
        return 0;
    }

    # 3. if cond { then } [else { else }]
    if k == TOKEN_KW_IF {
        let ci = 0;
        while ci < 256 {
            set_qword(tbl, 110000 + ci, 0);
            ci = ci + 1;
        }
        advance_token(s);
        let cond_mark_l = get_qword(s, 4);
        set_qword(s, 27, 0);
        let cond_t = parse_expr(s);
        if get_qword(s, 7) < 0 {
            return 0;
        }
        if cond_t != TYPE_BOOL {
            if type_is_integer(cond_t) == 0 {
                set_qword(s, 7, -43);
                return 0;
            }
        }

        let is_const_branch = 0;
        let branch_val = 0;
        if get_qword(s, 22) == 1 {
            if get_qword(s, 24) == 1 {
                is_const_branch = 1;
                branch_val = get_qword(s, 25);
            }
        }

        if is_const_branch == 1 {
            # Constant condition pruning: roll back mov rax, imm emitted for cond
            set_qword(s, 4, cond_mark_l);
            let prev_term = get_qword(s, 26);

            if branch_val != 0 {
                # CONSTANT TRUE: then-branch always executes, else-branch is dead
                expect(s, TOKEN_LBRACE);
                set_qword(s, 26, 0);
                while is_block_end(s) == 0 {
                    let term = get_qword(s, 26);
                    if term == 1 {
                        let code_mark = get_qword(s, 4);
                        let epilogue_mark = get_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX);
                        let call_patch_mark = get_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX);
                        let stack_mark = get_qword(s, 12);
                        parse_stmt(s);
                        set_qword(s, 4, code_mark);
                        set_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX, epilogue_mark);
                        set_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX, call_patch_mark);
                        set_qword(s, 12, stack_mark);
                    } else {
                        parse_stmt(s);
                    }
                }
                if get_qword(s, 7) < 0 { return 0; }
                expect(s, TOKEN_RBRACE);
                let then_term = get_qword(s, 26);

                if cur_tok_kind(s) == TOKEN_KW_ELSE {
                    advance_token(s); # skip 'else'
                    if cur_tok_kind(s) == TOKEN_KW_IF {
                        let code_mark = get_qword(s, 4);
                        let epilogue_mark = get_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX);
                        let call_patch_mark = get_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX);
                        let stack_mark = get_qword(s, 12);
                        parse_stmt(s);
                        set_qword(s, 4, code_mark);
                        set_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX, epilogue_mark);
                        set_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX, call_patch_mark);
                        set_qword(s, 12, stack_mark);
                    } else {
                        expect(s, TOKEN_LBRACE);
                        while is_block_end(s) == 0 {
                            let code_mark = get_qword(s, 4);
                            let epilogue_mark = get_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX);
                            let call_patch_mark = get_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX);
                            let stack_mark = get_qword(s, 12);
                            parse_stmt(s);
                            set_qword(s, 4, code_mark);
                            set_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX, epilogue_mark);
                            set_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX, call_patch_mark);
                            set_qword(s, 12, stack_mark);
                        }
                        if get_qword(s, 7) < 0 { return 0; }
                        expect(s, TOKEN_RBRACE);
                    }
                }
                if then_term == 1 {
                    set_qword(s, 26, 1);
                } else {
                    set_qword(s, 26, prev_term);
                }
            } else {
                # CONSTANT FALSE: then-branch is dead, else-branch always executes
                expect(s, TOKEN_LBRACE);
                while is_block_end(s) == 0 {
                    let code_mark = get_qword(s, 4);
                    let epilogue_mark = get_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX);
                    let call_patch_mark = get_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX);
                    let stack_mark = get_qword(s, 12);
                    parse_stmt(s);
                    set_qword(s, 4, code_mark);
                    set_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX, epilogue_mark);
                    set_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX, call_patch_mark);
                    set_qword(s, 12, stack_mark);
                }
                if get_qword(s, 7) < 0 { return 0; }
                expect(s, TOKEN_RBRACE);

                let else_term = 0;
                if cur_tok_kind(s) == TOKEN_KW_ELSE {
                    advance_token(s); # skip 'else'
                    if cur_tok_kind(s) == TOKEN_KW_IF {
                        parse_stmt(s);
                        else_term = get_qword(s, 26);
                    } else {
                        expect(s, TOKEN_LBRACE);
                        set_qword(s, 26, 0);
                        while is_block_end(s) == 0 {
                            let term = get_qword(s, 26);
                            if term == 1 {
                                let code_mark = get_qword(s, 4);
                                let epilogue_mark = get_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX);
                                let call_patch_mark = get_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX);
                                let stack_mark = get_qword(s, 12);
                                parse_stmt(s);
                                set_qword(s, 4, code_mark);
                                set_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX, epilogue_mark);
                                set_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX, call_patch_mark);
                                set_qword(s, 12, stack_mark);
                            } else {
                                parse_stmt(s);
                            }
                        }
                        if get_qword(s, 7) < 0 { return 0; }
                        expect(s, TOKEN_RBRACE);
                        else_term = get_qword(s, 26);
                    }
                }
                if else_term == 1 {
                    set_qword(s, 26, 1);
                } else {
                    set_qword(s, 26, prev_term);
                }
            }

            ci = 0;
            while ci < 256 {
                set_qword(tbl, 110000 + ci, 0);
                ci = ci + 1;
            }
            return 0;
        }

        # Dynamic Condition: emit normal conditional branching
        let l = get_qword(s, 4);
        l = emit_cmp_rax_zero(code_buf, l);
        l = emit_je_rel32(code_buf, l, 0); # je placeholder
        let else_patch = l - 4;
        set_qword(s, 4, l);

        expect(s, TOKEN_LBRACE);
        let prev_term2 = get_qword(s, 26);
        set_qword(s, 26, 0);
        while is_block_end(s) == 0 {
            let term = get_qword(s, 26);
            if get_qword(s, 22) == 1 {
                if term == 1 {
                    let code_mark = get_qword(s, 4);
                    let epilogue_mark = get_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX);
                    let call_patch_mark = get_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX);
                    let stack_mark = get_qword(s, 12);
                    parse_stmt(s);
                    set_qword(s, 4, code_mark);
                    set_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX, epilogue_mark);
                    set_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX, call_patch_mark);
                    set_qword(s, 12, stack_mark);
                } else {
                    parse_stmt(s);
                }
            } else {
                parse_stmt(s);
            }
        }
        if get_qword(s, 7) < 0 { return 0; }
        expect(s, TOKEN_RBRACE);
        let then_term2 = get_qword(s, 26);

        let else_term2 = 0;
        let has_else = 0;
        if cur_tok_kind(s) == TOKEN_KW_ELSE {
            has_else = 1;
            advance_token(s);
            l = get_qword(s, 4);
            l = emit_jmp_rel32(code_buf, l, 0); # jmp placeholder
            let end_patch = l - 4;
            emit_backpatch32(code_buf, else_patch, l);
            set_qword(s, 4, l);

            if cur_tok_kind(s) == TOKEN_KW_IF {
                parse_stmt(s);
                else_term2 = get_qword(s, 26);
            } else {
                expect(s, TOKEN_LBRACE);
                set_qword(s, 26, 0);
                while is_block_end(s) == 0 {
                    let term = get_qword(s, 26);
                    if get_qword(s, 22) == 1 {
                        if term == 1 {
                            let code_mark = get_qword(s, 4);
                            let epilogue_mark = get_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX);
                            let call_patch_mark = get_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX);
                            let stack_mark = get_qword(s, 12);
                            parse_stmt(s);
                            set_qword(s, 4, code_mark);
                            set_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX, epilogue_mark);
                            set_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX, call_patch_mark);
                            set_qword(s, 12, stack_mark);
                        } else {
                            parse_stmt(s);
                        }
                    } else {
                        parse_stmt(s);
                    }
                }
                if get_qword(s, 7) < 0 { return 0; }
                expect(s, TOKEN_RBRACE);
                else_term2 = get_qword(s, 26);
            }

            l = get_qword(s, 4);
            emit_backpatch32(code_buf, end_patch, l);
        } else {
            l = get_qword(s, 4);
            emit_backpatch32(code_buf, else_patch, l);
        }

        if has_else == 1 {
            if then_term2 == 1 {
                if else_term2 == 1 {
                    set_qword(s, 26, 1);
                } else {
                    set_qword(s, 26, prev_term2);
                }
            } else {
                set_qword(s, 26, prev_term2);
            }
        } else {
            set_qword(s, 26, prev_term2);
        }

        ci = 0;
        while ci < 256 {
            set_qword(tbl, 110000 + ci, 0);
            ci = ci + 1;
        }
        return 0;
    }

    # 4a. for ident in start..end { body }
    if k == TOKEN_KW_FOR {
        let ci = 0;
        while ci < 256 {
            set_qword(tbl, 110000 + ci, 0);
            ci = ci + 1;
        }
        advance_token(s); # skip 'for'
        let var_offset = cur_tok_offset(s);
        let var_len = cur_tok_len(s);
        let var_hash = hash_token(src, var_offset, var_len);
        expect(s, TOKEN_IDENT);
        set_qword(s, 230, 0); # has_idx = 0
        set_qword(s, 231, 0); # idx_hash = 0
        if cur_tok_kind(s) == TOKEN_COMMA {
            advance_token(s); # skip ','
            set_qword(s, 230, 1); # has_idx = 1
            set_qword(s, 231, var_hash); # idx_hash = first identifier
            var_offset = cur_tok_offset(s);
            var_len = cur_tok_len(s);
            var_hash = hash_token(src, var_offset, var_len);
            expect(s, TOKEN_IDENT);
        }
        let in_len = cur_tok_len(s);
        let in_off = cur_tok_offset(s);
        let is_in = 0;
        if in_len == 2 {
            if get_byte(src, in_off) == 105 {
                if get_byte(src, in_off + 1) == 110 {
                    is_in = 1;
                }
            }
        }
        if is_in == 0 {
            set_qword(s, 7, -1);
            return 0;
        }
        advance_token(s); # skip contextual 'in'

        let start_t = parse_expr(s);
        if get_qword(s, 7) < 0 { return 0; }

        if cur_tok_kind(s) == TOKEN_DOT_DOT {
            let var_slot = var_tbl_get(tbl, var_hash, 1);
            if var_slot == 0 {
                let cur_bytes = get_qword(s, 20);
                var_slot = cur_bytes + 8;
                set_qword(s, 20, var_slot);
                var_tbl_add(tbl, var_hash, var_slot, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
            }
            let l = get_qword(s, 4);
            l = emit_store_slot_typed(code_buf, l, var_slot, TYPE_I64);
            set_qword(s, 4, l);

            expect(s, TOKEN_DOT_DOT);
            let end_t = parse_expr(s);
            if get_qword(s, 7) < 0 { return 0; }

            let limit_slot = var_tbl_get(tbl, var_hash + 999983, 1);
            if limit_slot == 0 {
                let cur_bytes2 = get_qword(s, 20);
                limit_slot = cur_bytes2 + 8;
                set_qword(s, 20, limit_slot);
                var_tbl_add(tbl, var_hash + 999983, limit_slot, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
            }
            l = get_qword(s, 4);
            l = emit_store_slot_typed(code_buf, l, limit_slot, TYPE_I64);
            set_qword(s, 4, l);

            let loop_start = get_qword(s, 4);
            let loop_depth = get_qword(s, 21);
            set_qword(s, 21, loop_depth + 1);
            set_qword(s, 30 + loop_depth, loop_start);
            set_qword(s, 50 + loop_depth, 0);

            # Emit condition check: i < limit
            l = emit_load_slot_typed(code_buf, loop_start, var_slot, TYPE_I64);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 193);
            l = emit_load_slot_typed(code_buf, l, limit_slot, TYPE_I64);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 57); l = emit_byte(code_buf, l, 193);
            l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 141);
            l = emit_disp32(code_buf, l, 0);
            let exit_patch = l - 4;
            set_qword(s, 4, l);

            expect(s, TOKEN_LBRACE);
            while is_block_end(s) == 0 {
                parse_stmt(s);
                if get_qword(s, 7) < 0 {
                    set_qword(s, 21, loop_depth);
                    return 0;
                }
            }
            expect(s, TOKEN_RBRACE);
            set_qword(s, 21, loop_depth);

            l = get_qword(s, 4);
            l = emit_load_slot_typed(code_buf, l, var_slot, TYPE_I64);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 192);
            l = emit_store_slot_typed(code_buf, l, var_slot, TYPE_I64);

            let loop_disp = loop_start - (l + 5);
            l = emit_jmp_rel32(code_buf, l, loop_disp);
            emit_backpatch32(code_buf, exit_patch, l);

            let b_cnt = get_qword(s, 50 + loop_depth);
            let bi = 0;
            while bi < b_cnt {
                let b_patch = get_qword(s, 100 + (loop_depth * 32) + bi);
                emit_backpatch32(code_buf, b_patch, l);
                bi = bi + 1;
            }
            set_qword(s, 4, l);
            return 0;
        } else {
            let elem_t = get_qword(s, 14);
            if elem_t == TYPE_NONE { elem_t = TYPE_I64; }
            let arr_len = get_qword(s, 19);
            if arr_len == 0 { arr_len = 4; }

            let cur_bytes = get_qword(s, 20);
            let slot = cur_bytes + 8;
            let slot_idx = cur_bytes + 16;
            let limit_slot = cur_bytes + 24;
            set_qword(s, 20, cur_bytes + 24);

            var_tbl_add(tbl, var_hash + 999981, slot, TYPE_PTR, TYPE_NONE, PROV_STACK_LOCAL, 0);
            var_tbl_add(tbl, var_hash + 999982, slot_idx, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
            var_tbl_add(tbl, var_hash + 999983, limit_slot, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);

            let l = get_qword(s, 4);
            l = emit_store_slot_typed(code_buf, l, slot, TYPE_PTR);
            l = emit_mov_imm64(code_buf, l, 0, 0);
            l = emit_store_slot_typed(code_buf, l, slot_idx, TYPE_I64);
            l = emit_mov_imm64(code_buf, l, 0, arr_len);
            l = emit_store_slot_typed(code_buf, l, limit_slot, TYPE_I64);
            set_qword(s, 4, l);

            let var_slot = var_tbl_get(tbl, var_hash, 1);
            if var_slot == 0 {
                cur_bytes = get_qword(s, 20);
                var_slot = cur_bytes + 8;
                set_qword(s, 20, var_slot);
                var_tbl_add(tbl, var_hash, var_slot, elem_t, TYPE_NONE, PROV_STACK_LOCAL, 0);
            }
            if get_qword(s, 230) == 1 {
                ci = var_tbl_get(tbl, get_qword(s, 231), 1);
                if ci == 0 {
                    cur_bytes = get_qword(s, 20);
                    ci = cur_bytes + 8;
                    set_qword(s, 20, ci);
                    var_tbl_add(tbl, get_qword(s, 231), ci, TYPE_I64, TYPE_NONE, PROV_STACK_LOCAL, 0);
                }
            }

            let loop_start = get_qword(s, 4);
            let loop_depth = get_qword(s, 21);
            set_qword(s, 21, loop_depth + 1);
            set_qword(s, 30 + loop_depth, loop_start);
            set_qword(s, 50 + loop_depth, 0);

            l = emit_load_slot_typed(code_buf, loop_start, slot_idx, TYPE_I64);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 193);
            l = emit_load_slot_typed(code_buf, l, limit_slot, TYPE_I64);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 57); l = emit_byte(code_buf, l, 193);
            l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 141);
            l = emit_disp32(code_buf, l, 0);
            let exit_patch = l - 4;

            l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 199);
            l = emit_load_slot_typed(code_buf, l, slot_idx, TYPE_I64);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 4); l = emit_byte(code_buf, l, 247);
            l = emit_store_slot_typed(code_buf, l, var_slot, elem_t);
            if get_qword(s, 230) == 1 {
                ci = var_tbl_get(tbl, get_qword(s, 231), 1);
                l = emit_load_slot_typed(code_buf, l, slot_idx, TYPE_I64);
                l = emit_store_slot_typed(code_buf, l, ci, TYPE_I64);
            }
            set_qword(s, 4, l);

            expect(s, TOKEN_LBRACE);
            while is_block_end(s) == 0 {
                parse_stmt(s);
                if get_qword(s, 7) < 0 {
                    set_qword(s, 21, loop_depth);
                    return 0;
                }
            }
            expect(s, TOKEN_RBRACE);
            set_qword(s, 21, loop_depth);

            l = get_qword(s, 4);
            l = emit_load_slot_typed(code_buf, l, slot_idx, TYPE_I64);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 255); l = emit_byte(code_buf, l, 192);
            l = emit_store_slot_typed(code_buf, l, slot_idx, TYPE_I64);

            let loop_disp = loop_start - (l + 5);
            l = emit_jmp_rel32(code_buf, l, loop_disp);
            emit_backpatch32(code_buf, exit_patch, l);

            let b_cnt = get_qword(s, 50 + loop_depth);
            let bi = 0;
            while bi < b_cnt {
                let b_patch = get_qword(s, 100 + (loop_depth * 32) + bi);
                emit_backpatch32(code_buf, b_patch, l);
                bi = bi + 1;
            }
            set_qword(s, 4, l);
            return 0;
        }
    }

    # 4. while cond { body }
    if k == TOKEN_KW_WHILE {
        let ci = 0;
        while ci < 256 {
            set_qword(tbl, 110000 + ci, 0);
            ci = ci + 1;
        }
        advance_token(s);
        let loop_start = get_qword(s, 4);
        let loop_depth = get_qword(s, 21);
        set_qword(s, 21, loop_depth + 1);
        set_qword(s, 30 + loop_depth, loop_start);
        set_qword(s, 50 + loop_depth, 0);

        let cond_t = parse_expr(s);
        if get_qword(s, 7) < 0 {
            set_qword(s, 21, loop_depth);
            return 0;
        }
        if cond_t != TYPE_BOOL {
            if type_is_integer(cond_t) == 0 {
                set_qword(s, 7, -43);
                set_qword(s, 21, loop_depth);
                return 0;
            }
        }
        let l = get_qword(s, 4);
        l = emit_cmp_rax_zero(code_buf, l);
        l = emit_je_rel32(code_buf, l, 0); # exit placeholder
        let exit_patch = l - 4;
        set_qword(s, 4, l);

        expect(s, TOKEN_LBRACE);
        let prev_term3 = get_qword(s, 26);
        set_qword(s, 26, 0);
        while is_block_end(s) == 0 {
            let term = get_qword(s, 26);
            if get_qword(s, 22) == 1 {
                if term == 1 {
                    let code_mark = get_qword(s, 4);
                    let epilogue_mark = get_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX);
                    let call_patch_mark = get_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX);
                    let stack_mark = get_qword(s, 12);
                    parse_stmt(s);
                    set_qword(s, 4, code_mark);
                    set_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX, epilogue_mark);
                    set_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX, call_patch_mark);
                    set_qword(s, 12, stack_mark);
                } else {
                    parse_stmt(s);
                }
            } else {
                parse_stmt(s);
            }
            if get_qword(s, 7) < 0 {
                set_qword(s, 21, loop_depth);
                return 0;
            }
        }
        set_qword(s, 26, prev_term3);
        if get_qword(s, 7) < 0 {
            set_qword(s, 21, loop_depth);
            return 0;
        }
        expect(s, TOKEN_RBRACE);
        if get_qword(s, 7) < 0 {
            set_qword(s, 21, loop_depth);
            return 0;
        }

        l = get_qword(s, 4);
        let disp = loop_start - (l + 5);
        l = emit_jmp_rel32(code_buf, l, disp);
        emit_backpatch32(code_buf, exit_patch, l);

        let b_cnt = get_qword(s, 50 + loop_depth);
        let bi = 0;
        while bi < b_cnt {
            let b_patch = get_qword(s, 100 + (loop_depth * 32) + bi);
            emit_backpatch32(code_buf, b_patch, l);
            bi = bi + 1;
        }

        ci = 0;
        while ci < 256 {
            set_qword(tbl, 110000 + ci, 0);
            ci = ci + 1;
        }
        set_qword(s, 21, loop_depth);
        set_qword(s, 4, l);
        return 0;
    }

    # 4b. break;
    if k == TOKEN_KW_BREAK {
        advance_token(s);
        expect(s, TOKEN_SEMICOLON);
        let d = get_qword(s, 21);
        if d <= 0 {
            set_qword(s, 7, -52); # ERR_BREAK_OUTSIDE_LOOP
            return 0;
        }
        let cur_d = d - 1;
        let b_cnt = get_qword(s, 50 + cur_d);
        let l = get_qword(s, 4);
        l = emit_jmp_rel32(code_buf, l, 0);
        let patch_off = l - 4;
        if b_cnt < 32 {
            set_qword(s, 100 + (cur_d * 32) + b_cnt, patch_off);
            set_qword(s, 50 + cur_d, b_cnt + 1);
        }
        set_qword(s, 4, l);
        set_qword(s, 26, 1);
        return 0;
    }

    # 4c. continue;
    if k == TOKEN_KW_CONTINUE {
        advance_token(s);
        expect(s, TOKEN_SEMICOLON);
        let d = get_qword(s, 21);
        if d <= 0 {
            set_qword(s, 7, -53); # ERR_CONTINUE_OUTSIDE_LOOP
            return 0;
        }
        let cur_d = d - 1;
        let loop_start = get_qword(s, 30 + cur_d);
        let l = get_qword(s, 4);
        let disp = loop_start - (l + 5);
        l = emit_jmp_rel32(code_buf, l, disp);
        set_qword(s, 4, l);
        set_qword(s, 26, 1);
        return 0;
    }

    # 5. ident = expr; (Assignment) or Statement-level Call
    if k == TOKEN_IDENT {
        let offset = cur_tok_offset(s);
        let slen = cur_tok_len(s);
        let hash = hash_token(src, offset, slen);

        if (hash == 210724587794) | (hash == 229479076111340) { # print or println
            advance_token(s); # skip 'print' / 'println'
            let is_nl = 0;
            if hash == 229479076111340 { is_nl = 1; }
            let has_paren = 0;
            if cur_tok_kind(s) == TOKEN_LPAREN {
                has_paren = 1;
                advance_token(s);
            }
            if (cur_tok_kind(s) == TOKEN_SEMICOLON) | (cur_tok_kind(s) == TOKEN_RPAREN) {
                if has_paren == 1 {
                    expect(s, TOKEN_RPAREN);
                    if get_qword(s, 7) < 0 { return 0; }
                }
                expect(s, TOKEN_SEMICOLON);
                if is_nl == 1 {
                    let l = get_qword(s, 4);
                    l = emit_byte(code_buf, l, 106); l = emit_byte(code_buf, l, 10);
                    l = emit_byte(code_buf, l, 184); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
                    l = emit_byte(code_buf, l, 191); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 230);
                    l = emit_byte(code_buf, l, 186); l = emit_byte(code_buf, l, 1); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
                    l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 5);
                    l = emit_byte(code_buf, l, 88);
                    set_qword(s, 4, l);
                }
                return 0;
            }
            let val_t = parse_expr(s);
            if get_qword(s, 7) < 0 { return 0; }
            if has_paren == 1 {
                expect(s, TOKEN_RPAREN);
                if get_qword(s, 7) < 0 { return 0; }
            }
            expect(s, TOKEN_SEMICOLON);
            let l = get_qword(s, 4);
            l = emit_print_val_rax(code_buf, l, val_t, is_nl);
            set_qword(s, 4, l);
            return 0;
        }

        let saved_pos = get_qword(s, 2);
        let tok_buf = get_qword(s, 6);
        let saved_kind = get_qword(tok_buf, 0);
        let saved_val = get_qword(tok_buf, 1);
        let saved_off = get_qword(tok_buf, 2);
        let saved_len = get_qword(tok_buf, 3);

        advance_token(s);
        if cur_tok_kind(s) == TOKEN_DOT {
            let slot = var_tbl_get(tbl, hash, 1);
            if slot == 0 {
                set_qword(s, 7, -2);
                return 0;
            }
            let slot_idx = (slot / 8) % 128;
            let fn_idx = get_qword(s, 16);
            set_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + slot_idx, 1);
            let var_t = var_tbl_get(tbl, hash, 2);
            let p_pointee = var_tbl_get(tbl, hash, 3);
            let p_prov = var_tbl_get(tbl, hash, 4);
            let curr_struct_id = -1;
            let l = get_qword(s, 4);
            if var_t >= TYPE_STRUCT {
                if p_prov == PROV_STACK_LOCAL {
                    l = emit_lea_slot(code_buf, l, slot);
                } else {
                    l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
                }
                curr_struct_id = var_t - TYPE_STRUCT;
            } else {
                if var_t == TYPE_PTR {
                    if p_pointee >= TYPE_STRUCT {
                        l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
                        curr_struct_id = p_pointee - TYPE_STRUCT;
                    }
                }
            }
            if curr_struct_id < 0 {
                set_qword(s, 7, -51);
                return 0;
            }
            set_qword(s, 4, l);

            let done = 0;
            while done == 0 {
                if cur_tok_kind(s) != TOKEN_DOT {
                    set_qword(s, 7, -51);
                    return 0;
                }
                advance_token(s); # skip '.'
                if cur_tok_kind(s) != TOKEN_IDENT {
                    set_qword(s, 7, -51);
                    return 0;
                }
                let f_hash = hash_token(src, cur_tok_offset(s), cur_tok_len(s));
                advance_token(s);
                let f_idx = struct_tbl_find_field(tbl, curr_struct_id, f_hash);
                if f_idx < 0 {
                    set_qword(s, 7, -51); # ERR_UNKNOWN_FIELD
                    return 0;
                }
                let f_type = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 1);
                let f_pointee2 = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 2);
                let f_off = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 3);
                let f_sz = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 4);
                let f_arr_len = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 5);

                if cur_tok_kind(s) == TOKEN_DOT {
                    l = get_qword(s, 4);
                    if f_type >= TYPE_STRUCT {
                        l = emit_add_rax_imm32(code_buf, l, f_off);
                        curr_struct_id = f_type - TYPE_STRUCT;
                    } else {
                        if f_type == TYPE_PTR {
                            if f_pointee2 >= TYPE_STRUCT {
                                l = emit_field_load_typed(code_buf, l, f_off, TYPE_PTR);
                                curr_struct_id = f_pointee2 - TYPE_STRUCT;
                            } else {
                                set_qword(s, 7, -51);
                                return 0;
                            }
