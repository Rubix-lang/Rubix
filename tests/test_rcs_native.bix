    else { rcs_test_println("  FAIL 24: Golden - :root selector preservation"); fail = fail + 1; }

    # Test 25
    if test_golden_no_duplicate_flex() { rcs_test_println("  PASS 25: Golden - Duplicate flex suppression"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 25: Golden - Duplicate flex suppression"); fail = fail + 1; }

    # Test 26
    if test_bug1_keyframe_dedup() { rcs_test_println("  PASS 26: BUG-1 Keyframe deduplication"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 26: BUG-1 Keyframe deduplication"); fail = fail + 1; }

    # Test 27
    if test_bug2_selector_merging() { rcs_test_println("  PASS 27: BUG-2 Same selector rule merging"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 27: BUG-2 Same selector rule merging"); fail = fail + 1; }

    # Test 28
    if test_bug3_animation_comma_composed() { rcs_test_println("  PASS 28: BUG-3 Comma-composed animations"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 28: BUG-3 Comma-composed animations"); fail = fail + 1; }

    # Test 29
    if test_bug4_trigger_pseudo_mapping() { rcs_test_println("  PASS 29: BUG-4 Trigger-to-pseudo mapping (focus, active)"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 29: BUG-4 Trigger-to-pseudo mapping (focus, active)"); fail = fail + 1; }

    # Test 30
    if test_bug5_when_state_rules_preserved() { rcs_test_println("  PASS 30: BUG-5 'when' state rules preserved with comment"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 30: BUG-5 'when' state rules preserved with comment"); fail = fail + 1; }

    # Test 31
    if test_bug6_once_iteration() { rcs_test_println("  PASS 31: BUG-6 'once' iteration emits '1 forwards'"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 31: BUG-6 'once' iteration emits '1 forwards'"); fail = fail + 1; }

    # Test 32
