# ==============================================================================
# Rubix Control Style (RCS) Native Test Suite (rubix/tests/test_rcs_native.bix)
# Replaces the deleted Python test_rcs_engine.py with native Rubix tests.
# Exercises: lexer, parser, resolver, bake, and emit_css modules.
# ==============================================================================

# ==============================================================================
# Rubix Standard Library: Core Assertions & Utilities (std/core.bix)
# Canonical assertions, identity, and fundamental primitives.
# ==============================================================================

fn identity(x: i64): i64 = x;

fn assert_true(cond: bool): i64 {
    if cond { return 0; }
    return -1;
}

fn assert_false(cond: bool): i64 {
    if cond == false { return 0; }
    return -1;
}

fn assert_eq_int(actual: i64, expected: i64): i64 {
    if actual == expected { return 0; }
    return -1;
}

fn assert_eq_str(actual: str, expected: str): i64 {
    if actual == expected { return 0; }
    return -1;
}
# ==============================================================================
# Rubix Standard Library: String Operations (std/string.bix)
# Pure native string predicates, slicing, trimming, formatting, and conversion.
# ==============================================================================

fn string_is_empty(s: str): bool =
    string_length(s) == 0;

fn string_starts_with(s: str, prefix: str): bool {
    let s_len = string_length(s);
    let p_len = string_length(prefix);
    if p_len > s_len { return false; }
    let i = 0;
    while i < p_len {
        if s[i] != prefix[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn string_ends_with(s: str, suffix: str): bool {
    let s_len = string_length(s);
    let suf_len = string_length(suffix);
    if suf_len > s_len { return false; }
    let offset = s_len - suf_len;
    let i = 0;
    while i < suf_len {
        if s[offset + i] != suffix[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn string_index_of(s: str, needle: str): i64 {
    let s_len = string_length(s);
    let n_len = string_length(needle);
    if n_len == 0 { return 0; }
    if n_len > s_len { return -1; }
    let i = 0;
    while i <= (s_len - n_len) {
        let match_ok = 1;
        let j = 0;
        while j < n_len {
            if s[i + j] != needle[j] {
                match_ok = 0;
            }
            j = j + 1;
        }
        if match_ok == 1 { return i; }
        i = i + 1;
    }
    return -1;
}

fn string_contains(s: str, needle: str): bool =
    string_index_of(s, needle) >= 0;

fn string_slice(s: str, start: i64, len: i64): str {
    let s_len = string_length(s);
    if (start < 0) | (start >= s_len) { return ""; }
    let real_len = len;
    if (start + real_len) > s_len {
        real_len = s_len - start;
    }
    if real_len <= 0 { return ""; }
    let buf = alloc_buffer(real_len + 1) as *u8;
    let i = 0;
    while i < real_len {
        buf[i] = s[start + i];
        i = i + 1;
    }
    buf[real_len] = 0 as u8;
    let res = string_from_raw(buf);
    free_buffer(buf as ptr, real_len + 1);
    return res;
}

fn string_trim(s: str): str {
    let s_len = string_length(s);
    if s_len == 0 { return ""; }
    let start = 0;
    while (start < s_len) & ((s[start] == (32 as u8)) | (s[start] == (9 as u8)) | (s[start] == (10 as u8)) | (s[start] == (13 as u8))) {
        start = start + 1;
    }
    if start >= s_len { return ""; }
    let end = s_len - 1;
    while (end > start) & ((s[end] == (32 as u8)) | (s[end] == (9 as u8)) | (s[end] == (10 as u8)) | (s[end] == (13 as u8))) {
        end = end - 1;
    }
    let trimmed_len = (end - start) + 1;
    return string_slice(s, start, trimmed_len);
}

fn string_repeat(s: str, count: i64): str {
    if count <= 0 { return ""; }
    let res = "";
    let i = 0;
    while i < count {
        res = res + s;
        i = i + 1;
    }
    return res;
}

fn int_to_str(val: i64): str {
    if val == 0 { return "0"; }
    let is_neg = 0;
    let v = val;
    if v < 0 {
        is_neg = 1;
        v = 0 - v;
    }
    let temp = v;
    let digits = 0;
    while temp > 0 {
        digits = digits + 1;
        temp = temp / 10;
    }
    let total_len = if is_neg == 1 { digits + 1 } else { digits };
    let buf = alloc_buffer(total_len + 1) as *u8;
    buf[total_len] = 0 as u8;
    let idx = total_len - 1;
    while v > 0 {
        let digit = v % 10;
        buf[idx] = (48 + digit) as u8;
        idx = idx - 1;
        v = v / 10;
    }
    if is_neg == 1 {
        buf[0] = 45 as u8;
    }
    let res = string_from_raw(buf);
    free_buffer(buf as ptr, total_len + 1);
    return res;
}

fn string_to_upper(s: str): str {
    let l = string_length(s);
    if l == 0 { return ""; }
    let buf = alloc_buffer(l + 1) as *u8;
    let i = 0;
    while i < l {
        let b = s[i];
        if (b >= (97 as u8)) & (b <= (122 as u8)) {
            buf[i] = (b - (32 as u8)) as u8;
        } else {
            buf[i] = b;
        }
        i = i + 1;
    }
    buf[l] = 0 as u8;
    let res = string_from_raw(buf);
    free_buffer(buf as ptr, l + 1);
    return res;
}

fn string_to_lower(s: str): str {
    let l = string_length(s);
    if l == 0 { return ""; }
    let buf = alloc_buffer(l + 1) as *u8;
    let i = 0;
    while i < l {
        let b = s[i];
        if (b >= (65 as u8)) & (b <= (90 as u8)) {
            buf[i] = (b + (32 as u8)) as u8;
        } else {
            buf[i] = b;
        }
        i = i + 1;
    }
    buf[l] = 0 as u8;
    let res = string_from_raw(buf);
    free_buffer(buf as ptr, l + 1);
    return res;
}

fn string_replace_char(s: str, from_c: u8, to_c: u8): str {
    let l = string_length(s);
    if l == 0 { return ""; }
    let buf = alloc_buffer(l + 1) as *u8;
    let i = 0;
    while i < l {
        let b = s[i];
        if b == from_c {
            buf[i] = to_c;
        } else {
            buf[i] = b;
        }
        i = i + 1;
    }
    buf[l] = 0 as u8;
    let res = string_from_raw(buf);
    free_buffer(buf as ptr, l + 1);
    return res;
}

fn string_parse_int(s: str): i64 {
    let l = string_length(s);
    if l == 0 { return 0; }
    let i = 0;
    let is_neg = 0;
    if s[0] == (45 as u8) {
        is_neg = 1;
        i = 1;
    }
    let res = 0;
    while i < l {
        let b = s[i];
        if (b >= (48 as u8)) & (b <= (57 as u8)) {
            let digit = (b - (48 as u8)) as i64;
            res = (res * 10) + digit;
        } else {
            i = l;
        }
        i = i + 1;
    }
    if is_neg == 1 {
        return 0 - res;
    }
    return res;
}

fn string_char_at(s: str, idx: i64): u8 {
    let l = string_length(s);
    if (idx < 0) | (idx >= l) { return 0 as u8; }
    return s[idx];
}

fn string_from_int(val: i64): str {
    return "" + val;
}

# ==============================================================================
# Webbix Web IR — Core Domain Types (webbix/ir/types.bix)
# Pure Rubix domain types for native Web IR compilation.
# Zero HTML or CSS dependencies.
#
# Foundational type system for the entire Webbix framework.
# Every semantic web concept maps to a typed enum value.
# Each enum has <= 32 variants (Rubix compiler enum table capacity).
# ==============================================================================

# ------------------------------------------------------------------------------
# Semantic Node Kinds (Core HTML5 Semantic Coverage, max 32 variants)
# ------------------------------------------------------------------------------
enum WebKind {
    App,
    Page,
    Header,
    Nav,
    NavLink,
    Main,
    Hero,
    Title,
    Heading,
    Text,
    Paragraph,
    Button,
    StatsGrid,
    StatCard,
    Section,
    Article,
    Aside,
    Grid,
    Flex,
    ProjectCard,
    Card,
    Badge,
    Form,
    Label,
    Input,
    Footer,
    List,
    ListItem,
    Table,
    Image,
    Modal,
    EscapeHatch
}

# Extended node kinds represented as typed integer constants (0 overhead)
let WEB_KIND_TABS     = 32;
let WEB_KIND_PROGRESS = 33;
let WEB_KIND_SPINNER  = 34;
let WEB_KIND_DIVIDER  = 35;
let WEB_KIND_TOAST    = 36;
let WEB_KIND_TIMELINE = 37;

