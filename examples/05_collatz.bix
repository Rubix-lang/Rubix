# The Collatz Conjecture (3n + 1 problem) in Rubix.
# Demonstrates while-loops, branch conditions, and tracking mutable state.
# Run with: rubix run examples/05_collatz_conjecture.bix

fn collatz_steps(start: Integer): Integer {
    mut n = start
    mut steps = 0

    loop n > 1 {
        if n % 2 == 0 {
            # If n is even, divide by 2
            n = n / 2
        } else {
            # If n is odd, multiply by 3 and add 1
            n = (n * 3) + 1
        }
        steps = steps + 1
    }

    steps
}

fn main(): Integer {
    print "Collatz sequence steps for 6:"
    print collatz_steps(6)

    print "Collatz sequence steps for 19:"
    print collatz_steps(19)

    print "Collatz sequence steps for 27:"
    print collatz_steps(27)

    0
}
