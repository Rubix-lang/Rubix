    else { rcs_test_println("  FAIL 38: Motion triggers & reduced-motion a11y wrap"); fail = fail + 1; }

    rcs_test_println("");
    let summary = "Results: " + rcs_int_to_str(pass) + "/" + rcs_int_to_str(total) + " passed, " + rcs_int_to_str(fail) + " failed";
    rcs_test_println(summary);

    if fail > 0 { return 1; }
    return 0;
}

