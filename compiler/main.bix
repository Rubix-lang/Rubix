        return l;
    }

    # Comparisons: cmp rax, rcx (48 39 C8) followed by setcc al; movzx rax, al
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 57);
    l = emit_byte(buf, l, 200);

    let cc_byte = 148; # sete (0x94)
    if op == TOKEN_EQUAL_EQUAL { cc_byte = 148; }
    if op == TOKEN_NOT_EQUAL   { cc_byte = 149; } # setne (0x95)
    if op == TOKEN_LESS        { cc_byte = 156; } # setl (0x9C)
    if op == TOKEN_GREATER     { cc_byte = 159; } # setg (0x9F)
    if op == TOKEN_LESS_EQ     { cc_byte = 158; } # setle (0x9E)
    if op == TOKEN_GREATER_EQ  { cc_byte = 157; } # setge (0x9D)

    l = emit_byte(buf, l, 15);
    l = emit_byte(buf, l, cc_byte);
    l = emit_byte(buf, l, 192); # setcc al (0F cc C0)

    # movzx rax, al (48 0F B6 C0)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 15);
    l = emit_byte(buf, l, 182);
    l = emit_byte(buf, l, 192);
    return l;
}

fn emit_cast(buf: i64, len: i64, src_t: i64, dst_t: i64): i64 {
    let l = len;
    if src_t == dst_t {
        return l;
    }
    if src_t == TYPE_PTR {
        if dst_t == TYPE_PTR {
            return l; # Pointer-to-pointer cast is identity in RAX
        }
        if dst_t == TYPE_I64 {
            return l; # Pointer-to-i64 cast is identity in RAX
        }
    }
    if dst_t == TYPE_PTR {
        if (src_t == TYPE_I64) | (src_t == TYPE_INT_LIT) {
            return l; # i64-to-pointer cast is identity in RAX
        }
    }

    if dst_t == TYPE_F64 {
        if (src_t == TYPE_I64) | (src_t == TYPE_INT_LIT) {
            # cvtsi2sd xmm0, rax (F2 48 0F 2A C0)
