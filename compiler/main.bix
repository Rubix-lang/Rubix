            l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 110); l = emit_byte(buf, l, 192);
            # cvttss2si rax, xmm0 (F3 48 0F 2C C0)
            l = emit_byte(buf, l, 243); l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 44); l = emit_byte(buf, l, 192);
            return l;
        }
        if (src_t == TYPE_I32) | (src_t == TYPE_CHAR) {
            # movsxd rax, eax (48 63 C0)
            l = emit_byte(buf, l, 72);
            l = emit_byte(buf, l, 99);
            l = emit_byte(buf, l, 192);
            return l;
        }
        if src_t == TYPE_U8 {
            # movzx eax, al (0F B6 C0)
