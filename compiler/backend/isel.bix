# isel.bix - x86-64 instruction selection mapping AST/TIR to machine instructions


fn isel_emit_builtin_buffer(buf: i64, len: i64, is_free: i64, is_page: i64): i64 {
    let l = len;
    if is_free == 1 {
        # mov rax, 11 (48 C7 C0 0B 00 00 00)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 192);
        l = emit_byte(buf, l, 11); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0);
        # syscall (0F 05)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 5);
        return l;
    }
    if is_page == 1 {
        # xor rdi, rdi (48 31 FF)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 255);
        # mov rsi, 4096 (48 C7 C6 00 10 00 00)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 198);
        l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 16); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0);
    } else {
        # mov rsi, rdi (48 89 FE)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 254);
        # xor rdi, rdi (48 31 FF)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 255);
    }
    # mov rdx, 3 (48 C7 C2 03 00 00 00) - PROT_READ | PROT_WRITE
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 194);
    l = emit_byte(buf, l, 3); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0);
    # mov r10, 0x22 (49 C7 C2 22 00 00 00) - MAP_PRIVATE | MAP_ANONYMOUS
    l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 194);
    l = emit_byte(buf, l, 34); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0);
    # mov r8, -1 (49 C7 C0 FF FF FF FF)
    l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 192);
    l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 255);
    # xor r9, r9 (4D 31 C9)
    l = emit_byte(buf, l, 77); l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 201);
    # mov rax, 9 (48 C7 C0 09 00 00 00)
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 192);
    l = emit_byte(buf, l, 9); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0);
    # syscall (0F 05)
    l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 5);
    return l;
}

fn isel_emit_builtin_mem_access(buf: i64, len: i64, is_set: i64, is_qword: i64): i64 {
    let l = len;
    if is_set == 1 {
        if is_qword == 1 {
            # mov qword ptr [rdi + rsi*8], rdx (48 89 14 F7)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 20); l = emit_byte(buf, l, 247);
            return l;
        }
        # mov [rdi + rsi], dl (88 14 37)
        l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 20); l = emit_byte(buf, l, 55);
        return l;
    }
    if is_qword == 1 {
        # mov rax, qword ptr [rdi + rsi*8] (48 8B 04 F7)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 247);
        return l;
    }
    # movzx rax, byte ptr [rdi + rsi] (48 0F B6 04 37)
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 55);
    return l;
}

fn isel_emit_syscall(buf: i64, len: i64, nr: i64): i64 {
    let l = len;
    # mov rax, nr (48 C7 C0 nr 00 00 00)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 199);
    l = emit_byte(buf, l, 192);
    l = emit_disp32(buf, l, nr);
    # syscall (0F 05)
    l = emit_byte(buf, l, 15);
    l = emit_byte(buf, l, 5);
    return l;
}

fn emit_patch_rel8(buf: i64, patch_pos: i64, target_pos: i64): i64 {
    let disp = target_pos - (patch_pos + 1);
    if disp < 0 { disp = disp + 256; }
    set_byte(buf, patch_pos, disp % 256);
    return 0;
}

fn isel_emit_builtin_string(buf: i64, len: i64, name_hash: i64): i64 {
    let l = len;
    if name_hash == 4604361535797710365 { # string_length
        # test rdi, rdi (48 85 FF)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 133); l = emit_byte(buf, l, 255);
            # jz .L_null (74 disp8)
            let p_null = l + 1;
            l = emit_byte(buf, l, 116); l = emit_byte(buf, l, 0);
            # mov rax, [rdi] (48 8B 07)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 7);
            # jmp .L_done (EB disp8)
            let p_done = l + 1;
            l = emit_byte(buf, l, 235); l = emit_byte(buf, l, 0);
            # .L_null:
            let l_null = l;
            emit_patch_rel8(buf, p_null, l_null);
            # xor eax, eax (31 C0)
            l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 192);
            # .L_done:
            let l_done = l;
            emit_patch_rel8(buf, p_done, l_done);
            return l;
    }
    if (name_hash == 4369978079523077955) | (name_hash == 229461282205997) { # string_byte_at / byte_at
        # test rdi, rdi (48 85 FF)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 133); l = emit_byte(buf, l, 255);
            # jz .L_trap (74 disp8)
            let p_trap1 = l + 1;
            l = emit_byte(buf, l, 116); l = emit_byte(buf, l, 0);
            # cmp rsi, [rdi] (48 3B 37)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 59); l = emit_byte(buf, l, 55);
            # jb .L_ok (72 disp8)
            let p_ok = l + 1;
            l = emit_byte(buf, l, 114); l = emit_byte(buf, l, 0);
            # .L_trap:
            let l_trap = l;
            emit_patch_rel8(buf, p_trap1, l_trap);
            # ud2 (0F 0B)
            l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 11);
            # .L_ok:
            let l_ok = l;
            emit_patch_rel8(buf, p_ok, l_ok);
            # movzx eax, byte ptr [rdi + rsi + 8] (48 0F B6 44 37 08)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182);
            l = emit_byte(buf, l, 68); l = emit_byte(buf, l, 55); l = emit_byte(buf, l, 8);
            return l;
    }
    if name_hash == -2655435116151803629 { # string_equal
        # cmp rdi, rsi (48 39 F7)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 57); l = emit_byte(buf, l, 247);
            # je .L_true (74 disp8)
            let p_true1 = l + 1;
            l = emit_byte(buf, l, 116); l = emit_byte(buf, l, 0);
        
            # test rdi, rdi (48 85 FF)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 133); l = emit_byte(buf, l, 255);
            # jz .L_false (74 disp8)
            let p_false1 = l + 1;
            l = emit_byte(buf, l, 116); l = emit_byte(buf, l, 0);
        
            # test rsi, rsi (48 85 F6)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 133); l = emit_byte(buf, l, 246);
            # jz .L_false (74 disp8)
            let p_false2 = l + 1;
            l = emit_byte(buf, l, 116); l = emit_byte(buf, l, 0);
        
            # mov rcx, [rdi] (48 8B 0F)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 15);
            # cmp rcx, [rsi] (48 3B 0E)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 59); l = emit_byte(buf, l, 14);
            # jne .L_false (75 disp8)
            let p_false3 = l + 1;
            l = emit_byte(buf, l, 117); l = emit_byte(buf, l, 0);
        
            # test rcx, rcx (48 85 C9)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 133); l = emit_byte(buf, l, 201);
            # jz .L_true (74 disp8)
            let p_true2 = l + 1;
            l = emit_byte(buf, l, 116); l = emit_byte(buf, l, 0);
        
            # xor edx, edx (31 D2) - rdx is index
            l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 210);
        
            # .L_loop:
            let l_loop = l;
            # mov r8b, [rdi + rdx + 8] (44 8A 44 17 08)
            l = emit_byte(buf, l, 68); l = emit_byte(buf, l, 138); l = emit_byte(buf, l, 68);
            l = emit_byte(buf, l, 23); l = emit_byte(buf, l, 8);
        
            # cmp r8b, [rsi + rdx + 8] (44 38 44 16 08)
            l = emit_byte(buf, l, 68); l = emit_byte(buf, l, 56); l = emit_byte(buf, l, 68);
            l = emit_byte(buf, l, 22); l = emit_byte(buf, l, 8);
        
            # jne .L_false (75 disp8)
            let p_false4 = l + 1;
            l = emit_byte(buf, l, 117); l = emit_byte(buf, l, 0);
        
            # inc rdx (48 FF C2)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 194);
            # cmp rdx, rcx (48 39 CA)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 57); l = emit_byte(buf, l, 202);
            # jb .L_loop (72 disp8)
            let p_loop = l + 1;
            l = emit_byte(buf, l, 114); l = emit_byte(buf, l, 0);
            emit_patch_rel8(buf, p_loop, l_loop);
        
            # .L_true:
            let l_true = l;
            emit_patch_rel8(buf, p_true1, l_true);
            emit_patch_rel8(buf, p_true2, l_true);
            # mov eax, 1 (B8 01 00 00 00)
            l = emit_byte(buf, l, 184); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 0);
            l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0);
            # jmp .L_done (EB disp8)
            let p_done = l + 1;
            l = emit_byte(buf, l, 235); l = emit_byte(buf, l, 0);
        
            # .L_false:
            let l_false = l;
            emit_patch_rel8(buf, p_false1, l_false);
            emit_patch_rel8(buf, p_false2, l_false);
            emit_patch_rel8(buf, p_false3, l_false);
            emit_patch_rel8(buf, p_false4, l_false);
            # xor eax, eax (31 C0)
            l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 192);
        
            # .L_done:
            let l_done = l;
            emit_patch_rel8(buf, p_done, l_done);
            return l;
    }
    if name_hash == 4369978080415288578 { # string_compare
        # cmp rdi, rsi (48 39 F7)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 57); l = emit_byte(buf, l, 247);
            # je .L_eq (74 disp8)
            let p_eq1 = l + 1;
            l = emit_byte(buf, l, 116); l = emit_byte(buf, l, 0);
        
            # test rdi, rdi (48 85 FF)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 133); l = emit_byte(buf, l, 255);
            # jnz .L_rdi_ok (75 disp8)
            let p_rdi_ok = l + 1;
            l = emit_byte(buf, l, 117); l = emit_byte(buf, l, 0);
            # rdi is null and rsi is not null -> return -1 (mov rax, -1)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 192);
            l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 255);
            # jmp .L_done (EB disp8)
            let p_done1 = l + 1;
            l = emit_byte(buf, l, 235); l = emit_byte(buf, l, 0);
        
            # .L_rdi_ok:
            let l_rdi_ok = l;
            emit_patch_rel8(buf, p_rdi_ok, l_rdi_ok);
            # test rsi, rsi (48 85 F6)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 133); l = emit_byte(buf, l, 246);
            # jnz .L_both_ok (75 disp8)
            let p_both_ok = l + 1;
            l = emit_byte(buf, l, 117); l = emit_byte(buf, l, 0);
            # rsi is null and rdi is not null -> return 1 (mov eax, 1)
            l = emit_byte(buf, l, 184); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 0);
            l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0);
            # jmp .L_done
            let p_done2 = l + 1;
            l = emit_byte(buf, l, 235); l = emit_byte(buf, l, 0);
        
            # .L_both_ok:
            let l_both_ok = l;
            emit_patch_rel8(buf, p_both_ok, l_both_ok);
            # mov rcx, [rdi] (len_a) (48 8B 0F)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 15);
            # mov rdx, [rsi] (len_b) (48 8B 16)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 22);
            # min_len in r8: r8 = rcx
            # mov r8, rcx (49 89 C8)
            l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 200);
            # cmp r8, rdx (49 39 D0)
            l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 57); l = emit_byte(buf, l, 208);
            # jbe .L_min_ok (76 disp8)
            let p_min_ok = l + 1;
            l = emit_byte(buf, l, 118); l = emit_byte(buf, l, 0);
            # mov r8, rdx (49 89 D0)
            l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 208);
            # .L_min_ok:
            let l_min_ok = l;
            emit_patch_rel8(buf, p_min_ok, l_min_ok);
        
            # xor r9d, r9d (45 31 C9) - loop counter
            l = emit_byte(buf, l, 69); l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 201);
        
            # .L_loop:
            let l_loop = l;
            # cmp r9, r8 (4D 39 C1)
            l = emit_byte(buf, l, 77); l = emit_byte(buf, l, 57); l = emit_byte(buf, l, 193);
            # jae .L_lens (73 disp8)
            let p_lens = l + 1;
            l = emit_byte(buf, l, 115); l = emit_byte(buf, l, 0);
        
            # movzx eax, byte ptr [rdi + r9 + 8] (42 0F B6 44 0F 08)
            l = emit_byte(buf, l, 66); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182);
            l = emit_byte(buf, l, 68); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 8);
        
            # movzx r10d, byte ptr [rsi + r9 + 8] (46 0F B6 54 0E 08)
            l = emit_byte(buf, l, 70); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182);
            l = emit_byte(buf, l, 84); l = emit_byte(buf, l, 14); l = emit_byte(buf, l, 8);
        
            # cmp eax, r10d (44 39 D0)
            l = emit_byte(buf, l, 68); l = emit_byte(buf, l, 57); l = emit_byte(buf, l, 208);
            # jne .L_diff (75 disp8)
            let p_diff = l + 1;
            l = emit_byte(buf, l, 117); l = emit_byte(buf, l, 0);
        
            # inc r9 (49 FF C1)
            l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 193);
            # jmp .L_loop (EB disp8)
            let p_loop = l + 1;
            l = emit_byte(buf, l, 235); l = emit_byte(buf, l, 0);
            emit_patch_rel8(buf, p_loop, l_loop);
        
            # .L_lens: prefix matched, compare lengths (len_a - len_b)
            let l_lens = l;
            emit_patch_rel8(buf, p_lens, l_lens);
            # mov rax, rcx (48 89 C8)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 200);
            # sub rax, rdx (48 29 D0)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 41); l = emit_byte(buf, l, 208);
            # jmp .L_done
            let p_done3 = l + 1;
            l = emit_byte(buf, l, 235); l = emit_byte(buf, l, 0);
        
            # .L_diff: byte difference (rax = eax - r10d)
            let l_diff = l;
            emit_patch_rel8(buf, p_diff, l_diff);
            # sub rax, r10 (4C 29 D0)
            l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 41); l = emit_byte(buf, l, 208);
            # jmp .L_done
            let p_done4 = l + 1;
            l = emit_byte(buf, l, 235); l = emit_byte(buf, l, 0);
        
            # .L_eq:
            let l_eq = l;
            emit_patch_rel8(buf, p_eq1, l_eq);
            # xor eax, eax
            l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 192);
        
            # .L_done:
            let l_done = l;
            emit_patch_rel8(buf, p_done1, l_done);
            emit_patch_rel8(buf, p_done2, l_done);
            emit_patch_rel8(buf, p_done3, l_done);
            emit_patch_rel8(buf, p_done4, l_done);
            return l;
    }
    if name_hash == 4604361535457346067 { # string_concat
        # Check nulls and get len_a in r8, len_b in r9
            # r8 = 0
            l = emit_byte(buf, l, 77); l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 192); # xor r8, r8
            # test rdi, rdi
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 133); l = emit_byte(buf, l, 255);
            # jz .L_rdi_null
            let p_null_a = l + 1;
            l = emit_byte(buf, l, 116); l = emit_byte(buf, l, 0);
            # mov r8, [rdi] (4C 8B 07)
            l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 7);
            # .L_rdi_null:
            let l_null_a = l;
            emit_patch_rel8(buf, p_null_a, l_null_a);
        
            # r9 = 0
            l = emit_byte(buf, l, 77); l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 201); # xor r9, r9
            # test rsi, rsi
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 133); l = emit_byte(buf, l, 246);
            # jz .L_rsi_null
            let p_null_b = l + 1;
            l = emit_byte(buf, l, 116); l = emit_byte(buf, l, 0);
            # mov r9, [rsi] (4C 8B 0E)
            l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 14);
            # .L_rsi_null:
            let l_null_b = l;
            emit_patch_rel8(buf, p_null_b, l_null_b);
        
            # total_len in r10 = r8 + r9
            l = emit_byte(buf, l, 77); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 194); # mov r10, r8
            l = emit_byte(buf, l, 77); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 202);   # add r10, r9
        
            # Save rdi, rsi, r8, r9, r10 across mmap
            l = emit_byte(buf, l, 87); # push rdi
            l = emit_byte(buf, l, 86); # push rsi
            l = emit_byte(buf, l, 65); l = emit_byte(buf, l, 80); # push r8
            l = emit_byte(buf, l, 65); l = emit_byte(buf, l, 81); # push r9
            l = emit_byte(buf, l, 65); l = emit_byte(buf, l, 82); # push r10
        
            # sys_mmap(0, r10 + 16, PROT_READ|WRITE, MAP_PRIVATE|ANON, -1, 0)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 255); # xor rdi, rdi
            l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 214); # mov rsi, r10
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 198); l = emit_byte(buf, l, 16); # add rsi, 16
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 194);
            l = emit_byte(buf, l, 3); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); # mov rdx, 3
            l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 194);
            l = emit_byte(buf, l, 34); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); # mov r10, 34
            l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 192);
            l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 255); # mov r8, -1
            l = emit_byte(buf, l, 77); l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 201); # xor r9, r9
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 199); l = emit_byte(buf, l, 192);
            l = emit_byte(buf, l, 9); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); # mov rax, 9
            l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 5); # syscall
        
