            let imm12 = imm & 4095;
            return mach_emit_u32(code_buf, cur, 19 | (imm12 << 20) | (dst << 7));
        }
        let imm_u32 = imm & 4294967295;
        let lo12 = imm_u32 & 4095;
        let hi20 = ((imm_u32 + 2048) >> 12) & 1048575;
        let cur1 = mach_emit_u32(code_buf, cur, 55 | (hi20 << 12) | (dst << 7));
        return mach_emit_u32(code_buf, cur1, 27 | (lo12 << 20) | (dst << 15) | (dst << 7));
    }
    if tid == 99 {
        return mach_emit_u32(code_buf, cur, 67108864 | ((dst & 255) << 24) | (imm & 16777215));
    }
    if imm == 0 {
        let p = cur;
        if dst >= 8 {
            p = mach_emit_byte(code_buf, p, x86_rex(0, dst, dst));
        }
        p = mach_emit_byte(code_buf, p, 49); # 0x31: xor r/m32, r32
        p = mach_emit_byte(code_buf, p, 192 + ((dst & 7) * 8) + (dst & 7));
