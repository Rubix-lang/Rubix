    else { rcs_test_println("  FAIL 32: BUG-7 Bare shorthand motion verb"); fail = fail + 1; }

    # Test 33
    if test_bug8_gap_injects_flex() { rcs_test_println("  PASS 33: BUG-8 'gap' auto-injects flex context"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 33: BUG-8 'gap' auto-injects flex context"); fail = fail + 1; }

    # Test 34
    if test_at_rules() { rcs_test_println("  PASS 34: At-rules (@import, @media)"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 34: At-rules (@import, @media)"); fail = fail + 1; }

    # Test 35
    if test_css_nesting() { rcs_test_println("  PASS 35: CSS nesting (& and descendant)"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 35: CSS nesting (& and descendant)"); fail = fail + 1; }

    # Test 36
    if test_important_value_resolution() { rcs_test_println("  PASS 36: !important value resolution"); pass = pass + 1; }
    else { rcs_test_println("  FAIL 36: !important value resolution"); fail = fail + 1; }

