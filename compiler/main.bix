            l = emit_byte(buf, l, 243); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 42); l = emit_byte(buf, l, 192);
            # movd eax, xmm0
            l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 126); l = emit_byte(buf, l, 192);
            return l;
        }
        if (src_t == TYPE_F64) | (src_t == TYPE_FLOAT_LIT) {
            # movq xmm0, rax (66 48 0F 6E C0)
            l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 110); l = emit_byte(buf, l, 192);
            # cvtsd2ss xmm0, xmm0 (F2 0F 5A C0)
            l = emit_byte(buf, l, 242); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 90); l = emit_byte(buf, l, 192);
            # movd eax, xmm0
            l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 126); l = emit_byte(buf, l, 192);
            return l;
