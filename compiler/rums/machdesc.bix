    if op == 23 { p = mach_emit_byte(code_buf, p, 208 + (dst & 7)); }
    return p;
}

fn mach_model_emit_cmp(model: i64, code_buf: i64, cur: i64, op: i64, dst: i64, s1: i64, s2: i64): i64 {
