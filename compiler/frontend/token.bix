# token.bix - compiler token kinds, type IDs, and error codes


# Token Kind Constants
let TOKEN_EOF = 0;
let TOKEN_KW_FN = 1;
let TOKEN_KW_RETURN = 2;
let TOKEN_TYPE_I64 = 3;
let TOKEN_IDENT = 4;
let TOKEN_INT_LIT = 5;
let TOKEN_LPAREN = 6;
let TOKEN_RPAREN = 7;
let TOKEN_LBRACE = 8;
let TOKEN_RBRACE = 9;
let TOKEN_COLON = 10;
let TOKEN_SEMICOLON = 11;

# Control flow & Operator tokens
let TOKEN_KW_IF = 12;
let TOKEN_KW_ELSE = 13;
let TOKEN_KW_WHILE = 14;
let TOKEN_KW_LET = 15;
let TOKEN_PLUS = 16;
let TOKEN_MINUS = 17;
let TOKEN_LESS = 18;
let TOKEN_GREATER = 19;
let TOKEN_EQUAL_EQUAL = 20;
let TOKEN_NOT_EQUAL = 21;
let TOKEN_EQUAL = 22;
let TOKEN_COMMA = 23;
let TOKEN_STR_LIT = 24;
let TOKEN_STAR = 25;
let TOKEN_SLASH = 26;
let TOKEN_PERCENT = 27;
let TOKEN_LESS_EQ = 28;
let TOKEN_GREATER_EQ = 29;
let TOKEN_AMP = 30;
let TOKEN_PIPE = 31;
let TOKEN_CARET = 32;
let TOKEN_SHL = 33;
let TOKEN_SHR = 34;

