# ==============================================================================
# Rubix Standard Library: Collection & Array Utilities (std/collections.bix)
# Pure native fixed-array operations, reductions, search, and predicates.
# ==============================================================================

fn sum_4(arr: [i64; 4]): i64 {
    let mut_sum = 0;
    for x in arr {
        mut_sum = mut_sum + x;
    }
    return mut_sum;
}

fn min_4(arr: [i64; 4]): i64 {
    let mut_min = arr[0];
    for x in arr {
        if x < mut_min {
            mut_min = x;
        }
    }
    return mut_min;
}

fn max_4(arr: [i64; 4]): i64 {
    let mut_max = arr[0];
    for x in arr {
        if x > mut_max {
            mut_max = x;
        }
    }
    return mut_max;
}

fn contains_4(arr: [i64; 4], target: i64): bool {
    for x in arr {
        if x == target { return true; }
    }
    return false;
}

fn find_4(arr: [i64; 4], target: i64): i64 {
    for i, x in arr {
        if x == target { return i; }
    }
    return -1;
}

fn count_4(arr: [i64; 4], target: i64): i64 {
    let mut_count = 0;
    for x in arr {
        if x == target {
            mut_count = mut_count + 1;
        }
    }
    return mut_count;
}

fn sum_8(arr: [i64; 8]): i64 {
    let mut_sum = 0;
    for x in arr {
        mut_sum = mut_sum + x;
    }
    return mut_sum;
}

fn min_8(arr: [i64; 8]): i64 {
    let mut_min = arr[0];
    for x in arr {
        if x < mut_min {
            mut_min = x;
        }
    }
    return mut_min;
}

fn max_8(arr: [i64; 8]): i64 {
    let mut_max = arr[0];
    for x in arr {
        if x > mut_max {
            mut_max = x;
        }
    }
    return mut_max;
}

fn contains_8(arr: [i64; 8], target: i64): bool {
    for x in arr {
        if x == target { return true; }
    }
    return false;
}

fn find_8(arr: [i64; 8], target: i64): i64 {
    for i, x in arr {
        if x == target { return i; }
    }
    return -1;
}

fn first_4(arr: [i64; 4]): i64 =
    arr[0];

fn last_4(arr: [i64; 4]): i64 =
    arr[3];

fn all_positive_4(arr: [i64; 4]): bool {
    for x in arr {
        if x <= 0 { return false; }
    }
    return true;
}

fn any_negative_4(arr: [i64; 4]): bool {
    for x in arr {
        if x < 0 { return true; }
    }
    return false;
}

fn first_8(arr: [i64; 8]): i64 =
    arr[0];

fn last_8(arr: [i64; 8]): i64 =
    arr[7];

# ==============================================================================
# Rubix Dynamic Collections — Runtime Heap-Backed Implementations
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dynamic Vector (List / Dynamic Array)
# ------------------------------------------------------------------------------
struct Vector {
    data: *i64,
    len: i64,
    cap: i64
}

fn vec_new(initial_cap: i64): *Vector {
    let v = alloc_buffer(24) as *Vector;
    let cap = initial_cap;
    if cap <= 0 { cap = 8; }
    v.data = alloc_buffer(cap * 8) as *i64;
    v.len = 0;
    v.cap = cap;
    return v;
}

fn vec_push(self: *Vector, val: i64): i64 {
    if self.len >= self.cap {
        let new_cap = self.cap * 2;
        let new_buf = alloc_buffer(new_cap * 8) as *i64;
        let i = 0;
        let d = self.data;
        while i < self.len {
            new_buf[i] = d[i];
            i = i + 1;
        }
        self.data = new_buf;
        self.cap = new_cap;
    }
    let d = self.data;
    d[self.len] = val;
    self.len = self.len + 1;
    return self.len;
}

fn vec_get(self: *Vector, idx: i64): i64 {
    if (idx < 0) | (idx >= self.len) { return -999999999; }
    let d = self.data;
    return d[idx];
}

fn vec_set(self: *Vector, idx: i64, val: i64): i64 {
    if (idx < 0) | (idx >= self.len) { return -1; }
    let d = self.data;
    d[idx] = val;
    return 0;
}

fn vec_len(self: *Vector): i64 { return self.len; }
fn vec_cap(self: *Vector): i64 { return self.cap; }

# ------------------------------------------------------------------------------
# 2. Dynamic String (DynString)
# ------------------------------------------------------------------------------
struct DynString {
    data: *u8,
    len: i64,
    cap: i64
}

fn str_new(initial_cap: i64): *DynString {
    let s = alloc_buffer(24) as *DynString;
    let cap = initial_cap;
    if cap <= 0 { cap = 16; }
    s.data = alloc_buffer(cap) as *u8;
    s.len = 0;
    s.cap = cap;
    let d = s.data;
    d[0] = 0 as u8;
    return s;
}

fn str_push_byte(self: *DynString, b: i64): i64 {
    if self.len + 1 >= self.cap {
        let new_cap = self.cap * 2;
        let new_buf = alloc_buffer(new_cap) as *u8;
        let i = 0;
        let d = self.data;
        while i < self.len {
            new_buf[i] = d[i];
            i = i + 1;
        }
        self.data = new_buf;
        self.cap = new_cap;
    }
    let d = self.data;
    d[self.len] = b as u8;
    self.len = self.len + 1;
    d[self.len] = 0 as u8;
    return self.len;
}

fn str_append(self: *DynString, text: str): i64 {
    let t_len = string_length(text);
    let i = 0;
    while i < t_len {
        let b = string_byte_at(text, i);
        str_push_byte(self, b as i64);
        i = i + 1;
    }
    return self.len;
}

fn str_get_byte(self: *DynString, idx: i64): i64 {
    if (idx < 0) | (idx >= self.len) { return 0; }
    let d = self.data;
    return d[idx] as i64;
}

fn str_len(self: *DynString): i64 { return self.len; }

fn str_equals(self: *DynString, other: str): bool {
    let o_len = string_length(other);
    if self.len != o_len { return false; }
    let d = self.data;
    let i = 0;
    while i < self.len {
        let b1 = d[i] as i64;
        let b2 = string_byte_at(other, i) as i64;
        if b1 != b2 { return false; }
        i = i + 1;
    }
    return true;
}

# ------------------------------------------------------------------------------
# 3. Dynamic Hash Map (HashMap)
# ------------------------------------------------------------------------------
struct HashMap {
    keys: *i64,
    vals: *i64,
    occupied: *i64,
    cap: i64,
    size: i64
}

fn map_new(cap: i64): *HashMap {
    let m = alloc_buffer(40) as *HashMap;
    let c = cap;
    if c <= 0 { c = 16; }
    m.keys = alloc_buffer(c * 8) as *i64;
    m.vals = alloc_buffer(c * 8) as *i64;
    m.occupied = alloc_buffer(c * 8) as *i64;
    m.cap = c;
    m.size = 0;
    let occ = m.occupied;
    let i = 0;
    while i < c {
        occ[i] = 0;
        i = i + 1;
    }
    return m;
}

fn map_hash_key(key: i64, cap: i64): i64 {
    let h = key * 2654435761;
    let m = h % cap;
    if m < 0 { m = m + cap; }
    return m;
}

fn map_put(self: *HashMap, key: i64, val: i64): i64 {
    let c = self.cap;
    let keys = self.keys;
    let vals = self.vals;
    let occ = self.occupied;
    let slot = map_hash_key(key, c);
    let probes = 0;
    while probes < c {
        if occ[slot] == 0 {
            keys[slot] = key;
            vals[slot] = val;
            occ[slot] = 1;
            self.size = self.size + 1;
            return 0;
        }
        if keys[slot] == key {
            vals[slot] = val;
            return 0;
        }
        slot = (slot + 1) % c;
        probes = probes + 1;
    }
    return -1;
}

fn map_get(self: *HashMap, key: i64): i64 {
    let c = self.cap;
    let keys = self.keys;
    let vals = self.vals;
    let occ = self.occupied;
    let slot = map_hash_key(key, c);
    let probes = 0;
    while probes < c {
        if occ[slot] == 0 { return -999999999; }
        if keys[slot] == key { return vals[slot]; }
        slot = (slot + 1) % c;
        probes = probes + 1;
    }
    return -999999999;
}

fn map_has(self: *HashMap, key: i64): bool {
    let res = map_get(self, key);
    if res == -999999999 { return false; }
    return true;
}

fn map_len(self: *HashMap): i64 {
    return self.size;
}


