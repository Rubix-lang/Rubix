                    l = get_qword(s, 4);
                    l = emit_bin_op_typed(code_buf, l, TOKEN_CARET, common_t);
                    set_qword(s, 4, l);
                }
                t1 = common_t;
                is_c1 = 0;
                set_qword(s, 24, 0);
            }
        } else {
