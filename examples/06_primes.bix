# Prime number testing and counting in Rubix.
# Run with: rubix run examples/06_prime_numbers.bix

# Returns 1 if `n` is prime, 0 otherwise
fn is_prime(n: Integer): Integer {
    if n < 2 {
        return 0
    }
    mut d = 2
    mut prime = 1
    loop d * d <= n {
        if n % d == 0 {
            prime = 0
        }
        d = d + 1
    }
    prime
}

# Count how many prime numbers exist up to `limit`
fn count_primes(limit: Integer): Integer {
    mut count = 0
    mut i = 2
    loop i <= limit {
        if is_prime(i) == 1 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn main(): Integer {
    print "Is 29 prime? (1=yes, 0=no):"
    print is_prime(29)

    print "Is 35 prime? (1=yes, 0=no):"
    print is_prime(35)

    print "Total prime numbers under 100:"
    print count_primes(100)

    0
}
