# =====================================================================
# RUBIX ERGONOMICS CHEAT-SHEET
# Every new writing-style feature, with verified working code.
# Compile this file with the stage2 compiler (mmap+ctypes harness) and
# main() returns 42 if every feature works together.
# =====================================================================

# ---------------------------------------------------------------------
# 1. EXPRESSION-BODIED FUNCTIONS
#    Old:  fn double(x: i64): i64 { return x * 2; }
#    New:  fn double(x: i64): i64 = x * 2;
#    One-liner, no block, no return statement.
# ---------------------------------------------------------------------
fn double(x: i64): i64 = x * 2;

# ---------------------------------------------------------------------
# 2. TYPE INFERENCE (params + return)
#    Old:  fn add(a: i64, b: i64): i64 { return a + b; }
#    New:  fn add(a, b) = a + b;
#    Types inferred from usage. Booleans too:
#    fn is_positive(x) = x > 0;
# ---------------------------------------------------------------------
fn add(a, b) = a + b;
fn inc(x) = x + 1;
fn square(x) = x * x;
fn is_positive(x) = x > 0;

# ---------------------------------------------------------------------
# 3. IF-EXPRESSIONS (if produces a value)
#    Old:  let x = 0;
#          if flag == 1 { x = 42; } else { x = 0; }
#    New:  let x = if flag == 1 { 42 } else { 0 };
#    Works for i64, strings, nested, and as function bodies.
# ---------------------------------------------------------------------
fn get_greeting(formal) = if formal == 1 { "Hello" } else { "Hi" };

# ---------------------------------------------------------------------
# 4. RECURSIVE EXPRESSION-BODIED FUNCTION
#    if-expression as the whole function body; recursion allowed.
# ---------------------------------------------------------------------
fn fact(n) = if n <= 1 { 1 } else { n * fact(n - 1) };

# ---------------------------------------------------------------------
# 5. INFERRED ARRAY LITERALS & UNSIZED ARRAYS [T]
#    Old:  let nums: [i64; 4] = [1, 2, 3, 4];
#    New:  let nums = [1, 2, 3, 4];
#    Param: fn sum_unsized(arr: [i64]): i64 { ... }
# ---------------------------------------------------------------------
fn sum_unsized(arr: [i64]): i64 {
    let s = 0;
    for x in arr {
        s = s + x;
    }
    return s;
}

# ---------------------------------------------------------------------
# 6. RANGE FOR-LOOPS
#    Old:  let i = 0; while i < 10 { ... i = i + 1; }
#    New:  for i in 0..10 { ... }
#    Supports nested loops, break, and variable bounds.
# ---------------------------------------------------------------------
fn sum_range(n: i64): i64 {
    let total = 0;
    for i in 0..n {
        total = total + i;
    }
    return total;
}

# ---------------------------------------------------------------------
# 7. PIPELINE OPERATOR  (|>)
#    Old:  square(inc(5))
#    New:  5 |> inc |> square
#    - chains left-to-right
#    - parens optional for 1-arg calls:  5 |> inc
#    - multi-arg inserts value as FIRST arg:  10 |> add(4)
#    - works with builtins:  s |> string_length()
# ---------------------------------------------------------------------
fn mul(a, b) = a * b;

# ---------------------------------------------------------------------
# 8. ERROR OPERATOR  (?)
#    let x = fetch_val()?;
#    - non-negative result: unwraps and continues
#    - negative result:     returns it immediately from the caller
#    - propagates through pipelines:  v |> double()? |> add_two()
#    - rejected in void functions (compile error -41)
# ---------------------------------------------------------------------
fn fetch_val(ok) = if ok == 1 { 42 } else { -77 };
fn compute(): i64 {
    let x = fetch_val(1)?;   # 42 -> continues
    return x;
}

# ---------------------------------------------------------------------
# 9. ELVIS / FALLBACK OPERATOR  (?: and 'or')
#    let x = 0 ?: 100;        # zero -> uses 100
#    let x = 0 or 100;        # identical readable keyword alias
#    - chains:  0 or 0 or 88
#    - inside expressions:  (x or 50) * 2
#    - works on function results:  get_val(0) or 7
# ---------------------------------------------------------------------
fn get_val(flag) = if flag { 99 } else { 0 };

# ---------------------------------------------------------------------
# 10. STRING CONCATENATION (+)
#     let full = "Hello, " + "World!";
#     - Direct binary + operator on str operands
#     - Automatically allocates buffer and concatenates
# ---------------------------------------------------------------------
fn greet(name: str): str = "Hello, " + name + "!";

# ---------------------------------------------------------------------
# 11. ENUMERATED COLLECTION FOR-LOOP (for i, x in arr)
#     for i, val in items { ... }
#     - Simultaneously binds 0-based index and element value
#     - Zero manual index tracking boilerplate
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# 12. STRUCT LITERAL CONSTRUCTION & FIELD SHORTHAND
#     let p = Point { x: 10, y: 20 };
#     let p2 = Point { x, y };
#     - Explicit named fields in any order
#     - Omitted fields zero-initialized
#     - Field shorthand when variable name matches field
#     - Direct member access on literal: Point { x: 1, y: 2 }.x
# ---------------------------------------------------------------------
struct Point {
    x: i64,
    y: i64,
}

# ---------------------------------------------------------------------
# 13. STRING INTERPOLATION & MIXED CONCATENATION
#     let msg = "Hello {name}, score={pts}!";
#     let s2 = "Value: " + 42;
#     - In-line expression embedding with {expr}
#     - Transparent mixed string + int concatenation
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# 14. METHOD-CALL SYNTAX / UFCS (.method())
#     let l1 = "abc".len();
#     let l2 = nums.len();
#     let doubled = 21.double();
#     - Universal Function Call Syntax for natural method chaining
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# 15. RESOURCE CLEANUP (defer)
#     defer cleanup_action();
#     - LIFO execution on function exit
#     - Automatically preserves return values across early returns & ?
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# 16. BUILTIN PRINTLN
#     println("Hello from Rubix!");
#     - Prints directly to stdout with automatic newline
# ---------------------------------------------------------------------

# =====================================================================
# MAIN: exercise every feature together, return 42 on success
# =====================================================================
fn main(): i64 {
    # defer cleanup registration
    let cleanup_counter = 0;
    defer cleanup_counter = cleanup_counter + 1;

    # if-expression as a value
    let flag = 1;
    let chosen = if flag == 1 { 42 } else { 0 };

    # inferred array
    let nums = [1, 2, 3, 4];

    # range for-loop over inferred array with if-expression accumulator
    let sum_evens = 0;
    for i in 0..4 {
        let val = nums[i];
        let addend = if (val % 2) == 0 { val } else { 0 };
        sum_evens = sum_evens + addend;
    }

    # pipeline (multi-arg + chained, parens-free)
    let piped = 3 |> inc |> double |> square;      # (3+1)*2 = 8 -> 64

    # pipeline with multi-arg first-arg insertion
    let multi = 10 |> add(4) |> mul(3);            # (10+4)*3 = 42

    # error operator unwrap
    let ok_val = compute();                        # 42

    # elvis fallback (both ?: and 'or' supported)
    let fallback = 0 ?: 100;                       # 100
    let or_val = 0 or 42;                          # 42

    # string if-expression + builtin
    let s = get_greeting(1);                       # "Hello"
    let slen = s |> string_length();               # 5

    # string + concatenation
    let full_greeting = greet("Rubix");            # "Hello, Rubix!"
    let full_len = full_greeting |> string_length(); # 13

    # recursion
    let f = fact(5);                               # 120

    # range loop with variable bound
    let r = sum_range(5);                          # 0+1+2+3+4 = 10

    # composition: inferred array -> range loop -> pipeline -> fallback
    let total2 = 0;
    for i in 0..4 {
        total2 = total2 + (nums[i] |> double or 1);
    }

    # match expression
    let matched = match chosen {
        42 => 10,
        0..10 => 20,
        _ => 0
    };                                             # 10

    # collection for-in loop over array
    let collection_sum = 0;
    for n in nums {
        collection_sum = collection_sum + n;
    }                                              # 1+2+3+4 = 10

    # unsized array parameter invocation
    let unsized_sum = sum_unsized(nums);           # 1+2+3+4 = 10

    # enumerated for-loop (for i, x in arr)
    let enum_sum = 0;
    for idx, item in nums {
        enum_sum = enum_sum + (idx * 10) + item;   # 1 + 12 + 23 + 34 = 70
    }

    # struct literal construction + member access expression
    let lit_pt = Point { x: 20, y: 22 };
    let lit_sum = lit_pt.x + lit_pt.y;             # 42
    let direct_member = Point { x: 42, y: 99 }.x;  # 42

    # struct literal field shorthand
    let x = 12;
    let y = 30;
    let short_pt = Point { x, y };
    let short_sum = short_pt.x + short_pt.y;       # 42

    # destructuring let [a, b] = arr
    let pair = [20, 22];
    let [p1, p2] = pair;
    let destr_sum = p1 + p2;                       # 20+22 = 42

    # string interpolation & mixed concatenation
    let hero = "Rubix";
    let score = 42;
    let msg = "Hero {hero} has {score} points";
    let mixed_str = "Answer: " + 42;
    let msg_len = msg.len();                       # 24
    let mixed_len = mixed_str.len();               # 10

    # method-call syntax (UFCS)
    let ufcs_doubled = 21.double();                # 42
    let arr_len = nums.len();                      # 4

    # builtin println
    println("Rubix Cheatsheet Verified Cleanly!");

    # all feature results combine to 42
    return (chosen - 42) + (sum_evens - 6) + (piped - 64) + (multi - 42)
         + (ok_val - 42) + (fallback - 100) + (or_val - 42) + (slen - 5) + (full_len - 13)
         + (f - 120) + (r - 10) + (total2 - 20)
         + (matched - 10) + (collection_sum - 10) + (unsized_sum - 10) + (enum_sum - 70)
         + (lit_sum - 42) + (direct_member - 42) + (short_sum - 42)
         + (destr_sum - 42) + (msg_len - 24) + (mixed_len - 10)
         + (ufcs_doubled - 42) + (arr_len - 4) + 42;
}
