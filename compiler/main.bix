# Pointer Provenance Constants
let PROV_UNKNOWN     = 0; # External, parameter, heap, or unknown provenance
let PROV_STACK_LOCAL = 1; # Local stack object address (&local_var)

# Canonical Deterministic Compiler Error Codes:
# 1. Frontend Syntax, Identifier & Lexical Errors
#   ERR_SYNTAX             = -1; # Grammar/syntax expectation failure
#   ERR_UNDEFINED_IDENT    = -2; # Undefined identifier / variable out of scope
#   ERR_INVALID_TOKEN      = -3; # Malformed / unrecognized token (TOKEN_ERROR)
# 2. Driver & I/O Errors
#   ERR_FILE_OPEN          = -10; # Failed file open (sys_open < 0)
#   ERR_FILE_READ          = -11; # Failed file read or empty file (sys_read_all <= 0)
#   ERR_COMPILE_FAILED     = -12; # Generic compilation failure fallback (code_len == 0)
#   ERR_OUT_FILE_OPEN      = -20; # Output file open failure
#   ERR_OUT_FILE_WRITE     = -21; # Output file write failure
# 3. Symbol Table & Limit Errors
#   ERR_CONST_TABLE_FULL   = -30;
#   ERR_VAR_TABLE_FULL     = -31;
#   ERR_FUNC_TABLE_FULL    = -32;
#   ERR_PATCH_TABLE_FULL   = -33;
#   ERR_EPILOGUE_PATCH_FULL = -34;
# 4. Semantic & Type System Errors
#   ERR_ARG_COUNT_MISMATCH = -35;
#   ERR_TOO_MANY_ARGS      = -36;
#   ERR_UNKNOWN_TYPE       = -37;
#   ERR_TYPE_MISMATCH_ASSIGN = -40;
#   ERR_TYPE_MISMATCH_RETURN = -41;
#   ERR_TYPE_MISMATCH_ARG    = -42;
#   ERR_INVALID_BIN_OP_TYPE  = -43;
#   ERR_INVALID_PTR_OP       = -44;
#   ERR_VOID_EXPR_USED       = -45;
#   ERR_STACK_ESCAPE         = -46;
#   ERR_INVALID_PTR_DEREF    = -47;
#   ERR_INVALID_CAST         = -48;
#   ERR_INVALID_MAIN         = -49;
#   ERR_INVALID_ARRAY_SIZE   = -50;
#   ERR_UNKNOWN_FIELD        = -51;
#   ERR_BREAK_OUTSIDE_LOOP   = -52;
#   ERR_CONTINUE_OUTSIDE_LOOP = -53;
#   ERR_MAIN_NOT_FOUND       = -54;

fn token_set(tok_buf: i64, kind: i64, val: i64, offset: i64, len: i64): i64 {
    set_qword(tok_buf, 0, kind);
    set_qword(tok_buf, 1, val);
    set_qword(tok_buf, 2, offset);
    set_qword(tok_buf, 3, len);
    return 0;
}
# Streaming lexer


fn is_digit(b: i64): i64 {
    if b >= 48 {
        if b <= 57 {
            return 1;
        }
    }
    return 0;
}

fn is_alpha(b: i64): i64 {
    if b >= 65 {
        if b <= 90 {
            return 1;
        }
    }
    if b >= 97 {
        if b <= 122 {
            return 1;
        }
    }
    if b == 95 {
        return 1;
    }
    return 0;
}



fn parse_float_bits(src: i64, start: i64, tok_len: i64): i64 {
    let p = start;
    let end = start + tok_len;
    let int_part = 0;
    while p < end {
        let b = get_byte(src, p);
        if b == 46 { # '.'
            p = p + 1;
            let frac_part = 0;
            let frac_digits = 0;
            while p < end {
                let fb = get_byte(src, p);
                if (fb >= 48) & (fb <= 57) {
                    if frac_digits < 9 {
                        frac_part = frac_part * 10 + (fb - 48);
                        frac_digits = frac_digits + 1;
                    }
                }
                p = p + 1;
            }
            if (int_part == 0) & (frac_part == 0) {
                return 0;
            }
            let scale = 1;
            let i = 0;
            while i < frac_digits {
                scale = scale * 10;
                i = i + 1;
            }
            let num = int_part * scale + frac_part;
            let e = 0;
            while num >= (2 * scale) {
                scale = scale * 2;
                e = e + 1;
            }
            while num < scale {
                num = num * 2;
                e = e - 1;
            }
            let exp_biased = e + 1023;
            let r = num - scale;
            let mantissa = 0;
            let bit_i = 0;
            while bit_i < 54 {
                r = r * 2;
                if r >= scale {
                    mantissa = (mantissa * 2) | 1;
                    r = r - scale;
                } else {
                    mantissa = mantissa * 2;
                }
                bit_i = bit_i + 1;
            }
            let round_bit = (mantissa >> 1) & 1;
            let top52 = mantissa >> 2;
            if round_bit == 1 {
                top52 = top52 + 1;
                if top52 >= 4503599627370496 { # 1 << 52
                    top52 = 0;
                    exp_biased = exp_biased + 1;
                }
            }
            let bits = (exp_biased << 52) | top52;
            return bits;
        } else {
            if (b >= 48) & (b <= 57) {
                int_part = int_part * 10 + (b - 48);
            }
            p = p + 1;
        }
    }
    return 0;
}

fn scan_token(src: i64, pos: i64, len: i64, tok_buf: i64): i64 {
    let p = pos;
    let running = 1;
    while running == 1 {
        if p >= len {
            running = 0;
        } else {
            let b_ws = get_byte(src, p);
            let is_ws = 0;
            if b_ws == 32 { is_ws = 1; }
            if b_ws == 9  { is_ws = 1; }
            if b_ws == 10 { is_ws = 1; }
            if b_ws == 13 { is_ws = 1; }
            if is_ws == 1 {
                p = p + 1;
            } else {
                if b_ws == 35 { # '#' comment
                    let in_comment = 1;
                    while in_comment == 1 {
                        if p >= len {
                            in_comment = 0;
                        } else {
                            let cb = get_byte(src, p);
                            p = p + 1;
                            if cb == 10 {
                                in_comment = 0;
                            }
                        }
                    }
                } else {
                    if b_ws == 47 { # possible '//' comment
                        if p + 1 < len {
                            if get_byte(src, p + 1) == 47 {
                                p = p + 2;
                                let in_comment2 = 1;
                                while in_comment2 == 1 {
                                    if p >= len {
                                        in_comment2 = 0;
                                    } else {
                                        let cb2 = get_byte(src, p);
                                        p = p + 1;
                                        if cb2 == 10 {
                                            in_comment2 = 0;
                                        }
                                    }
                                }
                            } else {
                                running = 0;
                            }
                        } else {
                            running = 0;
                        }
                    } else {
                        running = 0;
                    }
                }
            }
        }
    }
    if p >= len {
        token_set(tok_buf, TOKEN_EOF, 0, p, 0);
        return p;
    }

    let b = get_byte(src, p);

    # String Literal
    if b == 34 { # '"'
        p = p + 1;
        let start = p;
        let scanning = 1;
        let err = 0;
        while scanning == 1 {
            if p >= len {
                scanning = 0;
                err = 1; # Unterminated string (reached EOF)
            } else {
                let sb = get_byte(src, p);
                if sb == 10 { # Unescaped newline in string literal is an error
                    scanning = 0;
                    err = 1;
                } else {
                    if sb == 34 { # '"'
                        scanning = 0; # Done
                    } else {
                        if sb == 92 { # '\' escape
                            p = p + 1;
                            if p >= len {
                                scanning = 0;
                                err = 1; # Trailing backslash at EOF
                            } else {
                                let esc = get_byte(src, p);
                                if esc == 110 { # 'n'
                                    p = p + 1;
                                } else {
                                    if esc == 116 { # 't'
                                        p = p + 1;
                                    } else {
                                        if esc == 114 { # 'r'
                                            p = p + 1;
                                        } else {
                                            if esc == 48 { # '0'
                                                p = p + 1;
                                            } else {
                                                if esc == 92 { # '\\'
                                                    p = p + 1;
                                                } else {
                                                    if esc == 34 { # '\"'
                                                        p = p + 1;
                                                    } else {
                                                        # Invalid escape sequence!
                                                        scanning = 0;
                                                        err = 1;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        } else {
                            p = p + 1;
                        }
                    }
                }
            }
        }
        if err == 1 {
            token_set(tok_buf, TOKEN_ERROR, 0, start, p - start);
            return p;
        }
        let tok_len = p - start;
        p = p + 1; # skip closing quote
        token_set(tok_buf, TOKEN_STR_LIT, 0, start, tok_len);
        return p;
    }

    # Character Literal 'c'
    if b == 39 { # '\''
        let start = p;
        p = p + 1; # skip opening quote
        let ch_val = 0;
        if p < len {
            let cb = get_byte(src, p);
            p = p + 1;
            if cb == 92 { # escape '\'
                if p < len {
                    let esc = get_byte(src, p);
                    p = p + 1;
                    if esc == 110 { ch_val = 10; } # '\n'
                    if esc == 114 { ch_val = 13; } # '\r'
                    if esc == 116 { ch_val = 9; }  # '\t'
                    if esc == 48  { ch_val = 0; }  # '\0'
                    if esc == 92  { ch_val = 92; } # '\\'
                    if esc == 39  { ch_val = 39; } # '\''
                }
            } else {
                ch_val = cb;
            }
        }
        if p < len {
            if get_byte(src, p) == 39 {
                p = p + 1; # skip closing '\''
            }
        }
        let tok_len = p - start;
        token_set(tok_buf, TOKEN_CHAR_LIT, ch_val, start, tok_len);
        return p;
    }

    # Integer or Float Literal
    if is_digit(b) == 1 {
        let start = p;
        let val = 0;
        let scanning = 1;
        while scanning == 1 {
            if p >= len {
                scanning = 0;
            } else {
                let db = get_byte(src, p);
                if is_digit(db) == 1 {
                    val = val * 10 + (db - 48);
                    p = p + 1;
                } else {
                    scanning = 0;
                }
            }
        }
        let is_float = 0;
        if p < len {
            if get_byte(src, p) == 46 { # '.'
                let is_range = 0;
                if p + 1 < len {
                    if get_byte(src, p + 1) == 46 { # '..'
                        is_range = 1;
                    }
                }
                if is_range == 0 {
                    if p + 1 < len {
                        if is_digit(get_byte(src, p + 1)) == 1 {
                            is_float = 1;
                            p = p + 1; # skip '.'
                            while (p < len) & (is_digit(get_byte(src, p)) == 1) {
                                p = p + 1;
                            }
                        }
                    }
                }
            }
        }
        let tok_len = p - start;
        if is_float == 1 {
            let fval = parse_float_bits(src, start, tok_len);
            token_set(tok_buf, TOKEN_FLOAT_LIT, fval, start, tok_len);
        } else {
            token_set(tok_buf, TOKEN_INT_LIT, val, start, tok_len);
        }
        return p;
    }

    # Identifier or Keyword
    if is_alpha(b) == 1 {
        let start = p;
        let scanning = 1;
        while scanning == 1 {
            if p >= len {
                scanning = 0;
            } else {
                let ab = get_byte(src, p);
                let is_an = is_alpha(ab);
                if is_an == 0 {
                    is_an = is_digit(ab);
                }
                if is_an == 1 {
                    p = p + 1;
                } else {
                    scanning = 0;
                }
            }
        }
        let tok_len = p - start;
        let kind = TOKEN_IDENT;

        if tok_len == 1 {
            let b0 = get_byte(src, start);
            if b0 == 95 { kind = TOKEN_UNDERSCORE; } # '_'
        }
        if tok_len == 2 {
            let b0 = get_byte(src, start);
            let b1 = get_byte(src, start + 1);
            if b0 == 102 { if b1 == 110 { kind = TOKEN_KW_FN; } }    # fn
            if b0 == 105 { if b1 == 102 { kind = TOKEN_KW_IF; } }    # if
            if b0 == 117 { if b1 == 56  { kind = TOKEN_TYPE_U8; } }  # u8
            if b0 == 97  { if b1 == 115 { kind = TOKEN_KW_AS; } }    # as
            if b0 == 111 { if b1 == 114 { kind = TOKEN_KW_OR; } }    # or
        }
        if tok_len == 3 {
            let b0 = get_byte(src, start);
            let b1 = get_byte(src, start + 1);
            let b2 = get_byte(src, start + 2);
            if b0 == 108 { if b1 == 101 { if b2 == 116 { kind = TOKEN_KW_LET; } } }   # let
            if b0 == 109 { if b1 == 117 { if b2 == 116 { kind = TOKEN_KW_MUT; } } }   # mut
            if b0 == 105 { if b1 == 54  { if b2 == 52  { kind = TOKEN_TYPE_I64; } } } # i64
            if b0 == 73  { if b1 == 110 { if b2 == 116 { kind = TOKEN_TYPE_I64; } } } # Int
            if b0 == 105 { if b1 == 51  { if b2 == 50  { kind = TOKEN_TYPE_I32; } } } # i32
            if b0 == 102 { if b1 == 54  { if b2 == 52  { kind = TOKEN_TYPE_F64; } } } # f64
            if b0 == 102 { if b1 == 51  { if b2 == 50  { kind = TOKEN_TYPE_F32; } } } # f32
            if b0 == 112 { if b1 == 116 { if b2 == 114 { kind = TOKEN_TYPE_PTR; } } } # ptr
            if b0 == 115 { if b1 == 116 { if b2 == 114 { kind = TOKEN_TYPE_STR; } } } # str
            if b0 == 102 { if b1 == 111 { if b2 == 114 { kind = TOKEN_KW_FOR; } } }   # for
        }
        if tok_len == 4 {
            let b0 = get_byte(src, start);
            let b1 = get_byte(src, start + 1);
            let b2 = get_byte(src, start + 2);
            let b3 = get_byte(src, start + 3);
            if b0 == 101 { if b1 == 108 { if b2 == 115 { if b3 == 101 { kind = TOKEN_KW_ELSE; } } } }    # else
            if b0 == 108 { if b1 == 111 { if b2 == 111 { if b3 == 112 { kind = TOKEN_KW_WHILE; } } } }   # loop
            if b0 == 98  { if b1 == 111 { if b2 == 111 { if b3 == 108 { kind = TOKEN_TYPE_BOOL; } } } }  # bool
            if b0 == 99  { if b1 == 104 { if b2 == 97  { if b3 == 114 { kind = TOKEN_TYPE_CHAR; } } } }  # char
            if b0 == 118 { if b1 == 111 { if b2 == 105 { if b3 == 100 { kind = TOKEN_TYPE_VOID; } } } }  # void
            if b0 == 86  { if b1 == 111 { if b2 == 105 { if b3 == 100 { kind = TOKEN_TYPE_VOID; } } } }  # Void
            if b0 == 116 { if b1 == 114 { if b2 == 117 { if b3 == 101 { kind = TOKEN_KW_TRUE; } } } }   # true
            if b0 == 110 { if b1 == 117 { if b2 == 108 { if b3 == 108 { kind = TOKEN_KW_NULL; } } } }   # null
            if b0 == 101 { if b1 == 110 { if b2 == 117 { if b3 == 109 { kind = TOKEN_KW_ENUM; } } } }   # enum
            if b0 == 116 { if b1 == 121 { if b2 == 112 { if b3 == 101 { kind = TOKEN_KW_STRUCT; } } } } # type
        }
        if tok_len == 5 {
            let b0 = get_byte(src, start);
            let b1 = get_byte(src, start + 1);
            let b2 = get_byte(src, start + 2);
            let b3 = get_byte(src, start + 3);
            let b4 = get_byte(src, start + 4);
            if b0 == 119 { if b1 == 104 { if b2 == 105 { if b3 == 108 { if b4 == 101 { kind = TOKEN_KW_WHILE; } } } } } # while
            if b0 == 102 { if b1 == 97  { if b2 == 108 { if b3 == 115 { if b4 == 101 { kind = TOKEN_KW_FALSE; } } } } } # false
            if b0 == 98  { if b1 == 114 { if b2 == 101 { if b3 == 97  { if b4 == 107 { kind = TOKEN_KW_BREAK; } } } } } # break
            if b0 == 109 { if b1 == 97  { if b2 == 116 { if b3 == 99  { if b4 == 104 { kind = TOKEN_KW_MATCH; } } } } } # match
            if b0 == 100 { if b1 == 101 { if b2 == 102 { if b3 == 101 { if b4 == 114 { kind = TOKEN_KW_DEFER; } } } } } # defer
            if b0 == 70  { if b1 == 108 { if b2 == 111 { if b3 == 97  { if b4 == 116 { kind = TOKEN_TYPE_F64; } } } } } # Float
        }
        if tok_len == 6 {
            let b0 = get_byte(src, start);
            let b1 = get_byte(src, start + 1);
            let b2 = get_byte(src, start + 2);
            let b3 = get_byte(src, start + 3);
            let b4 = get_byte(src, start + 4);
            let b5 = get_byte(src, start + 5);
            if b0 == 114 { if b1 == 101 { if b2 == 116 { if b3 == 117 { if b4 == 114 { if b5 == 110 { kind = TOKEN_KW_RETURN; } } } } } } # return
            if b0 == 115 { if b1 == 116 { if b2 == 114 { if b3 == 117 { if b4 == 99  { if b5 == 116 { kind = TOKEN_KW_STRUCT; } } } } } } # struct
            if b0 == 83  { if b1 == 116 { if b2 == 114 { if b3 == 105 { if b4 == 110 { if b5 == 103 { kind = TOKEN_TYPE_STR; } } } } } } # String
        }
        if tok_len == 7 {
            let b0 = get_byte(src, start);
            let b1 = get_byte(src, start + 1);
            let b2 = get_byte(src, start + 2);
            let b3 = get_byte(src, start + 3);
            let b4 = get_byte(src, start + 4);
            let b5 = get_byte(src, start + 5);
            let b6 = get_byte(src, start + 6);
            if b0 == 73 { if b1 == 110 { if b2 == 116 { if b3 == 101 { if b4 == 103 { if b5 == 101 { if b6 == 114 { kind = TOKEN_TYPE_I64; } } } } } } } # Integer
            if b0 == 66 { if b1 == 111 { if b2 == 111 { if b3 == 108 { if b4 == 101 { if b5 == 97  { if b6 == 110 { kind = TOKEN_TYPE_BOOL; } } } } } } } # Boolean
        }
        if tok_len == 8 {
            let b0 = get_byte(src, start);
            let b1 = get_byte(src, start + 1);
            let b2 = get_byte(src, start + 2);
            let b3 = get_byte(src, start + 3);
            let b4 = get_byte(src, start + 4);
            let b5 = get_byte(src, start + 5);
            let b6 = get_byte(src, start + 6);
            let b7 = get_byte(src, start + 7);
            if b0 == 99 { if b1 == 111 { if b2 == 110 { if b3 == 116 { if b4 == 105 { if b5 == 110 { if b6 == 117 { if b7 == 101 { kind = TOKEN_KW_CONTINUE; } } } } } } } } # continue
        }

        token_set(tok_buf, kind, 0, start, tok_len);
        return p;
    }

    # Punctuators and single characters
    p = p + 1;
    if b == 40  { token_set(tok_buf, TOKEN_LPAREN, 0, p - 1, 1); return p; } # '('
    if b == 41  { token_set(tok_buf, TOKEN_RPAREN, 0, p - 1, 1); return p; } # ')'
    if b == 123 { token_set(tok_buf, TOKEN_LBRACE, 0, p - 1, 1); return p; } # '{'
    if b == 125 { token_set(tok_buf, TOKEN_RBRACE, 0, p - 1, 1); return p; } # '}'
    if b == 58  { token_set(tok_buf, TOKEN_COLON, 0, p - 1, 1); return p; }  # ':'
    if b == 59  { token_set(tok_buf, TOKEN_SEMICOLON, 0, p - 1, 1); return p; } # ';'
    if b == 46 { # '.' or '..'
        if p < len {
            if get_byte(src, p) == 46 { # '..'
                p = p + 1;
                token_set(tok_buf, TOKEN_DOT_DOT, 0, p - 2, 2);
                return p;
            }
        }
        token_set(tok_buf, TOKEN_DOT, 0, p - 1, 1);
        return p;
    }
    if b == 43 { # '+', '+!', or '+|'
        if p < len {
            let nb = get_byte(src, p);
            if nb == 33 { # '+!'
                p = p + 1;
                token_set(tok_buf, TOKEN_PLUS_TRAP, 0, p - 2, 2);
                return p;
            }
            if nb == 124 { # '+|'
                p = p + 1;
                token_set(tok_buf, TOKEN_PLUS_SAT, 0, p - 2, 2);
                return p;
            }
        }
        token_set(tok_buf, TOKEN_PLUS, 0, p - 1, 1);
        return p;
    }
    if b == 45 { # '-', '-!', or '-|'
        if p < len {
            let nb = get_byte(src, p);
            if nb == 33 { # '-!'
                p = p + 1;
                token_set(tok_buf, TOKEN_MINUS_TRAP, 0, p - 2, 2);
                return p;
            }
            if nb == 124 { # '-|'
                p = p + 1;
                token_set(tok_buf, TOKEN_MINUS_SAT, 0, p - 2, 2);
                return p;
            }
        }
        token_set(tok_buf, TOKEN_MINUS, 0, p - 1, 1);
        return p;
    }
    if b == 42 { # '*', '*!', or '*|'
        if p < len {
            let nb = get_byte(src, p);
            if nb == 33 { # '*!'
                p = p + 1;
                token_set(tok_buf, TOKEN_STAR_TRAP, 0, p - 2, 2);
                return p;
            }
            if nb == 124 { # '*|'
                p = p + 1;
                token_set(tok_buf, TOKEN_STAR_SAT, 0, p - 2, 2);
                return p;
            }
        }
        token_set(tok_buf, TOKEN_STAR, 0, p - 1, 1);
        return p;
    }
    if b == 47  { token_set(tok_buf, TOKEN_SLASH, 0, p - 1, 1); return p; }  # '/'
    if b == 37  { token_set(tok_buf, TOKEN_PERCENT, 0, p - 1, 1); return p; } # '%'
    if b == 44  { token_set(tok_buf, TOKEN_COMMA, 0, p - 1, 1); return p; }  # ','
    if b == 38  { token_set(tok_buf, TOKEN_AMP, 0, p - 1, 1); return p; }    # '&'
    if b == 124 { # '|' or '|>'
        if p < len {
            if get_byte(src, p) == 62 { # '|>'
                p = p + 1;
                token_set(tok_buf, TOKEN_PIPE_GREATER, 0, p - 2, 2);
                return p;
            }
        }
        token_set(tok_buf, TOKEN_PIPE, 0, p - 1, 1);
        return p;
    }
    if b == 63 { # '?', '?:', '?.', '??'
        if p < len {
            let next_b = get_byte(src, p);
            if next_b == 58 { # '?:'
                p = p + 1;
                token_set(tok_buf, TOKEN_QUESTION_COLON, 0, p - 2, 2);
                return p;
            }
            if next_b == 46 { # '?.'
                p = p + 1;
                token_set(tok_buf, TOKEN_QUESTION_DOT, 0, p - 2, 2);
                return p;
            }
            if next_b == 63 { # '??'
                p = p + 1;
                token_set(tok_buf, TOKEN_QUESTION_QUESTION, 0, p - 2, 2);
                return p;
            }
        }
        token_set(tok_buf, TOKEN_QUESTION, 0, p - 1, 1);
        return p;
    }
    if b == 94  { token_set(tok_buf, TOKEN_CARET, 0, p - 1, 1); return p; }  # '^'
    if b == 91  { token_set(tok_buf, TOKEN_LBRACKET, 0, p - 1, 1); return p; } # '['
    if b == 93  { token_set(tok_buf, TOKEN_RBRACKET, 0, p - 1, 1); return p; } # ']'
    if b == 126 { token_set(tok_buf, TOKEN_TILDE, 0, p - 1, 1); return p; }    # '~'

    if b == 60 { # '<', '<=', or '<<'
        if p < len {
            let nb = get_byte(src, p);
            if nb == 60 { # '<<'
                p = p + 1;
                token_set(tok_buf, TOKEN_SHL, 0, p - 2, 2);
                return p;
            }
            if nb == 61 { # '<='
                p = p + 1;
                token_set(tok_buf, TOKEN_LESS_EQ, 0, p - 2, 2);
                return p;
            }
        }
        token_set(tok_buf, TOKEN_LESS, 0, p - 1, 1);
        return p;
    }

    if b == 62 { # '>', '>=', or '>>'
        if p < len {
            let nb2 = get_byte(src, p);
            if nb2 == 62 { # '>>'
                p = p + 1;
                token_set(tok_buf, TOKEN_SHR, 0, p - 2, 2);
                return p;
            }
            if nb2 == 61 { # '>='
                p = p + 1;
                token_set(tok_buf, TOKEN_GREATER_EQ, 0, p - 2, 2);
                return p;
            }
        }
        token_set(tok_buf, TOKEN_GREATER, 0, p - 1, 1);
        return p;
    }

    if b == 61 { # '=' or '==' or '=>'
        if p < len {
            let nb3 = get_byte(src, p);
            if nb3 == 61 {
                p = p + 1;
                token_set(tok_buf, TOKEN_EQUAL_EQUAL, 0, p - 2, 2);
                return p;
            }
            if nb3 == 62 { # '=>'
                p = p + 1;
                token_set(tok_buf, TOKEN_FAT_ARROW, 0, p - 2, 2);
                return p;
            }
        }
        token_set(tok_buf, TOKEN_EQUAL, 0, p - 1, 1);
        return p;
    }

    if b == 33 { # '!' or '!='
        if p < len {
            if get_byte(src, p) == 61 {
                p = p + 1;
                token_set(tok_buf, TOKEN_NOT_EQUAL, 0, p - 2, 2);
                return p;
            }
        }
        token_set(tok_buf, TOKEN_BANG, 0, p - 1, 1);
        return p;
    }

    token_set(tok_buf, TOKEN_ERROR, 0, p - 1, 1);
    return p;
}
# Type classification and stack frame layout



fn type_size(t: i64): i64 {
    if t == TYPE_I64     { return 8; }
    if t == TYPE_PTR     { return 8; }
    if t == TYPE_STR     { return 8; }
    if t == TYPE_ARRAY   { return 8; }
    if t >= TYPE_STRUCT  { return 8; }
    if t == TYPE_F64     { return 8; }
    if t == TYPE_FLOAT_LIT { return 8; }
    if t == TYPE_F32     { return 4; }
    if t == TYPE_I32     { return 4; }
    if t == TYPE_CHAR    { return 4; }
    if t == TYPE_U8      { return 1; }
    if t == TYPE_BOOL    { return 1; }
    if t == TYPE_VOID    { return 0; }
    if t == TYPE_INT_LIT { return 8; }
    if t == TYPE_OPTION  { return 16; }
    if t == TYPE_RESULT  { return 16; }
    if t == TYPE_TUPLE   { return 16; }
    if t == TYPE_GENERIC_PARAM { return 8; }
    return 8;
}

fn type_is_float(t: i64): i64 {
    if t == TYPE_F64       { return 1; }
    if t == TYPE_F32       { return 1; }
    if t == TYPE_FLOAT_LIT { return 1; }
    return 0;
}

fn type_is_integer(t: i64): i64 {
    if t == TYPE_I64     { return 1; }
    if t == TYPE_I32     { return 1; }
    if t == TYPE_CHAR    { return 1; }
    if t == TYPE_U8      { return 1; }
    if t == TYPE_INT_LIT { return 1; }
    return 0;
}

fn type_is_compatible(expected: i64, actual: i64): i64 {
    if expected == actual { return 1; }
    if (expected == TYPE_GENERIC_PARAM) | (actual == TYPE_GENERIC_PARAM) { return 1; }
    if expected == TYPE_OPTION {
        if actual == TYPE_OPTION { return 1; }
    }
    if expected == TYPE_RESULT {
        if actual == TYPE_RESULT { return 1; }
    }
    if expected == TYPE_TUPLE {
        if actual == TYPE_TUPLE { return 1; }
        if actual == TYPE_PTR   { return 1; }
    }
    if expected == TYPE_PTR {
        if actual == TYPE_TUPLE { return 1; }
    }
    if actual == TYPE_INT_LIT {
        if expected == TYPE_I64  { return 1; }
        if expected == TYPE_I32  { return 1; }
        if expected == TYPE_CHAR { return 1; }
        if expected == TYPE_U8   { return 1; }
    }
    if actual == TYPE_FLOAT_LIT {
        if expected == TYPE_F64 { return 1; }
        if expected == TYPE_F32 { return 1; }
    }
    if expected == TYPE_F64 {
        if actual == TYPE_F32 { return 1; }
        if actual == TYPE_FLOAT_LIT { return 1; }
    }
    if expected == TYPE_F32 {
        if actual == TYPE_FLOAT_LIT { return 1; }
    }
    if expected == TYPE_I64 {
        if actual == TYPE_I32  { return 1; }
        if actual == TYPE_CHAR { return 1; }
        if actual == TYPE_U8   { return 1; }
    }
    if expected == TYPE_I32 {
        if actual == TYPE_CHAR { return 1; }
        if actual == TYPE_U8   { return 1; }
    }
    if expected == TYPE_CHAR {
        if actual == TYPE_U8 { return 1; }
    }
    return 0;
}

fn resolve_binary_op_type(t1: i64, t2: i64): i64 {
    if t1 == TYPE_ARRAY   { return TYPE_NONE; }
    if t2 == TYPE_ARRAY   { return TYPE_NONE; }
    if t1 >= TYPE_STRUCT  { return TYPE_NONE; }
    if t2 >= TYPE_STRUCT  { return TYPE_NONE; }
    if t1 == t2 { return t1; }
    if (type_is_float(t1) == 1) | (type_is_float(t2) == 1) {
        if (t1 == TYPE_F64) | (t2 == TYPE_F64) { return TYPE_F64; }
        if (t1 == TYPE_F32) | (t2 == TYPE_F32) { return TYPE_F32; }
        return TYPE_F64;
    }
    if t1 == TYPE_INT_LIT {
        if type_is_integer(t2) == 1 { return t2; }
    }
    if t2 == TYPE_INT_LIT {
        if type_is_integer(t1) == 1 { return t1; }
    }
    if t1 == TYPE_I64 {
        if type_is_integer(t2) == 1 { return TYPE_I64; }
    }
    if t2 == TYPE_I64 {
        if type_is_integer(t1) == 1 { return TYPE_I64; }
    }
    if t1 == TYPE_I32 {
        if t2 == TYPE_CHAR { return TYPE_I32; }
        if t2 == TYPE_U8 { return TYPE_I32; }
    }
    if t2 == TYPE_I32 {
        if t1 == TYPE_CHAR { return TYPE_I32; }
        if t1 == TYPE_U8 { return TYPE_I32; }
    }
    if t1 == TYPE_CHAR {
        if t2 == TYPE_U8 { return TYPE_CHAR; }
    }
    if t2 == TYPE_CHAR {
        if t1 == TYPE_U8 { return TYPE_CHAR; }
    }
    return TYPE_NONE;
}

fn resolve_cmp_type(t1: i64, t2: i64, op: i64): i64 {
    if t1 == TYPE_ARRAY   { return -43; }
    if t2 == TYPE_ARRAY   { return -43; }
    if t1 >= TYPE_STRUCT  { return -43; }
    if t2 >= TYPE_STRUCT  { return -43; }
    if (type_is_float(t1) == 1) | (type_is_float(t2) == 1) {
        return TYPE_BOOL;
    }
    if t1 == TYPE_STR {
        if t2 == TYPE_STR {
            if op == TOKEN_EQUAL_EQUAL { return TYPE_BOOL; }
            if op == TOKEN_NOT_EQUAL   { return TYPE_BOOL; }
            return -43;
        }
        if t2 == TYPE_INT_LIT {
            if op == TOKEN_EQUAL_EQUAL { return TYPE_BOOL; }
            if op == TOKEN_NOT_EQUAL   { return TYPE_BOOL; }
            return -43;
        }
        return -43;
    }
    if t2 == TYPE_STR {
        if t1 == TYPE_INT_LIT {
            if op == TOKEN_EQUAL_EQUAL { return TYPE_BOOL; }
            if op == TOKEN_NOT_EQUAL   { return TYPE_BOOL; }
            return -43;
        }
        return -43;
    }
    if t1 == TYPE_PTR {
        if t2 == TYPE_PTR {
            if op == TOKEN_EQUAL_EQUAL { return TYPE_BOOL; }
            if op == TOKEN_NOT_EQUAL   { return TYPE_BOOL; }
            return -44;
        }
        if t2 == TYPE_INT_LIT {
            if op == TOKEN_EQUAL_EQUAL { return TYPE_BOOL; }
            if op == TOKEN_NOT_EQUAL   { return TYPE_BOOL; }
            return -44;
        }
        return -44;
    }
    if t2 == TYPE_PTR {
        if t1 == TYPE_INT_LIT {
            if op == TOKEN_EQUAL_EQUAL { return TYPE_BOOL; }
            if op == TOKEN_NOT_EQUAL   { return TYPE_BOOL; }
            return -44;
        }
        return -44;
    }
    if t1 == TYPE_BOOL {
        if t2 == TYPE_BOOL {
            if op == TOKEN_EQUAL_EQUAL { return TYPE_BOOL; }
            if op == TOKEN_NOT_EQUAL   { return TYPE_BOOL; }
            return -43;
        }
        return -43;
    }
    if t2 == TYPE_BOOL {
        return -43;
    }
    if type_is_integer(t1) == 1 {
        if type_is_integer(t2) == 1 {
            let common = resolve_binary_op_type(t1, t2);
            if common != TYPE_NONE {
                return TYPE_BOOL;
            }
        }
    }
    return -43;
}


fn tir_validate_cast(src_t: i64, dst_t: i64, src_pointee: i64, dst_pointee: i64): i64 {
    if src_t == TYPE_VOID { return -45; } # ERR_VOID_EXPR_USED
    if dst_t == TYPE_VOID { return -48; } # ERR_INVALID_CAST
    if src_t == TYPE_NONE { return -48; }
    if dst_t == TYPE_NONE { return -48; }
    if src_t == TYPE_ARRAY { return -48; }
    if dst_t == TYPE_ARRAY { return -48; }
    if src_t >= TYPE_STRUCT { return -48; }
    if dst_t >= TYPE_STRUCT { return -48; }

    # String conversions
    if src_t == TYPE_STR {
        if dst_t == TYPE_PTR {
            # s as *u8 or s as ptr
            if dst_pointee == TYPE_U8 { return 1; }
            if dst_pointee == TYPE_NONE { return 1; }
            return -48;
        }
        return -48; # Cannot cast str to integer or bool
    }
    if dst_t == TYPE_STR {
        if src_t == TYPE_PTR {
            # p as str (*u8 as str, ptr as str)
            return 1;
        }
        return -48; # Cannot cast scalar to str
    }

    # Pointer conversions
    if src_t == TYPE_PTR {
        if dst_t == TYPE_PTR {
            return 1; # Valid pointer cast (*T as ptr, ptr as *T, *T as *U)
        }
        if dst_t == TYPE_I64 {
            return 1; # Valid pointer-to-i64 cast (*T as i64)
        }
        return -48; # Cannot cast pointer to other types
    }

    # Integer to pointer conversions
    if dst_t == TYPE_PTR {
        if (src_t == TYPE_I64) | (src_t == TYPE_INT_LIT) {
            return 1; # Valid i64-to-pointer cast (i64 as *T, 0 as *T)
        }
        return -48; # Cannot cast other types to pointer
    }

    # Scalar conversions (integers, floats, bool, int literals)
    if (type_is_float(src_t) == 1) | (type_is_float(dst_t) == 1) {
        if (type_is_integer(src_t) == 1) | (type_is_float(src_t) == 1) {
            if (type_is_integer(dst_t) == 1) | (type_is_float(dst_t) == 1) {
                return 1;
            }
        }
    }
    if type_is_integer(src_t) == 1 {
        if type_is_integer(dst_t) == 1 { return 1; }
        if dst_t == TYPE_BOOL { return 1; }
        return -48;
    }
    if src_t == TYPE_BOOL {
        if type_is_integer(dst_t) == 1 { return 1; }
        if dst_t == TYPE_BOOL { return 1; }
        return -48;
    }

    return -48;
}

fn tir_validate_main(param_count: i64, ret_type: i64, t0: i64, t1: i64): i64 {
    if type_is_integer(ret_type) != 1 {
        return -49; # ERR_INVALID_MAIN (must return integer type: i64, i32, u8)
    }
    if param_count == 0 {
        return 1; # fn main(): integer is valid
    }
    if param_count != 2 {
        return -49; # ERR_INVALID_MAIN (must have 0 or 2 params)
    }
    if t0 != TYPE_I64 {
        return -49; # ERR_INVALID_MAIN (invalid argc type: must be i64)
    }
    if t1 != TYPE_PTR {
        if t1 != TYPE_I64 {
            return -49; # ERR_INVALID_MAIN (invalid argv type: must be *ptr or ptr)
        }
    }
    return 1;
}


# Direct x86-64 machine-code emitter


fn emit_byte(buf: i64, len: i64, b: i64): i64 {
    set_byte(buf, len, b);
    return len + 1;
}

fn emit_add_rax_imm32(buf: i64, len: i64, offset: i64): i64 {
    let l = len;
    if offset == 0 {
        return l;
    }
    if offset >= -128 {
        if offset <= 127 {
            # add rax, imm8 (48 83 C0 ib)
            let b = offset;
            if b < 0 { b = b + 256; }
            l = emit_byte(buf, l, 72);
            l = emit_byte(buf, l, 131);
            l = emit_byte(buf, l, 192);
            l = emit_byte(buf, l, b);
            return l;
        }
    }
    # add rax, imm32 (48 05 disp32)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 5);
    l = emit_disp32(buf, l, offset);
    return l;
}

fn emit_field_load_typed(buf: i64, len: i64, offset: i64, type_id: i64): i64 {
    let l = len;
    if offset == 0 {
        return emit_deref_load_typed(buf, l, type_id);
    }
    if offset < 128 {
        let disp8 = offset % 256;
        if (type_id == TYPE_I32) | (type_id == TYPE_CHAR) {
            # movsxd rax, dword ptr [rax + disp8] (48 63 40 disp8)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 99); l = emit_byte(buf, l, 64); l = emit_byte(buf, l, disp8);
            return l;
        }
        if type_id == TYPE_U8 {
            # movzx eax, byte ptr [rax + disp8] (0F B6 40 disp8)
            l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 64); l = emit_byte(buf, l, disp8);
            return l;
        }
        if type_id == TYPE_BOOL {
            l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 64); l = emit_byte(buf, l, disp8);
            return l;
        }
        # TYPE_I64 / TYPE_PTR / TYPE_STR / default: mov rax, [rax + disp8] (48 8B 40 disp8)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 64); l = emit_byte(buf, l, disp8);
        return l;
    }
    # offset >= 128: 32-bit displacement (ModRM = 0x80 = 128)
    if (type_id == TYPE_I32) | (type_id == TYPE_CHAR) {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 99); l = emit_byte(buf, l, 128);
        l = emit_disp32(buf, l, offset);
        return l;
    }
    if type_id == TYPE_U8 {
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 128);
        l = emit_disp32(buf, l, offset);
        return l;
    }
    if type_id == TYPE_BOOL {
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 128);
        l = emit_disp32(buf, l, offset);
        return l;
    }
    # TYPE_I64 / TYPE_PTR / TYPE_STR / default: mov rax, [rax + disp32] (48 8B 80 disp32)
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 128);
    l = emit_disp32(buf, l, offset);
    return l;
}

fn emit_field_store_typed(buf: i64, len: i64, offset: i64, type_id: i64): i64 {
    let l = len;
    if offset == 0 {
        return emit_deref_store_typed(buf, l, type_id);
    }
    if offset < 128 {
        let disp8 = offset % 256;
        if (type_id == TYPE_I32) | (type_id == TYPE_CHAR) {
            # mov [rcx + disp8], eax (89 41 disp8)
            l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 65); l = emit_byte(buf, l, disp8);
            return l;
        }
        if type_id == TYPE_U8 {
            # mov [rcx + disp8], al (88 41 disp8)
            l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 65); l = emit_byte(buf, l, disp8);
            return l;
        }
        if type_id == TYPE_BOOL {
            l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 65); l = emit_byte(buf, l, disp8);
            return l;
        }
        # TYPE_I64 / TYPE_PTR / default: mov [rcx + disp8], rax (48 89 41 disp8)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 65); l = emit_byte(buf, l, disp8);
        return l;
    }
    # offset >= 128: 32-bit displacement (ModRM = 0x81 = 129)
    if (type_id == TYPE_I32) | (type_id == TYPE_CHAR) {
        l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 129);
        l = emit_disp32(buf, l, offset);
        return l;
    }
    if type_id == TYPE_U8 {
        l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 129);
        l = emit_disp32(buf, l, offset);
        return l;
    }
    if type_id == TYPE_BOOL {
        l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 129);
        l = emit_disp32(buf, l, offset);
        return l;
    }
    # TYPE_I64 / TYPE_PTR / default: mov [rcx + disp32], rax (48 89 81 disp32)
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 129);
    l = emit_disp32(buf, l, offset);
    return l;
}

fn emit_mov_imm64(buf: i64, len: i64, reg: i64, imm: i64): i64 {
    let l = len;
    if reg == 0 {
        if imm == 0 {
            # xor eax, eax (31 C0) - zeroes rax in 2 bytes
            l = emit_byte(buf, l, 49);
            l = emit_byte(buf, l, 192);
            return l;
        }
    }
    # Optimization: use 32-bit form (5 bytes) for constants in [0, 2147483647].
    # mov eax/ecx/edx/ebx, imm32 zero-extends to 64 bits — correct for non-negative values.
    # This saves 5 bytes per constant load vs the 10-byte REX.W mov rax, imm64.
    if imm >= 0 {
        if imm <= 2147483647 {
            if reg < 4 {
                # mov e[ax/cx/dx/bx], imm32 — no REX prefix needed for low 8 regs
                l = emit_byte(buf, l, 184 + reg); # B8+rd
                l = emit_byte(buf, l, imm & 255);
                l = emit_byte(buf, l, (imm >> 8) & 255);
                l = emit_byte(buf, l, (imm >> 16) & 255);
                l = emit_byte(buf, l, (imm >> 24) & 255);
                return l;
            }
        }
    }
    # REX.W (48) for full 64-bit immediate or r8-r15
    l = emit_byte(buf, l, 72);
    # 0xB8 + reg
    l = emit_byte(buf, l, 184 + reg);

    # 8-byte little endian immediate
    let n = imm;
    let i = 0;
    while i < 8 {
        l = emit_byte(buf, l, n & 255);
        n = n >> 8;
        i = i + 1;
    }
    return l;
}

# ==============================================================================
# emit_mul_by_const: multiply rax by small constant using LEA or SHL.
# Avoids push/pop + imul sequence for constants 2,3,4,5,8,9.
# Returns new len, or -1 if constant not handled (caller falls back to imul).
# rax = rax * k on exit.
# ==============================================================================
fn emit_mul_by_const(buf: i64, len: i64, k: i64): i64 {
    let l = len;
    if k == 1 {
        # x * 1 = x — identity, no instruction needed
        return l;
    }
    if k == 2 {
        # shl rax, 1 (48 D1 E0)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 209); l = emit_byte(buf, l, 224);
        return l;
    }
    if k == 3 {
        # lea rax, [rax + rax*2] (48 8D 04 40)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 141); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 64);
        return l;
    }
    if k == 4 {
        # shl rax, 2 (48 C1 E0 02)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 224); l = emit_byte(buf, l, 2);
        return l;
    }
    if k == 5 {
        # lea rax, [rax + rax*4] (48 8D 04 80)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 141); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 128);
        return l;
    }
    if k == 8 {
        # shl rax, 3 (48 C1 E0 03)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 224); l = emit_byte(buf, l, 3);
        return l;
    }
    if k == 9 {
        # lea rax, [rax + rax*8] (48 8D 04 C0)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 141); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 192);
        return l;
    }
    return -1;
}



# ------------------------------------------------------------------------------
# emit_div_by_const(buf, len, d) -> new_len or -1
# Emits code to divide rax (signed i64) by constant d (d > 0).
# Output: rax = rax / d  (signed truncation toward zero)
# Clobbers: rdx, rdi (push/pop to preserve rdi)
# Uses GCC-style multiplicative inverse — eliminates idiv entirely.
# ------------------------------------------------------------------------------
fn emit_div_by_const(buf: i64, len: i64, d: i64): i64 {
    let l = len;
    # Power-of-2: signed division by 2^k needs rounding correction
    # GCC pattern: mov rcx,rax; sar rcx,63; shr rcx,(64-k); add rax,rcx; sar rax,k
    if d == 2 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 193); # mov rcx,rax
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 249); l = emit_byte(buf, l, 63); # sar rcx,63
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 233); l = emit_byte(buf, l, 63); # shr rcx,63
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 200); # add rax,rcx
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 209); l = emit_byte(buf, l, 248); # sar rax,1
        return l;
    }
    if d == 4 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 193);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 249); l = emit_byte(buf, l, 63);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 233); l = emit_byte(buf, l, 62);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 200);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 248); l = emit_byte(buf, l, 2);
        return l;
    }
    if d == 8 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 193);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 249); l = emit_byte(buf, l, 63);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 233); l = emit_byte(buf, l, 61);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 200);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 248); l = emit_byte(buf, l, 3);
        return l;
    }
    if d == 16 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 193);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 249); l = emit_byte(buf, l, 63);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 233); l = emit_byte(buf, l, 60);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 200);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 248); l = emit_byte(buf, l, 4);
        return l;
    }
    if d == 32 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 193);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 249); l = emit_byte(buf, l, 63);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 233); l = emit_byte(buf, l, 59);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 200);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 248); l = emit_byte(buf, l, 5);
        return l;
    }
    if d == 64 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 193);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 249); l = emit_byte(buf, l, 63);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 233); l = emit_byte(buf, l, 58);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 200);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 248); l = emit_byte(buf, l, 6);
        return l;
    }

    # Magic multiplier for non-power-of-2 divisors.
    # Encodings of magic as two 32-bit halves (in decimal to avoid hex literals).
    # magic = magic_hi * 2^32 + magic_lo  (both unsigned 32-bit)
    # Scratch register r11 is caller-saved and avoids stack pushes:
    #   mov r11, rax      (49 89 C3)
    #   movabs rax, magic (48 B8 lo0 lo1 lo2 lo3 hi0 hi1 hi2 hi3)
    #   imul r11          (49 F7 EB) -> rdx:rax = magic * x, rdx = high64
    #   [add rdx, r11]    (4C 01 DA) -> if post_add
    #   sar r11, 63       (49 C1 FB 3F) -> r11 = sign(x): 0 or -1
    #   [sar rdx, sh]     -> if sh > 0
    #   mov rax, rdx      (48 89 D0)
    #   sub rax, r11      (4C 29 D8) -> rax = quotient
    let magic_lo = 0;
    let magic_hi = 0;
    let sh = 0;
    let post_add = 0;
    # d=3: 0x5555555555555556, sh=0
    if d == 3  { magic_lo = 1431655766; magic_hi = 1431655765; sh = 0; post_add = 0; }
    # d=5: 0x6666666666666667, sh=1
    if d == 5  { magic_lo = 1717986919; magic_hi = 1717986918; sh = 1; post_add = 0; }
    # d=6: 0x2aaaaaaaaaaaaaab, sh=0
    if d == 6  { magic_lo = 2863311531; magic_hi = 715827882; sh = 0; post_add = 0; }
    # d=7: 0x4924924924924925, sh=1
    if d == 7  { magic_lo = 613566757; magic_hi = 1227133513; sh = 1; post_add = 0; }
    # d=9: 0x1c71c71c71c71c72, sh=0
    if d == 9  { magic_lo = 1908874354; magic_hi = 477218588; sh = 0; post_add = 0; }
    # d=10: 0x6666666666666667, sh=2
    if d == 10 { magic_lo = 1717986919; magic_hi = 1717986918; sh = 2; post_add = 0; }
    # d=11: 0x2e8ba2e8ba2e8ba3, sh=1
    if d == 11 { magic_lo = 3123612579; magic_hi = 780903144; sh = 1; post_add = 0; }
    # d=12: 0x2aaaaaaaaaaaaaab, sh=1
    if d == 12 { magic_lo = 2863311531; magic_hi = 715827882; sh = 1; post_add = 0; }
    # d=13: 0x4ec4ec4ec4ec4ec5, sh=2
    if d == 13 { magic_lo = 3303820997; magic_hi = 1321528398; sh = 2; post_add = 0; }
    # d=14: 0x4924924924924925, sh=2
    if d == 14 { magic_lo = 613566757; magic_hi = 1227133513; sh = 2; post_add = 0; }
    # d=15: 0x8888888888888889, sh=3, post_add=1
    if d == 15 { magic_lo = 2290649225; magic_hi = 2290649224; sh = 3; post_add = 1; }
    # d=17: 0x7878787878787879, sh=3
    if d == 17 { magic_lo = 2021161081; magic_hi = 2021161080; sh = 3; post_add = 0; }
    # d=18: 0xe38e38e38e38e39, sh=0
    if d == 18 { magic_lo = 954437177; magic_hi = 238609294; sh = 0; post_add = 0; }
    # d=20: 0x6666666666666667, sh=3
    if d == 20 { magic_lo = 1717986919; magic_hi = 1717986918; sh = 3; post_add = 0; }
    # d=24: 0x2aaaaaaaaaaaaaab, sh=2
    if d == 24 { magic_lo = 2863311531; magic_hi = 715827882; sh = 2; post_add = 0; }
    # d=25: 0xa3d70a3d70a3d70b, sh=4, post_add=1
    if d == 25 { magic_lo = 1889785611; magic_hi = 2748779069; sh = 4; post_add = 1; }
    # d=30: 0x8888888888888889, sh=4, post_add=1
    if d == 30 { magic_lo = 2290649225; magic_hi = 2290649224; sh = 4; post_add = 1; }
    # d=60: 0x8888888888888889, sh=5, post_add=1
    if d == 60 { magic_lo = 2290649225; magic_hi = 2290649224; sh = 5; post_add = 1; }
    # d=100: 0xa3d70a3d70a3d70b, sh=6, post_add=1
    if d == 100 { magic_lo = 1889785611; magic_hi = 2748779069; sh = 6; post_add = 1; }

    if magic_lo == 0 {
        if magic_hi == 0 {
            return -1;
        }
    }

    l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 195); # mov r11,rax
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 184); # movabs rax, (next 8 bytes)
    l = emit_byte(buf, l, magic_lo & 255);
    l = emit_byte(buf, l, (magic_lo >> 8) & 255);
    l = emit_byte(buf, l, (magic_lo >> 16) & 255);
    l = emit_byte(buf, l, (magic_lo >> 24) & 255);
    l = emit_byte(buf, l, magic_hi & 255);
    l = emit_byte(buf, l, (magic_hi >> 8) & 255);
    l = emit_byte(buf, l, (magic_hi >> 16) & 255);
    l = emit_byte(buf, l, (magic_hi >> 24) & 255);
    l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 247); l = emit_byte(buf, l, 235); # imul r11
    if post_add == 1 {
        l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 218); # add rdx,r11
    }
    l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 251); l = emit_byte(buf, l, 63); # sar r11,63
    if sh == 1 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 209); l = emit_byte(buf, l, 250); # sar rdx,1
    }
    if sh > 1 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 250); l = emit_byte(buf, l, sh); # sar rdx,sh
    }
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 208); # mov rax,rdx
    l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 41); l = emit_byte(buf, l, 216); # sub rax,r11
    return l;
}

# ------------------------------------------------------------------------------
# emit_mod_by_const(buf, len, d) -> new_len or -1
# rax = rax % d  (signed, truncation toward zero)
# Strategy: save x in rcx; emit x/d into rax; rax = x - q*d (via rcx)
# ------------------------------------------------------------------------------
fn emit_mod_by_const(buf: i64, len: i64, d: i64): i64 {
    let l = len;
    # Power-of-2 modulo: use signed-AND trick (no idiv, no extra scratch needed)
    # Formula: x % 2^k = (x + sign_adj) & (2^k-1) - sign_adj
    # Sequence: mov rdx,rax; sar rdx,63; shr rdx,(64-k); add rax,rdx; and rax,(2^k-1); sub rax,rdx
    if d == 2 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 194); # mov rdx,rax
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 250); l = emit_byte(buf, l, 63); # sar rdx,63
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 234); l = emit_byte(buf, l, 63); # shr rdx,63
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 208); # add rax,rdx
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 224); l = emit_byte(buf, l, 1); # and rax,1
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 41); l = emit_byte(buf, l, 208); # sub rax,rdx
        return l;
    }
    if d == 4 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 194);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 250); l = emit_byte(buf, l, 63);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 234); l = emit_byte(buf, l, 62); # shr rdx,62
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 208);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 224); l = emit_byte(buf, l, 3); # and rax,3
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 41); l = emit_byte(buf, l, 208);
        return l;
    }
    if d == 8 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 194);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 250); l = emit_byte(buf, l, 63);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 234); l = emit_byte(buf, l, 61); # shr rdx,61
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 208);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 224); l = emit_byte(buf, l, 7); # and rax,7
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 41); l = emit_byte(buf, l, 208);
        return l;
    }
    if d == 16 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 194);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 250); l = emit_byte(buf, l, 63);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 234); l = emit_byte(buf, l, 60); # shr rdx,60
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 208);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 224); l = emit_byte(buf, l, 15); # and rax,15
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 41); l = emit_byte(buf, l, 208);
        return l;
    }
    if d == 32 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 194);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 250); l = emit_byte(buf, l, 63);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 234); l = emit_byte(buf, l, 59); # shr rdx,59
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 208);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 224); l = emit_byte(buf, l, 31); # and rax,31
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 41); l = emit_byte(buf, l, 208);
        return l;
    }
    if d == 64 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 194);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 250); l = emit_byte(buf, l, 63);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 234); l = emit_byte(buf, l, 58); # shr rdx,58
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 1); l = emit_byte(buf, l, 208);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 224); l = emit_byte(buf, l, 63); # and rax,63
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 41); l = emit_byte(buf, l, 208);
        return l;
    }
    # Non-power-of-2: check divisor is in table BEFORE emitting any bytes.
    # (Cannot emit then return -1 — that would corrupt the code buffer.)
    let supported = 0;
    if d == 3  { supported = 1; }
    if d == 5  { supported = 1; }
    if d == 6  { supported = 1; }
    if d == 7  { supported = 1; }
    if d == 9  { supported = 1; }
    if d == 10 { supported = 1; }
    if d == 11 { supported = 1; }
    if d == 12 { supported = 1; }
    if d == 13 { supported = 1; }
    if d == 14 { supported = 1; }
    if d == 15 { supported = 1; }
    if d == 17 { supported = 1; }
    if d == 18 { supported = 1; }
    if d == 20 { supported = 1; }
    if d == 24 { supported = 1; }
    if d == 25 { supported = 1; }
    if d == 30 { supported = 1; }
    if d == 60 { supported = 1; }
    if d == 100 { supported = 1; }
    if supported == 0 { return -1; }
    # Now safe to emit: all paths will complete.
    # Strategy: save x in rcx; compute x/d into rax; rax *= d; rcx -= rax; rax = rcx
    # emit_div_by_const uses scratch r11 and clobbers rdx but NOT rcx. Safe.
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 193); # mov rcx,rax
    let div_l = emit_div_by_const(buf, l, d);
    l = div_l;  # div always succeeds since d is supported
    if d == 3  { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 141); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 64); } # lea rax,[rax+rax*2]
    if d == 5  { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 141); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 128); } # lea rax,[rax+rax*4]
    if d == 6  { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 6); }
    if d == 7  { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 7); }
    if d == 9  { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 141); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 192); } # lea rax,[rax+rax*8]
    if d == 10 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 10); }
    if d == 11 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 11); }
    if d == 12 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 12); }
    if d == 13 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 13); }
    if d == 14 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 14); }
    if d == 15 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 15); }
    if d == 17 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 17); }
    if d == 18 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 18); }
    if d == 20 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 20); }
    if d == 24 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 24); }
    if d == 25 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 25); }
    if d == 30 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 30); }
    if d == 60 { l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, 60); }
    if d == 100 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 105); l = emit_byte(buf, l, 192);
        l = emit_byte(buf, l, 100); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0); l = emit_byte(buf, l, 0);
    }
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 41); l = emit_byte(buf, l, 193); # sub rcx,rax
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 200); # mov rax,rcx
    return l;
}


fn emit_disp32(buf: i64, len: i64, disp32: i64): i64 {
    let l = len;
    l = emit_byte(buf, l, disp32 & 255);
    l = emit_byte(buf, l, (disp32 >> 8) & 255);
    l = emit_byte(buf, l, (disp32 >> 16) & 255);
    l = emit_byte(buf, l, (disp32 >> 24) & 255);
    return l;
}

fn emit_store_slot_typed(buf: i64, len: i64, slot: i64, type_id: i64): i64 {
    let l = len;
    if slot < 128 {
        let disp8 = (256 - slot) % 256;
        if (type_id == TYPE_I32) | (type_id == TYPE_F32) | (type_id == TYPE_CHAR) {
            l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8);
            return l;
        }
        if type_id == TYPE_U8 {
            l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8);
            return l;
        }
        if type_id == TYPE_BOOL {
            l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8);
            return l;
        }
        if (type_id == TYPE_OPTION) | (type_id == TYPE_RESULT) | (type_id == TYPE_TUPLE) {
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8);
            let disp8_pay = (disp8 + 8) % 256;
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 85); l = emit_byte(buf, l, disp8_pay);
            return l;
        }
        # TYPE_I64 / TYPE_PTR / default: mov [rbp - disp8], rax (48 89 45 disp8)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8);
        return l;
    }
    # slot >= 128: 32-bit negative displacement (ModRM = 0x85 = 133)
    let disp32 = 4294967296 - slot;
    if (type_id == TYPE_I32) | (type_id == TYPE_F32) | (type_id == TYPE_CHAR) {
        l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 133);
        l = emit_disp32(buf, l, disp32);
        return l;
    }
    if type_id == TYPE_U8 {
        l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 133);
        l = emit_disp32(buf, l, disp32);
        return l;
    }
    if type_id == TYPE_BOOL {
        l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 133);
        l = emit_disp32(buf, l, disp32);
        return l;
    }
    if (type_id == TYPE_OPTION) | (type_id == TYPE_RESULT) | (type_id == TYPE_TUPLE) {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 133);
        l = emit_disp32(buf, l, disp32);
        let disp32_pay = disp32 + 8;
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 149);
        l = emit_disp32(buf, l, disp32_pay);
        return l;
    }
    # TYPE_I64 / TYPE_PTR / default: mov [rbp - disp32], rax (48 89 85 disp32)
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 133);
    l = emit_disp32(buf, l, disp32);
    return l;
}

fn emit_load_slot_typed(buf: i64, len: i64, slot: i64, type_id: i64): i64 {
    let l = len;
    if slot < 128 {
        let disp8 = (256 - slot) % 256;
        if (type_id == TYPE_I32) | (type_id == TYPE_F32) | (type_id == TYPE_CHAR) {
            l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8);
            return l;
        }
        if type_id == TYPE_U8 {
            l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8);
            return l;
        }
        if type_id == TYPE_BOOL {
            l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8);
            return l;
        }
        if (type_id == TYPE_OPTION) | (type_id == TYPE_RESULT) | (type_id == TYPE_TUPLE) {
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8);
            let disp8_pay = (disp8 + 8) % 256;
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 85); l = emit_byte(buf, l, disp8_pay);
            return l;
        }
        # TYPE_I64 / TYPE_PTR / default: mov rax, [rbp - disp8] (48 8B 45 disp8)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8);
        return l;
    }
    # slot >= 128: 32-bit negative displacement (ModRM = 0x85 = 133)
    let disp32 = 4294967296 - slot;
    if (type_id == TYPE_I32) | (type_id == TYPE_F32) | (type_id == TYPE_CHAR) {
        l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 133);
        l = emit_disp32(buf, l, disp32);
        return l;
    }
    if type_id == TYPE_U8 {
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 133);
        l = emit_disp32(buf, l, disp32);
        return l;
    }
    if type_id == TYPE_BOOL {
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 133);
        l = emit_disp32(buf, l, disp32);
        return l;
    }
    if (type_id == TYPE_OPTION) | (type_id == TYPE_RESULT) | (type_id == TYPE_TUPLE) {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 133);
        l = emit_disp32(buf, l, disp32);
        let disp32_pay = disp32 + 8;
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 149);
        l = emit_disp32(buf, l, disp32_pay);
        return l;
    }
    # TYPE_I64 / TYPE_PTR / default: mov rax, [rbp - disp32] (48 8B 85 disp32)
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 133);
    l = emit_disp32(buf, l, disp32);
    return l;
}


fn emit_jmp_rel32(buf: i64, len: i64, disp: i64): i64 {
    let l = len;
    l = emit_byte(buf, l, 233); # 0xE9
    let n = disp;
    if n < 0 { n = n + 4294967296; }
    l = emit_byte(buf, l, n % 256);
    l = emit_byte(buf, l, (n / 256) % 256);
    l = emit_byte(buf, l, (n / 65536) % 256);
    l = emit_byte(buf, l, (n / 16777216) % 256);
    return l;
}

fn emit_je_rel32(buf: i64, len: i64, disp: i64): i64 {
    let l = len;
    l = emit_byte(buf, l, 15);  # 0x0F
    l = emit_byte(buf, l, 132); # 0x84
    let n = disp;
    if n < 0 { n = n + 4294967296; }
    l = emit_byte(buf, l, n % 256);
    l = emit_byte(buf, l, (n / 256) % 256);
    l = emit_byte(buf, l, (n / 65536) % 256);
    l = emit_byte(buf, l, (n / 16777216) % 256);
    return l;
}

fn emit_call_rel32(buf: i64, len: i64, disp: i64): i64 {
    let l = len;
    l = emit_byte(buf, l, 232); # 0xE8
    let n = disp;
    if n < 0 { n = n + 4294967296; }
    l = emit_byte(buf, l, n % 256);
    l = emit_byte(buf, l, (n / 256) % 256);
    l = emit_byte(buf, l, (n / 65536) % 256);
    l = emit_byte(buf, l, (n / 16777216) % 256);
    return l;
}

fn emit_store_param_typed(buf: i64, len: i64, param_idx: i64, slot: i64, type_id: i64): i64 {
    let l = len;
    let disp8 = (256 - slot) % 256;
    if (type_id == TYPE_I32) | (type_id == TYPE_CHAR) {
        if param_idx == 0 { l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 125); l = emit_byte(buf, l, disp8); return l; } # EDI (89 7D disp8)
        if param_idx == 1 { l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 117); l = emit_byte(buf, l, disp8); return l; } # ESI (89 75 disp8)
        if param_idx == 2 { l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 85);  l = emit_byte(buf, l, disp8); return l; } # EDX (89 55 disp8)
        if param_idx == 3 { l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 77);  l = emit_byte(buf, l, disp8); return l; } # ECX (89 4D disp8)
        if param_idx == 4 { l = emit_byte(buf, l, 68);  l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8); return l; } # R8D (44 89 45 disp8)
        if param_idx == 5 { l = emit_byte(buf, l, 68);  l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 77); l = emit_byte(buf, l, disp8); return l; } # R9D (44 89 4D disp8)
        return l;
    }
    if type_id == TYPE_U8 {
        if param_idx == 0 { l = emit_byte(buf, l, 64); l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 125); l = emit_byte(buf, l, disp8); return l; } # DIL (40 88 7D disp8)
        if param_idx == 1 { l = emit_byte(buf, l, 64); l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 117); l = emit_byte(buf, l, disp8); return l; } # SIL (40 88 75 disp8)
        if param_idx == 2 { l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 85);  l = emit_byte(buf, l, disp8); return l; } # DL (88 55 disp8)
        if param_idx == 3 { l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 77);  l = emit_byte(buf, l, disp8); return l; } # CL (88 4D disp8)
        if param_idx == 4 { l = emit_byte(buf, l, 68);  l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8); return l; } # R8B (44 88 45 disp8)
        if param_idx == 5 { l = emit_byte(buf, l, 68);  l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 77); l = emit_byte(buf, l, disp8); return l; } # R9B (44 88 4D disp8)
        return l;
    }
    if type_id == TYPE_BOOL {
        if param_idx == 0 { l = emit_byte(buf, l, 64); l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 125); l = emit_byte(buf, l, disp8); return l; } # DIL
        if param_idx == 1 { l = emit_byte(buf, l, 64); l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 117); l = emit_byte(buf, l, disp8); return l; } # SIL
        if param_idx == 2 { l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 85);  l = emit_byte(buf, l, disp8); return l; } # DL
        if param_idx == 3 { l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 77);  l = emit_byte(buf, l, disp8); return l; } # CL
        if param_idx == 4 { l = emit_byte(buf, l, 68);  l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8); return l; } # R8B
        if param_idx == 5 { l = emit_byte(buf, l, 68);  l = emit_byte(buf, l, 136); l = emit_byte(buf, l, 77); l = emit_byte(buf, l, disp8); return l; } # R9B
        return l;
    }
    # TYPE_I64 / TYPE_PTR / default: 64-bit store
    if param_idx == 0 { # RDI (48 89 7D disp8)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 125); l = emit_byte(buf, l, disp8); return l;
    }
    if param_idx == 1 { # RSI (48 89 75 disp8)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 117); l = emit_byte(buf, l, disp8); return l;
    }
    if param_idx == 2 { # RDX (48 89 55 disp8)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 85); l = emit_byte(buf, l, disp8); return l;
    }
    if param_idx == 3 { # RCX (48 89 4D disp8)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 77); l = emit_byte(buf, l, disp8); return l;
    }
    if param_idx == 4 { # R8 (49 89 45 disp8)
        l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 69); l = emit_byte(buf, l, disp8); return l;
    }
    if param_idx == 5 { # R9 (49 89 4D disp8)
        l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 77); l = emit_byte(buf, l, disp8); return l;
    }
    return l;
}

fn emit_mov_reg_rsp_disp(buf: i64, len: i64, reg_idx: i64, disp: i64): i64 {
    let l = len;
    if reg_idx == 0 { # RDI
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139);
        if disp <= 127 {
            l = emit_byte(buf, l, 124); l = emit_byte(buf, l, 36); l = emit_byte(buf, l, disp);
        } else {
            l = emit_byte(buf, l, 188); l = emit_byte(buf, l, 36); l = emit_disp32(buf, l, disp);
        }
        return l;
    }
    if reg_idx == 1 { # RSI
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139);
        if disp <= 127 {
            l = emit_byte(buf, l, 116); l = emit_byte(buf, l, 36); l = emit_byte(buf, l, disp);
        } else {
            l = emit_byte(buf, l, 180); l = emit_byte(buf, l, 36); l = emit_disp32(buf, l, disp);
        }
        return l;
    }
    if reg_idx == 2 { # RDX
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139);
        if disp <= 127 {
            l = emit_byte(buf, l, 84); l = emit_byte(buf, l, 36); l = emit_byte(buf, l, disp);
        } else {
            l = emit_byte(buf, l, 148); l = emit_byte(buf, l, 36); l = emit_disp32(buf, l, disp);
        }
        return l;
    }
    if reg_idx == 3 { # RCX
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139);
        if disp <= 127 {
            l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 36); l = emit_byte(buf, l, disp);
        } else {
            l = emit_byte(buf, l, 140); l = emit_byte(buf, l, 36); l = emit_disp32(buf, l, disp);
        }
        return l;
    }
    if reg_idx == 4 { # R8
        l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 139);
        if disp <= 127 {
            l = emit_byte(buf, l, 68); l = emit_byte(buf, l, 36); l = emit_byte(buf, l, disp);
        } else {
            l = emit_byte(buf, l, 132); l = emit_byte(buf, l, 36); l = emit_disp32(buf, l, disp);
        }
        return l;
    }
    if reg_idx == 5 { # R9
        l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 139);
        if disp <= 127 {
            l = emit_byte(buf, l, 76); l = emit_byte(buf, l, 36); l = emit_byte(buf, l, disp);
        } else {
            l = emit_byte(buf, l, 140); l = emit_byte(buf, l, 36); l = emit_disp32(buf, l, disp);
        }
        return l;
    }
    return l;
}

fn emit_lea_slot(buf: i64, len: i64, slot: i64): i64 {
    let l = len;
    if slot < 128 {
        let disp8 = (256 - slot) % 256;
        # lea rax, [rbp - disp8] (48 8D 45 disp8)
        l = emit_byte(buf, l, 72);
        l = emit_byte(buf, l, 141);
        l = emit_byte(buf, l, 69);
        l = emit_byte(buf, l, disp8);
        return l;
    }
    # slot >= 128: 32-bit negative displacement (ModRM = 0x85 = 133)
    let disp32 = 4294967296 - slot;
    # lea rax, [rbp - disp32] (48 8D 85 disp32)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 141);
    l = emit_byte(buf, l, 133);
    l = emit_disp32(buf, l, disp32);
    return l;
}


# ==============================================================================
# emit_bin_op_imm64: binary op where LHS is in rax, RHS is a known immediate.
# Avoids push/pop entirely — emits register-immediate form in 3-7 bytes.
# Returns new len. The result is left in rax.
# Handles: TOKEN_PLUS, TOKEN_MINUS, TOKEN_AMP, TOKEN_PIPE, TOKEN_CARET,
#          TOKEN_SHL, TOKEN_SHR, TOKEN_STAR (via LEA/imul), TOKEN_PERCENT (mod),
#          TOKEN_EQUAL_EQUAL, TOKEN_NOT_EQUAL, TOKEN_LESS, TOKEN_GREATER,
#          TOKEN_LESS_EQ, TOKEN_GREATER_EQ.
# Returns -1 if not handled (caller falls back to push/pop form).
# ==============================================================================
fn emit_bin_op_imm64(buf: i64, len: i64, op: i64, imm: i64, type_id: i64): i64 {
    let l = len;
    # We only handle TYPE_I64 / TYPE_INT_LIT for now (most common hot path).
    if type_id != TYPE_I64 {
        if type_id != TYPE_INT_LIT {
            return -1;
        }
    }

    # Immediate forms: prefer imm8 (3 bytes) when imm fits in [-128,127].
    let is_imm8 = 0;
    if imm >= -128 {
        if imm <= 127 {
            is_imm8 = 1;
        }
    }
    let is_imm32 = 0;
    if imm >= -2147483648 {
        if imm <= 2147483647 {
            is_imm32 = 1;
        }
    }

    if op == TOKEN_PLUS {
        if imm == 1 {
            # inc rax (48 FF C0)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 192);
            return l;
        }
        if imm == -1 {
            # dec rax (48 FF C8)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 200);
            return l;
        }
        if is_imm8 == 1 {
            # add rax, imm8 (48 83 C0 ib)
            let b = imm;
            if b < 0 { b = b + 256; }
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, b & 255);
            return l;
        }
        if is_imm32 == 1 {
            # add rax, imm32 (48 81 C0 id)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 129); l = emit_byte(buf, l, 192);
            l = emit_disp32(buf, l, imm);
            return l;
        }
        return -1;
    }

    if op == TOKEN_MINUS {
        if imm == 1 {
            # dec rax (48 FF C8)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 200);
            return l;
        }
        if imm == -1 {
            # inc rax
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 255); l = emit_byte(buf, l, 192);
            return l;
        }
        if is_imm8 == 1 {
            # sub rax, imm8 (48 83 E8 ib)
            let b = imm;
            if b < 0 { b = b + 256; }
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 232); l = emit_byte(buf, l, b & 255);
            return l;
        }
        if is_imm32 == 1 {
            # sub rax, imm32 (48 81 E8 id)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 129); l = emit_byte(buf, l, 232);
            l = emit_disp32(buf, l, imm);
            return l;
        }
        return -1;
    }

    if op == TOKEN_STAR {
        let new_l = emit_mul_by_const(buf, l, imm);
        if new_l >= 0 { return new_l; }
        if is_imm32 == 1 {
            # imul rax, rax, imm32 (48 69 C0 id)  or imm8 form (48 6B C0 ib)
            if is_imm8 == 1 {
                let b = imm;
                if b < 0 { b = b + 256; }
                l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 192); l = emit_byte(buf, l, b & 255);
            } else {
                l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 105); l = emit_byte(buf, l, 192);
                l = emit_disp32(buf, l, imm);
            }
            return l;
        }
        return -1;
    }

    if op == TOKEN_AMP {
        if is_imm8 == 1 {
            # and rax, imm8 (48 83 E0 ib)
            let b = imm;
            if b < 0 { b = b + 256; }
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 224); l = emit_byte(buf, l, b & 255);
            return l;
        }
        if is_imm32 == 1 {
            # and rax, imm32 (48 81 E0 id)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 129); l = emit_byte(buf, l, 224);
            l = emit_disp32(buf, l, imm);
            return l;
        }
        return -1;
    }

    if op == TOKEN_PIPE {
        if is_imm8 == 1 {
            # or rax, imm8 (48 83 C8 ib)
            let b = imm;
            if b < 0 { b = b + 256; }
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 200); l = emit_byte(buf, l, b & 255);
            return l;
        }
        if is_imm32 == 1 {
            # or rax, imm32 (48 81 C8 id)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 129); l = emit_byte(buf, l, 200);
            l = emit_disp32(buf, l, imm);
            return l;
        }
        return -1;
    }

    if op == TOKEN_CARET {
        if is_imm8 == 1 {
            # xor rax, imm8 (48 83 F0 ib)
            let b = imm;
            if b < 0 { b = b + 256; }
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 240); l = emit_byte(buf, l, b & 255);
            return l;
        }
        if is_imm32 == 1 {
            # xor rax, imm32 (48 81 F0 id)
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 129); l = emit_byte(buf, l, 240);
            l = emit_disp32(buf, l, imm);
            return l;
        }
        return -1;
    }

    if op == TOKEN_SHL {
        if imm >= 0 {
            if imm <= 63 {
                if imm == 1 {
                    # shl rax, 1 (48 D1 E0) — short form
                    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 209); l = emit_byte(buf, l, 224);
                    return l;
                }
                # shl rax, imm8 (48 C1 E0 ib)
                l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 224); l = emit_byte(buf, l, imm & 63);
                return l;
            }
        }
        return -1;
    }

    if op == TOKEN_SHR {
        if imm >= 0 {
            if imm <= 63 {
                if imm == 1 {
                    # shr rax, 1 (48 D1 E8)
                    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 209); l = emit_byte(buf, l, 232);
                    return l;
                }
                # shr rax, imm8 (48 C1 E8 ib) — LOGICAL right shift
                l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 193); l = emit_byte(buf, l, 232); l = emit_byte(buf, l, imm & 63);
                return l;
            }
        }
        return -1;
    }

    # TOKEN_PERCENT and TOKEN_SLASH use idiv via the standard fallback path.
    # Magic number strength reduction is available but applied via direct call only.
    # Comparisons: cmp rax, imm; setcc al; movzx rax, al
    let is_cmp = 0;
    let cc_byte = 148;
    if op == TOKEN_EQUAL_EQUAL { is_cmp = 1; cc_byte = 148; }
    if op == TOKEN_NOT_EQUAL   { is_cmp = 1; cc_byte = 149; }
    if op == TOKEN_LESS        { is_cmp = 1; cc_byte = 156; }
    if op == TOKEN_GREATER     { is_cmp = 1; cc_byte = 159; }
    if op == TOKEN_LESS_EQ     { is_cmp = 1; cc_byte = 158; }
    if op == TOKEN_GREATER_EQ  { is_cmp = 1; cc_byte = 157; }
    if is_cmp == 1 {
        if is_imm8 == 1 {
            # cmp rax, imm8 (48 83 F8 ib)
            let b = imm;
            if b < 0 { b = b + 256; }
            l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 131); l = emit_byte(buf, l, 248); l = emit_byte(buf, l, b & 255);
        } else {
            if is_imm32 == 1 {
                # cmp rax, imm32 (48 81 F8 id)
                l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 129); l = emit_byte(buf, l, 248);
                l = emit_disp32(buf, l, imm);
            } else {
                return -1;
            }
        }
        # setcc al; movzx rax, al
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, cc_byte); l = emit_byte(buf, l, 192);
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 192);
        return l;
    }

    return -1;
}

fn emit_deref_load_typed(buf: i64, len: i64, pointee_type: i64): i64 {
    let l = len;
    if (pointee_type == TYPE_I32) | (pointee_type == TYPE_CHAR) {
        # movsxd rax, dword ptr [rax] (48 63 00)
        l = emit_byte(buf, l, 72);
        l = emit_byte(buf, l, 99);
        l = emit_byte(buf, l, 0);
        return l;
    }
    if pointee_type == TYPE_U8 {
        # movzx eax, byte ptr [rax] (0F B6 00)
        l = emit_byte(buf, l, 15);
        l = emit_byte(buf, l, 182);
        l = emit_byte(buf, l, 0);
        return l;
    }
    if pointee_type == TYPE_BOOL {
        # movzx eax, byte ptr [rax] (0F B6 00)
        l = emit_byte(buf, l, 15);
        l = emit_byte(buf, l, 182);
        l = emit_byte(buf, l, 0);
        return l;
    }
    # TYPE_I64 / TYPE_PTR / default: mov rax, [rax] (48 8B 00)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 139);
    l = emit_byte(buf, l, 0);
    return l;
}

fn emit_deref_store_typed(buf: i64, len: i64, pointee_type: i64): i64 {
    let l = len;
    if (pointee_type == TYPE_I32) | (pointee_type == TYPE_CHAR) {
        # mov [rcx], eax (89 01)
        l = emit_byte(buf, l, 137);
        l = emit_byte(buf, l, 1);
        return l;
    }
    if pointee_type == TYPE_U8 {
        # mov [rcx], al (88 01)
        l = emit_byte(buf, l, 136);
        l = emit_byte(buf, l, 1);
        return l;
    }
    if pointee_type == TYPE_BOOL {
        # mov [rcx], al (88 01)
        l = emit_byte(buf, l, 136);
        l = emit_byte(buf, l, 1);
        return l;
    }
    # TYPE_I64 / TYPE_PTR / default: mov [rcx], rax (48 89 01)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 137);
    l = emit_byte(buf, l, 1);
    return l;
}

fn emit_index_load_typed(buf: i64, len: i64, pointee_type: i64): i64 {
    let l = len;
    if (pointee_type == TYPE_I32) | (pointee_type == TYPE_CHAR) {
        # movsxd rax, dword ptr [rdi + rsi*4] (48 63 04 B7)
        l = emit_byte(buf, l, 72);
        l = emit_byte(buf, l, 99);
        l = emit_byte(buf, l, 4);
        l = emit_byte(buf, l, 183);
        return l;
    }
    if pointee_type == TYPE_U8 {
        # movzx eax, byte ptr [rdi + rsi] (0F B6 04 37)
        l = emit_byte(buf, l, 15);
        l = emit_byte(buf, l, 182);
        l = emit_byte(buf, l, 4);
        l = emit_byte(buf, l, 55);
        return l;
    }
    if pointee_type == TYPE_BOOL {
        # movzx eax, byte ptr [rdi + rsi] (0F B6 04 37)
        l = emit_byte(buf, l, 15);
        l = emit_byte(buf, l, 182);
        l = emit_byte(buf, l, 4);
        l = emit_byte(buf, l, 55);
        return l;
    }
    # TYPE_I64 / TYPE_PTR / default: mov rax, qword ptr [rdi + rsi*8] (48 8B 04 F7)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 139);
    l = emit_byte(buf, l, 4);
    l = emit_byte(buf, l, 247);
    return l;
}

fn emit_index_store_typed(buf: i64, len: i64, pointee_type: i64): i64 {
    let l = len;
    if (pointee_type == TYPE_I32) | (pointee_type == TYPE_CHAR) {
        # mov dword ptr [rdi + rsi*4], eax (89 04 B7)
        l = emit_byte(buf, l, 137);
        l = emit_byte(buf, l, 4);
        l = emit_byte(buf, l, 183);
        return l;
    }
    if pointee_type == TYPE_U8 {
        # mov byte ptr [rdi + rsi], al (88 04 37)
        l = emit_byte(buf, l, 136);
        l = emit_byte(buf, l, 4);
        l = emit_byte(buf, l, 55);
        return l;
    }
    if pointee_type == TYPE_BOOL {
        # mov byte ptr [rdi + rsi], al (88 04 37)
        l = emit_byte(buf, l, 136);
        l = emit_byte(buf, l, 4);
        l = emit_byte(buf, l, 55);
        return l;
    }
    # TYPE_I64 / TYPE_PTR / default: mov qword ptr [rdi + rsi*8], rax (48 89 04 F7)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 137);
    l = emit_byte(buf, l, 4);
    l = emit_byte(buf, l, 247);
    return l;
}

fn emit_index_lea_sized(buf: i64, len: i64, elem_sz: i64): i64 {
    let l = len;
    if elem_sz == 4 {
        # lea rax, [rdi + rsi*4] (48 8D 04 B7)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 141); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 183);
        return l;
    }
    if elem_sz == 1 {
        # lea rax, [rdi + rsi] (48 8D 04 37)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 141); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 55);
        return l;
    }
    if elem_sz == 8 {
        # lea rax, [rdi + rsi*8] (48 8D 04 F7)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 141); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 247);
        return l;
    }
    # Arbitrary size (composite struct element): imul rsi, rsi, elem_sz; lea rax, [rdi + rsi]
    if elem_sz < 128 {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 107); l = emit_byte(buf, l, 246); l = emit_byte(buf, l, elem_sz % 256);
    } else {
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 105); l = emit_byte(buf, l, 246);
        l = emit_disp32(buf, l, elem_sz);
    }
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 141); l = emit_byte(buf, l, 4); l = emit_byte(buf, l, 55);
    return l;
}



fn emit_bounds_check(buf: i64, len: i64, limit: i64): i64 {
    let l = len;
    if limit <= 0 { return l; }
    if limit < 128 {
        # cmp rsi, imm8 (48 83 FE imm8)
        l = emit_byte(buf, l, 72);
        l = emit_byte(buf, l, 131);
        l = emit_byte(buf, l, 254);
        l = emit_byte(buf, l, limit % 256);
    } else {
        # cmp rsi, imm32 (48 81 FE imm32)
        l = emit_byte(buf, l, 72);
        l = emit_byte(buf, l, 129);
        l = emit_byte(buf, l, 254);
        l = emit_disp32(buf, l, limit);
    }
    # jb +2 (72 02)
    l = emit_byte(buf, l, 114);
    l = emit_byte(buf, l, 2);
    # ud2 (0F 0B)
    l = emit_byte(buf, l, 15);
    l = emit_byte(buf, l, 11);
    return l;
}

fn emit_zero_bytes(buf: i64, len: i64, slot: i64, total_bytes: i64): i64 {
    let l = len;
    l = emit_lea_slot(buf, l, slot);
    # mov rdi, rax (48 89 C7)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 137);
    l = emit_byte(buf, l, 199);
    # mov ecx, total_bytes (B9 imm32)
    l = emit_byte(buf, l, 185);
    l = emit_disp32(buf, l, total_bytes);
    # xor eax, eax (31 C0)
    l = emit_byte(buf, l, 49);
    l = emit_byte(buf, l, 192);
    # cld (FC)
    l = emit_byte(buf, l, 252);
    # rep stosb (F3 AA)
    l = emit_byte(buf, l, 243);
    l = emit_byte(buf, l, 170);
    return l;
}

fn emit_copy_bytes(buf: i64, len: i64, dst_slot: i64, total_bytes: i64): i64 {
    let l = len;
    # mov rsi, rax (48 89 C6)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 137);
    l = emit_byte(buf, l, 198);
    l = emit_lea_slot(buf, l, dst_slot);
    # mov rdi, rax (48 89 C7)
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 137);
    l = emit_byte(buf, l, 199);
    # mov ecx, total_bytes (B9 imm32)
    l = emit_byte(buf, l, 185);
    l = emit_disp32(buf, l, total_bytes);
    # cld (FC)
    l = emit_byte(buf, l, 252);
    # rep movsb (F3 A4)
    l = emit_byte(buf, l, 243);
    l = emit_byte(buf, l, 164);
    return l;
}

fn emit_copy_bytes_to_rcx(buf: i64, len: i64, total_bytes: i64): i64 {
    let l = len;
    # mov rsi, rax (48 89 C6)
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 198);
    # mov rdi, rcx (48 89 CF)
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 207);
    # mov ecx, total_bytes (B9 imm32)
    l = emit_byte(buf, l, 185);
    l = emit_disp32(buf, l, total_bytes);
    # cld (FC)
    l = emit_byte(buf, l, 252);
    # rep movsb (F3 A4)
    l = emit_byte(buf, l, 243);
    l = emit_byte(buf, l, 164);
    return l;
}

fn emit_mov_rcx_rax(buf: i64, len: i64): i64 {
    let l = len;
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 137);
    l = emit_byte(buf, l, 193); # 48 89 C1 (mov rcx, rax)
    return l;
}


fn emit_fp_comparison(buf: i64, len: i64, op: i64): i64 {
    let l = len;
    if op == TOKEN_EQUAL_EQUAL {
        # IEEE-754: equal requires ZF=1 and PF=0 (not NaN)
        # setnp dl (0F 9B C2)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 155); l = emit_byte(buf, l, 194);
        # sete al (0F 94 C0)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 148); l = emit_byte(buf, l, 192);
        # and al, dl (20 D0)
        l = emit_byte(buf, l, 32); l = emit_byte(buf, l, 208);
        # movzx rax, al (48 0F B6 C0)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 192);
        return l;
    }
    if op == TOKEN_NOT_EQUAL {
        # IEEE-754: not-equal is true if ZF=0 or PF=1 (NaN != NaN is true)
        # setp dl (0F 9A C2)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 154); l = emit_byte(buf, l, 194);
        # setne al (0F 95 C0)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 149); l = emit_byte(buf, l, 192);
        # or al, dl (08 D0)
        l = emit_byte(buf, l, 8); l = emit_byte(buf, l, 208);
        # movzx rax, al (48 0F B6 C0)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 192);
        return l;
    }
    if op == TOKEN_LESS {
        # IEEE-754: less requires CF=1 and PF=0
        # setnp dl (0F 9B C2)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 155); l = emit_byte(buf, l, 194);
        # setb al (0F 92 C0)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 146); l = emit_byte(buf, l, 192);
        # and al, dl (20 D0)
        l = emit_byte(buf, l, 32); l = emit_byte(buf, l, 208);
        # movzx rax, al (48 0F B6 C0)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 192);
        return l;
    }
    if op == TOKEN_LESS_EQ {
        # IEEE-754: less-equal requires (CF=1 or ZF=1) and PF=0
        # setnp dl (0F 9B C2)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 155); l = emit_byte(buf, l, 194);
        # setbe al (0F 96 C0)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 150); l = emit_byte(buf, l, 192);
        # and al, dl (20 D0)
        l = emit_byte(buf, l, 32); l = emit_byte(buf, l, 208);
        # movzx rax, al (48 0F B6 C0)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 192);
        return l;
    }
    if op == TOKEN_GREATER {
        # seta al (0F 97 C0): CF=0 and ZF=0 (already false for NaN)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 151); l = emit_byte(buf, l, 192);
        # movzx rax, al (48 0F B6 C0)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 192);
        return l;
    }
    if op == TOKEN_GREATER_EQ {
        # setae al (0F 93 C0): CF=0 (already false for NaN)
        l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 147); l = emit_byte(buf, l, 192);
        # movzx rax, al (48 0F B6 C0)
        l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 182); l = emit_byte(buf, l, 192);
        return l;
    }
    l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 49); l = emit_byte(buf, l, 192);
    return l;
}

fn emit_bin_op_typed(buf: i64, len: i64, op: i64, type_id: i64): i64 {
    let l = len;
    if (type_id == TYPE_F64) | (type_id == TYPE_FLOAT_LIT) {
        # movq xmm0, rax
        l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 110); l = emit_byte(buf, l, 192);
        # movq xmm1, rcx
