            let new_w = riscv_encode_bne(s1, s2, disp);
            mach_emit_u32(code_buf, patch_pos, new_w);
            return 1;
        }
        return 0;
    }
    if tid == 99 {
        let word = mach_read_u32(code_buf, patch_pos);
        let op8 = (word >> 24) & 255;
        let disp = target_pos - patch_pos;
        if op8 == 6 {
            mach_emit_u32(code_buf, patch_pos, 100663296 | (disp & 16777215));
            return 1;
        }
        if op8 == 7 {
            let s1 = (word >> 16) & 255;
            mach_emit_u32(code_buf, patch_pos, 117440512 | (s1 << 16) | (disp & 65535));
            return 1;
        }
        if op8 == 8 {
            mach_emit_u32(code_buf, patch_pos, 134217728 | (disp & 16777215));
            return 1;
        }
        return 0;
    }
    # x86-64
    if patch_pos == 0 {
        # Backpatch both in-memory jmp main (offset 1) and _start call main (offset 18)
        let disp_jmp = target_pos - 5;
        mach_emit_disp32(code_buf, 1, disp_jmp);
        let disp_call = target_pos - 22;
        mach_emit_disp32(code_buf, 18, disp_call);
        return 1;
    }
    let first_b = get_byte(code_buf, patch_pos);
    if first_b == 233 { # JMP rel32 (5 bytes)
        let disp = target_pos - (patch_pos + 5);
        mach_emit_disp32(code_buf, patch_pos + 1, disp);
        return 1;
    }
    if first_b == 232 { # CALL rel32 (5 bytes)
        let disp = target_pos - (patch_pos + 5);
        mach_emit_disp32(code_buf, patch_pos + 1, disp);
        return 1;
    }
    if (first_b >= 64) & (first_b <= 79) { # REX prefix before TEST + JNZ
        let disp = target_pos - (patch_pos + 9);
        mach_emit_disp32(code_buf, patch_pos + 5, disp);
        return 1;
    }
    let disp = target_pos - (patch_pos + 4);
    mach_emit_disp32(code_buf, patch_pos, disp);
    return 1;
}
# ==============================================================================
# Rubix Compiler -- Generic Linear Scan Register Allocator (compiler/rums/regalloc.bix)
# Pure Rubix implementation of Poletto & Sarkar linear-scan register allocation.
# Target-independent: allocates from a target machine register pool with
# loop-aware spill weighting, preferred register hints, and move coalescing.
# ==============================================================================
# Note: dependencies (machdesc) are imported centrally by main.bix

# ------------------------------------------------------------------------------
# Live Interval Analysis with Loop-Depth Weighting & Preferred Hints
# Computes [start_node, end_node, assigned_reg, spill_slot, spill_cost]
# ------------------------------------------------------------------------------
fn regalloc_compute_liveness_ex(uir_buf: i64, start_node: i64, end_node: i64, intervals: i64, hints: i64, target: i64): i64 {
    # Initialize up to 64 virtual registers (64 * 48 = 3072 bytes, fits in 1 page)
    let vi = 0;
    while vi < 64 {
        let base = intervals + (vi * 48);
        set_qword(base, 0, 0);      # defined = 0
        set_qword(base, 1, 999999); # start_node
        set_qword(base, 2, -1);     # end_node
        set_qword(base, 3, -1);     # assigned_phys_reg = -1 (none)
        set_qword(base, 4, 0);      # spill_slot
        set_qword(base, 5, 0);      # spill_cost (weighted use count)
        if hints > 0 {
            set_qword(hints, vi, -1); # no hint
        }
        vi = vi + 1;
    }

    let label_nodes = sys_mmap_page();
    let l_init = 0;
    while l_init < 512 {
        set_qword(label_nodes, l_init, -1);
        l_init = l_init + 1;
    }

    let ni = start_node;
    while ni < end_node {
        let addr = uir_node_addr(uir_buf, ni);
        let op = get_qword(addr, 0);
        let dst = get_qword(addr, 4);
        let s1 = get_qword(addr, 5);
        let s2 = get_qword(addr, 6);
        let fl = get_qword(addr, 2);
        let extra = get_qword(addr, 7); # loop depth in slot 7
        let imm1 = fl & 1;
        let imm2 = (fl >> 1) & 1;

        let weight = 1;
        if extra == 1 { weight = 10; }
        if extra >= 2 { weight = 100; }

        # Check definition (dst)
        if (op != 50) & (op != 51) & (op != 53) & (op != 54) & (op != 55) {
            if (dst >= 0) & (dst < 64) {
                let base_d = intervals + (dst * 48);
                set_qword(base_d, 0, 1); # defined = 1
                let cur_start = get_qword(base_d, 1);
                if ni < cur_start { set_qword(base_d, 1, ni); }
                let cur_end = get_qword(base_d, 2);
                if ni > cur_end { set_qword(base_d, 2, ni); }

                # Preferred register hints (queries machine model directly):
                if (op == 52) & (hints > 0) { # PARAM
                    let param_reg = -1;
                    if target >= 65536 { # mach_model pointer
                        param_reg = mach_model_get_abi_arg_reg(target, s1);
                    } else { # legacy numeric fallback
                        if target == 1 {
                            if s1 == 0 { param_reg = 7; } # RDI
                            if s1 == 1 { param_reg = 6; } # RSI
                            if s1 == 2 { param_reg = 2; } # RDX
                            if s1 == 3 { param_reg = 1; } # RCX
                            if s1 == 4 { param_reg = 8; } # R8
                            if s1 == 5 { param_reg = 9; } # R9
                        }
                        if target == 2 {
                            if s1 < 8 { param_reg = s1; } # x0..x7
                        }
                        if target == 3 {
                            if s1 < 8 { param_reg = 10 + s1; } # a0..a7
                        }
                    }
                    if param_reg >= 0 {
                        set_qword(hints, dst, param_reg);
                    }
                }
                if (op >= 30) & (op <= 35) & (hints > 0) {
                    set_qword(hints, dst, 0); # Hint comparison result to RAX / x0
                }
            }
        }

        # Check source 1 use
        let has_s1_vreg = 0;
        if (op == 2) | (op == 3) { has_s1_vreg = 1; } # MOVE, CAST
        if (op >= 10) & (op <= 15) { has_s1_vreg = 1; } # Arithmetic
        if (op >= 20) & (op <= 25) { has_s1_vreg = 1; } # Bitwise
        if (op >= 30) & (op <= 35) { has_s1_vreg = 1; } # Comparisons
        if (op >= 42) & (op <= 44) { has_s1_vreg = 1; } # LOAD, STORE, INDEX_ADDR
        if (op == 55) | (op == 57) | (op == 58) { has_s1_vreg = 1; } # BRANCH, RETURN, ARG

        if (has_s1_vreg == 1) & (imm1 == 0) & (s1 >= 0) & (s1 < 64) {
            let base_s1 = intervals + (s1 * 48);
            let cur_start = get_qword(base_s1, 1);
            if ni < cur_start { set_qword(base_s1, 1, ni); }
            let cur_end = get_qword(base_s1, 2);
            if ni > cur_end { set_qword(base_s1, 2, ni); }
            let cost = get_qword(base_s1, 5);
            set_qword(base_s1, 5, cost + weight);

            # RETURN hint (queries machine model directly):
            if (op == 57) & (hints > 0) {
                let ret_reg = 0; # RAX / x0
                if target >= 65536 { # mach_model pointer
                    ret_reg = mach_model_get_abi_return_reg(target);
                } else {
                    if target == 3 { ret_reg = 10; } # a0
                }
                if ret_reg >= 0 {
                    set_qword(hints, s1, ret_reg);
                }
            }
        }

        # Check source 2 use
        let has_s2_vreg = 0;
        if (op >= 10) & (op <= 14) { has_s2_vreg = 1; } # Binary arithmetic
        if (op >= 20) & (op <= 22) { has_s2_vreg = 1; } # AND, OR, XOR
        if (op == 24) | (op == 25) { has_s2_vreg = 1; } # SHL, SHR
        if (op >= 30) & (op <= 35) { has_s2_vreg = 1; } # Comparisons
        if (op == 43) | (op == 44) { has_s2_vreg = 1; } # STORE, INDEX_ADDR

        if (has_s2_vreg == 1) & (imm2 == 0) & (s2 >= 0) & (s2 < 64) {
            let base_s2 = intervals + (s2 * 48);
            let cur_start = get_qword(base_s2, 1);
            if ni < cur_start { set_qword(base_s2, 1, ni); }
            let cur_end = get_qword(base_s2, 2);
            if ni > cur_end { set_qword(base_s2, 2, ni); }
            let cost = get_qword(base_s2, 5);
            set_qword(base_s2, 5, cost + weight);
        }

        # Track labels for loop back-edge detection
        if op == 53 { # UIR_LABEL
            if (dst >= 0) & (dst < 512) {
                set_qword(label_nodes, dst, ni);
            }
        }

        # Detect loop back-edges on backward jumps (UIR_JUMP / UIR_BRANCH)
        if op == 54 { # UIR_JUMP
            if (dst >= 0) & (dst < 512) {
                let target_node = get_qword(label_nodes, dst);
                if (target_node >= 0) & (target_node < ni) {
                    let vi = 0;
                    while vi < 64 {
                        let base_v = intervals + (vi * 48);
                        if get_qword(base_v, 0) == 1 {
                            let v_start = get_qword(base_v, 1);
                            let v_end = get_qword(base_v, 2);
                            if (v_start <= target_node) & (v_end >= target_node) {
                                if v_end < ni {
                                    set_qword(base_v, 2, ni);
                                }
                            }
                        }
                        vi = vi + 1;
                    }
                }
            }
        }

        if op == 55 { # UIR_BRANCH
            let b_target = -1;
            if (dst >= 0) & (dst < 512) {
                let t_node = get_qword(label_nodes, dst);
                if (t_node >= 0) & (t_node < ni) { b_target = t_node; }
            }
            if (s2 >= 0) & (s2 < 512) {
                let f_node = get_qword(label_nodes, s2);
                if (f_node >= 0) & (f_node < ni) {
                    if (b_target < 0) | (f_node < b_target) { b_target = f_node; }
                }
            }
            if b_target >= 0 {
                let vi = 0;
                while vi < 64 {
                    let base_v = intervals + (vi * 48);
                    if get_qword(base_v, 0) == 1 {
                        let v_start = get_qword(base_v, 1);
                        let v_end = get_qword(base_v, 2);
                        if (v_start <= b_target) & (v_end >= b_target) {
                            if v_end < ni {
                                set_qword(base_v, 2, ni);
                            }
                        }
                    }
                    vi = vi + 1;
                }
            }
        }

        ni = ni + 1;
    }
    return 0;
}

fn regalloc_compute_liveness(uir_buf: i64, start_node: i64, end_node: i64, intervals: i64): i64 {
    return regalloc_compute_liveness_ex(uir_buf, start_node, end_node, intervals, 0, 1);
}

# ------------------------------------------------------------------------------
# Linear-Scan Allocator with Preferred Register Hints & Spill Cost Decisions
# ------------------------------------------------------------------------------
fn regalloc_linear_scan_ex(intervals: i64, num_vregs: i64, pool_regs: i64, pool_size: i64, hints: i64): i64 {
    # Active allocation tracking buffer: [vreg_id, end_node, phys_reg] (3 qwords per entry)
    let active = sys_mmap_page();
    let active_count = 0;
    let next_spill_slot = 1;

    # Reg in use mask (bitmask: bit R is 1 if physical reg R is currently held)
    let in_use_mask = 0;

    let vi = 0;
    while vi < num_vregs {
        let base_v = intervals + (vi * 48);
        if get_qword(base_v, 0) == 1 { # if defined
            let start = get_qword(base_v, 1);
            let end = get_qword(base_v, 2);
            let cur_cost = get_qword(base_v, 5);

            # 1. Expire old intervals
            let ai = 0;
            while ai < active_count {
                let act_end = get_qword(active, ai * 3 + 1);
                if act_end <= start {
                    let freed_reg = get_qword(active, ai * 3 + 2);
                    let freed_bit = 1 << freed_reg;
                    if ((in_use_mask >> freed_reg) & 1) == 1 {
                        in_use_mask = in_use_mask - freed_bit;
                    }

                    # Remove from active by shifting remaining
                    let shift_i = ai;
                    while shift_i < (active_count - 1) {
                        set_qword(active, shift_i * 3 + 0, get_qword(active, (shift_i + 1) * 3 + 0));
                        set_qword(active, shift_i * 3 + 1, get_qword(active, (shift_i + 1) * 3 + 1));
                        set_qword(active, shift_i * 3 + 2, get_qword(active, (shift_i + 1) * 3 + 2));
                        shift_i = shift_i + 1;
                    }
                    active_count = active_count - 1;
                } else {
                    ai = ai + 1;
                }
            }

            # 2. Try preferred hint first
            let assigned_reg = -1;
            if hints > 0 {
                let pref = get_qword(hints, vi);
                if pref >= 0 {
                    # Verify pref is in pool_regs and currently free
                    let pki = 0;
                    let in_pool = 0;
                    while pki < pool_size {
                        if get_qword(pool_regs, pki) == pref { in_pool = 1; }
                        pki = pki + 1;
                    }
                    if (in_pool == 1) & (((in_use_mask >> pref) & 1) == 0) {
                        assigned_reg = pref;
                    }
                }
            }

            # 3. If no hint matched, allocate first free register from pool
            if assigned_reg < 0 {
                let pi = 0;
                while (pi < pool_size) & (assigned_reg < 0) {
                    let cand_reg = get_qword(pool_regs, pi);
                    if ((in_use_mask >> cand_reg) & 1) == 0 {
                        assigned_reg = cand_reg;
                    }
                    pi = pi + 1;
                }
            }

            if assigned_reg >= 0 {
                # Successfully allocated
                set_qword(base_v, 3, assigned_reg);
                in_use_mask = in_use_mask | (1 << assigned_reg);
                # Add to active set
                set_qword(active, active_count * 3 + 0, vi);
                set_qword(active, active_count * 3 + 1, end);
                set_qword(active, active_count * 3 + 2, assigned_reg);
                active_count = active_count + 1;
            } else {
                # 4. Register pressure: loop-aware spill decision
                # Find active interval with lowest spill cost
                let min_cost_idx = -1;
                let min_cost_val = 999999;
                let chk_i = 0;
                while chk_i < active_count {
                    let act_vid = get_qword(active, chk_i * 3 + 0);
                    let act_cost = get_qword(intervals + (act_vid * 48), 5);
                    if act_cost < min_cost_val {
                        min_cost_val = act_cost;
                        min_cost_idx = chk_i;
                    }
                    chk_i = chk_i + 1;
                }

                if (min_cost_idx >= 0) & (cur_cost > min_cost_val) {
                    # Evict lower-cost active interval in favor of current high-priority interval
                    let evict_vid = get_qword(active, min_cost_idx * 3 + 0);
                    let evict_reg = get_qword(active, min_cost_idx * 3 + 2);
                    let base_evict = intervals + (evict_vid * 48);

                    # Spill evicted variable
                    set_qword(base_evict, 3, -1);
                    set_qword(base_evict, 4, next_spill_slot);
                    next_spill_slot = next_spill_slot + 1;

                    # Assign its register to current interval
                    set_qword(base_v, 3, evict_reg);
                    set_qword(active, min_cost_idx * 3 + 0, vi);
                    set_qword(active, min_cost_idx * 3 + 1, end);
                    set_qword(active, min_cost_idx * 3 + 2, evict_reg);
                } else {
                    # Spill current interval
                    set_qword(base_v, 3, -1);
                    set_qword(base_v, 4, next_spill_slot);
                    next_spill_slot = next_spill_slot + 1;
                }
            }
        }
        vi = vi + 1;
    }

    return next_spill_slot - 1; # total spilled slots
}

fn regalloc_linear_scan(intervals: i64, num_vregs: i64, pool_regs: i64, pool_size: i64): i64 {
    return regalloc_linear_scan_ex(intervals, num_vregs, pool_regs, pool_size, 0);
}

# Helper to query allocated location:
# Returns physical register ID (>= 0) or negative stack slot (-slot_idx)
fn regalloc_get_location(intervals: i64, vreg: i64): i64 {
    let base = intervals + (vreg * 48);
    let phys = get_qword(base, 3);
    if phys >= 0 {
        return phys;
    }
    let slot = get_qword(base, 4);
    if slot > 0 {
        return 0 - slot;
    }
    return 0 - (vreg + 1); # fallback to 1:1 slot
}
# ==============================================================================
# Rubix Universal Machine Synthesis (RUMS) -- Machine Synthesizer Engine
# File: compiler/rums/rums.bix
# Universal native code synthesis driven exclusively by loaded .machine models.
# Pure Rubix: queries machine model and produces raw native machine bytes directly.
# Zero GCC, zero Clang, zero LLVM, zero external assembler, zero external linker.
# ==============================================================================
# Target Identifiers (for convenience / CLI dispatch)
let TARGET_X86_64 = 1;
let TARGET_ARM64 = 2;
let TARGET_RISCV64 = 3;
let TARGET_REX = 4;
let TARGET_SYNTHETIC = 99;

# Precomputed hash of "main" identifier (hash_token("main", 4))
let FN_HASH_MAIN = 6385467242;

# ------------------------------------------------------------------------------
# Target File Path Resolvers
# ------------------------------------------------------------------------------
fn rums_get_target_path(target_id: i64, path_buf: i64): i64 {
    # "targets/"
    set_byte(path_buf, 0, 116); set_byte(path_buf, 1, 97); set_byte(path_buf, 2, 114); set_byte(path_buf, 3, 103);
    set_byte(path_buf, 4, 101); set_byte(path_buf, 5, 116); set_byte(path_buf, 6, 115); set_byte(path_buf, 7, 47);

    if target_id == TARGET_X86_64 {
        # "x86_64.machine"
        set_byte(path_buf, 8, 120); set_byte(path_buf, 9, 56); set_byte(path_buf, 10, 54); set_byte(path_buf, 11, 95);
        set_byte(path_buf, 12, 54); set_byte(path_buf, 13, 52); set_byte(path_buf, 14, 46); set_byte(path_buf, 15, 109);
        set_byte(path_buf, 16, 97); set_byte(path_buf, 17, 99); set_byte(path_buf, 18, 104); set_byte(path_buf, 19, 105);
        set_byte(path_buf, 20, 110); set_byte(path_buf, 21, 101); set_byte(path_buf, 22, 0);
        return 22;
    }
    if target_id == TARGET_ARM64 {
        # "arm64.machine"
        set_byte(path_buf, 8, 97); set_byte(path_buf, 9, 114); set_byte(path_buf, 10, 109); set_byte(path_buf, 11, 54);
        set_byte(path_buf, 12, 52); set_byte(path_buf, 13, 46); set_byte(path_buf, 14, 109); set_byte(path_buf, 15, 97);
        set_byte(path_buf, 16, 99); set_byte(path_buf, 17, 104); set_byte(path_buf, 18, 105); set_byte(path_buf, 19, 110);
        set_byte(path_buf, 20, 101); set_byte(path_buf, 21, 0);
        return 21;
    }
    if target_id == TARGET_RISCV64 {
        # "riscv64.machine"
        set_byte(path_buf, 8, 114); set_byte(path_buf, 9, 105); set_byte(path_buf, 10, 115); set_byte(path_buf, 11, 99);
        set_byte(path_buf, 12, 118); set_byte(path_buf, 13, 54); set_byte(path_buf, 14, 52); set_byte(path_buf, 15, 46);
        set_byte(path_buf, 16, 109); set_byte(path_buf, 17, 97); set_byte(path_buf, 18, 99); set_byte(path_buf, 19, 104);
        set_byte(path_buf, 20, 105); set_byte(path_buf, 21, 110); set_byte(path_buf, 22, 101); set_byte(path_buf, 23, 0);
        return 23;
    }
    if target_id == TARGET_REX {
        # "rex.machine"
        set_byte(path_buf, 8, 114); set_byte(path_buf, 9, 101); set_byte(path_buf, 10, 120); set_byte(path_buf, 11, 46);
        set_byte(path_buf, 12, 109); set_byte(path_buf, 13, 97); set_byte(path_buf, 14, 99); set_byte(path_buf, 15, 104);
        set_byte(path_buf, 16, 105); set_byte(path_buf, 17, 110); set_byte(path_buf, 18, 101); set_byte(path_buf, 19, 0);
        return 19;
    }
    if target_id == TARGET_SYNTHETIC {
        # "synthetic.machine"
        set_byte(path_buf, 8, 115); set_byte(path_buf, 9, 121); set_byte(path_buf, 10, 110); set_byte(path_buf, 11, 116);
        set_byte(path_buf, 12, 104); set_byte(path_buf, 13, 101); set_byte(path_buf, 14, 116); set_byte(path_buf, 15, 105);
        set_byte(path_buf, 16, 99); set_byte(path_buf, 17, 46); set_byte(path_buf, 18, 109); set_byte(path_buf, 19, 97);
        set_byte(path_buf, 20, 99); set_byte(path_buf, 21, 104); set_byte(path_buf, 22, 105); set_byte(path_buf, 23, 110);
        set_byte(path_buf, 24, 101); set_byte(path_buf, 25, 0);
        return 25;
    }
    return 0;
}

# ------------------------------------------------------------------------------
# Universal Model-Driven Function Synthesizer:
# Lowers a UIR function into native machine bytes using ONLY the loaded model.
# Zero target-specific branch logic -- all machine facts come from mach_model.
# ------------------------------------------------------------------------------
fn rums_synthesize_function_ex(uir_buf: i64, start_node: i64, end_node: i64, code_buf: i64, start_len: i64, model: i64, prog_call_patches: i64): i64 {
    let cur = start_len;

    # 1. Fetch Register Pool directly from machine model
    let pool = sys_mmap_page();
    let pool_sz = mach_model_get_scratch_pool(model, pool);

    # Check if function makes any calls or uses stack
    let has_calls = 0;
    let local_stack_bytes = 0;
    let has_stack_params = 0;
    let abi_cnt = get_qword(model, 9);
    let scan_i = start_node;
    while scan_i < end_node {
        let chk_addr = uir_node_addr(uir_buf, scan_i);
        let chk_op = get_qword(chk_addr, 0);
        if chk_op == 56 { # UIR_CALL
            has_calls = 1;
        }
        if chk_op == 40 { # ALLOC_STACK
            let sz = get_qword(chk_addr, 5);
            local_stack_bytes = local_stack_bytes + sz;
        }
        if chk_op == 52 { # PARAM
            let p_idx = get_qword(chk_addr, 5);
            if p_idx >= abi_cnt {
                has_stack_params = 1;
            }
        }
        scan_i = scan_i + 1;
    }

    # 2. Linear-Scan Register Allocation with Preferred Register Hints (from model)
    let intervals = sys_mmap_page();
    let hints = sys_mmap_page();
    regalloc_compute_liveness_ex(uir_buf, start_node, end_node, intervals, hints, model);
    let spills = regalloc_linear_scan_ex(intervals, 64, pool, pool_sz, hints);

    # Leaf function frame elimination: if no calls, no spills, no local stack, and no stack params
    let is_leaf = 0;
    if (has_calls == 0) & (spills == 0) & (local_stack_bytes == 0) & (has_stack_params == 0) {
        is_leaf = 1;
    }

    let frame_sz = 768 + (spills * 8) + local_stack_bytes;
    frame_sz = (frame_sz + 15) & (0 - 16);

    # 3. Emit Function Prologue (omitted for leaf functions)
    if is_leaf == 0 {
        cur = mach_model_emit_prologue(model, code_buf, cur, frame_sz);
    }

    # 4. Tables for labels and argument preparation
    let label_tbl = sys_mmap_page();
    let li = 0;
    while li < 128 {
        set_qword(label_tbl, li, -1);
        li = li + 1;
    }

    let patch_tbl = sys_mmap(0, 65536, 3, 34, -1, 0);
    let arg_slots = sys_mmap_page();

    # 5. Synthesize Instructions Driven by Model
    let ni = start_node;
    while ni < end_node {
        let addr = uir_node_addr(uir_buf, ni);
        let op = get_qword(addr, 0);
        let dst = get_qword(addr, 4);
        let s1 = get_qword(addr, 5);
        let s2 = get_qword(addr, 6);
        let fl = get_qword(addr, 2);
        let imm1 = fl & 1;
        let imm2 = (fl >> 1) & 1;
        let target = mach_model_get_target_id(model);
        let sp_base_reg = mach_model_get_sp_reg(model);

        if op == 52 { # PARAM
            let dst_loc = regalloc_get_location(intervals, dst);
            if dst_loc >= 0 {
                let param_abi_reg = mach_model_get_abi_arg_reg(model, s1);
                if param_abi_reg >= 0 {
                    if dst_loc != param_abi_reg {
                        cur = mach_model_emit_mov_reg(model, code_buf, cur, dst_loc, param_abi_reg);
                    }
                } else {
                    let abi_cnt = get_qword(model, 9);
                    let stack_offset = 0;
                    if (target == 1) | (target == 2) {
                        stack_offset = 16;
                    }
                    let stack_param_disp = frame_sz + stack_offset + ((s1 - abi_cnt) * 8);
                    cur = mach_model_emit_load(model, code_buf, cur, dst_loc, sp_base_reg, stack_param_disp);
                }
            }
        }

        if op == 1 { # CONST
            let dst_loc = regalloc_get_location(intervals, dst);
            if dst_loc >= 0 {
                cur = mach_model_emit_mov_imm(model, code_buf, cur, dst_loc, s1);
            }
        }

        if op == 2 { # MOVE
            let dst_loc = regalloc_get_location(intervals, dst);
            let s1_loc = regalloc_get_location(intervals, s1);
            if (dst_loc >= 0) & (s1_loc >= 0) {
                if dst_loc != s1_loc {
                    cur = mach_model_emit_mov_reg(model, code_buf, cur, dst_loc, s1_loc);
                }
            }
        }

        # Arithmetic & Bitwise
        let is_bin = 0;
        if (op >= 10) & (op <= 12) { is_bin = 1; }
        if (op >= 20) & (op <= 22) { is_bin = 1; }
        if (op >= 24) & (op <= 25) { is_bin = 1; }

        let scratch_reg = mach_model_get_scratch_reg(model);

        if (op >= 10) & (op <= 12) { # ADD, SUB, MUL
            let dst_loc = regalloc_get_location(intervals, dst);
            let s1_loc = regalloc_get_location(intervals, s1);
            let s2_loc = -1;
            if imm2 == 1 {
                s2_loc = scratch_reg;
                cur = mach_model_emit_mov_imm(model, code_buf, cur, scratch_reg, s2);
            } else {
                s2_loc = regalloc_get_location(intervals, s2);
            }
            if (dst_loc >= 0) & (s1_loc >= 0) & (s2_loc >= 0) {
                cur = mach_model_emit_bin_op(model, code_buf, cur, op, dst_loc, s1_loc, s2_loc);
            }
        }

        if (op >= 20) & (op <= 25) { # AND, OR, XOR, SHL, SAR (excluding NOT)
            if op != 23 {
                let dst_loc = regalloc_get_location(intervals, dst);
                let s1_loc = regalloc_get_location(intervals, s1);
                let s2_loc = -1;
                if imm2 == 1 {
                    s2_loc = scratch_reg;
                    cur = mach_model_emit_mov_imm(model, code_buf, cur, scratch_reg, s2);
                } else {
                    s2_loc = regalloc_get_location(intervals, s2);
                }
                if (dst_loc >= 0) & (s1_loc >= 0) & (s2_loc >= 0) {
                    cur = mach_model_emit_bin_op(model, code_buf, cur, op, dst_loc, s1_loc, s2_loc);
                }
            }
        }

        if (op == 13) | (op == 14) { # DIV, MOD
            let dst_loc = regalloc_get_location(intervals, dst);
            let s1_loc = regalloc_get_location(intervals, s1);
            let s2_loc = -1;
            if imm2 == 1 {
                s2_loc = scratch_reg;
                cur = mach_model_emit_mov_imm(model, code_buf, cur, scratch_reg, s2);
            } else {
                s2_loc = regalloc_get_location(intervals, s2);
            }
            if (dst_loc >= 0) & (s1_loc >= 0) & (s2_loc >= 0) {
                cur = mach_model_emit_div_mod(model, code_buf, cur, op, dst_loc, s1_loc, s2_loc);
            }
        }

        if (op == 15) | (op == 23) { # NEG, NOT
            let dst_loc = regalloc_get_location(intervals, dst);
            let s1_loc = regalloc_get_location(intervals, s1);
            if (dst_loc >= 0) & (s1_loc >= 0) {
                cur = mach_model_emit_unary_op(model, code_buf, cur, op, dst_loc, s1_loc);
            }
        }

        # Comparisons (30..35)
        if (op >= 30) & (op <= 35) {
            let dst_loc = regalloc_get_location(intervals, dst);
            let s1_loc = regalloc_get_location(intervals, s1);
            let s2_loc = -1;
            if imm2 == 1 {
                s2_loc = scratch_reg;
                cur = mach_model_emit_mov_imm(model, code_buf, cur, scratch_reg, s2);
            } else {
                s2_loc = regalloc_get_location(intervals, s2);
            }
            if (dst_loc >= 0) & (s1_loc >= 0) & (s2_loc >= 0) {
                cur = mach_model_emit_cmp(model, code_buf, cur, op, dst_loc, s1_loc, s2_loc);
            }
        }

        # Control Flow: Labels & Jumps
        if op == 53 { # UIR_LABEL
            let lbl = dst;
            set_qword(label_tbl, lbl, cur);
            let p_cnt = get_qword(patch_tbl, lbl * 16 + 0);
            let pi = 0;
            while pi < p_cnt {
                let p_pos = get_qword(patch_tbl, lbl * 16 + 1 + pi);
                mach_model_backpatch(model, code_buf, p_pos, cur);
                pi = pi + 1;
            }
        }

        if op == 54 { # UIR_JUMP
            let lbl = dst;
            let target = get_qword(label_tbl, lbl);
            if target >= 0 {
                cur = mach_model_emit_jump(model, code_buf, cur, target - cur);
            } else {
                let p_pos = cur;
                cur = mach_model_emit_jump(model, code_buf, cur, 0);
                let p_cnt = get_qword(patch_tbl, lbl * 16 + 0);
                if p_cnt < 15 {
                    set_qword(patch_tbl, lbl * 16 + 1 + p_cnt, p_pos);
                    set_qword(patch_tbl, lbl * 16 + 0, p_cnt + 1);
                }
            }
        }

        if op == 55 { # UIR_BRANCH
            let s1_loc = regalloc_get_location(intervals, s1);
            let lbl_t = dst;
            let lbl_f = s2;

            let target_t = get_qword(label_tbl, lbl_t);
            if target_t >= 0 {
                cur = mach_model_emit_branch_cond(model, code_buf, cur, s1_loc, target_t - cur);
            } else {
                let p_pos_t = cur;
                cur = mach_model_emit_branch_cond(model, code_buf, cur, s1_loc, 0);
                let p_cnt_t = get_qword(patch_tbl, lbl_t * 16 + 0);
                if p_cnt_t < 15 {
                    set_qword(patch_tbl, lbl_t * 16 + 1 + p_cnt_t, p_pos_t);
                    set_qword(patch_tbl, lbl_t * 16 + 0, p_cnt_t + 1);
                }
            }

            let target_f = get_qword(label_tbl, lbl_f);
            if target_f >= 0 {
                cur = mach_model_emit_jump(model, code_buf, cur, target_f - cur);
            } else {
                let p_pos_f = cur;
                cur = mach_model_emit_jump(model, code_buf, cur, 0);
                let p_cnt_f = get_qword(patch_tbl, lbl_f * 16 + 0);
                if p_cnt_f < 15 {
                    set_qword(patch_tbl, lbl_f * 16 + 1 + p_cnt_f, p_pos_f);
                    set_qword(patch_tbl, lbl_f * 16 + 0, p_cnt_f + 1);
                }
            }
        }

        # Memory Operations
        if op == 41 { # ADDR_OF
            let dst_loc = regalloc_get_location(intervals, dst);
            if dst_loc >= 0 {
                cur = mach_model_emit_addr_of(model, code_buf, cur, dst_loc, s1);
            }
        }

        if op == 42 { # UIR_LOAD
            let dst_loc = regalloc_get_location(intervals, dst);
            let s1_loc = regalloc_get_location(intervals, s1);
            if (dst_loc >= 0) & (s1_loc >= 0) {
                let disp = get_qword(addr, 7);
                cur = mach_model_emit_load(model, code_buf, cur, dst_loc, s1_loc, disp);
            }
        }

        if op == 43 { # UIR_STORE
            let s1_loc = regalloc_get_location(intervals, s1);
            let s2_loc = -1;
            if imm2 == 1 {
                s2_loc = scratch_reg;
                cur = mach_model_emit_mov_imm(model, code_buf, cur, scratch_reg, s2);
            } else {
                s2_loc = regalloc_get_location(intervals, s2);
            }
            if (s1_loc >= 0) & (s2_loc >= 0) {
                let disp = get_qword(addr, 7);
                cur = mach_model_emit_store(model, code_buf, cur, s1_loc, disp, s2_loc);
            }
        }

        # Function Calls & Arguments
        if op == 58 { # ARG
            let arg_idx = dst;
            let arg_disp = 600 + (arg_idx * 8);

            if imm1 == 1 {
                cur = mach_model_emit_mov_imm(model, code_buf, cur, scratch_reg, s1);
                cur = mach_model_emit_store(model, code_buf, cur, sp_base_reg, arg_disp, scratch_reg);
            } else {
                let s1_loc = regalloc_get_location(intervals, s1);
                if s1_loc >= 0 {
                    cur = mach_model_emit_store(model, code_buf, cur, sp_base_reg, arg_disp, s1_loc);
                }
            }
        }

        if op == 56 { # UIR_CALL
            let target_fn_hash = s1;
            let arg_cnt = s2;

            # 1. Save caller-saved virtual registers that are live across this call

            let vi = 0;
            while vi < 64 {
                let v_base = intervals + (vi * 48);
                if get_qword(v_base, 0) == 1 { # defined
                    let v_start = get_qword(v_base, 1);
                    let v_end = get_qword(v_base, 2);
                    let v_phys = get_qword(v_base, 3);
                    if (v_start < ni) & (v_end > ni) & (v_phys >= 0) & (vi != dst) {
                        let save_disp = 64 + (vi * 8);
                        cur = mach_model_emit_store(model, code_buf, cur, sp_base_reg, save_disp, v_phys);
                    }
                }
                vi = vi + 1;
            }

            # 2. Setup call arguments directly from argument slots (no register clobbering)
            let ai = 0;
            while ai < arg_cnt {
                let abi_reg = mach_model_get_abi_arg_reg(model, ai);
                let arg_disp = 600 + (ai * 8);
                if abi_reg >= 0 {
                    cur = mach_model_emit_load(model, code_buf, cur, abi_reg, sp_base_reg, arg_disp);
                } else {
                    let abi_cnt = get_qword(model, 9);
                    let out_stack_disp = (ai - abi_cnt) * 8;
                    cur = mach_model_emit_load(model, code_buf, cur, scratch_reg, sp_base_reg, arg_disp);
                    cur = mach_model_emit_store(model, code_buf, cur, sp_base_reg, out_stack_disp, scratch_reg);
                }
                ai = ai + 1;
            }

            # 3. Emit call instruction
            let call_patch = cur;
            cur = mach_model_emit_call(model, code_buf, cur, 0);
            if prog_call_patches > 0 {
                let cp_count = get_qword(prog_call_patches, 0);
                set_qword(prog_call_patches, 1 + cp_count * 2 + 0, target_fn_hash);
                set_qword(prog_call_patches, 1 + cp_count * 2 + 1, call_patch);
                set_qword(prog_call_patches, 0, cp_count + 1);
            }

            # 4. Save return value into scratch_reg before restoring caller-saved registers
            if dst >= 0 {
                let ret_reg = mach_model_get_abi_return_reg(model);
                cur = mach_model_emit_mov_reg(model, code_buf, cur, scratch_reg, ret_reg);
            }

            # 5. Restore caller-saved registers
            vi = 0;
            while vi < 64 {
                let v_base = intervals + (vi * 48);
                if get_qword(v_base, 0) == 1 { # defined
                    let v_start = get_qword(v_base, 1);
                    let v_end = get_qword(v_base, 2);
                    let v_phys = get_qword(v_base, 3);
                    if (v_start < ni) & (v_end > ni) & (v_phys >= 0) & (vi != dst) {
                        let save_disp = 64 + (vi * 8);
                        cur = mach_model_emit_load(model, code_buf, cur, v_phys, sp_base_reg, save_disp);
                    }
                }
                vi = vi + 1;
            }

            # 6. Put return value into dst_loc
            if dst >= 0 {
                let dst_loc = regalloc_get_location(intervals, dst);
                if dst_loc >= 0 {
                    cur = mach_model_emit_mov_reg(model, code_buf, cur, dst_loc, scratch_reg);
                }
            }
        }

        if op == 57 { # RETURN
            if s1 >= 0 {
                let ret_abi_reg = mach_model_get_abi_return_reg(model);
                if imm1 == 1 {
                    cur = mach_model_emit_mov_imm(model, code_buf, cur, ret_abi_reg, s1);
                } else {
                    let s1_loc = regalloc_get_location(intervals, s1);
                    if (s1_loc >= 0) & (s1_loc != ret_abi_reg) {
                        cur = mach_model_emit_mov_reg(model, code_buf, cur, ret_abi_reg, s1_loc);
                    }
                }
            }
            if is_leaf == 0 {
                cur = mach_model_emit_epilogue(model, code_buf, cur, frame_sz);
            } else {
                cur = mach_model_emit_return(model, code_buf, cur);
            }
        }

        ni = ni + 1;
    }

    return cur;
}

fn rums_synthesize_function_model(uir_buf: i64, start_node: i64, end_node: i64, code_buf: i64, start_len: i64, model: i64): i64 {
    return rums_synthesize_function_ex(uir_buf, start_node, end_node, code_buf, start_len, model, 0);
}

# ------------------------------------------------------------------------------
# High-Level Synthesizer Entry Points
# ------------------------------------------------------------------------------
fn rums_synthesize_function_file(uir_buf: i64, start_node: i64, end_node: i64, code_buf: i64, start_len: i64, machine_path: i64): i64 {
    let model = sys_mmap_page();
    let load_res = machdesc_load_file(machine_path, model);
    if load_res < 0 {
        return load_res;
    }
    return rums_synthesize_function_model(uir_buf, start_node, end_node, code_buf, start_len, model);
}

fn rums_synthesize_function(uir_buf: i64, start_node: i64, end_node: i64, code_buf: i64, start_len: i64, target_or_model: i64): i64 {
    if target_or_model >= 65536 {
        return rums_synthesize_function_model(uir_buf, start_node, end_node, code_buf, start_len, target_or_model);
    }
    let path_buf = sys_mmap_page();
    let plen = rums_get_target_path(target_or_model, path_buf);
    if plen <= 0 {
        return -50;
    }
    return rums_synthesize_function_file(uir_buf, start_node, end_node, code_buf, start_len, path_buf);
}

fn rums_synthesize_program(uir_buf: i64, code_buf: i64, target_or_model: i64): i64 {
    let model = 0;
    if target_or_model >= 65536 {
        model = target_or_model;
    } else {
        let path_buf = sys_mmap_page();
        let plen = rums_get_target_path(target_or_model, path_buf);
        if plen <= 0 {
            return -50;
        }
        model = sys_mmap_page();
        let load_res = machdesc_load_file(path_buf, model);
        if load_res < 0 {
            return load_res;
        }
    }

    # Query target synthesis capability: portable vs CPU
    let target_type = mach_model_get_target_type(model);
    if target_type == 2 { # TARGET_TYPE_PORTABLE (REX)
        return rex_lower_uir_program(uir_buf, code_buf);
    }

    let l = 0;

    # 1. Emit process startup stub
    let main_call_patch = l;
    l = mach_model_emit_startup(model, code_buf, l);

    # 2. Function table & program call patch table
    let func_tbl = sys_mmap_page();
    let func_count = 0;
    let call_patches = sys_mmap_page();
    set_qword(call_patches, 0, 0);

    # 3. Iterate through functions in uir_buf
    let total_nodes = uir_get_count(uir_buf);
    let ni = 0;
    while ni < total_nodes {
        let n_addr = uir_node_addr(uir_buf, ni);
        if get_qword(n_addr, 0) == 50 { # UIR_FUNCTION_START
            let fn_hash = get_qword(n_addr, 4);
            let fn_start_node = ni;
            let fn_end_node = ni + 1;
            let searching = 1;
            while (fn_end_node < total_nodes) & (searching == 1) {
                let chk_addr = uir_node_addr(uir_buf, fn_end_node);
                if get_qword(chk_addr, 0) == 51 { # UIR_FUNCTION_END
                    searching = 0;
                } else {
                    fn_end_node = fn_end_node + 1;
                }
            }

            set_qword(func_tbl, func_count * 2 + 0, fn_hash);
            set_qword(func_tbl, func_count * 2 + 1, l);
            func_count = func_count + 1;

            l = rums_synthesize_function_ex(uir_buf, fn_start_node, fn_end_node, code_buf, l, model, call_patches);
            ni = fn_end_node;
        }
        ni = ni + 1;
    }

    # 4. Find main function offset (FN_HASH_MAIN is precomputed hash_token("main", 4))
    let main_hash = FN_HASH_MAIN;
    let main_offset = -1;
    let fi = 0;
    while fi < func_count {
        if get_qword(func_tbl, fi * 2 + 0) == main_hash {
            main_offset = get_qword(func_tbl, fi * 2 + 1);
        }
        fi = fi + 1;
    }
    if main_offset >= 0 {
        mach_model_backpatch(model, code_buf, main_call_patch, main_offset);
    } else {
        return -1;
    }

    # 5. Backpatch inter-function calls
    let total_calls = get_qword(call_patches, 0);
    let ci = 0;
    while ci < total_calls {
        let target_hash = get_qword(call_patches, 1 + ci * 2 + 0);
        let patch_pos = get_qword(call_patches, 1 + ci * 2 + 1);
        let target_offset = -1;
        fi = 0;
        while fi < func_count {
            if get_qword(func_tbl, fi * 2 + 0) == target_hash {
                target_offset = get_qword(func_tbl, fi * 2 + 1);
            }
            fi = fi + 1;
        }
        if target_offset >= 0 {
            mach_model_backpatch(model, code_buf, patch_pos, target_offset);
        } else {
            return -1;
        }
        ci = ci + 1;
    }

    return l;
}
# ==============================================================================
# Rubix Compiler — Diagnostic Reporter & Warnings Subsystem
# Single canonical source of truth: compiler/middle/warnings.bix
# ==============================================================================
use compiler.middle.warnings;


fn sys_read_all(fd: i64, buf: i64, max_len: i64): i64 {
    if fd < 0 { return -10; }
    if max_len <= 0 { return 0; }
    let total = 0;
    let running = 1;
    while running == 1 {
        let remaining = max_len - total;
        if remaining <= 0 {
            running = 0;
        } else {
            let n = sys_read(fd, buf + total, remaining);
            if n == 0 {
                running = 0;
            } else {
                if n < 0 {
                    if n == -4 {
                        # EINTR: retry
                    } else {
                        return n;
                    }
                } else {
                    total = total + n;
                }
            }
        }
    }
    return total;
}

fn sys_write_all(fd: i64, buf: i64, count: i64): i64 {
    if fd < 0 { return -20; }
    if count <= 0 { return 0; }
    let total = 0;
    let running = 1;
    while running == 1 {
        let remaining = count - total;
        if remaining <= 0 {
            running = 0;
        } else {
            let n = sys_write(fd, buf + total, remaining);
            if n == 0 {
                return -21;
            } else {
                if n < 0 {
                    if n == -4 {
                        # EINTR: retry
                    } else {
                        return n;
                    }
                } else {
                    total = total + n;
                }
            }
        }
    }
    return total;
}

use compiler.packaging.pe_coff;
use compiler.packaging.macho;
use compiler.packaging.wasm;
use compiler.middle.mir;

fn hash_mod(buf: i64, n: i64): i64 {
    let h = 5381;
    let i = 0;
    while i < n {
        let b = get_byte(buf, i);
        h = h * 33 + b;
        i = i + 1;
    }
    return h;
}

fn is_module_seen(tbl: i64, h: i64): i64 {
    let count = get_qword(tbl, 0);
    let i = 0;
    while i < count {
        if get_qword(tbl, i + 1) == h {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn mark_module_seen(tbl: i64, h: i64): i64 {
    let count = get_qword(tbl, 0);
    if count < 500 {
        set_qword(tbl, count + 1, h);
        set_qword(tbl, 0, count + 1);
    }
    return 0;
}

fn mod_copy_bytes(dst: i64, dst_off: i64, src: i64, src_off: i64, n: i64): i64 {
    let i = 0;
    while i < n {
        set_byte(dst, dst_off + i, get_byte(src, src_off + i));
        i = i + 1;
    }
    return dst_off + n;
}

fn try_open_fixed_prefix(cand_buf: i64, prefix_str: str, prefix_len: i64, path_buf: i64, path_len: i64): i64 {
    let p = 0;
    while p < prefix_len {
        set_byte(cand_buf, p, prefix_str[p] as i64);
        p = p + 1;
    }
    let total = mod_copy_bytes(cand_buf, p, path_buf, 0, path_len);
    set_byte(cand_buf, total, 0);
    return sys_open(cand_buf, 0, 0);
}

fn try_open_module(cand_buf: i64, path_buf: i64, path_len: i64): i64 {
    let fd = sys_open(path_buf, 0, 0);
    if fd >= 0 { return fd; }

    # "rubix/" + path
    set_byte(cand_buf, 0, 114);
    set_byte(cand_buf, 1, 117);
    set_byte(cand_buf, 2, 98);
    set_byte(cand_buf, 3, 105);
    set_byte(cand_buf, 4, 120);
    set_byte(cand_buf, 5, 47);
    let p = mod_copy_bytes(cand_buf, 6, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # "../" + path
    set_byte(cand_buf, 0, 46);
    set_byte(cand_buf, 1, 46);
    set_byte(cand_buf, 2, 47);
    p = mod_copy_bytes(cand_buf, 3, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # "../../" + path
    set_byte(cand_buf, 0, 46);
    set_byte(cand_buf, 1, 46);
    set_byte(cand_buf, 2, 47);
    set_byte(cand_buf, 3, 46);
    set_byte(cand_buf, 4, 46);
    set_byte(cand_buf, 5, 47);
    p = mod_copy_bytes(cand_buf, 6, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # "../rubix/" + path
    set_byte(cand_buf, 0, 46);
    set_byte(cand_buf, 1, 46);
    set_byte(cand_buf, 2, 47);
    set_byte(cand_buf, 3, 114);
    set_byte(cand_buf, 4, 117);
    set_byte(cand_buf, 5, 98);
    set_byte(cand_buf, 6, 105);
    set_byte(cand_buf, 7, 120);
    set_byte(cand_buf, 8, 47);
    p = mod_copy_bytes(cand_buf, 9, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # "rcs/" + path
    set_byte(cand_buf, 0, 114);
    set_byte(cand_buf, 1, 99);
    set_byte(cand_buf, 2, 115);
    set_byte(cand_buf, 3, 47);
    p = mod_copy_bytes(cand_buf, 4, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # "std/" + path
    set_byte(cand_buf, 0, 115);
    set_byte(cand_buf, 1, 116);
    set_byte(cand_buf, 2, 100);
    set_byte(cand_buf, 3, 47);
    p = mod_copy_bytes(cand_buf, 4, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # "../rcs/" + path
    set_byte(cand_buf, 0, 46);
    set_byte(cand_buf, 1, 46);
    set_byte(cand_buf, 2, 47);
    set_byte(cand_buf, 3, 114);
    set_byte(cand_buf, 4, 99);
    set_byte(cand_buf, 5, 115);
    set_byte(cand_buf, 6, 47);
    p = mod_copy_bytes(cand_buf, 7, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # "../std/" + path
    set_byte(cand_buf, 0, 46);
    set_byte(cand_buf, 1, 46);
    set_byte(cand_buf, 2, 47);
    set_byte(cand_buf, 3, 115);
    set_byte(cand_buf, 4, 116);
    set_byte(cand_buf, 5, 100);
    set_byte(cand_buf, 6, 47);
    p = mod_copy_bytes(cand_buf, 7, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # "rubix/std/" + path
    set_byte(cand_buf, 0, 114);
    set_byte(cand_buf, 1, 117);
    set_byte(cand_buf, 2, 98);
    set_byte(cand_buf, 3, 105);
    set_byte(cand_buf, 4, 120);
    set_byte(cand_buf, 5, 47);
    set_byte(cand_buf, 6, 115);
    set_byte(cand_buf, 7, 116);
    set_byte(cand_buf, 8, 100);
    set_byte(cand_buf, 9, 47);
    p = mod_copy_bytes(cand_buf, 10, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # "../rubix/std/" + path
    set_byte(cand_buf, 0, 46);
    set_byte(cand_buf, 1, 46);
    set_byte(cand_buf, 2, 47);
    set_byte(cand_buf, 3, 114);
    set_byte(cand_buf, 4, 117);
    set_byte(cand_buf, 5, 98);
    set_byte(cand_buf, 6, 105);
    set_byte(cand_buf, 7, 120);
    set_byte(cand_buf, 8, 47);
    set_byte(cand_buf, 9, 115);
    set_byte(cand_buf, 10, 116);
    set_byte(cand_buf, 11, 100);
    set_byte(cand_buf, 12, 47);
    p = mod_copy_bytes(cand_buf, 13, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # System and ancestor library fallbacks:
    let is_std_prefix = 0;
    if path_len >= 4 {
        if (get_byte(path_buf, 0) == 115) & (get_byte(path_buf, 1) == 116) & (get_byte(path_buf, 2) == 100) & (get_byte(path_buf, 3) == 47) {
            is_std_prefix = 1;
        }
    }

    # Deep ancestor search: "../../../" and "../../../../"
    set_byte(cand_buf, 0, 46); set_byte(cand_buf, 1, 46); set_byte(cand_buf, 2, 47);
    set_byte(cand_buf, 3, 46); set_byte(cand_buf, 4, 46); set_byte(cand_buf, 5, 47);
    set_byte(cand_buf, 6, 46); set_byte(cand_buf, 7, 46); set_byte(cand_buf, 8, 47);
    p = mod_copy_bytes(cand_buf, 9, path_buf, 0, path_len);
    set_byte(cand_buf, p, 0);
    fd = sys_open(cand_buf, 0, 0);
    if fd >= 0 { return fd; }

    # System library roots:
    # 1. /usr/local/lib/rubix/std/
    if is_std_prefix == 1 {
        fd = try_open_fixed_prefix(cand_buf, "/usr/local/lib/rubix/std/", 25, path_buf + 4, path_len - 4);
        if fd >= 0 { return fd; }
    } else {
        fd = try_open_fixed_prefix(cand_buf, "/usr/local/lib/rubix/std/", 25, path_buf, path_len);
        if fd >= 0 { return fd; }
    }

    # 2. /usr/share/rubix/std/
    if is_std_prefix == 1 {
        fd = try_open_fixed_prefix(cand_buf, "/usr/share/rubix/std/", 21, path_buf + 4, path_len - 4);
        if fd >= 0 { return fd; }
    } else {
        fd = try_open_fixed_prefix(cand_buf, "/usr/share/rubix/std/", 21, path_buf, path_len);
        if fd >= 0 { return fd; }
    }

    # 3. /usr/local/share/rubix/std/
    if is_std_prefix == 1 {
        fd = try_open_fixed_prefix(cand_buf, "/usr/local/share/rubix/std/", 27, path_buf + 4, path_len - 4);
        if fd >= 0 { return fd; }
    } else {
        fd = try_open_fixed_prefix(cand_buf, "/usr/local/share/rubix/std/", 27, path_buf, path_len);
        if fd >= 0 { return fd; }
    }

    # 4. /opt/rubix/std/
    if is_std_prefix == 1 {
        fd = try_open_fixed_prefix(cand_buf, "/opt/rubix/std/", 15, path_buf + 4, path_len - 4);
        if fd >= 0 { return fd; }
    } else {
        fd = try_open_fixed_prefix(cand_buf, "/opt/rubix/std/", 15, path_buf, path_len);
        if fd >= 0 { return fd; }
    }

    return -1;
}

fn resolve_use_rec(src: i64, src_len: i64, out_buf: i64, out_p: i64, seen_tbl: i64, cand_buf: i64, path_buf: i64): i64 {
    let in_p = 0;
    let at_bol = 1;

    while in_p < src_len {
        let is_import = 0;
        let is_include = 0;

        if at_bol == 1 {
            let skipping_bol = 1;
            while skipping_bol == 1 {
                if in_p >= src_len {
                    skipping_bol = 0;
                } else {
                    let b_bol = get_byte(src, in_p);
                    if (b_bol == 32) | (b_bol == 9) {
                        in_p = in_p + 1;
                    } else {
                        skipping_bol = 0;
                    }
                }
            }

            if in_p + 4 < src_len {
                if (get_byte(src, in_p) == 117) & (get_byte(src, in_p + 1) == 115) & (get_byte(src, in_p + 2) == 101) & (get_byte(src, in_p + 3) == 32) {
                    is_import = 1;
                }
            }
            if in_p + 8 < src_len {
                if (get_byte(src, in_p) == 105) & (get_byte(src, in_p + 1) == 110) & (get_byte(src, in_p + 2) == 99) & (get_byte(src, in_p + 3) == 108) & (get_byte(src, in_p + 4) == 117) & (get_byte(src, in_p + 5) == 100) & (get_byte(src, in_p + 6) == 101) & (get_byte(src, in_p + 7) == 32) {
                    is_include = 1;
                }
            }
        }

        if (is_import == 1) | (is_include == 1) {
            if is_import == 1 { in_p = in_p + 4; }
            else { in_p = in_p + 8; }

            let skipping_ws = 1;
            while skipping_ws == 1 {
                if in_p >= src_len {
                    skipping_ws = 0;
                } else {
                    let ws_b = get_byte(src, in_p);
                    if (ws_b == 32) | (ws_b == 9) { in_p = in_p + 1; }
                    else { skipping_ws = 0; }
                }
            }

            if is_include == 1 {
                if in_p < src_len {
                    if get_byte(src, in_p) == 34 { in_p = in_p + 1; }
                }
            }

            let path_p = 0;
            let reading_path = 1;
            while reading_path == 1 {
                if in_p >= src_len {
                    reading_path = 0;
                } else {
                    let b = get_byte(src, in_p);
                    if (b == 59) | (b == 34) | (b == 10) | (b == 13) {
                        reading_path = 0;
                    } else {
                        in_p = in_p + 1;
                        if is_import == 1 {
                            if b == 46 { set_byte(path_buf, path_p, 47); }
                            else { set_byte(path_buf, path_p, b); }
                        } else {
                            set_byte(path_buf, path_p, b);
                        }
                        path_p = path_p + 1;
                    }
                }
            }

            if is_import == 1 {
                set_byte(path_buf, path_p, 46);
                set_byte(path_buf, path_p + 1, 98);
                set_byte(path_buf, path_p + 2, 105);
                set_byte(path_buf, path_p + 3, 120);
                path_p = path_p + 4;
            }
            set_byte(path_buf, path_p, 0);

            let skip_nl = 1;
            while (in_p < src_len) & (skip_nl == 1) {
                let nb = get_byte(src, in_p);
                in_p = in_p + 1;
                if nb == 10 { skip_nl = 0; }
            }

            let h = hash_mod(path_buf, path_p);
            if is_module_seen(seen_tbl, h) == 0 {
                mark_module_seen(seen_tbl, h);
                let mod_fd = try_open_module(cand_buf, path_buf, path_p);
                if mod_fd >= 0 {
                    let mod_src = sys_mmap(0, 1048576, 3, 34, -1, 0);
                    let mod_read = sys_read_all(mod_fd, mod_src, 1048576);
                    sys_close(mod_fd);
                    if mod_read > 0 {
                        set_byte(mod_src, mod_read, 0);
                        out_p = resolve_use_rec(mod_src, mod_read, out_buf, out_p, seen_tbl, cand_buf, path_buf);
                        set_byte(out_buf, out_p, 10);
                        out_p = out_p + 1;
                    }
                    sys_munmap(mod_src, 1048576);
                }
            }
            at_bol = 1;
        } else {
            if in_p < src_len {
                let cb = get_byte(src, in_p);
                if cb == 35 { # '#' comment until newline
                    let in_comment = 1;
                    while (in_p < src_len) & (in_comment == 1) {
                        let cm_b = get_byte(src, in_p);
                        set_byte(out_buf, out_p, cm_b);
                        in_p = in_p + 1;
                        out_p = out_p + 1;
                        if cm_b == 10 {
                            in_comment = 0;
                            at_bol = 1;
                        }
                    }
                } else {
                    if cb == 34 { # string literal
                        let scan_p = in_p + 1;
                        let has_interp = 0;
                        let str_end = 0 - 1;
                        let in_interp_expr = 0;
                        let interp_braces = 0;
                        while (scan_p < src_len) & (str_end < 0) {
                            let sc = get_byte(src, scan_p);
                            if in_interp_expr == 0 {
                                if sc == 92 {
                                    scan_p = scan_p + 2;
                                } else {
                                    if sc == 34 {
                                        str_end = scan_p;
                                        scan_p = scan_p + 1;
                                    } else {
                                        if sc == 123 {
                                            has_interp = 1;
                                            in_interp_expr = 1;
                                            interp_braces = 1;
                                            scan_p = scan_p + 1;
                                        } else {
                                            scan_p = scan_p + 1;
                                        }
                                    }
                                }
                            } else {
                                if sc == 34 {
                                    scan_p = scan_p + 1;
                                    let nested_str = 1;
                                    while (scan_p < src_len) & (nested_str == 1) {
                                        let nsc = get_byte(src, scan_p);
                                        if nsc == 92 {
                                            scan_p = scan_p + 2;
                                        } else {
                                            scan_p = scan_p + 1;
                                            if nsc == 34 { nested_str = 0; }
                                        }
                                    }
                                } else {
                                    if sc == 123 {
                                        interp_braces = interp_braces + 1;
                                        scan_p = scan_p + 1;
                                    } else {
                                        if sc == 125 {
                                            interp_braces = interp_braces - 1;
                                            if interp_braces == 0 {
                                                in_interp_expr = 0;
                                            }
                                            scan_p = scan_p + 1;
                                        } else {
                                            scan_p = scan_p + 1;
                                        }
                                    }
                                }
                            }
                        }

                        if has_interp == 0 {
                            let limit_p = scan_p;
                            if str_end >= 0 { limit_p = str_end + 1; }
                            while in_p < limit_p {
                                set_byte(out_buf, out_p, get_byte(src, in_p));
                                in_p = in_p + 1;
                                out_p = out_p + 1;
                            }
                            at_bol = 0;
                        } else {
                            set_byte(out_buf, out_p, 40); out_p = out_p + 1;
                            set_byte(out_buf, out_p, 34); out_p = out_p + 1;
                            set_byte(out_buf, out_p, 34); out_p = out_p + 1;
                            in_p = in_p + 1;

                            while in_p < str_end {
                                let cur_c = get_byte(src, in_p);
                                if cur_c == 123 {
                                    in_p = in_p + 1;
                                    set_byte(out_buf, out_p, 32); out_p = out_p + 1;
                                    set_byte(out_buf, out_p, 43); out_p = out_p + 1;
                                    set_byte(out_buf, out_p, 32); out_p = out_p + 1;
                                    set_byte(out_buf, out_p, 40); out_p = out_p + 1;
                                    let expr_braces = 1;
                                    while (in_p < str_end) & (expr_braces > 0) {
                                        let ec = get_byte(src, in_p);
                                        if ec == 34 {
                                            set_byte(out_buf, out_p, ec); in_p = in_p + 1; out_p = out_p + 1;
                                            let nq = 1;
                                            while (in_p < str_end) & (nq == 1) {
                                                let n_ec = get_byte(src, in_p);
                                                set_byte(out_buf, out_p, n_ec); in_p = in_p + 1; out_p = out_p + 1;
                                                if n_ec == 92 {
                                                    if in_p < str_end {
                                                        set_byte(out_buf, out_p, get_byte(src, in_p));
                                                        in_p = in_p + 1; out_p = out_p + 1;
                                                    }
                                                } else {
                                                    if n_ec == 34 { nq = 0; }
                                                }
                                            }
                                        } else {
                                            if ec == 123 {
                                                expr_braces = expr_braces + 1;
                                                set_byte(out_buf, out_p, ec); in_p = in_p + 1; out_p = out_p + 1;
                                            } else {
                                                if ec == 125 {
                                                    expr_braces = expr_braces - 1;
                                                    if expr_braces > 0 {
                                                        set_byte(out_buf, out_p, ec); in_p = in_p + 1; out_p = out_p + 1;
                                                    } else {
                                                        in_p = in_p + 1;
                                                    }
                                                } else {
                                                    set_byte(out_buf, out_p, ec); in_p = in_p + 1; out_p = out_p + 1;
                                                }
                                            }
                                        }
                                    }
                                    set_byte(out_buf, out_p, 41); out_p = out_p + 1;
                                } else {
                                    set_byte(out_buf, out_p, 32); out_p = out_p + 1;
                                    set_byte(out_buf, out_p, 43); out_p = out_p + 1;
                                    set_byte(out_buf, out_p, 32); out_p = out_p + 1;
                                    set_byte(out_buf, out_p, 34); out_p = out_p + 1;
                                    while (in_p < str_end) & (get_byte(src, in_p) != 123) {
                                        let lc = get_byte(src, in_p);
                                        if lc == 92 {
                                            let next_c = get_byte(src, in_p + 1);
                                            if (next_c == 123) | (next_c == 125) {
                                                in_p = in_p + 1;
                                                set_byte(out_buf, out_p, next_c);
                                                in_p = in_p + 1; out_p = out_p + 1;
                                            } else {
                                                set_byte(out_buf, out_p, lc); in_p = in_p + 1; out_p = out_p + 1;
                                                if in_p < str_end {
                                                    set_byte(out_buf, out_p, get_byte(src, in_p));
                                                    in_p = in_p + 1; out_p = out_p + 1;
                                                }
                                            }
                                        } else {
                                            set_byte(out_buf, out_p, lc); in_p = in_p + 1; out_p = out_p + 1;
                                        }
                                    }
                                    set_byte(out_buf, out_p, 34); out_p = out_p + 1;
                                }
                            }
                            in_p = in_p + 1;
                            set_byte(out_buf, out_p, 41); out_p = out_p + 1;
                            at_bol = 0;
                        }
                    } else {
                        let cb = get_byte(src, in_p);
                        set_byte(out_buf, out_p, cb);
                        in_p = in_p + 1;
                        out_p = out_p + 1;
                        if cb == 10 {
                            at_bol = 1;
                        } else {
                            at_bol = 0;
                        }
                    }
                }
            }
        }
    }

    return out_p;
}

fn resolve_use(src: i64, src_len: i64, out_buf: i64): i64 {
    let seen_tbl = sys_mmap_page();
    set_qword(seen_tbl, 0, 0);
    let cand_buf = sys_mmap_page();
    let path_buf = sys_mmap_page();

    let final_len = resolve_use_rec(src, src_len, out_buf, 0, seen_tbl, cand_buf, path_buf);

    sys_munmap(seen_tbl, 4096);
    sys_munmap(cand_buf, 4096);
    sys_munmap(path_buf, 4096);
    set_byte(out_buf, final_len, 0);
    return final_len;
}



fn compile_source_buffer_target(src: i64, src_len: i64, code_buf: i64, opt_level: i64, target_id: i64): i64 {
    let opt_ctx = sys_mmap_page();
    opt_ctx_init(opt_ctx, opt_level);

    # Primary RUMS Pipeline: Rubix source -> Universal UIR -> Optimizer -> Bridge/RUMS native bytes
    let uir_buf = sys_mmap(0, 2097152, 3, 34, -1, 0);
    uir_init(uir_buf);
    let uir_nodes = uir_frontend_parse_target(src, src_len, uir_buf, target_id);
    if uir_nodes > 0 {
        let uir_v = uir_verify_program(uir_buf);
        if uir_v < 0 {
            return -12;
        }

        # Integrated MIR Phase: Construct CFG & Enforce MIR Invariants
        let mir_buf = sys_mmap(0, 2097152, 3, 34, -1, 0);
        mir_init(mir_buf);
        let mir_build_res = mir_build_from_uir(uir_buf, mir_buf);
        if mir_build_res < 0 {
            sys_munmap(mir_buf, 2097152);
            return -13;
        }
        let mir_v = mir_verify_program(mir_buf);
        sys_munmap(mir_buf, 2097152);
        if mir_v < 0 {
            return -14;
        }

        warnings_analyze_uir(uir_buf, 0);
        if opt_level >= 1 {
            opt_run_pipeline(opt_ctx, uir_buf, uir_nodes);
        }
        if target_id == TARGET_X86_64 {
            let bridge_res = uir_bridge_compile_program(uir_buf, code_buf);
            if bridge_res > 0 {
                return bridge_res;
            }
        }
        if target_id != TARGET_X86_64 {
            let rums_len = rums_synthesize_program(uir_buf, code_buf, target_id);
            if rums_len > 0 {
                return rums_len;
            }
            return -12;
        }
    }

    # Reference / Legacy compilation pipeline: parser -> direct x86-64 machine bytes (target 1 only)
    if target_id != TARGET_X86_64 {
        return -12;
    }

    let state_buf = sys_mmap_page();
    let tbl_buf = sys_mmap(0, 33554432, 3, 34, -1, 0);
    let tok_buf = sys_mmap_page();

    set_qword(state_buf, 0, src);
    set_qword(state_buf, 1, src_len);
    set_qword(state_buf, 2, 0); # pos = 0
    set_qword(state_buf, 3, code_buf);
    set_qword(state_buf, 4, 0); # code_len = 0
    set_qword(state_buf, 5, tbl_buf);
    set_qword(state_buf, 6, tok_buf);
    set_qword(state_buf, 7, 0); # status = 0

    let opt_en = 0;
    if opt_level >= 1 { opt_en = 1; }
    set_qword(state_buf, 22, opt_en);
    set_qword(state_buf, 23, opt_ctx);

    let code_len = parse_program(state_buf);
    let status = get_qword(state_buf, 7);
    if status < 0 {
        let err_pos = get_qword(state_buf, 8);
        if err_pos <= 0 {
            err_pos = get_qword(tok_buf, 2);
        }
        set_qword(code_buf, 0, err_pos);
        return status;
    }

    if opt_level >= 1 {
        opt_run_pipeline(opt_ctx, code_buf, code_len);
    }

    return code_len;
}

fn compile_source_buffer_opt(src: i64, src_len: i64, code_buf: i64, opt_level: i64): i64 {
    return compile_source_buffer_target(src, src_len, code_buf, opt_level, 1);
}

fn compile_and_run_mode(src_path: i64, mode: i64): i64 {
    let fd = sys_open(src_path, 0, 0);
    if fd < 0 {
        return -10;
    }
    let raw_src = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let n = sys_read_all(fd, raw_src, 2097152);
    sys_close(fd);
    if n <= 0 {
        return -11;
    }
    set_byte(raw_src, n, 0);

    if n >= 4 {
        if get_byte(raw_src, 0) == REX_MAGIC_0 {
            if get_byte(raw_src, 1) == REX_MAGIC_1 {
                if get_byte(raw_src, 2) == REX_MAGIC_2 {
                    if get_byte(raw_src, 3) == REX_MAGIC_3 {
                        return rex_execute(raw_src, n, mode);
                    }
                }
            }
        }
    }

    let sp = 0;
    while get_byte(src_path, sp) != 0 {
        sp = sp + 1;
    }
    if sp >= 4 {
        if get_byte(src_path, sp - 4) == 46 {
            if get_byte(src_path, sp - 3) == 114 {
                if get_byte(src_path, sp - 2) == 101 {
                    if get_byte(src_path, sp - 1) == 120 {
                        return rex_execute(raw_src, n, mode);
                    }
                }
            }
        }
    }

    let code_buf = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let res_src = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let res_len = resolve_use(raw_src, n, res_src);
    let code_len = compile_source_buffer_opt(res_src, res_len, code_buf, 1);
    if code_len <= 0 {
        let err_code = code_len;
        if err_code == 0 { err_code = -12; }
        let err_pos = get_qword(code_buf, 0);
        diag_report_error_loc(src_path, err_code, res_src, res_len, err_pos);
        return err_code;
    }

    let result = executor_execute(code_buf, code_len);
    return result;
}

fn compile_and_run(src_path: i64): i64 {
    return compile_and_run_mode(src_path, REX_MODE_COMPILED);
}


fn detect_target_from_path(path: i64): i64 {
    let p = 0;
    while get_byte(path, p) != 0 {
        p = p + 1;
    }
    let i = 0;
    while i < p {
        let prev_ok = 0;
        if i == 0 {
            prev_ok = 1;
        } else {
            let prev = get_byte(path, i - 1);
            if (prev == 46) | (prev == 95) | (prev == 47) { # '.', '_', '/'
                prev_ok = 1;
            }
        }
        if prev_ok == 1 {
            # Check for 'arm64'
            if i + 5 <= p {
                if get_byte(path, i) == 97 {
                    if get_byte(path, i + 1) == 114 {
                        if get_byte(path, i + 2) == 109 {
                            if get_byte(path, i + 3) == 54 {
                                if get_byte(path, i + 4) == 52 {
                                    let next = get_byte(path, i + 5);
                                    if (next == 0) | (next == 46) | (next == 95) {
                                        return TARGET_ARM64;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            # Check for 'aarch64'
            if i + 7 <= p {
                if get_byte(path, i) == 97 {
                    if get_byte(path, i + 1) == 97 {
                        if get_byte(path, i + 2) == 114 {
                            if get_byte(path, i + 3) == 99 {
                                if get_byte(path, i + 4) == 104 {
                                    if get_byte(path, i + 5) == 54 {
                                        if get_byte(path, i + 6) == 52 {
                                            let next = get_byte(path, i + 7);
                                            if (next == 0) | (next == 46) | (next == 95) {
                                                return TARGET_ARM64;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            # Check for 'riscv'
            if i + 5 <= p {
                if get_byte(path, i) == 114 {
                    if get_byte(path, i + 1) == 105 {
                        if get_byte(path, i + 2) == 115 {
                            if get_byte(path, i + 3) == 99 {
                                if get_byte(path, i + 4) == 118 {
                                    return TARGET_RISCV64;
                                }
                            }
                        }
                    }
                }
            }
            # Check for 'rex'
            if i + 3 <= p {
                if get_byte(path, i) == 114 {
                    if get_byte(path, i + 1) == 101 {
                        if get_byte(path, i + 2) == 120 {
                            let next = get_byte(path, i + 3);
                            if (next == 0) | (next == 46) | (next == 95) {
                                return TARGET_REX;
                            }
                        }
                    }
                }
            }
            # Check for 'synth'
            if i + 5 <= p {
                if get_byte(path, i) == 115 {
                    if get_byte(path, i + 1) == 121 {
                        if get_byte(path, i + 2) == 110 {
                            if get_byte(path, i + 3) == 116 {
                                if get_byte(path, i + 4) == 104 {
                                    return TARGET_SYNTHETIC;
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return TARGET_X86_64;
}

fn compile_file_to_binary_target(src_path: i64, out_path: i64, target_id: i64): i64 {
    let fd = sys_open(src_path, 0, 0);
    if fd < 0 {
        return -10;
    }
    let raw_src = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let n = sys_read_all(fd, raw_src, 2097152);
    sys_close(fd);
    if n <= 0 {
        return -11;
    }
    set_byte(raw_src, n, 0);

    let code_buf = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let res_src = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let res_len = resolve_use(raw_src, n, res_src);
    let code_len = compile_source_buffer_target(res_src, res_len, code_buf, 1, target_id);
    if code_len <= 0 {
        let err_code = code_len;
        if err_code == 0 { err_code = -12; }
        let err_pos = get_qword(code_buf, 0);
        diag_report_error_loc(src_path, err_code, res_src, res_len, err_pos);
        return err_code;
    }

    let p = 0;
    while get_byte(out_path, p) != 0 {
        p = p + 1;
    }
    let is_elf = 0;
    let is_pe = 0;
    let is_macho = 0;
    let is_wasm = 0;
    if p >= 4 {
        if (get_byte(out_path, p - 4) == 46) & (get_byte(out_path, p - 3) == 101) & (get_byte(out_path, p - 2) == 108) & (get_byte(out_path, p - 1) == 102) { # .elf
            is_elf = 1;
        }
        if (get_byte(out_path, p - 4) == 46) & (get_byte(out_path, p - 3) == 101) & (get_byte(out_path, p - 2) == 120) & (get_byte(out_path, p - 1) == 101) { # .exe
            is_pe = 1;
        }
    }
    if p >= 5 {
        if (get_byte(out_path, p - 5) == 46) & (get_byte(out_path, p - 4) == 119) & (get_byte(out_path, p - 3) == 97) & (get_byte(out_path, p - 2) == 115) & (get_byte(out_path, p - 1) == 109) { # .wasm
            is_wasm = 1;
        }
    }
    if p >= 6 {
        if (get_byte(out_path, p - 6) == 46) & (get_byte(out_path, p - 5) == 109) & (get_byte(out_path, p - 4) == 97) & (get_byte(out_path, p - 3) == 99) & (get_byte(out_path, p - 2) == 104) & (get_byte(out_path, p - 1) == 111) { # .macho
            is_macho = 1;
        }
    }

    let final_res = code_len;
    if is_elf == 1 {
        final_res = write_elf_executable_target(out_path, code_buf, code_len, target_id);
        if final_res <= 0 {
            return final_res;
        }
    } else {
        if is_pe == 1 {
            final_res = pe_coff_write_executable(out_path, code_buf, code_len, target_id);
            if final_res <= 0 {
                return final_res;
            }
        } else {
            if is_macho == 1 {
                final_res = macho_write_object(out_path, code_buf, code_len, target_id);
                if final_res <= 0 {
                    return final_res;
                }
            } else {
                if is_wasm == 1 {
                    final_res = wasm_write_module(out_path, code_buf, code_len);
                    if final_res <= 0 {
                        return final_res;
                    }
                } else {
                    final_res = write_elf_executable_target(out_path, code_buf, code_len, target_id);
                    if final_res <= 0 {
                        return final_res;
                    }
                }
            }
        }
    }

    # --- Check for adjacent RCS stylesheet (e.g. app.rcs next to app.bix) ---
    let src_p = 0;
    while get_byte(src_path, src_p) != 0 {
        src_p = src_p + 1;
    }
    if src_p >= 4 {
        if (get_byte(src_path, src_p - 4) == 46) & (get_byte(src_path, src_p - 3) == 98) & (get_byte(src_path, src_p - 2) == 105) & (get_byte(src_path, src_p - 1) == 120) {
            let rcs_cand = sys_mmap(0, src_p + 16, 3, 34, -1, 0);
            let ci = 0;
            while ci < (src_p - 3) {
                set_byte(rcs_cand, ci, get_byte(src_path, ci));
                ci = ci + 1;
            }
            set_byte(rcs_cand, src_p - 3, 114); # 'r'
            set_byte(rcs_cand, src_p - 2, 99);  # 'c'
            set_byte(rcs_cand, src_p - 1, 115); # 's'
            set_byte(rcs_cand, src_p, 0);

            let rcs_fd = sys_open(rcs_cand, 0, 0);
            if rcs_fd >= 0 {
                let rcs_raw = sys_mmap(0, 1048576, 3, 34, -1, 0);
                let rn = sys_read_all(rcs_fd, rcs_raw, 1048576);
                sys_close(rcs_fd);
                if rn > 0 {
                    set_byte(rcs_raw, rn, 0);
                    let sbuf = alloc_buffer(rn + 1) as *u8;
                    let si = 0;
                    while si < rn {
                        sbuf[si] = get_byte(rcs_raw, si) as u8;
                        si = si + 1;
                    }
                    sbuf[rn] = 0 as u8;
                    let rcs_src_str = string_from_raw(sbuf);
                    free_buffer(sbuf as ptr, rn + 1);
                    let rcs_css = rcs_emit_css(rcs_src_str);
                    let rcs_css_len = string_length(rcs_css);

                    let out_p = 0;
                    while get_byte(out_path, out_p) != 0 {
                        out_p = out_p + 1;
                    }
                    let css_out_path = sys_mmap(0, out_p + 16, 3, 34, -1, 0);
                    let cj = 0;
                    let last_dot = -1;
                    while cj < out_p {
                        set_byte(css_out_path, cj, get_byte(out_path, cj));
                        if get_byte(out_path, cj) == 46 {
                            last_dot = cj;
                        }
                        cj = cj + 1;
                    }
                    if last_dot > 0 {
                        set_byte(css_out_path, last_dot, 46); # '.'
                        set_byte(css_out_path, last_dot + 1, 99); # 'c'
                        set_byte(css_out_path, last_dot + 2, 115); # 's'
                        set_byte(css_out_path, last_dot + 3, 115); # 's'
                        set_byte(css_out_path, last_dot + 4, 0);
                    } else {
                        set_byte(css_out_path, out_p, 46); # '.'
                        set_byte(css_out_path, out_p + 1, 99); # 'c'
                        set_byte(css_out_path, out_p + 2, 115); # 's'
                        set_byte(css_out_path, out_p + 3, 115); # 's'
                        set_byte(css_out_path, out_p + 4, 0);
                    }

                    let css_fd = sys_open(css_out_path, 577, 493);
                    if css_fd >= 0 {
                        let c_buf = sys_mmap(0, rcs_css_len + 1, 3, 34, -1, 0);
                        let ck = 0;
                        while ck < rcs_css_len {
                            set_byte(c_buf, ck, rcs_css[ck] as i64);
                            ck = ck + 1;
                        }
                        sys_write_all(css_fd, c_buf, rcs_css_len);
                        sys_close(css_fd);
                        sys_munmap(c_buf, rcs_css_len + 1);
                    }
                    sys_munmap(css_out_path, out_p + 16);
                }
                sys_munmap(rcs_raw, 1048576);
            }
            sys_munmap(rcs_cand, src_p + 16);
        }
    }

    return final_res;
}

fn compile_file_to_binary(src_path: i64, out_path: i64): i64 {
    let target_id = detect_target_from_path(out_path);
    if target_id == TARGET_X86_64 {
        target_id = detect_target_from_path(src_path);
    }
    return compile_file_to_binary_target(src_path, out_path, target_id);
}

fn is_rcs_file_path(path: i64): i64 {
    if path == 0 { return 0; }
    let p = 0;
    while get_byte(path, p) != 0 {
        p = p + 1;
    }
    if p >= 4 {
        if (get_byte(path, p - 4) == 46) & (get_byte(path, p - 3) == 114) & (get_byte(path, p - 2) == 99) & (get_byte(path, p - 1) == 115) { # .rcs
            return 1;
        }
    }
    return 0;
}

fn rcs_compile_dispatch(src_path: i64, out_path: i64): i64 {
    let fd = sys_open(src_path, 0, 0);
    if fd < 0 {
        return -10;
    }
    let raw_src = sys_mmap(0, 1048576, 3, 34, -1, 0);
    let n = sys_read_all(fd, raw_src, 1048576);
    sys_close(fd);
    if n <= 0 {
        sys_munmap(raw_src, 1048576);
        return -11;
    }
    set_byte(raw_src, n, 0);
    let sbuf = alloc_buffer(n + 1) as *u8;
    let si = 0;
    while si < n {
        sbuf[si] = get_byte(raw_src, si) as u8;
        si = si + 1;
    }
    sbuf[n] = 0 as u8;
    let rcs_src_str = string_from_raw(sbuf);
    free_buffer(sbuf as ptr, n + 1);
    let rcs_css = rcs_emit_css(rcs_src_str);
    let rcs_css_len = string_length(rcs_css);

    let c_buf = sys_mmap(0, rcs_css_len + 1, 3, 34, -1, 0);
    let ck = 0;
    while ck < rcs_css_len {
        set_byte(c_buf, ck, rcs_css[ck] as i64);
        ck = ck + 1;
    }
    set_byte(c_buf, rcs_css_len, 0);

    let is_stdout = 0;
    if (out_path == 0) | (out_path == 1) {
        is_stdout = 1;
    } else {
        if out_path > 1000 {
            if (get_byte(out_path, 0) == 45) & (get_byte(out_path, 1) == 45) {
                is_stdout = 1;
            }
        }
    }

    if is_stdout == 1 {
        sys_write_all(1, c_buf, rcs_css_len);
        sys_munmap(c_buf, rcs_css_len + 1);
        sys_munmap(raw_src, 1048576);
        return rcs_css_len;
    }

    let out_fd = sys_open(out_path, 577, 493);
    if out_fd < 0 {
        sys_munmap(c_buf, rcs_css_len + 1);
        sys_munmap(raw_src, 1048576);
        return -20;
    }
    let w = sys_write_all(out_fd, c_buf, rcs_css_len);
    sys_close(out_fd);
    sys_munmap(c_buf, rcs_css_len + 1);
    sys_munmap(raw_src, 1048576);
    if w != rcs_css_len {
        return -21;
    }
    return rcs_css_len;
}

# ------------------------------------------------------------------------------
# Rubix Runtime CLI (the 'node' of Rubix)
# The OS delivers (argc, argv) into this entry point. We dispatch to the
# compiler. Nothing here depends on Python or any external runtime.
# ------------------------------------------------------------------------------
fn cli_streq(a: i64, b: str): i64 {
    let blen = string_length(b);
    let i = 0;
    while i < blen {
        let ca = get_byte(a, i);
        let cb = b[i] as i64;
        if ca != cb { return 0; }
        i = i + 1;
    }
    if get_byte(a, blen) == 0 {
        return 1;
    }
    return 0;
}

fn cli_write_s(buf: i64, pos: i64, s: str): i64 {
    let slen = string_length(s);
    let i = 0;
    while i < slen {
        set_byte(buf, pos + i, s[i] as i64);
        i = i + 1;
    }
    return pos + slen;
}

fn cli_write_lit(fd: i64, s: str): i64 {
    let buf = sys_mmap_page();
    let cur = cli_write_s(buf, 0, s);
    sys_write(fd, buf, cur);
    sys_munmap(buf, 4096);
    return 0;
}

fn cli_print_targets(): i64 {
    let buf = sys_mmap_page();
    let cur = 0;
    cur = cli_write_s(buf, cur, "Rubix Target Architecture & Platform Registry:\n\n");
    cur = cli_write_s(buf, cur, "Target Triple / Identifier    CPU Arch     OS Family    Object Format    Maturity Tier    Status\n");
    cur = cli_write_s(buf, cur, "---------------------------------------------------------------------------------------------------------\n");
    cur = cli_write_s(buf, cur, "x86_64-unknown-linux-elf      x86-64       Linux        ELF64            Tier 1           Verified Native & Self-Hosting\n");
    cur = cli_write_s(buf, cur, "rex-bytecode                  REX          Universal    REX Bytecode     Tier 1           Verified JIT / Interpreter / VM\n");
    cur = cli_write_s(buf, cur, "aarch64-unknown-linux-elf     AArch64      Linux        ELF64            Tier 2           Supported Cross-Target (RUMS)\n");
    cur = cli_write_s(buf, cur, "riscv64-unknown-linux-elf     RISC-V 64    Linux        ELF64            Tier 2           Supported Cross-Target (RUMS)\n");
    cur = cli_write_s(buf, cur, "x86_64-pc-windows-pe          x86-64       Windows      PE/COFF          Tier 4           Planned Target Specification\n");
    cur = cli_write_s(buf, cur, "x86_64-apple-darwin-macho     x86-64       macOS        Mach-O           Tier 4           Planned Target Specification\n");
    cur = cli_write_s(buf, cur, "wasm32-unknown-wasi           Wasm32       WASI         WebAssembly      Tier 4           Planned Target Specification\n\n");
    cur = cli_write_s(buf, cur, "Active Host: x86_64-unknown-linux-elf (Native Tier 1)\n");
    sys_write(1, buf, cur);
    sys_munmap(buf, 4096);
    return 0;
}

fn compiler_check_entry_opt(src_path: i64, json_mode: i64): i64 {
    let fd = sys_open(src_path, 0, 0);
    if fd < 0 {
        if json_mode == 1 {
            diag_report_error_json(src_path, -10, 0, 0, -1);
        } else {
            diag_report_error_loc(src_path, -10, 0, 0, -1);
        }
        return -10;
    }
    let raw_src = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let n = sys_read_all(fd, raw_src, 2097152);
    sys_close(fd);
    if n <= 0 {
        if json_mode == 1 {
            diag_report_error_json(src_path, -11, 0, 0, -1);
        } else {
            diag_report_error_loc(src_path, -11, 0, 0, -1);
        }
        sys_munmap(raw_src, 2097152);
        return -11;
    }
    set_byte(raw_src, n, 0);

    let code_buf = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let res_src = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let res_len = resolve_use(raw_src, n, res_src);
    let code_len = compile_source_buffer_target(res_src, res_len, code_buf, 0, TARGET_X86_64);
    if code_len <= 0 {
        let err_code = code_len;
        if err_code == 0 { err_code = -12; }
        if err_code == -54 {
            # Library or module checked successfully without requiring a standalone main() entrypoint
            sys_munmap(code_buf, 2097152);
            sys_munmap(res_src, 2097152);
            sys_munmap(raw_src, 2097152);
            if json_mode == 1 {
                let jbuf = sys_mmap_page();
                let jcur = 0;
                set_byte(jbuf, jcur, 123); jcur = jcur + 1; # '{'
                jcur = cli_write_s(jbuf, jcur, "\"diagnostics\":[],\"status\":\"ok\",\"errors\":0");
                set_byte(jbuf, jcur, 125); jcur = jcur + 1; # '}'
                set_byte(jbuf, jcur, 10); jcur = jcur + 1;  # '\n'
                sys_write(1, jbuf, jcur);
                sys_munmap(jbuf, 4096);
            } else {
                cli_write_lit(1, "rubix: check passed: 0 errors\n");
            }
            return 0;
        }
        let err_pos = get_qword(code_buf, 0);
        if json_mode == 1 {
            diag_report_error_json(src_path, err_code, res_src, res_len, err_pos);
        } else {
            diag_report_error_loc(src_path, err_code, res_src, res_len, err_pos);
        }
        sys_munmap(code_buf, 2097152);
        sys_munmap(res_src, 2097152);
        sys_munmap(raw_src, 2097152);
        return err_code;
    }

    sys_munmap(code_buf, 2097152);
    sys_munmap(res_src, 2097152);
    sys_munmap(raw_src, 2097152);

    if json_mode == 1 {
        let jbuf = sys_mmap_page();
        let jcur = 0;
        set_byte(jbuf, jcur, 123); jcur = jcur + 1; # '{'
        jcur = cli_write_s(jbuf, jcur, "\"diagnostics\":[],\"status\":\"ok\",\"errors\":0");
        set_byte(jbuf, jcur, 125); jcur = jcur + 1; # '}'
        set_byte(jbuf, jcur, 10); jcur = jcur + 1;  # '\n'
        sys_write(1, jbuf, jcur);
        sys_munmap(jbuf, 4096);
    } else {
        cli_write_lit(1, "rubix: check passed: 0 errors\n");
    }
    return 0;
}

fn compiler_check_entry(src_path: i64): i64 {
    return compiler_check_entry_opt(src_path, 0);
}

fn compiler_emit_tokens(src_path: i64): i64 {
    let fd = sys_open(src_path, 0, 0);
    if fd < 0 {
        diag_report_error_loc(src_path, -10, 0, 0, -1);
        return -10;
    }
    let raw_src = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let n = sys_read_all(fd, raw_src, 2097152);
    sys_close(fd);
    if n <= 0 {
        diag_report_error_loc(src_path, -11, 0, 0, -1);
        sys_munmap(raw_src, 2097152);
        return -11;
    }
    set_byte(raw_src, n, 0);

    let res_src = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let res_len = resolve_use(raw_src, n, res_src);

    let tok_buf = sys_mmap_page();
    let p = 0;
    let running = 1;
    let out_buf = sys_mmap_page();
    let cur = 0;
    cur = cli_write_s(out_buf, cur, "=== RUBIX TOKEN STREAM ===\n");
    sys_write(1, out_buf, cur);

    while running == 1 {
        p = scan_token(res_src, p, res_len, tok_buf);
        let kind = get_qword(tok_buf, 0);
        let val = get_qword(tok_buf, 1);
        let off = get_qword(tok_buf, 2);
        let tlen = get_qword(tok_buf, 3);

        cur = 0;
        cur = cli_write_s(out_buf, cur, "token: kind=");
        cur = diag_write_num(out_buf, cur, kind);
        cur = cli_write_s(out_buf, cur, " off=");
        cur = diag_write_num(out_buf, cur, off);
        cur = cli_write_s(out_buf, cur, " len=");
        cur = diag_write_num(out_buf, cur, tlen);
        cur = cli_write_s(out_buf, cur, " val=");
        cur = diag_write_num(out_buf, cur, val);
        cur = cli_write_s(out_buf, cur, "\n");
        sys_write(1, out_buf, cur);

        if kind == TOKEN_EOF {
            running = 0;
        }
    }

    sys_munmap(out_buf, 4096);
    sys_munmap(tok_buf, 4096);
    sys_munmap(res_src, 2097152);
    sys_munmap(raw_src, 2097152);
    return 0;
}

fn compiler_emit_uir(src_path: i64): i64 {
    let fd = sys_open(src_path, 0, 0);
    if fd < 0 {
        diag_report_error_loc(src_path, -10, 0, 0, -1);
        return -10;
    }
    let raw_src = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let n = sys_read_all(fd, raw_src, 2097152);
    sys_close(fd);
    if n <= 0 {
        diag_report_error_loc(src_path, -11, 0, 0, -1);
        sys_munmap(raw_src, 2097152);
        return -11;
    }
    set_byte(raw_src, n, 0);

    let res_src = sys_mmap(0, 2097152, 3, 34, -1, 0);
    let res_len = resolve_use(raw_src, n, res_src);

    let uir_buf = sys_mmap(0, 2097152, 3, 34, -1, 0);
    uir_init(uir_buf);
    let node_count = uir_frontend_parse_target(res_src, res_len, uir_buf, TARGET_X86_64);
    if node_count <= 0 {
        cli_write_lit(2, "rubix: uir frontend failed to produce instructions\n");
        sys_munmap(uir_buf, 2097152);
        sys_munmap(res_src, 2097152);
        sys_munmap(raw_src, 2097152);
        return -12;
    }

    let out_buf = sys_mmap_page();
    let cur = 0;
    cur = cli_write_s(out_buf, cur, "=== RUBIX UNIVERSAL IR (UIR) ===\n");
    cur = cli_write_s(out_buf, cur, "Total instructions: ");
    cur = diag_write_num(out_buf, cur, node_count);
    cur = cli_write_s(out_buf, cur, "\n");
    sys_write(1, out_buf, cur);

    let i = 0;
    while i < node_count {
        let addr = uir_node_addr(uir_buf, i);
        let op = get_qword(addr, 0);
        let ty = get_qword(addr, 1);
        let dst = get_qword(addr, 4);
        let s1 = get_qword(addr, 5);
        let s2 = get_qword(addr, 6);
        let ext = get_qword(addr, 7);

        cur = 0;
        cur = cli_write_s(out_buf, cur, "  [");
        cur = diag_write_num(out_buf, cur, i);
        cur = cli_write_s(out_buf, cur, "] op=");
        cur = diag_write_num(out_buf, cur, op);
        cur = cli_write_s(out_buf, cur, " ty=");
        cur = diag_write_num(out_buf, cur, ty);
        cur = cli_write_s(out_buf, cur, " dst=");
        cur = diag_write_num(out_buf, cur, dst);
        cur = cli_write_s(out_buf, cur, " src1=");
        cur = diag_write_num(out_buf, cur, s1);
        cur = cli_write_s(out_buf, cur, " src2=");
        cur = diag_write_num(out_buf, cur, s2);
        cur = cli_write_s(out_buf, cur, " extra=");
        cur = diag_write_num(out_buf, cur, ext);
        cur = cli_write_s(out_buf, cur, "\n");
        sys_write(1, out_buf, cur);

        i = i + 1;
    }

    sys_munmap(out_buf, 4096);
    sys_munmap(uir_buf, 2097152);
    sys_munmap(res_src, 2097152);
    sys_munmap(raw_src, 2097152);
    return 0;
}

fn cli_usage(): i64 {
    cli_write_lit(2, "rubix: usage: rubix <command> [options]\n\n");
    cli_write_lit(2, "Commands:\n");
    cli_write_lit(2, "  run <file.bix>                          Execute a Rubix program\n");
    cli_write_lit(2, "  compile <file.bix> [-o out.elf/.exe]    Compile to native executable/object\n");
    cli_write_lit(2, "  check [--json] <file.bix>               Type-check and verify source\n");
    cli_write_lit(2, "  targets                                 Show target architecture registry\n");
    cli_write_lit(2, "  emit <tokens|uir|pe|macho|wasm> <file>  Inspect IR or package binary\n\n");
    cli_write_lit(2, "Options:\n");
    cli_write_lit(2, "  --version                               Print version information\n");
    cli_write_lit(2, "  --help                                  Show this help message\n");
    return 0;
}

fn main(argc: i64, argv: i64): i64 {
    if argc > 500 {
        return compiler_entry(argc, argv);
    }
    if argc < 2 {
        return cli_usage();
    }
    let a1 = get_qword(argv, 1);
    if cli_streq(a1, "--version") == 1 {
        cli_write_lit(1, "rubix v1.0.0\n");
        return 0;
    }
    if (cli_streq(a1, "--help") == 1) | (cli_streq(a1, "-h") == 1) {
        return cli_usage();
    }
    if cli_streq(a1, "targets") == 1 {
        return cli_print_targets();
    }
    if cli_streq(a1, "check") == 1 {
        if argc < 3 { return cli_usage(); }
        let is_json = 0;
        let c_file = get_qword(argv, 2);
        if (cli_streq(c_file, "--json") == 1) | (cli_streq(c_file, "-j") == 1) {
            is_json = 1;
            if argc < 4 { return cli_usage(); }
            c_file = get_qword(argv, 3);
        } else {
            if argc >= 4 {
                if (cli_streq(get_qword(argv, 3), "--json") == 1) | (cli_streq(get_qword(argv, 3), "-j") == 1) {
                    is_json = 1;
                }
            }
        }
        return compiler_check_entry_opt(c_file, is_json);
    }
    if cli_streq(a1, "emit") == 1 {
        if argc < 4 { return cli_usage(); }
        let kind = get_qword(argv, 2);
        let file = get_qword(argv, 3);
        if cli_streq(kind, "tokens") == 1 {
            return compiler_emit_tokens(file);
        }
        if cli_streq(kind, "uir") == 1 {
            return compiler_emit_uir(file);
        }
        if (cli_streq(kind, "pe") == 1) | (cli_streq(kind, "macho") == 1) | (cli_streq(kind, "wasm") == 1) {
            let out_file = 0;
            if argc >= 6 {
                if cli_streq(get_qword(argv, 4), "-o") == 1 {
                    out_file = get_qword(argv, 5);
                }
            }
            if (out_file == 0) & (argc >= 5) {
                out_file = get_qword(argv, 4);
            }
            if out_file == 0 { return cli_usage(); }
            let w_res = compile_file_to_binary(file, out_file);
            if w_res > 0 { return 0; }
            return w_res;
        }
        return cli_usage();
    }
    if cli_streq(a1, "run") == 1 {
        if argc < 3 { return cli_usage(); }
        return compiler_entry(get_qword(argv, 2), 0);
    }
    if cli_streq(a1, "compile") == 1 {
        if argc < 3 { return cli_usage(); }
        let src_file = get_qword(argv, 2);
        let out_file = 0;
        if argc >= 5 {
            if cli_streq(get_qword(argv, 3), "-o") == 1 {
                out_file = get_qword(argv, 4);
            }
        }
        if (out_file == 0) & (argc >= 4) {
            out_file = get_qword(argv, 3);
        }
        return compiler_entry(src_file, out_file);
    }
    if argc >= 3 {
        return compiler_entry(a1, get_qword(argv, 2));
    }
    return compiler_entry(a1, 0);
}

fn compiler_entry(src_path: i64, out_path: i64): i64 {
    if src_path == 0 {
        return 0;
    }
    if is_rcs_file_path(src_path) == 1 {
        let r_res = rcs_compile_dispatch(src_path, out_path);
        if r_res > 0 {
            return 0;
        }
        return r_res;
    }
    if out_path == 0 {
        let res = compile_and_run(src_path);
        return res;
    }
    if out_path == 1 {
        return compile_and_run_mode(src_path, REX_MODE_COMPILED);
    }
    if out_path == 2 {
        return compile_and_run_mode(src_path, REX_MODE_INTERPRET);
    }
    if out_path == 3 {
        return compile_and_run_mode(src_path, REX_MODE_VM);
    }
    if out_path > 1000 {
        if (get_byte(out_path, 0) == 45) & (get_byte(out_path, 1) == 45) {
            let m = 1;
            let p = 0;
            while get_byte(out_path, p) != 0 {
                if (get_byte(out_path, p) == 118) & (get_byte(out_path, p + 1) == 109) {
                    m = 3;
                }
                if (get_byte(out_path, p) == 105) & (get_byte(out_path, p + 1) == 110) {
                    m = 2;
                }
                if (get_byte(out_path, p) == 99) & (get_byte(out_path, p + 1) == 111) {
                    m = 1;
                }
                p = p + 1;
            }
            return compile_and_run_mode(src_path, m);
        }
    }
    let w_res = compile_file_to_binary(src_path, out_path);
    if w_res > 0 {
        return 0;
    }
    return w_res;
}
