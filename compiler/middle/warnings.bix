# warnings.bix - compiler diagnostics, error messages, and static warnings


fn diag_get_category(code: i64): i64 {
    if code >= 0 { return 0; } # DIAG_CAT_NONE
    if code == -1 { return 2; } # DIAG_CAT_SYNTAX
    if code == -3 { return 2; } # DIAG_CAT_SYNTAX
    if code == -2 { return 3; } # DIAG_CAT_SEMANTIC
    if (code >= -21) & (code <= -10) { return 1; } # DIAG_CAT_IO
    if (code >= -34) & (code <= -30) { return 5; } # DIAG_CAT_INTERNAL
    if (code >= -60) & (code <= -35) { return 3; } # DIAG_CAT_SEMANTIC
    if code == -100 { return 5; } # DIAG_CAT_INTERNAL
    if (code >= -112) & (code <= -101) { return 4; } # DIAG_CAT_REX
    return 5; # DIAG_CAT_INTERNAL
}

fn diag_write_str(buf: i64, pos: i64, s: str, len: i64): i64 {
    let i = 0;
    while i < len {
        set_byte(buf, pos + i, s[i] as i64);
        i = i + 1;
    }
    return pos + len;
}

fn diag_write_num(buf: i64, pos: i64, num: i64): i64 {
    let n = num;
    let cur = pos;
    if n < 0 {
        set_byte(buf, cur, 45); # '-'
        cur = cur + 1;
        n = 0 - n;
    }
    if n == 0 {
        set_byte(buf, cur, 48); # '0'
        return cur + 1;
    }
    let digits_buf = buf + 512;
    let dcount = 0;
    while n > 0 {
        let rem = n % 10;
        set_byte(digits_buf, dcount, 48 + rem);
        dcount = dcount + 1;
        n = n / 10;
    }
    let j = dcount - 1;
    while j >= 0 {
        set_byte(buf, cur, get_byte(digits_buf, j));
        cur = cur + 1;
        j = j - 1;
    }
    return cur;
}

fn diag_write_message(buf: i64, pos: i64, code: i64): i64 {
    if code == -1 {
        return diag_write_str(buf, pos, "grammar syntax expectation failure", 34);
    }
    if code == -2 {
        return diag_write_str(buf, pos, "undefined identifier or variable out of scope", 45);
    }
    if code == -3 {
        return diag_write_str(buf, pos, "malformed or unrecognized token", 31);
    }
    if code == -10 {
        return diag_write_str(buf, pos, "failed to open source file", 26);
    }
    if code == -11 {
        return diag_write_str(buf, pos, "failed to read source file or file is empty", 43);
    }
    if code == -12 {
        return diag_write_str(buf, pos, "generic compilation failure", 27);
    }
    if code == -20 {
        return diag_write_str(buf, pos, "failed to open destination binary file", 38);
    }
    if code == -21 {
        return diag_write_str(buf, pos, "failed to write output binary file", 34);
    }
    if code == -30 {
        return diag_write_str(buf, pos, "constant symbol table capacity exceeded", 40);
    }
    if code == -31 {
        return diag_write_str(buf, pos, "variable symbol table capacity exceeded", 40);
    }
    if code == -32 {
        return diag_write_str(buf, pos, "function symbol table capacity exceeded", 40);
    }
    if code == -33 {
        return diag_write_str(buf, pos, "patch table capacity exceeded", 29);
    }
    if code == -34 {
        return diag_write_str(buf, pos, "epilogue patch table capacity exceeded", 38);
    }
    if code == -35 {
        return diag_write_str(buf, pos, "function argument count mismatch", 32);
    }
    if code == -36 {
        return diag_write_str(buf, pos, "too many function arguments", 27);
    }
    if code == -37 {
        return diag_write_str(buf, pos, "unknown type in type annotation or signature", 44);
    }
    if code == -40 {
        return diag_write_str(buf, pos, "assignment type mismatch", 24);
    }
    if code == -41 {
        return diag_write_str(buf, pos, "return type mismatch", 20);
    }
    if code == -42 {
        return diag_write_str(buf, pos, "argument type mismatch", 22);
    }
    if code == -43 {
        return diag_write_str(buf, pos, "invalid binary operation", 24);
    }
    if code == -44 {
        return diag_write_str(buf, pos, "invalid pointer operation", 25);
    }
    if code == -45 {
        return diag_write_str(buf, pos, "void expression used where a value is required", 46);
    }
    if code == -46 {
        return diag_write_str(buf, pos, "stack-escape rejected: local variable address cannot escape", 59);
    }
    if code == -47 {
        return diag_write_str(buf, pos, "invalid pointer dereference", 27);
    }
    if code == -48 {
        return diag_write_str(buf, pos, "invalid type cast", 17);
    }
    if code == -49 {
        return diag_write_str(buf, pos, "invalid main function signature", 31);
    }
    if code == -50 {
        return diag_write_str(buf, pos, "invalid array size or dimension", 31);
    }
    if code == -51 {
        return diag_write_str(buf, pos, "unknown struct field", 20);
    }
    if code == -52 {
        return diag_write_str(buf, pos, "break statement outside of loop", 31);
    }
    if code == -53 {
        return diag_write_str(buf, pos, "continue statement outside of loop", 34);
    }
    if code == -54 {
        return diag_write_str(buf, pos, "main function not found in executable", 37);
    }
    if code == -100 {
        return diag_write_str(buf, pos, "AST allocation failed - out of memory", 37);
    }
    if code == -101 {
        return diag_write_str(buf, pos, "invalid REX binary magic header", 31);
    }
    if code == -102 {
        return diag_write_str(buf, pos, "unsupported REX binary version", 30);
    }
    if code == -103 {
        return diag_write_str(buf, pos, "truncated REX binary or premature EOF", 37);
    }
    if code == -104 {
        return diag_write_str(buf, pos, "invalid REX section length", 26);
    }
    if code == -105 {
        return diag_write_str(buf, pos, "duplicate REX section encountered", 33);
    }
    if code == -106 {
        return diag_write_str(buf, pos, "invalid REX function index", 26);
    }
    if code == -107 {
        return diag_write_str(buf, pos, "invalid REX value or local register slot", 40);
    }
    if code == -108 {
        return diag_write_str(buf, pos, "invalid or unknown REX instruction opcode", 41);
    }
    if code == -109 {
        return diag_write_str(buf, pos, "invalid REX branch target offset", 32);
    }
    if code == -110 {
        return diag_write_str(buf, pos, "REX type mismatch or signature violation", 40);
    }
    if code == -111 {
        return diag_write_str(buf, pos, "missing main function export in REX module", 42);
    }
    if code == -112 {
        return diag_write_str(buf, pos, "function call arity mismatch in REX invocation", 46);
    }
    return diag_write_str(buf, pos, "unspecified compilation error", 29);
}

fn diag_write_category(buf: i64, pos: i64, cat: i64): i64 {
    if cat == 1 {
        return diag_write_str(buf, pos, "IO", 2);
    }
    if cat == 2 {
        return diag_write_str(buf, pos, "SYNTAX", 6);
    }
    if cat == 3 {
        return diag_write_str(buf, pos, "SEMANTIC", 8);
    }
    if cat == 4 {
        return diag_write_str(buf, pos, "REX", 3);
    }
    return diag_write_str(buf, pos, "INTERNAL", 8);
}

fn diag_get_line_col(src: i64, src_len: i64, target_offset: i64, out_buf: i64): i64 {
    let p = 0;
    let line = 1;
    let line_start = 0;
    let lim = target_offset;
    if lim > src_len { lim = src_len; }
    while p < lim {
        let b = get_byte(src, p);
        if b == 10 {
            line = line + 1;
            line_start = p + 1;
        }
        p = p + 1;
    }
    let col = target_offset - line_start + 1;
    if col < 1 { col = 1; }

    let end_p = line_start;
    while (end_p < src_len) & (get_byte(src, end_p) != 10) & (get_byte(src, end_p) != 13) {
        end_p = end_p + 1;
    }
    let line_len = end_p - line_start;

    set_qword(out_buf, 0, line);
    set_qword(out_buf, 1, col);
    set_qword(out_buf, 2, line_start);
    set_qword(out_buf, 3, line_len);
    return 0;
}

fn diag_report_error_loc(path: i64, code: i64, src: i64, src_len: i64, offset: i64): i64 {
    if code >= 0 { return 0; }
    let buf = sys_mmap_page();
    let cur = 0;

    cur = diag_write_str(buf, cur, "rubix: error[", 13);
    cur = diag_write_num(buf, cur, code);
    cur = diag_write_str(buf, cur, "] [", 3);

    let cat = diag_get_category(code);
    cur = diag_write_category(buf, cur, cat);
    cur = diag_write_str(buf, cur, "]: ", 3);

    cur = diag_write_message(buf, cur, code);

    if (src != 0) & (offset >= 0) & (offset < src_len) & (src_len > 0) {
        let info = buf + 2048;
        diag_get_line_col(src, src_len, offset, info);
        let line = get_qword(info, 0);
        let col = get_qword(info, 1);
        let lstart = get_qword(info, 2);
        let llen = get_qword(info, 3);

        if path != 0 {
            cur = diag_write_str(buf, cur, "\n  --> ", 7);
            let p_len = 0;
            while get_byte(path, p_len) != 0 {
                set_byte(buf, cur + p_len, get_byte(path, p_len));
                p_len = p_len + 1;
            }
            cur = cur + p_len;
            set_byte(buf, cur, 58); cur = cur + 1; # ':'
            cur = diag_write_num(buf, cur, line);
            set_byte(buf, cur, 58); cur = cur + 1; # ':'
            cur = diag_write_num(buf, cur, col);
        }

        # Source line snippet & caret
        cur = diag_write_str(buf, cur, "\n   |\n", 6);
        cur = diag_write_num(buf, cur, line);
        cur = diag_write_str(buf, cur, " | ", 3);

        let show_len = llen;
        if show_len > 120 { show_len = 120; }
        let si = 0;
        while si < show_len {
            set_byte(buf, cur + si, get_byte(src, lstart + si));
            si = si + 1;
        }
        cur = cur + show_len;

        # Underline with caret
        cur = diag_write_str(buf, cur, "\n   | ", 6);
        let max_sp = col;
        if max_sp > 120 { max_sp = 120; }
        let sp = 1;
        while sp < max_sp {
            set_byte(buf, cur, 32); # ' '
            cur = cur + 1;
            sp = sp + 1;
        }
        set_byte(buf, cur, 94); # '^'
        cur = cur + 1;
    } else {
        if path != 0 {
            cur = diag_write_str(buf, cur, "\n  file: ", 9);
            let p_len = 0;
            while get_byte(path, p_len) != 0 {
                set_byte(buf, cur + p_len, get_byte(path, p_len));
                p_len = p_len + 1;
            }
            cur = cur + p_len;
        }
    }

    set_byte(buf, cur, 10); # '\n'
    cur = cur + 1;

    sys_write(2, buf, cur);
    sys_munmap(buf, 4096);
    return 0;
}

fn diag_report_error(path: i64, code: i64): i64 {
    return diag_report_error_loc(path, code, 0, 0, -1);
}

fn diag_report_error_json(path: i64, code: i64, src: i64, src_len: i64, offset: i64): i64 {
    if code >= 0 { return 0; }
    let buf = sys_mmap_page();
    let cur = 0;

    set_byte(buf, cur, 123); cur = cur + 1; # '{'
    cur = diag_write_str(buf, cur, "\"diagnostics\":[", 15);
    set_byte(buf, cur, 123); cur = cur + 1; # '{'
    cur = diag_write_str(buf, cur, "\"severity\":\"error\",\"code\":", 26);
    cur = diag_write_num(buf, cur, code);
    cur = diag_write_str(buf, cur, ",\"category\":\"", 13);
    let cat = diag_get_category(code);
    cur = diag_write_category(buf, cur, cat);
    cur = diag_write_str(buf, cur, "\",\"message\":\"", 13);
    cur = diag_write_message(buf, cur, code);
    cur = diag_write_str(buf, cur, "\"", 1);

    if path != 0 {
        cur = diag_write_str(buf, cur, ",\"file\":\"", 9);
        let p_len = 0;
        while get_byte(path, p_len) != 0 {
            set_byte(buf, cur + p_len, get_byte(path, p_len));
            p_len = p_len + 1;
        }
        cur = cur + p_len;
        cur = diag_write_str(buf, cur, "\"", 1);
    }

    if (src != 0) & (offset >= 0) & (src_len > 0) {
        let info = buf + 2048;
        diag_get_line_col(src, src_len, offset, info);
        let line = get_qword(info, 0);
        let col = get_qword(info, 1);

        cur = diag_write_str(buf, cur, ",\"line\":", 8);
        cur = diag_write_num(buf, cur, line);
        cur = diag_write_str(buf, cur, ",\"column\":", 10);
        cur = diag_write_num(buf, cur, col);
        cur = diag_write_str(buf, cur, ",\"span\":", 8);
        set_byte(buf, cur, 123); cur = cur + 1; # '{'
        cur = diag_write_str(buf, cur, "\"offset\":", 9);
        cur = diag_write_num(buf, cur, offset);
        cur = diag_write_str(buf, cur, ",\"length\":1", 11);
        set_byte(buf, cur, 125); cur = cur + 1; # '}'
    }

    set_byte(buf, cur, 125); cur = cur + 1; # '}'
    cur = diag_write_str(buf, cur, "]}", 2);
    set_byte(buf, cur, 10); cur = cur + 1; # '\n'

    sys_write(2, buf, cur);
    sys_munmap(buf, 4096);
    return 0;
}

# ------------------------------------------------------------------------------
# Warning Analysis Pass on UIR
# Detects unreachable code (instructions immediately following UIR_RETURN)
# ------------------------------------------------------------------------------
fn warnings_analyze_uir(uir_buf: i64, path: i64): i64 {
    let total = get_qword(uir_buf, 0);
    let warnings_count = 0;
    let i = 0;

    while i < total {
        let addr = uir_buf + 256 + (i * 64);
        let op = get_qword(addr, 0);

        if op == 57 { # UIR_RETURN
            if i + 1 < total {
                let next_addr = uir_buf + 256 + ((i + 1) * 64);
                let next_op = get_qword(next_addr, 0);
                # If next is not a label (53) and not function_end (51)
                if (next_op != 53) & (next_op != 51) & (next_op != 0) {
                    warnings_count = warnings_count + 1;
                    let wbuf = sys_mmap_page();
                    let wcur = diag_write_str(wbuf, 0, "rubix: warning: unreachable statement after return\n", 51);
                    sys_write(2, wbuf, wcur);
                }
            }
        }
        i = i + 1;
    }
    return warnings_count;
}
