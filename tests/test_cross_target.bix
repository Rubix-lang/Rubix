# ==============================================================================
# Cross-Target Verification Suite for Rubix
# Tests recursive functions, loops, arithmetic, conditionals, and builtin print
# across all Tier 1 and Tier 2 targets (x86-64, REX, AArch64, RISC-V 64).
# ==============================================================================

fn fib(n: i64): i64 {
    if n <= 1 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn sum_to(n: i64): i64 {
    let s = 0;
    let i = 1;
    while i <= n {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn main(): i64 {
    let f = fib(10);
    let s = sum_to(100);
    print(f);
    print(s);
    if f != 55 { return 1; }
    if s != 5050 { return 2; }
    return 0;
}
