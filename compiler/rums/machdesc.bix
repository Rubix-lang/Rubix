    let divisor = s2;
    if (s2 == 0) | (s2 == 2) {
        p = mach_model_emit_mov_reg(model, code_buf, p, 11, s2);
        divisor = 11;
    }
    if s1 != 0 { p = mach_model_emit_mov_reg(model, code_buf, p, 0, s1); }
    p = mach_emit_byte(code_buf, p, 72); p = mach_emit_byte(code_buf, p, 153);
    p = mach_emit_byte(code_buf, p, x86_rex(1, 0, divisor));
    p = mach_emit_byte(code_buf, p, 247);
    p = mach_emit_byte(code_buf, p, 248 + (divisor & 7));
    if op == 13 {
        if dst != 0 { p = mach_model_emit_mov_reg(model, code_buf, p, dst, 0); }
    } else {
