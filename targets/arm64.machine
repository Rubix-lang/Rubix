# ==============================================================================
# Rubix Universal Machine Synthesis (RUMS) — Target Machine Description
# Target Architecture: ARM64 / AArch64
# Standard AAPCS64 (ARM 64-bit Architecture Procedure Call Standard)
# ==============================================================================

target arm64 {
    machine_format_version: 1;
    word_size: 8;
    endianness: little;
    stack_alignment: 16;
    stack_direction: down;
    instruction_width: 4; # Fixed 32-bit instructions
    pc_relative_calls: true;
}

registers {
    # id  name   role           callee_saved  class
    reg 0  x0    arg1_ret       false         general;
    reg 1  x1    arg2           false         general;
    reg 2  x2    arg3           false         general;
    reg 3  x3    arg4           false         general;
    reg 4  x4    arg5           false         general;
    reg 5  x5    arg6           false         general;
    reg 6  x6    arg7           false         general;
    reg 7  x7    arg8           false         general;
    reg 8  x8    indirect_ret   false         general;
    reg 9  x9    scratch        false         general;
    reg 10 x10   scratch        false         general;
    reg 11 x11   scratch        false         general;
    reg 12 x12   scratch        false         general;
    reg 13 x13   scratch        false         general;
    reg 14 x14   scratch        false         general;
    reg 15 x15   scratch        false         general;
    reg 16 x16   intra_call     false         special;
    reg 17 x17   intra_call     false         special;
    reg 18 x18   platform       false         special;
    reg 19 x19   preserved      true          general;
    reg 20 x20   preserved      true          general;
    reg 21 x21   preserved      true          general;
    reg 22 x22   preserved      true          general;
    reg 23 x23   preserved      true          general;
    reg 24 x24   preserved      true          general;
    reg 25 x25   preserved      true          general;
    reg 26 x26   preserved      true          general;
    reg 27 x27   preserved      true          general;
    reg 28 x28   preserved      true          general;
    reg 29 x29   frame_ptr      true          special; # FP
    reg 30 x30   link_reg       false         special; # LR
    reg 31 sp    stack_ptr      true          special; # SP
}

calling_convention aapcs64 {
    args: [x0, x1, x2, x3, x4, x5, x6, x7];
    return_reg: x0;
    scratch_pool: [x0, x1, x2, x3, x4, x5, x6, x7, x9, x10, x11, x12, x13, x14, x15];
    preserved_pool: [x19, x20, x21, x22, x23, x24, x25, x26, x27, x28];
    link_register: x30;
    frame_pointer: x29;
}

patterns {
    pattern MOV_REG_REG(dst, src) {
        cost: 1;
        latency: 1;
        encoding_u32: 0xAA0003E0 | (REG_ID(src) << 16) | REG_ID(dst);
    }

    pattern ADD_REG_REG(dst, src1, src2) {
        cost: 1;
        latency: 1;
        encoding_u32: 0x8B000000 | (REG_ID(src2) << 16) | (REG_ID(src1) << 5) | REG_ID(dst);
    }

    pattern SUB_REG_REG(dst, src1, src2) {
        cost: 1;
        latency: 1;
        encoding_u32: 0xCB000000 | (REG_ID(src2) << 16) | (REG_ID(src1) << 5) | REG_ID(dst);
    }

    pattern MUL_REG_REG(dst, src1, src2) {
        cost: 1;
        latency: 1;
        encoding_u32: 0x9B007C00 | (REG_ID(src2) << 16) | (REG_ID(src1) << 5) | REG_ID(dst);
    }

    pattern AND_REG_REG(dst, src1, src2) {
        cost: 1;
        latency: 1;
        encoding_u32: 0x8A000000 | (REG_ID(src2) << 16) | (REG_ID(src1) << 5) | REG_ID(dst);
    }

    pattern ORR_REG_REG(dst, src1, src2) {
        cost: 1;
        latency: 1;
        encoding_u32: 0xAA000000 | (REG_ID(src2) << 16) | (REG_ID(src1) << 5) | REG_ID(dst);
    }

    pattern EOR_REG_REG(dst, src1, src2) {
        cost: 1;
        latency: 1;
        encoding_u32: 0xCA000000 | (REG_ID(src2) << 16) | (REG_ID(src1) << 5) | REG_ID(dst);
    }

    # Shifts & Division
    pattern LSL_REG_IMM(dst, src, imm) {
        cost: 1;
        latency: 1;
        encoding_u32: 0xD3400000 | ((64 - (imm & 63)) << 16) | ((63 - (imm & 63)) << 10) | (REG_ID(src) << 5) | REG_ID(dst);
    }

    pattern LSR_REG_IMM(dst, src, imm) {
        cost: 1;
        latency: 1;
        encoding_u32: 0xD3400000 | ((imm & 63) << 16) | (0x3F << 10) | (REG_ID(src) << 5) | REG_ID(dst);
    }

    pattern SDIV_REG_REG(dst, src1, src2) {
        cost: 3;
        latency: 4;
        encoding_u32: 0x9AC00C00 | (REG_ID(src2) << 16) | (REG_ID(src1) << 5) | REG_ID(dst);
    }

    pattern MSUB_REG_REG_REG(dst, src1, src2, src3) {
        cost: 1;
        latency: 1;
        encoding_u32: 0x9B008000 | (REG_ID(src2) << 16) | (REG_ID(src3) << 10) | (REG_ID(src1) << 5) | REG_ID(dst);
    }

    # Memory Access
    pattern LDR_REG_MEM(dst, base, disp) {
        cost: 2;
        latency: 3;
        encoding_u32: 0xF9400000 | (((disp / 8) & 0xFFF) << 10) | (REG_ID(base) << 5) | REG_ID(dst);
    }

    pattern STR_MEM_REG(src, base, disp) {
        cost: 2;
        latency: 2;
        encoding_u32: 0xF9000000 | (((disp / 8) & 0xFFF) << 10) | (REG_ID(base) << 5) | REG_ID(src);
    }

    pattern RET() {
        cost: 1;
        latency: 1;
        encoding_u32: 0xD65F03C0; # ret lr (x30)
    }

    # Vector / SIMD AI Acceleration Patterns (ARM64 NEON)
    pattern VEC_FMA(dst, src1, src2) {
        cost: 2;
        latency: 4;
        encoding_u32: 0x4E20CC00; # fmla v0.4s, v1.4s, v2.4s
    }

    pattern VEC_DOT(dst, src1, src2) {
        cost: 2;
        latency: 3;
        encoding_u32: 0x4E809400; # sdot v0.4s, v1.16b, v2.16b
    }
}
