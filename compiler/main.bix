fn mach_model_emit_startup(model: i64, code_buf: i64, cur: i64): i64 {
    let tid = get_qword(model, 1);
    if tid == 2 {
        let p = mach_emit_u32(code_buf, cur, 2483027968);     # BL main
        p = mach_emit_u32(code_buf, p, 3531606952);           # MOVZ x8, 93
        p = mach_emit_u32(code_buf, p, 3556769793);           # SVC #0
        p = mach_emit_u32(code_buf, p, 3573751839);           # NOP
        return p;
    }
    if tid == 3 {
        let p = mach_emit_u32(code_buf, cur, 239);            # JAL ra, main
        p = mach_emit_u32(code_buf, p, 97519763);             # ADDI a7, zero, 93
        p = mach_emit_u32(code_buf, p, 115);                  # ECALL
        p = mach_emit_u32(code_buf, p, 19);                   # NOP
        return p;
    }
    if tid == 99 {
        let p = mach_emit_u32(code_buf, cur, 134217728);      # CALL main
        p = mach_emit_u32(code_buf, p, 251658240);            # RET
        p = mach_emit_u32(code_buf, p, 0);
        p = mach_emit_u32(code_buf, p, 0);
        return p;
    }
    # x86-64 Dual-Entry Startup:
    # Offset 0..4: In-memory execution entry jump: jmp main (E9 rel32)
    let p = mach_emit_byte(code_buf, cur, 233);
    p = mach_emit_disp32(code_buf, p, 0);
    # Offset 5..31: Standalone ELF process startup (_start):
    p = mach_emit_byte(code_buf, p, 72); p = mach_emit_byte(code_buf, p, 49); p = mach_emit_byte(code_buf, p, 237); # xor rbp, rbp
    p = mach_emit_byte(code_buf, p, 72); p = mach_emit_byte(code_buf, p, 139); p = mach_emit_byte(code_buf, p, 60); p = mach_emit_byte(code_buf, p, 36); # mov rdi, [rsp]
    p = mach_emit_byte(code_buf, p, 72); p = mach_emit_byte(code_buf, p, 141); p = mach_emit_byte(code_buf, p, 116); p = mach_emit_byte(code_buf, p, 36); p = mach_emit_byte(code_buf, p, 8); # lea rsi, [rsp+8]
    p = mach_emit_byte(code_buf, p, 232); # call main
    p = mach_emit_disp32(code_buf, p, 0);
    p = mach_emit_byte(code_buf, p, 72); p = mach_emit_byte(code_buf, p, 137); p = mach_emit_byte(code_buf, p, 199); # mov rdi, rax
    p = mach_emit_byte(code_buf, p, 184); p = mach_emit_disp32(code_buf, p, 60); # mov eax, 60 (sys_exit)
    p = mach_emit_byte(code_buf, p, 15); p = mach_emit_byte(code_buf, p, 5); # syscall
    return p;
}

fn mach_model_backpatch(model: i64, code_buf: i64, patch_pos: i64, target_pos: i64): i64 {
