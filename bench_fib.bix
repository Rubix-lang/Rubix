# Benchmark: Recursive Fibonacci fib(30)
# Measures function call overhead, stack frame management, and recursion performance.

fn fib(n: i64): i64 {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main(): i64 {
    let res = fib(30);
    print res;
    return 0;
}
