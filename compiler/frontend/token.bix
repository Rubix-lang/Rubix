let TOKEN_TYPE_STR = 46;
let TOKEN_KW_STRUCT = 47;
let TOKEN_DOT = 48;
let TOKEN_BANG = 49;
let TOKEN_KW_BREAK = 50;
let TOKEN_KW_CONTINUE = 51;
let TOKEN_TILDE = 52;
let TOKEN_PIPE_GREATER = 53;
let TOKEN_QUESTION = 54;
let TOKEN_KW_FOR = 55;
let TOKEN_DOT_DOT = 57;
let TOKEN_QUESTION_COLON = 58;
let TOKEN_KW_MATCH = 59;
let TOKEN_FAT_ARROW = 60;
let TOKEN_UNDERSCORE = 61;
