            l = emit_byte(buf, l, 182);
            l = emit_byte(buf, l, 192);
            return l;
        }
        if src_t == TYPE_BOOL {
            # movzx eax, al (0F B6 C0)
            l = emit_byte(buf, l, 15);
            l = emit_byte(buf, l, 182);
            l = emit_byte(buf, l, 192);
            return l;
        }
        if src_t == TYPE_INT_LIT {
            return l;
        }
    }

    if (dst_t == TYPE_I32) | (dst_t == TYPE_CHAR) {
        if (src_t == TYPE_F64) | (src_t == TYPE_FLOAT_LIT) {
            # movq xmm0, rax
            l = emit_byte(buf, l, 102); l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 110); l = emit_byte(buf, l, 192);
            # cvttsd2si eax, xmm0 (F2 0F 2C C0)
            l = emit_byte(buf, l, 242); l = emit_byte(buf, l, 15); l = emit_byte(buf, l, 44); l = emit_byte(buf, l, 192);
