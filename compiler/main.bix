                        l = emit_add_rax_imm32(code_buf, l, f_off);
                        set_qword(s, 4, l);
                        parser_push_rax(s);
                        advance_token(s); # skip '['
                        let idx_t = parse_expr(s);
                        if get_qword(s, 7) < 0 { return 0; }
                        expect(s, TOKEN_RBRACKET);
                        l = get_qword(s, 4);
                        l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198);
                        l = emit_bounds_check(code_buf, l, f_arr_len);
                        l = emit_byte(code_buf, l, 95); # pop rdi
                        let cur_d = get_qword(s, 12); set_qword(s, 12, cur_d - 1);
                        let elem_sz = type_size(f_pointee2);
                        if f_pointee2 >= TYPE_STRUCT {
                            elem_sz = struct_tbl_get_meta(tbl, f_pointee2 - TYPE_STRUCT, 1);
                        }
                        l = emit_index_lea_sized(code_buf, l, elem_sz);
                        set_qword(s, 4, l);
                        if cur_tok_kind(s) == TOKEN_DOT {
                            if f_pointee2 >= TYPE_STRUCT {
                                curr_struct_id = f_pointee2 - TYPE_STRUCT;
                            } else {
                                set_qword(s, 7, -51);
                                return 0;
                            }
                        } else {
                            parser_push_rax(s);
                            expect(s, TOKEN_EQUAL);
                            let val_t = parse_expr(s);
                            if get_qword(s, 7) < 0 { return 0; }
                            if type_is_compatible(f_pointee2, val_t) == 0 {
                                set_qword(s, 7, -40);
                                return 0;
                            }
                            parser_pop_reg(s, 89);
                            l = get_qword(s, 4);
                            if f_pointee2 >= TYPE_STRUCT {
                                l = emit_copy_bytes_to_rcx(code_buf, l, elem_sz);
                            } else {
                                l = emit_field_store_typed(code_buf, l, 0, f_pointee2);
                            }
                            set_qword(s, 4, l);
                            expect(s, TOKEN_SEMICOLON);
                            return 0;
                        }
                    } else {
                        l = get_qword(s, 4);
                        l = emit_add_rax_imm32(code_buf, l, f_off);
                        set_qword(s, 4, l);
                        parser_push_rax(s);

                        expect(s, TOKEN_EQUAL);
                        let val_t = parse_expr(s);
                        if get_qword(s, 7) < 0 { return 0; }

                        if f_type >= TYPE_STRUCT {
                            if val_t != f_type {
                                set_qword(s, 7, -40);
                                return 0;
                            }
                            parser_pop_reg(s, 89);
                            l = get_qword(s, 4);
                            l = emit_copy_bytes_to_rcx(code_buf, l, f_sz);
                            set_qword(s, 4, l);
                            expect(s, TOKEN_SEMICOLON);
                            return 0;
                        }

                        if type_is_compatible(f_type, val_t) == 0 {
                            set_qword(s, 7, -40);
                            return 0;
                        }
                        parser_pop_reg(s, 89);
                        l = get_qword(s, 4);
                        l = emit_field_store_typed(code_buf, l, 0, f_type);
