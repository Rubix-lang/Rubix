    }

    return l;
}

fn emit_cmp_rax_zero(buf: i64, len: i64): i64 {
    let l = len;
    # test rax, rax (48 85 C0) - sets ZF=1 if rax == 0, identical to cmp rax, 0 for following je
    l = emit_byte(buf, l, 72);
    l = emit_byte(buf, l, 133);
    l = emit_byte(buf, l, 192);
    return l;
}

fn emit_backpatch32(buf: i64, patch_pos: i64, target_pos: i64): i64 {
    let disp = target_pos - (patch_pos + 4);
    let n = disp;
    if n < 0 { n = n + 4294967296; }
    set_byte(buf, patch_pos, n % 256);
    set_byte(buf, patch_pos + 1, (n / 256) % 256);
    set_byte(buf, patch_pos + 2, (n / 65536) % 256);
    set_byte(buf, patch_pos + 3, (n / 16777216) % 256);
    return 0;
}
