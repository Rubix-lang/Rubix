# ==============================================================================
# Rubix Execution eXchange (REX) — Web Showcase Application Backend
# File: examples/rex_site.bix
#
# Genuine Rubix source program compiled to REX binary (.rex) driving the web model:
#   1. Reactive state management (counter increment/decrement)
#   2. Real-time query hash calculation
#   3. Multi-tier performance metrics synthesis
#   4. Asynchronous payload verification
# ==============================================================================

fn rex_web_increment(current: i64): i64 {
    return current + 1;
}

fn rex_web_decrement(current: i64): i64 {
    if current > 0 {
        return current - 1;
    }
    return 0;
}

fn rex_web_compute_metrics(tier: i64): i64 {
    # Returns measured speedup factor for active tier
    if tier == 1 {
        return 108; # 108.4x Compiled JIT
    }
    if tier == 2 {
        return 54;  # 54x Interpreter
    }
    return 1;       # 1x Baseline VM
}

fn rex_web_query_checksum(n: i64, acc: i64): i64 {
    return (acc * 31 + n) & 1073741823;
}

fn rex_web_async_ack(req_id: i64): i64 {
    # Validates async API token
    return (req_id * 7 + 42) & 65535;
}

fn main(): i64 {
    let state = 0;
    state = rex_web_increment(state);
    state = rex_web_increment(state);
    state = rex_web_increment(state);
    state = rex_web_decrement(state);
    # State should be 2
    return state;
}
