            return 0;
        }

        if cur_tok_kind(s) == TOKEN_LBRACKET {
            let slot = var_tbl_get(tbl, hash, 1);
            if slot == 0 {
                set_qword(s, 7, -2); # undefined identifier
                return 0;
            }
            let slot_idx = (slot / 8) % 128;
            let fn_idx = get_qword(s, 16);
            set_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + slot_idx, 1);
            let var_t = var_tbl_get(tbl, hash, 2);
            if var_t == TYPE_ARRAY {
                let elem_t = var_tbl_get(tbl, hash, 3);
                let p_prov = var_tbl_get(tbl, hash, 4);
                let arr_len = var_tbl_get(tbl, hash, 5);
                let l = get_qword(s, 4);
                if p_prov == PROV_STACK_LOCAL {
                    l = emit_lea_slot(code_buf, l, slot);
                } else {
                    l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
                }
                set_qword(s, 4, l);
                parser_push_rax(s);

                advance_token(s); # skip '['
                let idx_t = parse_expr(s);
                if get_qword(s, 7) < 0 { return 0; }
                if type_is_integer(idx_t) == 0 {
                    set_qword(s, 7, -43); # ERR_INVALID_BIN_OP_TYPE
                    return 0;
                }
                expect(s, TOKEN_RBRACKET);
                if get_qword(s, 7) < 0 { return 0; }
                l = get_qword(s, 4);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
                l = emit_bounds_check(code_buf, l, arr_len);
                set_qword(s, 4, l);
                if cur_tok_kind(s) == TOKEN_DOT {
                    l = emit_byte(code_buf, l, 95); # pop rdi
                    let cur_depth = get_qword(s, 12);
                    set_qword(s, 12, cur_depth - 1);
                    let elem_sz = type_size(elem_t);
                    if elem_t >= TYPE_STRUCT {
                        elem_sz = struct_tbl_get_meta(tbl, elem_t - TYPE_STRUCT, 1);
                    }
                    l = emit_index_lea_sized(code_buf, l, elem_sz);
                    set_qword(s, 4, l);

                    let curr_struct_id = elem_t - TYPE_STRUCT;
                    advance_token(s); # skip '.'
                    let f_hash = hash_token(src, cur_tok_offset(s), cur_tok_len(s));
                    advance_token(s); # skip field name
                    let f_idx = struct_tbl_find_field(tbl, curr_struct_id, f_hash);
                    if f_idx < 0 {
                        set_qword(s, 7, -51);
                        return 0;
                    }
                    let f_type = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 1);
                    let f_off = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 3);
                    let f_sz = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 4);
                    l = get_qword(s, 4);
                    l = emit_add_rax_imm32(code_buf, l, f_off);
                    set_qword(s, 4, l);
                    parser_push_rax(s);

                    expect(s, TOKEN_EQUAL);
                    let val_t = parse_expr(s);
                    if get_qword(s, 7) < 0 { return 0; }
                    if type_is_compatible(f_type, val_t) == 0 {
                        set_qword(s, 7, -40);
                        return 0;
                    }
                    parser_pop_reg(s, 89); # pop rcx
                    l = get_qword(s, 4);
                    if f_type >= TYPE_STRUCT {
                        l = emit_copy_bytes_to_rcx(code_buf, l, f_sz);
                    } else {
                        l = emit_field_store_typed(code_buf, l, 0, f_type);
                    }
                    set_qword(s, 4, l);
                    expect(s, TOKEN_SEMICOLON);
                    return 0;
                }

                if elem_t >= TYPE_STRUCT {
                    l = emit_byte(code_buf, l, 95); # pop rdi
                    let cur_depth = get_qword(s, 12);
                    set_qword(s, 12, cur_depth - 1);
                    let elem_sz = struct_tbl_get_meta(tbl, elem_t - TYPE_STRUCT, 1);
                    l = emit_index_lea_sized(code_buf, l, elem_sz);
                    set_qword(s, 4, l);

                    expect(s, TOKEN_EQUAL);
                    if get_qword(s, 7) < 0 { return 0; }
                    parser_push_rax(s);
                    let val_t = parse_expr(s);
                    if get_qword(s, 7) < 0 { return 0; }
                    if type_is_compatible(elem_t, val_t) == 0 {
                        set_qword(s, 7, -40);
                        return 0;
                    }
                    parser_pop_reg(s, 89);
                    l = get_qword(s, 4);
                    l = emit_copy_bytes_to_rcx(code_buf, l, elem_sz);
                    set_qword(s, 4, l);
                    expect(s, TOKEN_SEMICOLON);
                    return 0;
                }

                parser_push_rax(s); # push rsi (index)

                expect(s, TOKEN_EQUAL);
                if get_qword(s, 7) < 0 { return 0; }
                let val_t = parse_expr(s);
                if get_qword(s, 7) < 0 { return 0; }

                if type_is_compatible(elem_t, val_t) == 0 {
                    set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                    return 0;
                }

                l = get_qword(s, 4);
                l = emit_byte(code_buf, l, 94); # pop rsi
                l = emit_byte(code_buf, l, 95); # pop rdi
                let cur_depth = get_qword(s, 12);
                set_qword(s, 12, cur_depth - 2);

                l = emit_index_store_typed(code_buf, l, elem_t);
                set_qword(s, 4, l);

                expect(s, TOKEN_SEMICOLON);
                return 0;
            }
            if var_t != TYPE_PTR {
                set_qword(s, 7, -47); # ERR_INVALID_PTR_DEREF
                return 0;
            }
            let p_pointee = var_tbl_get(tbl, hash, 3);
            if p_pointee == TYPE_VOID {
                set_qword(s, 7, -45); # ERR_VOID_EXPR_USED
                return 0;
            }
            if p_pointee == TYPE_NONE {
                if get_qword(s, 17) == 1 {
                    set_qword(s, 7, -47); # ERR_INVALID_PTR_DEREF
                    return 0;
                }
                p_pointee = TYPE_I64;
            }
            let l = get_qword(s, 4);
            l = emit_load_slot_typed(code_buf, l, slot, TYPE_PTR);
            set_qword(s, 4, l);
            parser_push_rax(s);

            advance_token(s); # skip '['
            let idx_t = parse_expr(s);
            if get_qword(s, 7) < 0 { return 0; }
            if type_is_integer(idx_t) == 0 {
                set_qword(s, 7, -43); # ERR_INVALID_BIN_OP_TYPE
                return 0;
            }
            expect(s, TOKEN_RBRACKET);
            if get_qword(s, 7) < 0 { return 0; }

            l = get_qword(s, 4);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
            set_qword(s, 4, l);

            if cur_tok_kind(s) == TOKEN_DOT {
                l = emit_byte(code_buf, l, 95); # pop rdi
                let cur_depth = get_qword(s, 12);
                set_qword(s, 12, cur_depth - 1);
                let elem_sz = type_size(p_pointee);
                if p_pointee >= TYPE_STRUCT {
                    elem_sz = struct_tbl_get_meta(tbl, p_pointee - TYPE_STRUCT, 1);
                }
                l = emit_index_lea_sized(code_buf, l, elem_sz);
                set_qword(s, 4, l);

                let curr_struct_id = p_pointee - TYPE_STRUCT;
                advance_token(s); # skip '.'
                let f_hash = hash_token(src, cur_tok_offset(s), cur_tok_len(s));
                advance_token(s); # skip field name
                let f_idx = struct_tbl_find_field(tbl, curr_struct_id, f_hash);
                if f_idx < 0 {
                    set_qword(s, 7, -51);
                    return 0;
                }
                let f_type = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 1);
                let f_off = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 3);
                let f_sz = struct_tbl_get_field_info(tbl, curr_struct_id, f_idx, 4);
                l = get_qword(s, 4);
                l = emit_add_rax_imm32(code_buf, l, f_off);
                set_qword(s, 4, l);
                parser_push_rax(s);

                expect(s, TOKEN_EQUAL);
                let val_t = parse_expr(s);
                if get_qword(s, 7) < 0 { return 0; }
                if type_is_compatible(f_type, val_t) == 0 {
                    set_qword(s, 7, -40);
                    return 0;
                }
                parser_pop_reg(s, 89); # pop rcx
                l = get_qword(s, 4);
                if f_type >= TYPE_STRUCT {
                    l = emit_copy_bytes_to_rcx(code_buf, l, f_sz);
                } else {
                    l = emit_field_store_typed(code_buf, l, 0, f_type);
                }
                set_qword(s, 4, l);
                expect(s, TOKEN_SEMICOLON);
                return 0;
            }

            if p_pointee >= TYPE_STRUCT {
                l = emit_byte(code_buf, l, 95); # pop rdi
                let cur_depth = get_qword(s, 12);
                set_qword(s, 12, cur_depth - 1);
                let elem_sz = struct_tbl_get_meta(tbl, p_pointee - TYPE_STRUCT, 1);
                l = emit_index_lea_sized(code_buf, l, elem_sz);
                set_qword(s, 4, l);

                expect(s, TOKEN_EQUAL);
                if get_qword(s, 7) < 0 { return 0; }
                parser_push_rax(s);
                let val_t = parse_expr(s);
                if get_qword(s, 7) < 0 { return 0; }
                if type_is_compatible(p_pointee, val_t) == 0 {
                    set_qword(s, 7, -40);
                    return 0;
                }
                parser_pop_reg(s, 89);
                l = get_qword(s, 4);
                l = emit_copy_bytes_to_rcx(code_buf, l, elem_sz);
                set_qword(s, 4, l);
                expect(s, TOKEN_SEMICOLON);
                return 0;
            }

            parser_push_rax(s); # push rsi (index)

            expect(s, TOKEN_EQUAL);
            if get_qword(s, 7) < 0 { return 0; }
            let val_t = parse_expr(s);
            if get_qword(s, 7) < 0 { return 0; }

            if p_pointee != TYPE_NONE {
                if type_is_compatible(p_pointee, val_t) == 0 {
                    set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                    return 0;
                }
            }

            l = get_qword(s, 4);
            l = emit_byte(code_buf, l, 94); # pop rsi
            l = emit_byte(code_buf, l, 95); # pop rdi
            let cur_depth = get_qword(s, 12);
            set_qword(s, 12, cur_depth - 2);

            l = emit_index_store_typed(code_buf, l, p_pointee);
            set_qword(s, 4, l);

            expect(s, TOKEN_SEMICOLON);
            return 0;
        }

        if cur_tok_kind(s) == TOKEN_EQUAL {
            advance_token(s); # skip '='
            let slot = var_tbl_get(tbl, hash, 1);
            let slot_idx = (slot / 8) % 128;
            set_qword(tbl, 110000 + (slot_idx * 2), 0);
            let var_t = var_tbl_get(tbl, hash, 2);
            if var_t == TYPE_ARRAY {
                let expr_t = parse_expr(s);
                if get_qword(s, 7) < 0 { return 0; }
                if expr_t != TYPE_ARRAY {
                    set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                    return 0;
                }
                let dst_elem_t = var_tbl_get(tbl, hash, 3);
                let dst_len = var_tbl_get(tbl, hash, 5);
                let src_elem_t = get_qword(s, 14);
                let src_len = get_qword(s, 19);
                if dst_elem_t != src_elem_t {
                    set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                    return 0;
                }
                if dst_len != src_len {
                    set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                    return 0;
                }
                let elem_sz = type_size(dst_elem_t);
                let total_bytes = elem_sz * dst_len;
                let l = get_qword(s, 4);
                l = emit_copy_bytes(code_buf, l, slot, total_bytes);
                set_qword(s, 4, l);
                expect(s, TOKEN_SEMICOLON);
                return 0;
            }
            if var_t >= TYPE_STRUCT {
                let expr_t = parse_expr(s);
                if get_qword(s, 7) < 0 { return 0; }
                if expr_t != var_t {
                    set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                    return 0;
                }
                let st_id = var_t - TYPE_STRUCT;
                let total_bytes = struct_tbl_get_meta(tbl, st_id, 1);
                let l = get_qword(s, 4);
                l = emit_copy_bytes(code_buf, l, slot, total_bytes);
                set_qword(s, 4, l);
                expect(s, TOKEN_SEMICOLON);
                return 0;
            }
            let assign_mark_l = get_qword(s, 4);
            set_qword(s, 27, 0);
            let expr_t = parse_expr(s);
            if get_qword(s, 7) < 0 {
                return 0;
            }
            if type_is_compatible(var_t, expr_t) == 0 {
                set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                return 0;
            }
            if var_t == TYPE_PTR {
                let p_pointee = get_qword(s, 14);
                let cur_pointee = var_tbl_get(tbl, hash, 3);
                if p_pointee == TYPE_NONE {
                    p_pointee = cur_pointee;
                }
                let p_prov = get_qword(s, 15);
                var_tbl_set_metadata(tbl, hash, p_pointee, p_prov, 0);
            }

            let is_dead_assign = 0;
            let fn_idx = get_qword(s, 16);
            let round = get_qword(s, 28);
            if get_qword(s, 22) == 1 {
                if round > 0 {
                    let is_used = get_byte(tbl, 400000 + (fn_idx * 128) + slot_idx);
                    if is_used == 0 {
                        if get_qword(s, 27) == 0 {
                            is_dead_assign = 1;
                        }
                    }
                }
            }

            if is_dead_assign == 1 {
                set_qword(s, 4, assign_mark_l);
                let r_cnt = get_qword(tbl, 10380);
                let ri = 0;
                while ri < r_cnt {
                    let r_slot = get_qword(tbl, 10381 + ri);
                    let cur_c = get_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + r_slot);
                    if cur_c > 0 {
                        if cur_c < 250 {
                            set_byte(tbl, TBL_VAR_USAGE_NEXT_OFFSET + (fn_idx * 128) + r_slot, cur_c - 1);
                        }
                    }
                    ri = ri + 1;
                }
            } else {
                let l = get_qword(s, 4);
                if var_t != expr_t {
                    l = emit_cast(code_buf, l, expr_t, var_t);
                }
                l = emit_store_slot_typed(code_buf, l, slot, var_t);
                set_qword(s, 4, l);
            }
            expect(s, TOKEN_SEMICOLON);
            return 0;
        }

        # Statement-level Function Call
        let fn_ret_t = func_tbl_get(tbl, hash, 3);
        if (cur_tok_kind(s) == TOKEN_LPAREN) & (fn_ret_t == TYPE_VOID) {
            advance_token(s); # skip '('
            let arg_count = 0;
            if cur_tok_kind(s) != TOKEN_RPAREN {
                let a_t = parse_expr(s);
                if get_qword(s, 7) < 0 { return 0; }
                set_qword(tbl, 10240 + arg_count, a_t);
                set_qword(tbl, 10272 + arg_count, get_qword(s, 14));
                set_qword(tbl, 10304 + arg_count, get_qword(s, 15));
                set_qword(tbl, 10336 + arg_count, get_qword(s, 19));
                parser_push_rax(s);
                arg_count = 1;
                while cur_tok_kind(s) == TOKEN_COMMA {
                    advance_token(s);
                    let a_t2 = parse_expr(s);
                    if get_qword(s, 7) < 0 { return 0; }
                    set_qword(tbl, 10240 + arg_count, a_t2);
                    set_qword(tbl, 10272 + arg_count, get_qword(s, 14));
                    set_qword(tbl, 10304 + arg_count, get_qword(s, 15));
                    set_qword(tbl, 10336 + arg_count, get_qword(s, 19));
                    parser_push_rax(s);
                    arg_count = arg_count + 1;
                }
            }
            expect(s, TOKEN_RPAREN);
            if get_qword(s, 7) < 0 { return 0; }
            emit_call_or_builtin(s, offset, slen, hash, arg_count);
            if get_qword(s, 7) < 0 { return 0; }
            expect(s, TOKEN_SEMICOLON);
            return 0;
        }

        set_qword(s, 2, saved_pos);
        token_set(tok_buf, saved_kind, saved_val, saved_off, saved_len);
    }

    # 6. *ptr = expr; (Pointer store)
    if k == TOKEN_STAR {
        advance_token(s); # skip '*'
        let p_t = parse_postfix(s);
        if get_qword(s, 7) < 0 { return 0; }
        if p_t != TYPE_PTR {
            set_qword(s, 7, -47); # ERR_INVALID_PTR_DEREF
            return 0;
        }
        let pointee_t = get_qword(s, 14);
        if pointee_t == TYPE_VOID {
            set_qword(s, 7, -45); # ERR_VOID_EXPR_USED
            return 0;
        }
        if pointee_t == TYPE_NONE {
            if get_qword(s, 17) == 1 {
                set_qword(s, 7, -47); # ERR_INVALID_PTR_DEREF
                return 0;
            }
        }
        parser_push_rax(s);
        expect(s, TOKEN_EQUAL);
        if get_qword(s, 7) < 0 { return 0; }
        let val_t = parse_expr(s);
        if get_qword(s, 7) < 0 { return 0; }

        if pointee_t != TYPE_NONE {
            if type_is_compatible(pointee_t, val_t) == 0 {
                set_qword(s, 7, -40); # ERR_TYPE_MISMATCH_ASSIGN
                return 0;
            }
        }

        parser_pop_reg(s, 89);
        let l = get_qword(s, 4);
        l = emit_deref_store_typed(code_buf, l, pointee_t);
        set_qword(s, 4, l);
        expect(s, TOKEN_SEMICOLON);
        return 0;
    }

    # Fallback: expr;
    parse_expr(s);
    expect(s, TOKEN_SEMICOLON);
    return 0;
}

fn parse_fn(s: i64): i64 {
    let src = get_qword(s, 0);
    let code_buf = get_qword(s, 3);
    let tbl = get_qword(s, 5);

    advance_token(s); # skip 'fn'
    let fn_offset = cur_tok_offset(s);
    let fn_len = cur_tok_len(s);
    let fn_hash = hash_token(src, fn_offset, fn_len);
    expect(s, TOKEN_IDENT);
    expect(s, TOKEN_LPAREN);

    set_qword(tbl, TBL_VAR_COUNT_QWORD_IDX, 0); # var_count
    set_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX, 0); # epilogue_count
    let vi = 0;
    while vi < 128 {
        set_qword(tbl, 110000 + (vi * 2), 0);
        vi = vi + 1;
    }
    set_qword(s, 12, 0); # reset stack depth for function body
    set_qword(s, 21, 0); # reset loop depth for function body
    set_qword(s, 460, 0); # reset defer count for function body
    set_qword(s, 461, 0); # reset defer mask slot for function body

    let param_count = 0;
    if cur_tok_kind(s) != TOKEN_RPAREN {
        let p_offset = cur_tok_offset(s);
        let p_len = cur_tok_len(s);
        let p_hash = hash_token(src, p_offset, p_len);
        expect(s, TOKEN_IDENT);
        let p_type = TYPE_I64;
        let p_ann_pointee = TYPE_NONE;
        let p_arr_len = 0;
        if cur_tok_kind(s) == TOKEN_COLON {
            advance_token(s);
            p_type = parse_type(s);
            if (p_type == TYPE_PTR) | (p_type == TYPE_TUPLE) {
                p_ann_pointee = get_qword(s, 14);
            }
            if p_type == TYPE_ARRAY {
                p_ann_pointee = get_qword(s, 14);
                p_arr_len = get_qword(s, 19);
            }
        }
        param_count = 1;
        let p_pointee = func_tbl_get_param_info(tbl, fn_hash, 0, 1);
        if p_ann_pointee != TYPE_NONE {
            p_pointee = p_ann_pointee;
        }
        if p_type == TYPE_STR {
            p_pointee = TYPE_U8;
        }
        if p_type == TYPE_ARRAY {
            if p_arr_len == 0 {
                p_arr_len = func_tbl_get_param_info(tbl, fn_hash, 0, 2);
            }
        }
        if p_type == TYPE_TUPLE {
            p_pointee = get_qword(s, 14);
            let p_t1 = get_qword(s, 18);
            let p_arity = get_qword(s, 19);
            if p_arity == 0 { p_arity = 2; }
            var_tbl_add(tbl, p_hash, 8, p_type, p_pointee, p_t1, 0 - p_arity);
        } else {
            var_tbl_add(tbl, p_hash, 8, p_type, p_pointee, PROV_UNKNOWN, p_arr_len);
        }

        while cur_tok_kind(s) == TOKEN_COMMA {
            advance_token(s);
            let p_offset2 = cur_tok_offset(s);
            let p_len2 = cur_tok_len(s);
            let p_hash2 = hash_token(src, p_offset2, p_len2);
            expect(s, TOKEN_IDENT);
            let p_type2 = TYPE_I64;
            let p_ann_pointee2 = TYPE_NONE;
            let p_arr_len2 = 0;
            if cur_tok_kind(s) == TOKEN_COLON {
                advance_token(s);
                p_type2 = parse_type(s);
                if (p_type2 == TYPE_PTR) | (p_type2 == TYPE_TUPLE) {
                    p_ann_pointee2 = get_qword(s, 14);
                }
                if p_type2 == TYPE_ARRAY {
                    p_ann_pointee2 = get_qword(s, 14);
                    p_arr_len2 = get_qword(s, 19);
                }
            }
            let p_pointee2 = func_tbl_get_param_info(tbl, fn_hash, param_count, 1);
            if p_ann_pointee2 != TYPE_NONE {
                p_pointee2 = p_ann_pointee2;
            }
            if p_type2 == TYPE_STR {
                p_pointee2 = TYPE_U8;
            }
            if p_type2 == TYPE_ARRAY {
                if p_arr_len2 == 0 {
                    p_arr_len2 = func_tbl_get_param_info(tbl, fn_hash, param_count, 2);
                }
            }
            param_count = param_count + 1;
            if p_type2 == TYPE_TUPLE {
                p_pointee2 = get_qword(s, 14);
                let p_t1_2 = get_qword(s, 18);
                let p_arity2 = get_qword(s, 19);
                if p_arity2 == 0 { p_arity2 = 2; }
                var_tbl_add(tbl, p_hash2, param_count * 8, p_type2, p_pointee2, p_t1_2, 0 - p_arity2);
            } else {
                var_tbl_add(tbl, p_hash2, param_count * 8, p_type2, p_pointee2, PROV_UNKNOWN, p_arr_len2);
            }
        }
    }
    expect(s, TOKEN_RPAREN);

    if param_count > 16 {
        set_qword(s, 7, -36);
        return -36;
    }

    let fn_ret_type = TYPE_I64;
    let fn_ret_ann_pointee = TYPE_NONE;
    let has_explicit_ret = 0;
    if cur_tok_kind(s) == TOKEN_COLON {
        has_explicit_ret = 1;
        advance_token(s);
        fn_ret_type = parse_type(s);
        if (fn_ret_type == TYPE_PTR) | (fn_ret_type == TYPE_TUPLE) {
            fn_ret_ann_pointee = get_qword(s, 14);
        }
        if fn_ret_type == TYPE_ARRAY {
            set_qword(s, 7, -41); # Array returns not supported
            return -41;
        }
        if fn_ret_type >= TYPE_STRUCT {
            set_qword(s, 7, -41); # Struct returns by value not supported
            return -41;
        }
    }

    set_qword(s, 13, fn_ret_type);

    # Record function offset in func_tbl
    let fn_start = get_qword(s, 4);
    let fn_idx = func_tbl_add(tbl, fn_hash, fn_start, param_count, fn_ret_type);
    set_qword(s, 16, fn_idx);
    if (fn_ret_type == TYPE_PTR) | (fn_ret_type == TYPE_TUPLE) {
        func_tbl_set_ret_metadata(tbl, fn_idx, fn_ret_ann_pointee, get_qword(s, 18));
    }

    # Initialize dynamic stack byte tracker for this function
    set_qword(s, 20, param_count * 8);

    let main_hash = 6385467242;
    if fn_hash == main_hash {
        let t0 = func_tbl_get_param_info(tbl, fn_hash, 0, 0);
        let t1 = func_tbl_get_param_info(tbl, fn_hash, 1, 0);
        let v = tir_validate_main(param_count, fn_ret_type, t0, t1);
        if v < 0 {
            set_qword(s, 7, v);
            return v;
        }
    }

    # Emit prologue: push rbp; mov rbp, rsp; sub rsp, <imm32>
    let l = fn_start;
    l = emit_byte(code_buf, l, 85);
    l = emit_byte(code_buf, l, 72);
    l = emit_byte(code_buf, l, 137);
    l = emit_byte(code_buf, l, 229);
    l = emit_byte(code_buf, l, 72);
    l = emit_byte(code_buf, l, 129);
    l = emit_byte(code_buf, l, 236);
    let frame_size_patch = l;
    l = emit_byte(code_buf, l, 0);
    l = emit_byte(code_buf, l, 0);
    l = emit_byte(code_buf, l, 0);
    l = emit_byte(code_buf, l, 0);

    # Save parameter registers and stack arguments into their assigned stack slots with typed widths
    let p_idx = 0;
    while p_idx < param_count {
        let p_type_saved = func_tbl_get_param_info(tbl, fn_hash, p_idx, 0);
        if p_idx < 6 {
            l = emit_store_param_typed(code_buf, l, p_idx, (p_idx + 1) * 8, p_type_saved);
        } else {
            let src_disp = 16 + ((p_idx - 6) * 8);
            l = emit_byte(code_buf, l, 72);
            l = emit_byte(code_buf, l, 139);
            if src_disp <= 127 {
                l = emit_byte(code_buf, l, 69);
                l = emit_byte(code_buf, l, src_disp);
            } else {
                l = emit_byte(code_buf, l, 133);
                l = emit_disp32(code_buf, l, src_disp);
            }
            l = emit_store_slot_typed(code_buf, l, (p_idx + 1) * 8, p_type_saved);
        }
        p_idx = p_idx + 1;
    }
    set_qword(s, 4, l);

    if cur_tok_kind(s) == TOKEN_EQUAL {
        advance_token(s); # skip '='
        let expr_t = parse_expr(s);
        if get_qword(s, 7) < 0 {
            return get_qword(s, 7);
        }
        if has_explicit_ret == 0 {
            if expr_t == TYPE_INT_LIT {
                fn_ret_type = TYPE_I64;
            } else {
                fn_ret_type = expr_t;
            }
            func_tbl_add(tbl, fn_hash, fn_start, param_count, fn_ret_type);
            set_qword(s, 13, fn_ret_type);
        } else {
            if type_is_compatible(fn_ret_type, expr_t) == 0 {
                set_qword(s, 7, -41); # ERR_TYPE_MISMATCH_RETURN
                return -41;
            }
        }
        if fn_ret_type == TYPE_PTR {
            let expr_prov = get_qword(s, 15);
            if expr_prov == PROV_STACK_LOCAL {
                set_qword(s, 7, -46); # ERR_STACK_ESCAPE
                return -46;
            }
            let cur_fn_idx = get_qword(s, 16);
            let expr_pointee = get_qword(s, 14);
            func_tbl_set_ret_metadata(tbl, cur_fn_idx, expr_pointee, expr_prov);
        }
        l = get_qword(s, 4);
        l = emit_jmp_rel32(code_buf, l, 0); # placeholder to epilogue
        epilogue_patches_add(tbl, l - 4);
        set_qword(s, 4, l);
        set_qword(s, 26, 1);
        expect(s, TOKEN_SEMICOLON);
    } else {
        expect(s, TOKEN_LBRACE);
        set_qword(s, 26, 0);
        while is_block_end(s) == 0 {
            if get_qword(s, 7) < 0 {
                return get_qword(s, 7);
            }
            let term = get_qword(s, 26);
            if get_qword(s, 22) == 1 {
                if term == 1 {
                    let code_mark = get_qword(s, 4);
                    let epilogue_mark = get_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX);
                    let call_patch_mark = get_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX);
                    let stack_mark = get_qword(s, 12);
                    parse_stmt(s);
                    set_qword(s, 4, code_mark);
                    set_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX, epilogue_mark);
                    set_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX, call_patch_mark);
                    set_qword(s, 12, stack_mark);
                } else {
                    parse_stmt(s);
                }
            } else {
                parse_stmt(s);
            }
        }
        if get_qword(s, 7) < 0 {
            return get_qword(s, 7);
        }
        expect(s, TOKEN_RBRACE);
    }

    # Backpatch frame size dynamically from s[20] or optimized live slots
    let raw_bytes = get_qword(s, 20);
    if get_qword(s, 22) == 1 {
        let round = get_qword(s, 28);
        if round > 0 {
            # Phase 4 Step 5: Stack / Frame Layout Optimization
            # Recalculate frame size from maximum offset of actually live slots and parameters
            let max_active = param_count * 8;
            t0 = max_active;
            let v_count = get_qword(tbl, TBL_VAR_COUNT_QWORD_IDX);
            let vi = 0;
            while vi < v_count {
                let base = tbl + TBL_VAR_BASE_OFFSET + (vi * TBL_VAR_ENTRY_SIZE);
                let v_slot = get_qword(base, 1);
                let v_type = get_qword(base, 2);
                let v_prov = get_qword(base, 4);
                if v_slot > t0 {
                    t0 = v_slot;
                }
                let v_live = 0;
                if vi < param_count {
                    v_live = 1;
                } else {
                    if v_type == TYPE_ARRAY {
                        v_live = 1;
                    }
                    if v_type >= TYPE_STRUCT {
                        v_live = 1;
                    }
                    if v_prov == PROV_STACK_LOCAL {
                        v_live = 1;
                    }
                    let slot_idx = (v_slot / 8) % 128;
                    let fn_idx = get_qword(s, 16);
                    let is_used = get_byte(tbl, TBL_VAR_USAGE_BASE_OFFSET + (fn_idx * 128) + slot_idx);
                    if is_used > 0 {
                        v_live = 1;
                    }
                }
                if v_live == 1 {
                    if v_slot > max_active {
                        max_active = v_slot;
                    }
                }
                vi = vi + 1;
            }
            t1 = get_qword(s, 20);
            if t1 > t0 {
                max_active = max_active + (t1 - t0);
            }
            raw_bytes = max_active;
        }
    }
    if get_qword(s, 461) > raw_bytes {
        raw_bytes = get_qword(s, 461);
    }
    let frame_size = ((raw_bytes + 15) / 16) * 16;
    set_byte(code_buf, frame_size_patch, frame_size % 256);
    set_byte(code_buf, frame_size_patch + 1, (frame_size / 256) % 256);
    set_byte(code_buf, frame_size_patch + 2, (frame_size / 65536) % 256);
    set_byte(code_buf, frame_size_patch + 3, (frame_size / 16777216) % 256);

    # Epilogue position
    l = get_qword(s, 4);
    let ep_cnt = get_qword(tbl, TBL_EPILOGUE_COUNT_QWORD_IDX);
    let ep_i = 0;
    while ep_i < ep_cnt {
        let ep_base = tbl + TBL_EPILOGUE_BASE_OFFSET + (ep_i * TBL_EPILOGUE_ENTRY_SIZE);
        let ep_pos = get_qword(ep_base, 0);
        emit_backpatch32(code_buf, ep_pos, l);
        ep_i = ep_i + 1;
    }

    let d_cnt = get_qword(s, 460);
    if d_cnt > 0 {
        let mask_slot = get_qword(s, 461);
        let fn_end_pos = get_qword(s, 2);
        let fn_end_k = cur_tok_kind(s);
        let fn_end_v = cur_tok_val(s);
        let fn_end_off = cur_tok_offset(s);
        let fn_end_len = cur_tok_len(s);

        let di = d_cnt - 1;
        while di >= 0 {
            let bit_val = 1;
            let bi = 0;
            while bi < di {
                bit_val = bit_val * 2;
                bi = bi + 1;
            }

            # 1. push rax (preserve return value / error code)
            l = emit_byte(code_buf, l, 80);
            # 2. test qword ptr [rbp - mask_slot], bit_val
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 69);
            l = emit_byte(code_buf, l, (256 - (mask_slot % 256)) % 256);
            l = emit_byte(code_buf, l, bit_val % 256);
            l = emit_byte(code_buf, l, (bit_val / 256) % 256);
            l = emit_byte(code_buf, l, (bit_val / 65536) % 256);
            l = emit_byte(code_buf, l, (bit_val / 16777216) % 256);
            # 3. jz .L_skip_defer (0F 84 disp32)
            l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 132);
            let p_skip = l;
            l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0); l = emit_byte(code_buf, l, 0);
            set_qword(s, 4, l);

            # 4. Restore token position to defer start:
            set_qword(s, 2, get_qword(s, 462 + (di * 5) + 0));
            token_set(get_qword(s, 6), get_qword(s, 462 + (di * 5) + 1), get_qword(s, 462 + (di * 5) + 2), get_qword(s, 462 + (di * 5) + 3), get_qword(s, 462 + (di * 5) + 4));

            # 5. Compile deferred statement
            parse_stmt(s);

            # 6. Patch .L_skip_defer:
            l = get_qword(s, 4);
            let disp = l - (p_skip + 4);
            if disp < 0 { disp = disp + 4294967296; }
            set_byte(code_buf, p_skip, disp % 256);
            set_byte(code_buf, p_skip + 1, (disp / 256) % 256);
            set_byte(code_buf, p_skip + 2, (disp / 65536) % 256);
            set_byte(code_buf, p_skip + 3, (disp / 16777216) % 256);

            # 7. pop rax (restore return value / error code)
            l = emit_byte(code_buf, l, 88);
            set_qword(s, 4, l);

            di = di - 1;
        }

        # Restore token stream to end of function
        set_qword(s, 2, fn_end_pos);
        token_set(get_qword(s, 6), fn_end_k, fn_end_v, fn_end_off, fn_end_len);
    }

    # Single canonical epilogue: mov rsp, rbp; pop rbp; ret
    let fn_ret_type = get_qword(s, 13);
    if fn_ret_type == TYPE_F64 {
        l = emit_byte(code_buf, l, 102); l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 110); l = emit_byte(code_buf, l, 192); # movq xmm0, rax
    }
    if fn_ret_type == TYPE_F32 {
        l = emit_byte(code_buf, l, 102); l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 110); l = emit_byte(code_buf, l, 192); # movd xmm0, eax
    }
    l = emit_byte(code_buf, l, 72);
    l = emit_byte(code_buf, l, 137);
    l = emit_byte(code_buf, l, 236);
    l = emit_byte(code_buf, l, 93);
    l = emit_byte(code_buf, l, 195);
    set_qword(s, 4, l);

    return 0;
}

# ------------------------------------------------------------------------------
# Signature Pre-Scanning Pass
# ------------------------------------------------------------------------------

fn parse_struct_decl(s: i64): i64 {
    let src = get_qword(s, 0);
    let tbl = get_qword(s, 5);

    advance_token(s); # skip 'struct'
    let s_offset = cur_tok_offset(s);
    let s_len = cur_tok_len(s);
    let s_hash = hash_token(src, s_offset, s_len);
    expect(s, TOKEN_IDENT);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }

    let struct_id = struct_tbl_find(tbl, s_hash);
    if struct_id < 0 {
        let count = get_qword(tbl, TBL_STRUCT_COUNT_QWORD_IDX);
        if count >= TBL_STRUCT_MAX_CAPACITY {
            set_qword(s, 7, -31);
            return -31;
        }
        let base = tbl + TBL_STRUCT_BASE_OFFSET + (count * TBL_STRUCT_ENTRY_SIZE);
        set_qword(base, 0, s_hash);
        set_qword(base, 1, 0); # total_size
        set_qword(base, 2, 8); # alignment
        set_qword(base, 3, 0); # field_count
        set_qword(tbl, TBL_STRUCT_COUNT_QWORD_IDX, count + 1);
        struct_id = count;
    }

    expect(s, TOKEN_LBRACE);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }

    let cur_offset = 0;
    let max_align = 1;
    let field_count = 0;

    while cur_tok_kind(s) != TOKEN_RBRACE {
        if cur_tok_kind(s) == TOKEN_EOF {
            set_qword(s, 7, -1);
            return -1;
        }
        let f_offset = cur_tok_offset(s);
        let f_len = cur_tok_len(s);
        let f_hash = hash_token(src, f_offset, f_len);
        expect(s, TOKEN_IDENT);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }

        expect(s, TOKEN_COLON);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }

        let f_type = parse_type(s);
        if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        let f_pointee = get_qword(s, 14);
        let f_arr_len = get_qword(s, 19);

        let f_sz = 8;
        let f_align = 8;

        if f_type == TYPE_I64 { f_sz = 8; f_align = 8; }
        if f_type == TYPE_PTR { f_sz = 8; f_align = 8; }
        if f_type == TYPE_STR { f_sz = 8; f_align = 8; }
        if f_type == TYPE_F64 { f_sz = 8; f_align = 8; }
        if f_type == TYPE_I32 { f_sz = 4; f_align = 4; }
        if f_type == TYPE_F32 { f_sz = 4; f_align = 4; }
        if f_type == TYPE_U8  { f_sz = 1; f_align = 1; }
        if f_type == TYPE_BOOL { f_sz = 1; f_align = 1; }

        if f_type >= TYPE_STRUCT {
            let nested_id = f_type - TYPE_STRUCT;
            f_sz = struct_tbl_get_meta(tbl, nested_id, 1);
            f_align = struct_tbl_get_meta(tbl, nested_id, 2);
        }

        if f_type == TYPE_ARRAY {
            let elem_sz = 8;
            if f_pointee == TYPE_I32 { elem_sz = 4; }
            if f_pointee == TYPE_F32 { elem_sz = 4; }
            if f_pointee == TYPE_U8  { elem_sz = 1; }
            if f_pointee == TYPE_BOOL { elem_sz = 1; }
            if f_pointee >= TYPE_STRUCT {
                elem_sz = struct_tbl_get_meta(tbl, f_pointee - TYPE_STRUCT, 1);
            }
            f_sz = elem_sz * f_arr_len;
            f_align = elem_sz;
            if f_align > 8 { f_align = 8; }
        }

        if (cur_offset % f_align) != 0 {
            cur_offset = cur_offset + (f_align - (cur_offset % f_align));
        }

        if f_align > max_align {
            max_align = f_align;
        }

        struct_tbl_set_field(tbl, struct_id, field_count, f_hash, f_type, f_pointee, cur_offset, f_sz, f_arr_len);
        cur_offset = cur_offset + f_sz;
        field_count = field_count + 1;

        if cur_tok_kind(s) == TOKEN_COMMA {
            advance_token(s);
        } else {
            if cur_tok_kind(s) == TOKEN_SEMICOLON {
                advance_token(s);
            }
        }
    }

    expect(s, TOKEN_RBRACE);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }

    if (cur_offset % max_align) != 0 {
        cur_offset = cur_offset + (max_align - (cur_offset % max_align));
    }
    if cur_offset == 0 {
        cur_offset = max_align;
    }

    if struct_id >= 0 {
        let s_base = tbl + TBL_STRUCT_BASE_OFFSET + (struct_id * TBL_STRUCT_ENTRY_SIZE);
        set_qword(s_base, 1, cur_offset);
        set_qword(s_base, 2, max_align);
        set_qword(s_base, 3, field_count);
    }
    return 0;
}

fn parse_enum_decl(s: i64): i64 {
    let src = get_qword(s, 0);
    let tbl = get_qword(s, 5);

    advance_token(s); # skip 'enum'
    let e_offset = cur_tok_offset(s);
    let e_len = cur_tok_len(s);
    let e_hash = hash_token(src, e_offset, e_len);
    expect(s, TOKEN_IDENT);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }

    let enum_id = enum_tbl_find(tbl, e_hash);
    if enum_id < 0 {
        enum_id = enum_tbl_add(tbl, e_hash);
        if enum_id < 0 {
            set_qword(s, 7, -31);
            return -31;
        }
    }

    expect(s, TOKEN_LBRACE);
    if get_qword(s, 7) < 0 { return get_qword(s, 7); }

    let cur_val = 0;
    let v_idx = 0;

    while (cur_tok_kind(s) != TOKEN_RBRACE) & (cur_tok_kind(s) != TOKEN_EOF) {
        let v_offset = cur_tok_offset(s);
        let v_len = cur_tok_len(s);
        let v_hash = hash_token(src, v_offset, v_len);
        let vk = cur_tok_kind(s);
        if (vk != TOKEN_RBRACE) & (vk != TOKEN_COMMA) & (vk != TOKEN_EQUAL) & (vk != TOKEN_LPAREN) & (vk != TOKEN_EOF) {
            advance_token(s);
        } else {
            expect(s, TOKEN_IDENT);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        }

        let disc_val = cur_val;
        if cur_tok_kind(s) == TOKEN_EQUAL {
            advance_token(s); # skip '='
            let neg = 0;
            if cur_tok_kind(s) == TOKEN_MINUS {
                neg = 1;
                advance_token(s);
            }
            disc_val = cur_tok_val(s);
            if neg == 1 { disc_val = 0 - disc_val; }
            expect(s, TOKEN_INT_LIT);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
            cur_val = disc_val;
        }

        let payload_cnt = 0;
        let p_type = TYPE_NONE;
        if cur_tok_kind(s) == TOKEN_LPAREN {
            advance_token(s); # skip '('
            p_type = parse_type(s);
            payload_cnt = 1;
            expect(s, TOKEN_RPAREN);
            if get_qword(s, 7) < 0 { return get_qword(s, 7); }
        }

        enum_tbl_set_variant(tbl, enum_id, v_idx, v_hash, disc_val, payload_cnt, p_type);
        const_tbl_add(tbl, v_hash, disc_val);

        cur_val = cur_val + 1;
        v_idx = v_idx + 1;

        if cur_tok_kind(s) == TOKEN_COMMA {
            advance_token(s);
        } else {
            if cur_tok_kind(s) == TOKEN_SEMICOLON {
                advance_token(s);
            }
        }
    }
    expect(s, TOKEN_RBRACE);
    return 0;
}

fn scan_signatures(s: i64): i64 {
    let src = get_qword(s, 0);
    let tbl = get_qword(s, 5);

    # Pass 1: Scan all struct and enum declarations
    advance_token(s);
    while cur_tok_kind(s) != TOKEN_EOF {
        let k = cur_tok_kind(s);
        if k == TOKEN_KW_STRUCT {
            parse_struct_decl(s);
            if get_qword(s, 7) < 0 {
                return get_qword(s, 7);
            }
        } else {
            if k == TOKEN_KW_ENUM {
                parse_enum_decl(s);
                if get_qword(s, 7) < 0 {
                    return get_qword(s, 7);
                }
            } else {
                advance_token(s);
            }
        }
    }

    # Pass 2: Scan function signatures
    set_qword(s, 2, 0);
    advance_token(s);

    while cur_tok_kind(s) != TOKEN_EOF {
        let k = cur_tok_kind(s);
        if k == TOKEN_ERROR {
            set_qword(s, 7, -3); # ERR_INVALID_TOKEN
            return -3;
        }

        if (k == TOKEN_KW_STRUCT) | (k == TOKEN_KW_ENUM) {
            advance_token(s);
            expect(s, TOKEN_IDENT);
            expect(s, TOKEN_LBRACE);
            let bdepth = 1;
            while bdepth > 0 {
                if cur_tok_kind(s) == TOKEN_EOF { return -1; }
                if cur_tok_kind(s) == TOKEN_LBRACE { bdepth = bdepth + 1; }
                if cur_tok_kind(s) == TOKEN_RBRACE { bdepth = bdepth - 1; }
                advance_token(s);
            }
        } else {
            if k == TOKEN_KW_FN {
                advance_token(s); # skip 'fn'
                let fn_offset = cur_tok_offset(s);
                let fn_len = cur_tok_len(s);
                let fn_hash = hash_token(src, fn_offset, fn_len);
                expect(s, TOKEN_IDENT);
                expect(s, TOKEN_LPAREN);

                let param_count = 0;
                let fn_idx = func_tbl_add(tbl, fn_hash, -1, 0, TYPE_I64);

                if cur_tok_kind(s) != TOKEN_RPAREN {
                    expect(s, TOKEN_IDENT);
                    let p_type = TYPE_I64;
                    let p_ann = TYPE_NONE;
                    if cur_tok_kind(s) == TOKEN_COLON {
                        advance_token(s);
                        p_type = parse_type(s);
                        if (p_type == TYPE_PTR) | (p_type == TYPE_TUPLE) {
                            p_ann = get_qword(s, 14);
                        }
                        if (p_type == TYPE_ARRAY) | (p_type == TYPE_TUPLE) {
                            p_ann = get_qword(s, 14);
                            func_tbl_set_param_array_len(tbl, fn_idx, 0, get_qword(s, 19));
                        }
                    }
                    func_tbl_set_param_type(tbl, fn_idx, 0, p_type);
                    if p_ann != TYPE_NONE {
                        func_tbl_set_param_metadata(tbl, fn_idx, 0, p_ann, PROV_UNKNOWN);
                    }
                    param_count = 1;

                    while cur_tok_kind(s) == TOKEN_COMMA {
                        advance_token(s);
                        expect(s, TOKEN_IDENT);
                        let p_type2 = TYPE_I64;
                        let p_ann2 = TYPE_NONE;
                        if cur_tok_kind(s) == TOKEN_COLON {
                            advance_token(s);
                            p_type2 = parse_type(s);
                            if (p_type2 == TYPE_PTR) | (p_type2 == TYPE_TUPLE) {
                                p_ann2 = get_qword(s, 14);
                            }
                            if (p_type2 == TYPE_ARRAY) | (p_type2 == TYPE_TUPLE) {
                                p_ann2 = get_qword(s, 14);
                                func_tbl_set_param_array_len(tbl, fn_idx, param_count, get_qword(s, 19));
                            }
                        }
                        func_tbl_set_param_type(tbl, fn_idx, param_count, p_type2);
                        if p_ann2 != TYPE_NONE {
                            func_tbl_set_param_metadata(tbl, fn_idx, param_count, p_ann2, PROV_UNKNOWN);
                        }
                        param_count = param_count + 1;
                    }
                }
                expect(s, TOKEN_RPAREN);
                if param_count > 16 {
                    set_qword(s, 7, -36);
                    return 0;
                }

                let ret_type = TYPE_I64;
                let ret_ann = TYPE_NONE;
                if cur_tok_kind(s) == TOKEN_COLON {
                    advance_token(s);
                    ret_type = parse_type(s);
                    if (ret_type == TYPE_PTR) | (ret_type == TYPE_TUPLE) {
                        ret_ann = get_qword(s, 14);
                    }
                    if ret_type == TYPE_ARRAY {
                        set_qword(s, 7, -41); # Array returns not supported
                        return -41;
                    }
                    if ret_type >= TYPE_STRUCT {
                        set_qword(s, 7, -41); # Struct returns by value not supported
                        return -41;
                    }
                }

                let fn_idx2 = func_tbl_add(tbl, fn_hash, -1, param_count, ret_type);
                if (ret_type == TYPE_PTR) | (ret_type == TYPE_TUPLE) {
                    func_tbl_set_ret_metadata(tbl, fn_idx2, ret_ann, get_qword(s, 18));
                }

                let main_hash = 6385467242;
                if fn_hash == main_hash {
                    let t0 = func_tbl_get_param_info(tbl, fn_hash, 0, 0);
                    let t1 = func_tbl_get_param_info(tbl, fn_hash, 1, 0);
                    let v = tir_validate_main(param_count, ret_type, t0, t1);
                    if v < 0 {
                        set_qword(s, 7, v);
                        return v;
                    }
                }

                if cur_tok_kind(s) == TOKEN_LBRACE {
                    advance_token(s);
                    let brace_depth = 1;
                    while brace_depth > 0 {
                        if cur_tok_kind(s) == TOKEN_EOF {
                            return -1;
                        }
                        if cur_tok_kind(s) == TOKEN_LBRACE {
                            brace_depth = brace_depth + 1;
                        } else {
                            if cur_tok_kind(s) == TOKEN_RBRACE {
                                brace_depth = brace_depth - 1;
                            }
                        }
                        advance_token(s);
                    }
                } else {
                    if cur_tok_kind(s) == TOKEN_EQUAL {
                        advance_token(s);
                        let paren_depth = 0;
                        let scan_eq = 1;
                        while scan_eq == 1 {
                            if cur_tok_kind(s) == TOKEN_EOF { return -1; }
                            let tk = cur_tok_kind(s);
                            if tk == TOKEN_LPAREN { paren_depth = paren_depth + 1; }
                            if tk == TOKEN_LBRACKET { paren_depth = paren_depth + 1; }
                            if tk == TOKEN_LBRACE { paren_depth = paren_depth + 1; }
                            if tk == TOKEN_RPAREN { paren_depth = paren_depth - 1; }
                            if tk == TOKEN_RBRACKET { paren_depth = paren_depth - 1; }
                            if tk == TOKEN_RBRACE { paren_depth = paren_depth - 1; }
                            if tk == TOKEN_SEMICOLON {
                                if paren_depth <= 0 {
                                    advance_token(s);
                                    scan_eq = 0;
                                }
                            }
                            if scan_eq == 1 {
                                advance_token(s);
                            }
                        }
                    }
                }
            } else {
                advance_token(s);
            }
        }
    }

    set_qword(s, 2, 0); # reset position for main pass
    set_qword(s, 7, 0); # clear status
    return 0;
}

# ------------------------------------------------------------------------------
# Program Parser
# ------------------------------------------------------------------------------

fn parse_declarations(s: i64): i64 {
    let src = get_qword(s, 0);
    let tbl = get_qword(s, 5);

    advance_token(s);

    while cur_tok_kind(s) != TOKEN_EOF {
        if get_qword(s, 7) < 0 {
            return get_qword(s, 7);
        }
        let k = cur_tok_kind(s);
        if k == TOKEN_ERROR {
            set_qword(s, 7, -3); # ERR_INVALID_TOKEN
            return -3;
        }
        if (k == TOKEN_KW_LET) | (k == TOKEN_KW_MUT) {
            # Top-level constant: let NAME [: type] = [-]INT;
            advance_token(s);
            let c_offset = cur_tok_offset(s);
            let c_len = cur_tok_len(s);
            let c_hash = hash_token(src, c_offset, c_len);
            expect(s, TOKEN_IDENT);
            if cur_tok_kind(s) == TOKEN_COLON {
                advance_token(s);
                advance_token(s); # skip optional type
            }
            expect(s, TOKEN_EQUAL);

            let neg = 0;
            if cur_tok_kind(s) == TOKEN_MINUS {
                neg = 1;
                advance_token(s);
            }
            let cval = cur_tok_val(s);
            if neg == 1 { cval = 0 - cval; }
            advance_token(s);
            if cur_tok_kind(s) == TOKEN_SEMICOLON {
                advance_token(s);
            }
            const_tbl_add(tbl, c_hash, cval);
        } else {
            if k == TOKEN_KW_FN {
                parse_fn(s);
            } else {
                if (k == TOKEN_KW_STRUCT) | (k == TOKEN_KW_ENUM) {
                    advance_token(s); # skip 'struct' or 'enum'
                    expect(s, TOKEN_IDENT);
                    expect(s, TOKEN_LBRACE);
                    let bdepth = 1;
                    while bdepth > 0 {
                        if cur_tok_kind(s) == TOKEN_EOF { return -1; }
                        if cur_tok_kind(s) == TOKEN_LBRACE { bdepth = bdepth + 1; }
                        if cur_tok_kind(s) == TOKEN_RBRACE { bdepth = bdepth - 1; }
                        advance_token(s);
                    }
                } else {
                    advance_token(s);
                }
            }
        }
    }
    return 0;
}

# ------------------------------------------------------------------------------
# Program Parser
# ------------------------------------------------------------------------------

fn parse_program(s: i64): i64 {
    let src = get_qword(s, 0);
    let code_buf = get_qword(s, 3);
    let tbl = get_qword(s, 5);

    # 1. Reset tables & register builtins
    set_qword(tbl, 0, 0);     # legacy const_tbl count
    set_qword(tbl, TBL_CONST_COUNT_QWORD_IDX, 0);
    set_qword(tbl, TBL_FUNC_COUNT_QWORD_IDX, 0);
    set_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX, 0);
    set_qword(tbl, TBL_STRUCT_COUNT_QWORD_IDX, 0);
    set_qword(tbl, TBL_ENUM_COUNT_QWORD_IDX, 0);
    let di = 0;
    while di < TBL_VAR_USAGE_MAX_WORDS {
        set_qword(tbl, TBL_VAR_USAGE_QWORD_IDX + di, 0);
        set_qword(tbl, TBL_VAR_USAGE_NEXT_IDX + di, 0);
        di = di + 1;
    }
    set_qword(s, 12, 0); # initialize stack depth
    set_qword(s, 21, 0); # initialize loop depth
    set_qword(s, 14, TYPE_NONE);
    set_qword(s, 15, PROV_UNKNOWN);
    register_builtins(tbl);

    # 2. First Pass: Scan function signatures
    scan_signatures(s);
    if get_qword(s, 7) < 0 {
        return get_qword(s, 7);
    }

    # 3. Pass 0: Semantic inference & call-site propagation (3 rounds)
    let round = 0;
    while round < 3 {
        set_qword(s, 28, round);
        if round < 2 {
            set_qword(s, 17, 0); # inference pass (deferred error)
        } else {
            set_qword(s, 17, 1); # strict verification pass
        }
        set_qword(s, 2, 0); # rewind source pos to 0
        set_qword(s, 4, 32); # offset 32 accounts for entry block (jmp main + _start)
        set_qword(s, 12, 0);
        set_qword(s, 21, 0);
        set_qword(s, 14, TYPE_NONE);
        set_qword(s, 15, PROV_UNKNOWN);
        patch_tbl_reset(tbl);
        parse_declarations(s);
        if round == 2 {
            if get_qword(s, 7) < 0 {
                return get_qword(s, 7);
            }
        } else {
            set_qword(s, 7, 0); # clear deferred status during inference rounds
        }
        let cpi = 0;
        while cpi < 8000 {
            set_qword(tbl, 50000 + cpi, get_qword(tbl, 62500 + cpi));
            set_qword(tbl, 62500 + cpi, 0);
            cpi = cpi + 1;
        }
        round = round + 1;
    }

    # 4. Pass 1: Final Code Generation Pass
    set_qword(s, 28, 3);
    set_qword(s, 17, 1);
    set_qword(s, 2, 0); # rewind source pos to 0
    set_qword(s, 12, 0);
    set_qword(s, 21, 0);
    set_qword(s, 14, TYPE_NONE);
    set_qword(s, 15, PROV_UNKNOWN);
    patch_tbl_reset(tbl);

    # Emit top-level entry jump: jmp main (E9 00 00 00 00)
    let l = emit_jmp_rel32(code_buf, 0, 0);
    let main_entry_patch = 1;

    # Emit _start (native Linux process startup entry at offset 5):
    # 1. xor rbp, rbp (48 31 ED) - clear base pointer for outermost frame
    l = emit_byte(code_buf, l, 72);
    l = emit_byte(code_buf, l, 49);
    l = emit_byte(code_buf, l, 237);
    # 2. mov rdi, [rsp] (48 8B 3C 24) - read argc from initial stack
    l = emit_byte(code_buf, l, 72);
    l = emit_byte(code_buf, l, 139);
    l = emit_byte(code_buf, l, 60);
    l = emit_byte(code_buf, l, 36);
    # 3. lea rsi, [rsp + 8] (48 8D 74 24 08) - compute argv pointer at rsp + 8
    l = emit_byte(code_buf, l, 72);
    l = emit_byte(code_buf, l, 141);
    l = emit_byte(code_buf, l, 116);
    l = emit_byte(code_buf, l, 36);
    l = emit_byte(code_buf, l, 8);
    # 4. call main (E8 <disp32>) - 16-byte aligned call to Rubix main
    let start_call_patch = l + 1;
    l = emit_byte(code_buf, l, 232);
    l = emit_disp32(code_buf, l, 0);
    # 5. mov rdi, rax (48 89 C7) - pass return value from main as exit code
    l = emit_byte(code_buf, l, 72);
    l = emit_byte(code_buf, l, 137);
    l = emit_byte(code_buf, l, 199);
    # 6. mov eax, 60 (B8 3C 00 00 00) - sys_exit syscall number
    l = emit_byte(code_buf, l, 184);
    l = emit_disp32(code_buf, l, 60);
    # 7. syscall (0F 05) - invoke native Linux process termination
    l = emit_byte(code_buf, l, 15);
    l = emit_byte(code_buf, l, 5);

    set_qword(s, 4, l);

    parse_declarations(s);
    if get_qword(s, 7) < 0 {
        return get_qword(s, 7);
    }

    # 5. Backpatch entry jump and _start call to 'main'
    let main_hash = 6385467242;
    let main_offset = func_tbl_get(tbl, main_hash, 1);
    if main_offset >= 0 {
        emit_backpatch32(code_buf, main_entry_patch, main_offset);
        emit_backpatch32(code_buf, start_call_patch, main_offset);
    } else {
        set_qword(s, 7, -54); # ERR_MAIN_NOT_FOUND
        return -54;
    }

    # 6. Backpatch all forward user function calls
    let pt_cnt = get_qword(tbl, TBL_PATCH_COUNT_QWORD_IDX);
    let pt_i = 0;
    while pt_i < pt_cnt {
        let pt_base = tbl + TBL_PATCH_BASE_OFFSET + (pt_i * TBL_PATCH_ENTRY_SIZE);
        let pt_pos = get_qword(pt_base, 0);
        let pt_hash = get_qword(pt_base, 1);
        let pt_target = func_tbl_get(tbl, pt_hash, 1);
        if pt_target >= 0 {
            emit_backpatch32(code_buf, pt_pos, pt_target);
        }
        pt_i = pt_i + 1;
    }

    let status = get_qword(s, 7);
    if status < 0 {
        return status;
    }

    return get_qword(s, 4); # total code bytes emitted
}

# ==============================================================================
# Rubix Compiler — In-Memory Execution Interface (compiler/executor/executor.bix)
# Pure Rubix executor abstraction for direct in-memory CPU execution with W^X.
# ==============================================================================

fn executor_execute(code_buf: i64, code_len: i64): i64 {
    if code_buf <= 0 {
        return -98;
    }
    if code_len <= 0 {
        return -97;
    }

    # Step 1: Compute page-aligned length covering the entire emitted code buffer
    let page_aligned_len = ((code_len + 4095) / 4096) * 4096;

    # Step 2: W^X transition — make memory PROT_READ | PROT_EXEC (5)
    # Removing PROT_WRITE seals the code buffer before execution begins.
    let prot_res = sys_mprotect(code_buf, page_aligned_len, 5);
    if prot_res < 0 {
        return -99;
    }

    # Step 3: Jump directly to machine-code buffer on physical CPU
    let exit_code = sys_call_code(code_buf);

    return exit_code;
}
# ==============================================================================
# Rubix Compiler — Native Optimization Framework (compiler/middle/optimizer.bix)
# Phase 4 Step 1: Lightweight sequential TIR optimization pass manager.
# Enforces clean separation between unoptimized and optimized modes.
# Supports deterministic pass ordering, enabling/disabling, and change tracking.
# ==============================================================================
# Optimization pass index IDs (0..20)
# (Pass slots are indexed numerically 0..20 directly in opt_ctx_init)


let OPT_INFO_LEVEL = 0;
let OPT_INFO_PASS_COUNT = 1;
let OPT_INFO_TOTAL_CHANGED = 2;
let OPT_INFO_PIPELINE_RUNS = 3;
let OPT_INFO_ENABLED = 10;
let OPT_INFO_RUNS = 11;
let OPT_INFO_CHANGED = 12;

fn opt_ctx_init(ctx: i64, opt_level: i64): i64 {
    set_qword(ctx, 0, opt_level);
    let p_count = 11;
    if opt_level >= 2 {
        p_count = 21;
    }
    set_qword(ctx, 1, p_count);
    set_qword(ctx, 2, 0);  # total_changed = 0
    set_qword(ctx, 3, 0);  # pipeline_runs = 0

    let en_base = 0;
    if opt_level >= 1 { en_base = 1; }

    # Pass 0: OPT_PASS_IDENTITY
    let p0 = ctx + 32;
    set_qword(p0, 0, en_base); set_qword(p0, 1, 0); set_qword(p0, 2, 0); set_qword(p0, 3, 0);

    # Pass 1: OPT_PASS_VERIFY_TIR
    let p1 = ctx + 64;
    set_qword(p1, 0, en_base); set_qword(p1, 1, 0); set_qword(p1, 2, 0); set_qword(p1, 3, 1);

    # Pass 2: OPT_PASS_CONST_FOLD
    let p2 = ctx + 96;
    set_qword(p2, 0, en_base); set_qword(p2, 1, 0); set_qword(p2, 2, 0); set_qword(p2, 3, 2);

    # Pass 3: OPT_PASS_DCE
    let p3 = ctx + 128;
    set_qword(p3, 0, en_base); set_qword(p3, 1, 0); set_qword(p3, 2, 0); set_qword(p3, 3, 3);

    # Pass 4: OPT_PASS_PEEPHOLE
    let p4 = ctx + 160;
    set_qword(p4, 0, en_base); set_qword(p4, 1, 0); set_qword(p4, 2, 0); set_qword(p4, 3, 4);

    # Pass 5: OPT_PASS_FRAME_OPT
    let p5 = ctx + 192;
    set_qword(p5, 0, en_base); set_qword(p5, 1, 0); set_qword(p5, 2, 0); set_qword(p5, 3, 5);

    # Pass 6: OPT_PASS_CALL_REG
    let p6 = ctx + 224;
    set_qword(p6, 0, en_base); set_qword(p6, 1, 0); set_qword(p6, 2, 0); set_qword(p6, 3, 6);

    # Pass 7: OPT_PASS_VALUE_OPT
    let p7 = ctx + 256;
    set_qword(p7, 0, en_base); set_qword(p7, 1, 0); set_qword(p7, 2, 0); set_qword(p7, 3, 7);

    # Pass 8: OPT_PASS_LOOP_OPT
    let p8 = ctx + 288;
    set_qword(p8, 0, en_base); set_qword(p8, 1, 0); set_qword(p8, 2, 0); set_qword(p8, 3, 8);

    # Pass 9: OPT_PASS_IPO
    let p9 = ctx + 320;
    set_qword(p9, 0, en_base); set_qword(p9, 1, 0); set_qword(p9, 2, 0); set_qword(p9, 3, 9);

    # Pass 10: OPT_PASS_INTEGRATION
    let p10 = ctx + 352;
    set_qword(p10, 0, en_base); set_qword(p10, 1, 0); set_qword(p10, 2, 0); set_qword(p10, 3, 10);

    # Phase 5 Passes (11..20):
    let en_p5 = 0;
    if opt_level >= 2 { en_p5 = 1; }

    # Pass 11: OPT_PASS_SSA
    let p11 = ctx + 384;
    set_qword(p11, 0, en_p5); set_qword(p11, 1, 0); set_qword(p11, 2, 0); set_qword(p11, 3, 11);

    # Pass 12: OPT_PASS_GLOBAL_VAL
    let p12 = ctx + 416;
    set_qword(p12, 0, en_p5); set_qword(p12, 1, 0); set_qword(p12, 2, 0); set_qword(p12, 3, 12);

    # Pass 13: OPT_PASS_REG_ALLOC
    let p13 = ctx + 448;
    set_qword(p13, 0, en_p5); set_qword(p13, 1, 0); set_qword(p13, 2, 0); set_qword(p13, 3, 13);

    # Pass 14: OPT_PASS_ADV_SPILL
    let p14 = ctx + 480;
    set_qword(p14, 0, en_p5); set_qword(p14, 1, 0); set_qword(p14, 2, 0); set_qword(p14, 3, 14);

    # Pass 15: OPT_PASS_ADV_LOOP
    let p15 = ctx + 512;
    set_qword(p15, 0, en_p5); set_qword(p15, 1, 0); set_qword(p15, 2, 0); set_qword(p15, 3, 15);

    # Pass 16: OPT_PASS_ADV_IPO
    let p16 = ctx + 544;
    set_qword(p16, 0, en_p5); set_qword(p16, 1, 0); set_qword(p16, 2, 0); set_qword(p16, 3, 16);

    # Pass 17: OPT_PASS_CFG_OPT
    let p17 = ctx + 576;
    set_qword(p17, 0, en_p5); set_qword(p17, 1, 0); set_qword(p17, 2, 0); set_qword(p17, 3, 17);

    # Pass 18: OPT_PASS_MACH_OPT
    let p18 = ctx + 608;
    set_qword(p18, 0, en_p5); set_qword(p18, 1, 0); set_qword(p18, 2, 0); set_qword(p18, 3, 18);

    # Pass 19: OPT_PASS_ADV_PIPELINE
    let p19 = ctx + 640;
    set_qword(p19, 0, en_p5); set_qword(p19, 1, 0); set_qword(p19, 2, 0); set_qword(p19, 3, 19);

    # Pass 20: OPT_PASS_DIAGNOSTICS
    let p20 = ctx + 672;
    set_qword(p20, 0, en_p5); set_qword(p20, 1, 0); set_qword(p20, 2, 0); set_qword(p20, 3, 20);

    return 0;
}

fn opt_ctx_set_pass(ctx: i64, pass_id: i64, enabled: i64): i64 {
    let count = get_qword(ctx, 1);
    if pass_id < 0 { return -1; }
    if pass_id >= count { return -1; }
    let base = ctx + 32 + (pass_id * 32);
    set_qword(base, 0, enabled);
    return 0;
}

fn opt_ctx_get_info(ctx: i64, pass_id: i64, info_kind: i64): i64 {
    if info_kind == 0 { return get_qword(ctx, 0); }
    if info_kind == 1 { return get_qword(ctx, 1); }
    if info_kind == 2 { return get_qword(ctx, 2); }
    if info_kind == 3 { return get_qword(ctx, 3); }

    let count = get_qword(ctx, 1);
    if pass_id < 0 { return -1; }
    if pass_id >= count { return -1; }
    let base = ctx + 32 + (pass_id * 32);
    if info_kind == 10 { return get_qword(base, 0); }
    if info_kind == 11 { return get_qword(base, 1); }
    if info_kind == 12 { return get_qword(base, 2); }
    return 0;
}

fn opt_run_pipeline(ctx: i64, tir_buf: i64, count: i64): i64 {
    let opt_lvl = get_qword(ctx, 0);
    if opt_lvl == 0 {
        # Unoptimized Mode: zero pass execution, returns immediately
        return 0;
    }

    let p_runs = get_qword(ctx, 3);
    set_qword(ctx, 3, p_runs + 1);

    let total_ch = get_qword(ctx, 2);

    # If this is a UIR buffer, delegate to the real fixed-point pipeline.
    # uir_opt_run_pipeline runs up to 5 iterations until no more changes.
    let is_uir = 0;
    if get_qword(tir_buf, 4) == 1430932817 { is_uir = 1; }
    if is_uir == 1 {
        let ch = uir_opt_run_pipeline(tir_buf);
        total_ch = total_ch + ch;
        set_qword(ctx, 2, total_ch);
        return total_ch;
    }

    # Legacy TIR path: single-pass linear scan (unchanged)
    let num_passes = get_qword(ctx, 1);
    let pass_idx = 0;
    while pass_idx < num_passes {
        let base = ctx + 32 + (pass_idx * 32);
        let enabled = get_qword(base, 0);
        if enabled == 1 {
            let r_cnt = get_qword(base, 1);
            set_qword(base, 1, r_cnt + 1);
            let changed = 0;
            if pass_idx == 0 {
                let i = 0;
                while i < count {
                    let k = get_byte(tir_buf, i);
                    i = i + 1;
                }
                changed = 0;
            }
            if changed > 0 {
                let ch_cnt = get_qword(base, 2);
                set_qword(base, 2, ch_cnt + changed);
                total_ch = total_ch + changed;
                set_qword(ctx, 2, total_ch);
            }
        }
        pass_idx = pass_idx + 1;
    }

    return total_ch;
}

# ==============================================================================
# Rubix Compiler — Universal Rubix Intermediate Representation (compiler/middle/uir.bix)
# Pure Rubix implementation of hardware-independent 3-address virtual register IR.
# Direct memory-mapped buffer storage without heap GC.
# ==============================================================================

# --- Core Universal Opcode Constants (retained in const_tbl) ---
let UIR_CONST = 1;
let UIR_MOVE = 2;
let UIR_ADD = 10;
let UIR_SUB = 11;
let UIR_MUL = 12;
let UIR_DIV = 13;
let UIR_LOAD = 42;
let UIR_STORE = 43;
let UIR_FUNCTION_START = 50;
let UIR_FUNCTION_END = 51;
let UIR_LABEL = 53;
let UIR_JUMP = 54;
let UIR_BRANCH = 55;
let UIR_CALL = 56;
let UIR_RETURN = 57;
# (Remaining opcodes: CAST=3, NEG=15, AND=20, OR=21, XOR=22, NOT=23, SHL=24, SHR=25,
#  CMP_NE=31, CMP_LE=33, CMP_GT=34, CMP_GE=35, SELECT=36, ALLOC_STACK=40, ADDR_OF=41,
#  INDEX_ADDR=44, PARAM=52, ARG=58, F_IMM1=1, F_IMM2=2, F_SIDE_EFFECT=4)

# Arithmetic

# Bitwise & Shifts

# Comparisons

# Memory & Addressing

# Control Flow & Functions


# ------------------------------------------------------------------------------
# Flat Memory UIR Buffer Management
# Memory layout:
#   Header (offsets 0..255):
#     [qword 0]: node_count
#     [qword 1]: next_vreg_id
#     [qword 2]: next_label_id
#     [qword 3]: func_count
#     [qword 4..31]: reserved
#   Nodes (offset 256 onwards, 64 bytes / 8 qwords per node):
#     slot 0: opcode
#     slot 1: type_id
#     slot 2: flags
#     slot 3: prov
#     slot 4: dst
#     slot 5: src1
#     slot 6: src2
#     slot 7: extra
# ------------------------------------------------------------------------------

fn uir_init(buf: i64): i64 {
    set_qword(buf, 0, 0); # node_count = 0
    set_qword(buf, 1, 0); # next_vreg_id = 0
    set_qword(buf, 2, 0); # next_label_id = 0
    set_qword(buf, 3, 0); # func_count = 0
    set_qword(buf, 4, 1430932817); # UIR Magic: 0x55495231
    return 0;
}


fn uir_get_count(buf: i64): i64 {
    return get_qword(buf, 0);
}

fn uir_node_addr(buf: i64, idx: i64): i64 {
    return buf + 256 + (idx * 64);
}

fn uir_op(addr: i64): i64 {
    return get_qword(addr, 0);
}

fn uir_src1(addr: i64): i64 {
    return get_qword(addr, 5);
}

fn uir_src2(addr: i64): i64 {
    return get_qword(addr, 6);
}

fn uir_emit(buf: i64, op: i64, type_id: i64, flags: i64, prov: i64, dst: i64, src1: i64, src2: i64, extra: i64): i64 {
    let count = get_qword(buf, 0);
    let addr = buf + 256 + (count * 64);
    set_qword(addr, 0, op);
    set_qword(addr, 1, type_id);
    set_qword(addr, 2, flags);
    set_qword(addr, 3, prov);
    set_qword(addr, 4, dst);
    set_qword(addr, 5, src1);
    set_qword(addr, 6, src2);
    set_qword(addr, 7, extra);
    set_qword(buf, 0, count + 1);
    return count;
}


# ------------------------------------------------------------------------------
# Universal Optimizations on UIR
# Hardware-independent, target-agnostic optimization passes.
# ------------------------------------------------------------------------------

fn uir_opt_const_fold(uir_buf: i64): i64 {
    let total = uir_get_count(uir_buf);
    let const_map = sys_mmap_page();
    let changed = 0;
    let i = 0;
    while i < total {
        let addr = uir_node_addr(uir_buf, i);
        let op = get_qword(addr, 0);
        let dst = get_qword(addr, 4);
        let s1 = get_qword(addr, 5);
        let s2 = get_qword(addr, 6);
        let fl = get_qword(addr, 2);

        if (op == 50) | (op == 51) | (op == 53) | (op == 54) | (op == 55) {
            let ci = 0;
            while ci < 256 {
                set_qword(const_map, ci * 2 + 0, 0);
                ci = ci + 1;
            }
        }

        if op == 1 { # CONST
            if dst < 250 {
                set_qword(const_map, dst * 2 + 0, 1);
                set_qword(const_map, dst * 2 + 1, s1);
            }
        } else {
            if (dst >= 0) & (dst < 250) {
                if (op != 50) & (op != 51) & (op != 53) & (op != 54) & (op != 55) & (op != 57) & (op != 58) {
                    set_qword(const_map, dst * 2 + 0, 0);
                }
            }
        }

        let is_bin = 0;
        if (op >= 10) & (op <= 14) { is_bin = 1; }
        if (op >= 20) & (op <= 25) { is_bin = 1; }
        if (op >= 30) & (op <= 35) { is_bin = 1; }

        if is_bin == 1 {
            let is_c1 = fl & 1;
            let val1 = s1;
            if is_c1 == 0 {
                if s1 < 250 {
                    if get_qword(const_map, s1 * 2 + 0) == 1 {
                        is_c1 = 1;
                        val1 = get_qword(const_map, s1 * 2 + 1);
                    }
                }
            }
            let is_c2 = (fl >> 1) & 1;
            let val2 = s2;
            if is_c2 == 0 {
                if s2 < 250 {
                    if get_qword(const_map, s2 * 2 + 0) == 1 {
                        is_c2 = 1;
                        val2 = get_qword(const_map, s2 * 2 + 1);
                    }
                }
            }

            if (is_c1 == 1) & (is_c2 == 1) {
                let folded = 0;
                let valid = 1;
                # Arithmetic
                if op == 10 { folded = val1 + val2; }
                if op == 11 { folded = val1 - val2; }
                if op == 12 { folded = val1 * val2; }
                if op == 13 { if val2 != 0 { folded = val1 / val2; } else { valid = 0; } }
                if op == 14 { if val2 != 0 { folded = val1 % val2; } else { valid = 0; } }
                # Bitwise
                if op == 20 { folded = val1 & val2; }
                if op == 21 { folded = val1 | val2; }
                if op == 22 { folded = val1 ^ val2; }
                if op == 24 { folded = val1 << val2; }
                if op == 25 { folded = val1 >> val2; }
                # Comparisons
                if op == 30 { if val1 == val2 { folded = 1; } else { folded = 0; } }
                if op == 31 { if val1 != val2 { folded = 1; } else { folded = 0; } }
                if op == 32 { if val1 < val2 { folded = 1; } else { folded = 0; } }
                if op == 33 { if val1 <= val2 { folded = 1; } else { folded = 0; } }
                if op == 34 { if val1 > val2 { folded = 1; } else { folded = 0; } }
                if op == 35 { if val1 >= val2 { folded = 1; } else { folded = 0; } }

                if valid == 1 {
                    set_qword(addr, 0, 1); # op = CONST
                    set_qword(addr, 2, 1); # flags = IMM1
                    set_qword(addr, 5, folded);
                    set_qword(addr, 6, 0);
                    if dst < 250 {
                        set_qword(const_map, dst * 2 + 0, 1);
                        set_qword(const_map, dst * 2 + 1, folded);
                    }
                    changed = changed + 1;
                }
            } else {
                # Algebraic identities
                let id_done = 0;
                # ADD: x + 0 -> x, 0 + x -> x
                if op == 10 {
                    if (is_c2 == 1) & (val2 == 0) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, fl & 1); set_qword(addr, 5, s1); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                    if (id_done == 0) & (is_c1 == 1) & (val1 == 0) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, (fl >> 1) & 1); set_qword(addr, 5, s2); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                }
                # SUB: x - 0 -> x, x - x -> 0
                if op == 11 {
                    if (is_c2 == 1) & (val2 == 0) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, fl & 1); set_qword(addr, 5, s1); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                    if (id_done == 0) & ((fl & 3) == 0) & (s1 == s2) {
                        set_qword(addr, 0, 1); set_qword(addr, 2, 1); set_qword(addr, 5, 0); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                }
                # MUL: x * 1 -> x, 1 * x -> x, x * 0 -> 0, 0 * x -> 0
                if op == 12 {
                    if (is_c2 == 1) & (val2 == 1) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, fl & 1); set_qword(addr, 5, s1); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                    if (id_done == 0) & (is_c1 == 1) & (val1 == 1) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, (fl >> 1) & 1); set_qword(addr, 5, s2); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                    if (id_done == 0) & (((is_c2 == 1) & (val2 == 0)) | ((is_c1 == 1) & (val1 == 0))) {
                        set_qword(addr, 0, 1); set_qword(addr, 2, 1); set_qword(addr, 5, 0); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                }
                # DIV: x / 1 -> x
                if op == 13 {
                    if (is_c2 == 1) & (val2 == 1) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, fl & 1); set_qword(addr, 5, s1); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                }
                # AND: x & 0 -> 0, 0 & x -> 0
                if op == 20 {
                    if ((is_c2 == 1) & (val2 == 0)) | ((is_c1 == 1) & (val1 == 0)) {
                        set_qword(addr, 0, 1); set_qword(addr, 2, 1); set_qword(addr, 5, 0); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                }
                # OR: x | 0 -> x, 0 | x -> x
                if op == 21 {
                    if (is_c2 == 1) & (val2 == 0) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, fl & 1); set_qword(addr, 5, s1); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                    if (id_done == 0) & (is_c1 == 1) & (val1 == 0) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, (fl >> 1) & 1); set_qword(addr, 5, s2); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                }
                # XOR: x ^ x -> 0, x ^ 0 -> x, 0 ^ x -> x
                if op == 22 {
                    if ((fl & 3) == 0) & (s1 == s2) {
                        set_qword(addr, 0, 1); set_qword(addr, 2, 1); set_qword(addr, 5, 0); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                    if (id_done == 0) & (is_c2 == 1) & (val2 == 0) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, fl & 1); set_qword(addr, 5, s1); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                    if (id_done == 0) & (is_c1 == 1) & (val1 == 0) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, (fl >> 1) & 1); set_qword(addr, 5, s2); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                }
                # SHL, SHR: x << 0 -> x, x >> 0 -> x
                if (op == 24) | (op == 25) {
                    if (is_c2 == 1) & (val2 == 0) {
                        set_qword(addr, 0, 2); set_qword(addr, 2, fl & 1); set_qword(addr, 5, s1); set_qword(addr, 6, 0);
                        changed = changed + 1; id_done = 1;
                    }
                }
            }
        }

        # Fold UIR_RETURN with constant operand: RETURN vreg -> RETURN imm
        if op == 57 { # UIR_RETURN
            let is_c = fl & 1;
            if is_c == 0 {
                if (s1 >= 0) & (s1 < 250) {
                    if get_qword(const_map, s1 * 2 + 0) == 1 {
                        let cval = get_qword(const_map, s1 * 2 + 1);
                        set_qword(addr, 2, 1); # flags = IMM1
                        set_qword(addr, 5, cval); # s1 = cval
                        changed = changed + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    return changed;
}

fn uir_opt_strength_reduce(uir_buf: i64): i64 {
    let total = uir_get_count(uir_buf);
    let changed = 0;
    let i = 0;
    while i < total {
        let addr = uir_node_addr(uir_buf, i);
        let op = get_qword(addr, 0);
        let fl = get_qword(addr, 2);
        let s2 = get_qword(addr, 6);
        let imm2 = (fl >> 1) & 1;

        if (op == 12) & (imm2 == 1) { # MUL by imm
            let shift_amt = -1;
            if s2 == 2 { shift_amt = 1; }
            if s2 == 4 { shift_amt = 2; }
            if s2 == 8 { shift_amt = 3; }
            if s2 == 16 { shift_amt = 4; }
            if s2 == 32 { shift_amt = 5; }
            if s2 == 64 { shift_amt = 6; }
            if s2 == 128 { shift_amt = 7; }
            if s2 == 256 { shift_amt = 8; }

            if shift_amt > 0 {
                # Convert MUL v, 2^k -> SHL v, k
                set_qword(addr, 0, 24); # SHL
                set_qword(addr, 6, shift_amt); # imm = shift_amt
                changed = changed + 1;
            } else {
                if s2 == 0 {
                    # Convert MUL v, 0 -> CONST 0
                    set_qword(addr, 0, 1); # CONST
                    set_qword(addr, 2, 1); # IMM1
                    set_qword(addr, 5, 0);
                    set_qword(addr, 6, 0);
                    changed = changed + 1;
                }
                if s2 == 1 {
                    # Convert MUL v, 1 -> MOVE v
                    set_qword(addr, 0, 2); # MOVE
                    set_qword(addr, 2, fl & 1);
                    set_qword(addr, 6, 0);
                    changed = changed + 1;
                }
            }
        }
        if (op == 13) & (imm2 == 1) { # DIV by imm
            if s2 == 1 {
                set_qword(addr, 0, 2); # MOVE
                set_qword(addr, 2, fl & 1);
                set_qword(addr, 6, 0);
                changed = changed + 1;
            } else {
                let k = -1;
                if s2 == 2 { k = 1; }
                if s2 == 4 { k = 2; }
                if s2 == 8 { k = 3; }
                if s2 == 16 { k = 4; }
                if s2 == 32 { k = 5; }
                if s2 == 64 { k = 6; }
                if s2 == 128 { k = 7; }
                if s2 == 256 { k = 8; }
                if s2 == 512 { k = 9; }
                if s2 == 1024 { k = 10; }
                if k > 0 {
                    set_qword(addr, 0, 25); # SHR
                    set_qword(addr, 6, k);
                    changed = changed + 1;
                }
            }
        }
        if (op == 14) & (imm2 == 1) { # MOD by imm
            if s2 == 1 {
                set_qword(addr, 0, 1); # CONST 0
                set_qword(addr, 2, 1);
                set_qword(addr, 5, 0);
                set_qword(addr, 6, 0);
                changed = changed + 1;
            } else {
                let mask = -1;
                if s2 == 2 { mask = 1; }
                if s2 == 4 { mask = 3; }
                if s2 == 8 { mask = 7; }
                if s2 == 16 { mask = 15; }
                if s2 == 32 { mask = 31; }
                if s2 == 64 { mask = 63; }
                if s2 == 128 { mask = 127; }
                if s2 == 256 { mask = 255; }
                if s2 == 512 { mask = 511; }
                if s2 == 1024 { mask = 1023; }
                if mask > 0 {
                    set_qword(addr, 0, 20); # AND
                    set_qword(addr, 6, mask);
                    changed = changed + 1;
                }
            }
        }
        i = i + 1;
    }
    return changed;
}

fn uir_opt_copy_prop(uir_buf: i64): i64 {
    let total = uir_get_count(uir_buf);
    let changed = 0;
    let i = 0;
    while i < total {
        let addr = uir_node_addr(uir_buf, i);
        let op = get_qword(addr, 0);
        let dst = get_qword(addr, 4);
        let s1 = get_qword(addr, 5);
        let fl = get_qword(addr, 2);

        if (op == 2) & ((fl & 1) == 0) { # v_dst = MOVE v_src1
            let j = i + 1;
            let stop = 0;
            while (j < total) & (stop == 0) {
                let j_addr = uir_node_addr(uir_buf, j);
                let j_op = get_qword(j_addr, 0);
                let j_dst = get_qword(j_addr, 4);
                let j_s1 = get_qword(j_addr, 5);
                let j_s2 = get_qword(j_addr, 6);
                let j_fl = get_qword(j_addr, 2);

                if (j_op == 50) | (j_op == 51) | (j_op == 53) | (j_op == 54) | (j_op == 55) | (j_op == 56) {
                    stop = 1;
                } else {
                    if (j_op != 57) & (j_op != 58) {
                        if j_dst == s1 { stop = 1; }
                        if j_dst == dst { stop = 1; }
                    }

                    if j_op != 1 {
                        if ((j_fl & 1) == 0) & (j_s1 == dst) {
                            set_qword(j_addr, 5, s1);
                            changed = changed + 1;
                        }
                        if ((j_fl & 2) == 0) & (j_s2 == dst) {
                            set_qword(j_addr, 6, s1);
                            changed = changed + 1;
                        }
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return changed;
}

fn uir_opt_dce(uir_buf: i64): i64 {
    let total = uir_get_count(uir_buf);
    let use_counts = sys_mmap_page();
    let changed = 0;
    let ni = 0;
    while ni < total {
        let fn_addr = uir_node_addr(uir_buf, ni);
        if get_qword(fn_addr, 0) == 50 { # UIR_FUNCTION_START
            let fn_start = ni;
            let fn_end = ni + 1;
            while (fn_end < total) & (get_qword(uir_node_addr(uir_buf, fn_end), 0) != 51) {
                fn_end = fn_end + 1;
            }

            # 1. Unreachable code elimination following UIR_RETURN
            let ui = fn_start;
            let in_unreach = 0;
            while ui <= fn_end {
                let uaddr = uir_node_addr(uir_buf, ui);
                let uop = get_qword(uaddr, 0);
                if uop == 57 { # UIR_RETURN
                    in_unreach = 1;
                } else {
                    if (uop == 53) | (uop == 51) { # LABEL or FUNCTION_END
                        in_unreach = 0;
                    } else {
                        if in_unreach == 1 {
                            if uop != 0 {
                                set_qword(uaddr, 0, 0); # NOP
                                changed = changed + 1;
                            }
                        }
                    }
                }
                ui = ui + 1;
            }

            # 2. Multi-round dead computation cascading
            let dce_iter = 0;
            let dce_cont = 1;
            while (dce_iter < 4) & (dce_cont == 1) {
                let dce_ch = 0;
                let c_idx = 0;
                while c_idx < 256 { set_qword(use_counts, c_idx, 0); c_idx = c_idx + 1; }

                let i = fn_start;
                while i <= fn_end {
                    let addr = uir_node_addr(uir_buf, i);
                    let op = get_qword(addr, 0);
                    let s1 = get_qword(addr, 5);
                    let s2 = get_qword(addr, 6);
                    let fl = get_qword(addr, 2);
                    let imm1 = fl & 1;
                    let imm2 = (fl >> 1) & 1;

                    if (op != 0) & (op != 1) & (op != 50) & (op != 51) & (op != 53) & (op != 54) {
                        if op == 55 {
                            if s1 < 250 { set_qword(use_counts, s1, get_qword(use_counts, s1) + 1); }
                        } else {
                            if (imm1 == 0) & (s1 >= 0) & (s1 < 250) {
                                set_qword(use_counts, s1, get_qword(use_counts, s1) + 1);
                            }
                            if (imm2 == 0) & (s2 >= 0) & (s2 < 250) {
                                set_qword(use_counts, s2, get_qword(use_counts, s2) + 1);
                            }
                        }
                    }
                    i = i + 1;
                }

                i = fn_start;
                while i <= fn_end {
                    let addr = uir_node_addr(uir_buf, i);
                    let op = get_qword(addr, 0);
                    let dst = get_qword(addr, 4);
                    let can_dce = 0;
                    if (op == 1) | (op == 2) { can_dce = 1; }
                    if (op >= 10) & (op <= 15) { can_dce = 1; }
                    if (op >= 20) & (op <= 25) { can_dce = 1; }
                    if (op >= 30) & (op <= 35) { can_dce = 1; }

                    if can_dce == 1 {
                        if dst < 250 {
                            if get_qword(use_counts, dst) == 0 {
                                set_qword(addr, 0, 0); # NOP
                                dce_ch = dce_ch + 1;
                            }
                        }
                    }
                    i = i + 1;
                }
                changed = changed + dce_ch;
                if dce_ch == 0 { dce_cont = 0; }
                dce_iter = dce_iter + 1;
            }

            ni = fn_end;
        }
        ni = ni + 1;
    }
    return changed;
}

fn uir_opt_cse(uir_buf: i64): i64 {
    let total = uir_get_count(uir_buf);
    let cse_tbl = sys_mmap_page();
    let cse_cnt = 0;
    let changed = 0;
    let i = 0;
    while i < total {
        let addr = uir_node_addr(uir_buf, i);
        let op = get_qword(addr, 0);
        let dst = get_qword(addr, 4);
        let s1 = get_qword(addr, 5);
        let s2 = get_qword(addr, 6);
        let fl = get_qword(addr, 2);

        if (op == 50) | (op == 51) | (op == 53) | (op == 54) | (op == 55) | (op == 56) {
            cse_cnt = 0;
        } else {
            let is_pure_bin = 0;
            if (op >= 10) & (op <= 14) { is_pure_bin = 1; }
            if (op >= 20) & (op <= 25) { is_pure_bin = 1; }
            if (op >= 30) & (op <= 35) { is_pure_bin = 1; }

            if is_pure_bin == 1 {
                let is_comm = 0;
                if (op == 10) | (op == 12) | (op == 20) | (op == 21) | (op == 22) | (op == 30) | (op == 31) {
                    is_comm = 1;
                }
                let norm_s1 = s1;
                let norm_s2 = s2;
                let norm_fl = fl;
                if (is_comm == 1) & ((fl & 3) == 0) & (norm_s1 > norm_s2) {
                    let tmp = norm_s1; norm_s1 = norm_s2; norm_s2 = tmp;
                }

                let match_idx = -1;
                let ci = 0;
                while ci < cse_cnt {
                    let base = ci * 5;
                    if (get_qword(cse_tbl, base + 0) == op) &
                       (get_qword(cse_tbl, base + 1) == norm_s1) &
                       (get_qword(cse_tbl, base + 2) == norm_s2) &
                       (get_qword(cse_tbl, base + 3) == norm_fl) {
                        match_idx = ci;
                        ci = cse_cnt;
                    }
                    ci = ci + 1;
                }

                if match_idx >= 0 {
                    let prev_dst = get_qword(cse_tbl, match_idx * 5 + 4);
                    set_qword(addr, 0, 2); # MOVE
                    set_qword(addr, 2, 0);
                    set_qword(addr, 5, prev_dst);
                    set_qword(addr, 6, 0);
                    changed = changed + 1;
                } else {
                    if dst >= 0 {
                        let k = 0;
                        while k < cse_cnt {
                            let kbase = k * 5;
                            let es1 = get_qword(cse_tbl, kbase + 1);
                            let es2 = get_qword(cse_tbl, kbase + 2);
                            let edst = get_qword(cse_tbl, kbase + 4);
                            let efl = get_qword(cse_tbl, kbase + 3);
                            let inv = 0;
                            if edst == dst { inv = 1; }
                            if ((efl & 1) == 0) & (es1 == dst) { inv = 1; }
                            if ((efl & 2) == 0) & (es2 == dst) { inv = 1; }
                            if inv == 1 {
                                set_qword(cse_tbl, kbase + 0, -1);
                            }
                            k = k + 1;
                        }
                    }

                    if cse_cnt < 80 {
                        let base = cse_cnt * 5;
                        set_qword(cse_tbl, base + 0, op);
                        set_qword(cse_tbl, base + 1, norm_s1);
                        set_qword(cse_tbl, base + 2, norm_s2);
                        set_qword(cse_tbl, base + 3, norm_fl);
                        set_qword(cse_tbl, base + 4, dst);
                        cse_cnt = cse_cnt + 1;
                    }
                }
            } else {
                if (op != 57) & (op != 58) & (dst >= 0) {
                    let k = 0;
                    while k < cse_cnt {
                        let kbase = k * 5;
                        let es1 = get_qword(cse_tbl, kbase + 1);
                        let es2 = get_qword(cse_tbl, kbase + 2);
                        let edst = get_qword(cse_tbl, kbase + 4);
                        let efl = get_qword(cse_tbl, kbase + 3);
                        let inv = 0;
                        if edst == dst { inv = 1; }
                        if ((efl & 1) == 0) & (es1 == dst) { inv = 1; }
                        if ((efl & 2) == 0) & (es2 == dst) { inv = 1; }
                        if inv == 1 {
                            set_qword(cse_tbl, kbase + 0, -1);
                        }
                        k = k + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    return changed;
}

fn uir_opt_branch_fold(uir_buf: i64): i64 {
    let total = uir_get_count(uir_buf);
    let const_map = sys_mmap_page();
    let changed = 0;
    let i = 0;
    while i < total {
        let addr = uir_node_addr(uir_buf, i);
        let op = get_qword(addr, 0);
        let dst = get_qword(addr, 4);
        let s1 = get_qword(addr, 5);
        let s2 = get_qword(addr, 6);
        let fl = get_qword(addr, 2);

        if (op == 50) | (op == 51) | (op == 53) | (op == 54) | (op == 55) {
            let ci = 0;
            while ci < 256 {
                set_qword(const_map, ci * 2 + 0, 0);
                ci = ci + 1;
            }
        }

        if op == 1 {
            if dst < 250 {
                set_qword(const_map, dst * 2 + 0, 1);
                set_qword(const_map, dst * 2 + 1, s1);
            }
        } else {
            if (dst >= 0) & (dst < 250) {
                if (op != 50) & (op != 51) & (op != 53) & (op != 54) & (op != 55) & (op != 57) & (op != 58) {
                    set_qword(const_map, dst * 2 + 0, 0);
                }
            }
        }

        if op == 55 {
            let is_const = fl & 1;
            let val = s1;
            if (is_const == 0) & (s1 < 250) {
                if get_qword(const_map, s1 * 2 + 0) == 1 {
                    is_const = 1;
                    val = get_qword(const_map, s1 * 2 + 1);
                }
            }
            if is_const == 1 {
                set_qword(addr, 0, 54); # UIR_JUMP
                set_qword(addr, 2, 0);
                if val != 0 {
                    set_qword(addr, 4, dst);
                } else {
                    set_qword(addr, 4, s2);
                }
                set_qword(addr, 5, 0);
                set_qword(addr, 6, 0);
                changed = changed + 1;
            } else {
                if dst == s2 {
                    set_qword(addr, 0, 54);
                    set_qword(addr, 2, 0);
                    set_qword(addr, 4, dst);
                    set_qword(addr, 5, 0);
                    set_qword(addr, 6, 0);
                    changed = changed + 1;
                }
            }
        }

        if op == 54 {
            if i + 1 < total {
                let next_addr = uir_node_addr(uir_buf, i + 1);
                if (get_qword(next_addr, 0) == 53) & (get_qword(next_addr, 4) == dst) {
                    set_qword(addr, 0, 0); # NOP
                    changed = changed + 1;
                }
            }
        }

        # Redundant self move: MOVE v, v -> NOP
        if (op == 2) & ((fl & 1) == 0) & (dst == s1) {
            set_qword(addr, 0, 0); # NOP
            changed = changed + 1;
        }

        i = i + 1;
    }
    return changed;
}

fn uir_opt_run_pipeline(uir_buf: i64): i64 {
    let total_ch = 0;
    let iter = 0;
    let keep_going = 1;
    while (iter < 5) & (keep_going == 1) {
        let ch = 0;
        ch = ch + uir_opt_copy_prop(uir_buf);
        ch = ch + uir_opt_cse(uir_buf);
        ch = ch + uir_opt_strength_reduce(uir_buf);
        ch = ch + uir_opt_const_fold(uir_buf);
        ch = ch + uir_opt_branch_fold(uir_buf);
        ch = ch + uir_opt_dce(uir_buf);
        total_ch = total_ch + ch;
        if ch == 0 {
            keep_going = 0;
        }
        iter = iter + 1;
    }
    return total_ch;
}

# ------------------------------------------------------------------------------
# UIR Verifier (Invariant & Structural Correctness Validation Pass)
# Invariants verified:
#   1. Buffer bounded: 0 <= node_count <= 32768
#   2. Well-nested functions: exactly one UIR_FUNCTION_END for each UIR_FUNCTION_START
#   3. Opcode legality: all non-zero opcodes are within defined UIR opcode range (1..60)
#   4. Parameter placement: UIR_PARAM must occur within active function scope
#   5. Terminator semantics: UIR_RETURN must occur within active function scope
# ------------------------------------------------------------------------------
fn uir_verify_program(uir_buf: i64): i64 {
    let count = get_qword(uir_buf, 0);
    if count < 0 { return -1; }
    if count > 32768 { return -2; }

    let in_func = 0;
    let i = 0;
    while i < count {
        let addr = uir_node_addr(uir_buf, i);
        let op = get_qword(addr, 0);

        if op != 0 {
            if (op < 1) | (op > 60) {
                return -20; # Illegal/corrupt opcode
            }

            if op == 50 { # UIR_FUNCTION_START
                if in_func == 1 {
                    return -10; # Nested function illegal
                }
                in_func = 1;
            }

            if op == 51 { # UIR_FUNCTION_END
                if in_func == 0 {
                    return -11; # FUNCTION_END without active FUNCTION_START
                }
                in_func = 0;
            }

            if op == 52 { # UIR_PARAM
                if in_func == 0 {
                    return -12; # Parameter outside function scope
                }
            }

            if op == 57 { # UIR_RETURN
                if in_func == 0 {
                    return -13; # Return outside function scope
                }
            }
        }
        i = i + 1;
    }

    if in_func == 1 {
        return -14; # Unclosed function at end of UIR stream
    }

    return 0;
}


# ==============================================================================
# Rubix Compiler — UIR Backend Bridge (compiler/legacy/uir_bridge.bix)
# Pure Rubix implementation lowering Universal Rubix IR (UIR) to machine code.
# Step 5 of RUMS architecture migration — now with linear-scan register allocation.
# ==============================================================================

# Note: dependencies (token, emitter, uir, regalloc) are imported centrally by main.bix

# Callee-saved physical registers available for vreg allocation (x86-64 ABI):
# rbx=3, r12=12, r13=13, r14=14, r15=15 (pool size = 5)
# These are never clobbered by the bridge's internal instruction sequences.

# Bridge-aware load: emit code that puts vreg into rax.
# If vreg has a physical register (rbx=3, r12=12, r13=13, r14=14, r15=15), emit mov rax, reg.
# Otherwise load from stack slot.
fn uir_bridge_load_vreg(buf: i64, l: i64, vreg: i64, type_id: i64, intervals: i64): i64 {
    if (vreg >= 0) & (vreg < 64) {
        let phys = get_qword(intervals + (vreg * 48), 3);
        if phys > 0 {
            if phys == 3 { # rbx: 48 8B C3
                l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 139); l = emit_byte(buf, l, 195);
                return l;
            }
            # r12..r15: 49 8B C4/C5/C6/C7
            l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 139);
            if phys == 12 { l = emit_byte(buf, l, 196); }
            if phys == 13 { l = emit_byte(buf, l, 197); }
            if phys == 14 { l = emit_byte(buf, l, 198); }
            if phys == 15 { l = emit_byte(buf, l, 199); }
            return l;
        }
    }
    return emit_load_slot_typed(buf, l, (vreg + 1) * 8, type_id);
}

# Bridge-aware store: emit code that puts rax into vreg.
# If vreg has a physical register, emit mov reg, rax. Otherwise store to stack slot.
fn uir_bridge_store_vreg(buf: i64, l: i64, vreg: i64, type_id: i64, intervals: i64): i64 {
    if (vreg >= 0) & (vreg < 64) {
        let phys = get_qword(intervals + (vreg * 48), 3);
        if phys > 0 {
            if phys == 3 { # rbx: 48 89 C3
                l = emit_byte(buf, l, 72); l = emit_byte(buf, l, 137); l = emit_byte(buf, l, 195);
                return l;
            }
            # r12..r15: 49 89 C4/C5/C6/C7
            l = emit_byte(buf, l, 73); l = emit_byte(buf, l, 137);
            if phys == 12 { l = emit_byte(buf, l, 196); }
            if phys == 13 { l = emit_byte(buf, l, 197); }
            if phys == 14 { l = emit_byte(buf, l, 198); }
            if phys == 15 { l = emit_byte(buf, l, 199); }
            return l;
        }
    }
    return emit_store_slot_typed(buf, l, (vreg + 1) * 8, type_id);
}

fn uir_bridge_load_cached(buf: i64, l: i64, vreg: i64, type_id: i64, intervals: i64, cached_vreg: i64, cached_type: i64): i64 {
    if (vreg >= 0) & (vreg == cached_vreg) & (type_id == cached_type) {
        return l;
    }
    return uir_bridge_load_vreg(buf, l, vreg, type_id, intervals);
}

# ------------------------------------------------------------------------------
# uir_bridge_compile_function_with_patches:
# Lowers a single UIR function into machine bytes in code_buf starting at start_len.
# Records function calls into prog_call_patches if provided.
# Returns new code length.
# ------------------------------------------------------------------------------
fn uir_bridge_compile_function_with_patches(uir_buf: i64, start_node: i64, end_node: i64, code_buf: i64, start_len: i64, prog_call_patches: i64): i64 {
    let l = start_len;

    # Allocate label table & patch table (scratch memory)
    let label_tbl = sys_mmap_page();
    let patch_tbl = sys_mmap_page();
    # Initialize label offsets to -1 (up to 64 labels per function)
    let li = 0;
    while li < 64 {
        set_qword(label_tbl, li, -1);
        set_qword(patch_tbl, li * 4 + 0, 0); # patch count for label li
        li = li + 1;
    }
    # Count parameters from UIR_FUNCTION_START
    let param_count = get_qword(uir_node_addr(uir_buf, start_node), 5);

    # Find active slots, calls, and max_vreg
    let max_vreg = -1;
    let max_call_args = 0;
    let live_let_count = 0;
    let ni = start_node;
    while ni < end_node {
        let n_addr = uir_node_addr(uir_buf, ni);
        let op = get_qword(n_addr, 0);
        let dst = get_qword(n_addr, 4);
        let s1 = get_qword(n_addr, 5);
        let s2 = get_qword(n_addr, 6);
        let fl = get_qword(n_addr, 2);

        if op != 0 {
            if op == 2 { # UIR_MOVE (live local variable)
                live_let_count = live_let_count + 1;
            }
            if op == UIR_CALL {
                if s2 > max_call_args { max_call_args = s2; }
                if dst > max_vreg { max_vreg = dst; }
            } else {
                if op == UIR_BRANCH {
                    if s1 > max_vreg { max_vreg = s1; }
                } else {
                    if op == 58 { # ARG
                        if (fl & 1) == 0 {
                            if s1 > max_vreg { max_vreg = s1; }
                        }
                    } else {
                        if op == UIR_RETURN {
                            if (fl & 1) == 0 {
                                if (s1 >= 0) & (s1 > max_vreg) { max_vreg = s1; }
                            }
                        } else {
                            # Skip structural ops whose dst/s1/s2 are NOT virtual registers:
                            # FUNCTION_START(50), FUNCTION_END(51), LABEL(53), JUMP(54).
                            let is_struct_op = 0;
                            if op == 50 { is_struct_op = 1; }
                            if op == 51 { is_struct_op = 1; }
                            if op == 53 { is_struct_op = 1; }
                            if op == 54 { is_struct_op = 1; }
                            if is_struct_op == 0 {
                                if dst > max_vreg { max_vreg = dst; }
                                if (fl & 1) == 0 {
                                    if (op != 1) & (s1 > max_vreg) { max_vreg = s1; }
                                }
                                if (fl & 2) == 0 {
                                    if s2 > max_vreg { max_vreg = s2; }
                                }
                            }
                        }
                    }
                }
            }
        }
        ni = ni + 1;
    }

    # -------------------------------------------------------------------------
    # Linear-scan register allocation over {rbx=3, r12=12, r13=13, r14=14, r15=15}
    # -------------------------------------------------------------------------
    let intervals = sys_mmap_page();  # 64 * 48 = 3072 bytes
    let pool_regs = sys_mmap_page();  # allocation pool: 5 callee-saved regs
    set_qword(pool_regs, 0, 3);   # rbx
    set_qword(pool_regs, 1, 12);  # r12
    set_qword(pool_regs, 2, 13);  # r13
    set_qword(pool_regs, 3, 14);  # r14
    set_qword(pool_regs, 4, 15);  # r15

    let num_vregs = max_vreg + 1;
    if num_vregs > 64 { num_vregs = 64; }
    if num_vregs > 0 {
        # Initialize intervals (up to 64 virtual registers)
        let vi = 0;
        while vi < 64 {
            let base = intervals + (vi * 48);
            set_qword(base, 0, 0);      # defined = 0
            set_qword(base, 1, 999999); # start_node
            set_qword(base, 2, -1);     # end_node
            set_qword(base, 3, -1);     # assigned_phys_reg = -1
            set_qword(base, 4, 0);      # spill_slot
            set_qword(base, 5, 0);      # spill_cost
            vi = vi + 1;
        }

        # 1. Compute liveness intervals
        let ni = start_node;
        while ni < end_node {
            let addr = uir_node_addr(uir_buf, ni);
            let op = get_qword(addr, 0);
            let dst = get_qword(addr, 4);
            let s1 = get_qword(addr, 5);
            let s2 = get_qword(addr, 6);
            let fl = get_qword(addr, 2);
            let extra = get_qword(addr, 7);
            let imm1 = fl & 1;
            let imm2 = (fl >> 1) & 1;

            let weight = 1;
            if extra == 1 { weight = 10; }
            if extra >= 2 { weight = 100; }

            if (op != 50) & (op != 51) & (op != 53) & (op != 54) & (op != 55) {
                if (dst >= 0) & (dst < 64) {
                    let base_d = intervals + (dst * 48);
                    set_qword(base_d, 0, 1);
                    if ni < get_qword(base_d, 1) { set_qword(base_d, 1, ni); }
                    if ni > get_qword(base_d, 2) { set_qword(base_d, 2, ni); }
                }
            }

            let has_s1 = 0;
            if (op == 2) | (op == 3) { has_s1 = 1; }
            if (op >= 10) & (op <= 15) { has_s1 = 1; }
            if (op >= 20) & (op <= 25) { has_s1 = 1; }
            if (op >= 30) & (op <= 35) { has_s1 = 1; }
            if (op >= 41) & (op <= 44) { has_s1 = 1; }
            if (op == 55) | (op == 57) | (op == 58) { has_s1 = 1; }

            if (has_s1 == 1) & (imm1 == 0) & (s1 >= 0) & (s1 < 64) {
                let base_s1 = intervals + (s1 * 48);
                if ni < get_qword(base_s1, 1) { set_qword(base_s1, 1, ni); }
                if ni > get_qword(base_s1, 2) { set_qword(base_s1, 2, ni); }
                set_qword(base_s1, 5, get_qword(base_s1, 5) + weight);
            }

            let has_s2 = 0;
            if (op >= 10) & (op <= 14) { has_s2 = 1; }
            if (op >= 20) & (op <= 22) { has_s2 = 1; }
            if (op == 24) | (op == 25) { has_s2 = 1; }
            if (op >= 30) & (op <= 35) { has_s2 = 1; }
            if (op == 43) | (op == 44) { has_s2 = 1; }

            if (has_s2 == 1) & (imm2 == 0) & (s2 >= 0) & (s2 < 64) {
                let base_s2 = intervals + (s2 * 48);
                if ni < get_qword(base_s2, 1) { set_qword(base_s2, 1, ni); }
                if ni > get_qword(base_s2, 2) { set_qword(base_s2, 2, ni); }
                set_qword(base_s2, 5, get_qword(base_s2, 5) + weight);
            }

            ni = ni + 1;
        }

        # 2. Pin any vreg whose address is taken by op 41 (ADDR_OF) to stack
        let chk_i = start_node;
        while chk_i < end_node {
            let chk_addr = uir_node_addr(uir_buf, chk_i);
            if get_qword(chk_addr, 0) == 41 {
                let ao_s1 = get_qword(chk_addr, 5);
                if (ao_s1 >= 0) & (ao_s1 < 64) {
                    set_qword(intervals + (ao_s1 * 48), 0, 0); # defined = 0
                }
            }
            chk_i = chk_i + 1;
        }

        # 3. Linear Scan Register Allocation
        let active = sys_mmap_page();
        let active_count = 0;
        let in_use_mask = 0;

        let vreg_i = 0;
        while vreg_i < num_vregs {
            let base_v = intervals + (vreg_i * 48);
            if get_qword(base_v, 0) == 1 {
                let start = get_qword(base_v, 1);
                let end = get_qword(base_v, 2);
                let cur_cost = get_qword(base_v, 5);

                # Expire old intervals
                let ai = 0;
                while ai < active_count {
                    let act_end = get_qword(active, ai * 3 + 1);
                    if act_end < start {
                        let freed_reg = get_qword(active, ai * 3 + 2);
                        let freed_bit = 1 << freed_reg;
                        if ((in_use_mask >> freed_reg) & 1) == 1 {
                            in_use_mask = in_use_mask - freed_bit;
                        }
                        let shift_i = ai;
                        while shift_i < (active_count - 1) {
                            set_qword(active, shift_i * 3 + 0, get_qword(active, (shift_i + 1) * 3 + 0));
                            set_qword(active, shift_i * 3 + 1, get_qword(active, (shift_i + 1) * 3 + 1));
                            set_qword(active, shift_i * 3 + 2, get_qword(active, (shift_i + 1) * 3 + 2));
                            shift_i = shift_i + 1;
                        }
                        active_count = active_count - 1;
                    } else {
                        ai = ai + 1;
                    }
                }

                # Find first free register from pool (size = 5)
                let assigned_reg = -1;
                if cur_cost >= 2 {
                    let pi = 0;
                    while (pi < 5) & (assigned_reg < 0) {
                        let cand_reg = get_qword(pool_regs, pi);
                        if ((in_use_mask >> cand_reg) & 1) == 0 {
                            assigned_reg = cand_reg;
                        }
                        pi = pi + 1;
                    }
                }

                if assigned_reg >= 0 {
                    set_qword(base_v, 3, assigned_reg);
                    in_use_mask = in_use_mask | (1 << assigned_reg);
                    set_qword(active, active_count * 3 + 0, vreg_i);
                    set_qword(active, active_count * 3 + 1, end);
                    set_qword(active, active_count * 3 + 2, assigned_reg);
                    active_count = active_count + 1;
                } else {
                    if cur_cost >= 2 {
                        # Register pressure: spill decision based on loop cost
                        let min_cost_idx = -1;
                        let min_cost_val = 999999;
                        let chk_c = 0;
                        while chk_c < active_count {
                            let act_vid = get_qword(active, chk_c * 3 + 0);
                            let act_cost = get_qword(intervals + (act_vid * 48), 5);
                            if act_cost < min_cost_val {
                                min_cost_val = act_cost;
                                min_cost_idx = chk_c;
                            }
                            chk_c = chk_c + 1;
                        }

                        if (min_cost_idx >= 0) & (cur_cost > min_cost_val) {
                            let evict_vid = get_qword(active, min_cost_idx * 3 + 0);
                            let evict_reg = get_qword(active, min_cost_idx * 3 + 2);
                            set_qword(intervals + (evict_vid * 48), 3, -1);
                            set_qword(base_v, 3, evict_reg);
                            set_qword(active, min_cost_idx * 3 + 0, vreg_i);
                            set_qword(active, min_cost_idx * 3 + 1, end);
                            set_qword(active, min_cost_idx * 3 + 2, evict_reg);
                        } else {
                            set_qword(base_v, 3, -1);
                        }
                    } else {
                        set_qword(base_v, 3, -1);
                    }
                }
            }
            vreg_i = vreg_i + 1;
        }
    }

    # Determine which callee-saved regs are actually assigned (need push/pop)
    let use_rbx = 0;
    let use_r12 = 0;
    let use_r13 = 0;
    let use_r14 = 0;
    let use_r15 = 0;
    let num_callee = 0;
    if num_vregs > 0 {
        let vi = 0;
        while vi < num_vregs {
            let phys = get_qword(intervals + (vi * 48), 3);
            if phys == 3 { use_rbx = 1; }
            if phys == 12 { use_r12 = 1; }
            if phys == 13 { use_r13 = 1; }
            if phys == 14 { use_r14 = 1; }
            if phys == 15 { use_r15 = 1; }
            vi = vi + 1;
        }
        num_callee = use_rbx + use_r12 + use_r13 + use_r14 + use_r15;
    }

    let frame_bytes = 0;
    if max_vreg >= 0 {
        frame_bytes = (max_vreg + 2 + max_call_args) * 8;
    }
    let frame_size = 0;
    if frame_bytes > 0 {
        frame_size = ((frame_bytes + 15) / 16) * 16;
        if (num_callee % 2) == 1 {
            frame_size = frame_size + 8;
        }
    } else {
        if (num_callee % 2) == 1 {
            frame_size = 8;
        }
    }

    # Prologue: push callee-saved regs FIRST (in allocation order), then rbp frame setup
    # Must mirror epilogue order (pop in reverse).
    if use_rbx == 1 { l = emit_byte(code_buf, l, 83); }
    if use_r12 == 1 { l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 84); }
    if use_r13 == 1 { l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 85); }
    if use_r14 == 1 { l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 86); }
    if use_r15 == 1 { l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 87); }
    l = emit_byte(code_buf, l, 85);
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 229);
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 129); l = emit_byte(code_buf, l, 236);
    l = emit_disp32(code_buf, l, frame_size);

    # Epilogue patch list
    let epilogue_patch_count = 0;
    let epilogue_patches = sys_mmap_page();

    let fused_cmp_jcc = -1;
    let cached_rax_vreg = -1;
    let cached_rax_type = -1;

    # Lower each UIR instruction
    let idx = start_node;
    while idx < end_node {
        let addr = uir_node_addr(uir_buf, idx);
        let op = get_qword(addr, 0);
        let type_id = get_qword(addr, 1);
        let fl = get_qword(addr, 2);
        let dst = get_qword(addr, 4);
        let s1 = get_qword(addr, 5);
        let s2 = get_qword(addr, 6);
        let extra = get_qword(addr, 7);
        let imm1 = fl & 1;
        let imm2 = (fl >> 1) & 1;

        if op != 55 {
            fused_cmp_jcc = -1;
        }

        if op == 52 {
            cached_rax_vreg = -1;
            cached_rax_type = -1;
            # dst = vreg, s1 = param index (0, 1, 2, ...)
            let p_slot = (dst + 1) * 8;
            if s1 < 6 {
                l = emit_store_param_typed(code_buf, l, s1, p_slot, type_id);
                let phys_d = -1;
                if (dst >= 0) & (dst < 64) {
                    phys_d = get_qword(intervals + (dst * 48), 3);
                }
                if phys_d > 0 {
                    l = emit_load_slot_typed(code_buf, l, p_slot, type_id);
                    l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
                }
            } else {
                let src_disp = 16 + (num_callee * 8) + ((s1 - 6) * 8);
                l = emit_byte(code_buf, l, 72);
                l = emit_byte(code_buf, l, 139);
                if src_disp <= 127 {
                    l = emit_byte(code_buf, l, 69);
                    l = emit_byte(code_buf, l, src_disp);
                } else {
                    l = emit_byte(code_buf, l, 133);
                    l = emit_disp32(code_buf, l, src_disp);
                }
                l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            }
        }

        if op == UIR_CONST {
            l = emit_mov_imm64(code_buf, l, 0, s1);
            l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = type_id;
        }

        if op == UIR_MOVE {
            l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type);
            l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = type_id;
        }

        if op == 3 {
            l = uir_bridge_load_cached(code_buf, l, s1, extra, intervals, cached_rax_vreg, cached_rax_type);
            l = emit_cast(code_buf, l, extra, type_id);
            l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = type_id;
        }

        # Binary Arithmetic & Bitwise Operations
        let is_bin_op = 0;
        let tok_op = 0;
        if op == UIR_ADD { is_bin_op = 1; tok_op = TOKEN_PLUS; }
        if op == UIR_SUB { is_bin_op = 1; tok_op = TOKEN_MINUS; }
        if op == 20 { is_bin_op = 1; tok_op = TOKEN_AMP; }
        if op == 21  { is_bin_op = 1; tok_op = TOKEN_PIPE; }
        if op == 22 { is_bin_op = 1; tok_op = TOKEN_CARET; }
        if op == 24 { is_bin_op = 1; tok_op = TOKEN_SHL; }
        if op == 25 { is_bin_op = 1; tok_op = TOKEN_SHR; }

        if is_bin_op == 1 {
            if imm2 == 1 {
                l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type);
                l = emit_bin_op_imm64(code_buf, l, tok_op, s2, type_id);
            } else {
                l = uir_bridge_load_cached(code_buf, l, s2, type_id, intervals, cached_rax_vreg, cached_rax_type); # rax = s2
                l = emit_mov_rcx_rax(code_buf, l);                             # rcx = s2
                l = uir_bridge_load_vreg(code_buf, l, s1, type_id, intervals); # rax = s1
                l = emit_bin_op_typed(code_buf, l, tok_op, type_id);           # op rax, rcx
            }
            l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = type_id;
        }

        if op == UIR_MUL {
            if imm2 == 1 {
                l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type);
                let mul_l = emit_mul_by_const(code_buf, l, s2);
                if mul_l >= 0 {
                    l = mul_l;
                } else {
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 105); l = emit_byte(code_buf, l, 192);
                    l = emit_disp32(code_buf, l, s2);
                }
            } else {
                l = uir_bridge_load_cached(code_buf, l, s2, type_id, intervals, cached_rax_vreg, cached_rax_type);
                l = emit_mov_rcx_rax(code_buf, l); # rcx = s2
                l = uir_bridge_load_vreg(code_buf, l, s1, type_id, intervals); # rax = s1
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 233); # imul rcx
            }
            l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = type_id;
        }

        if op == UIR_DIV {
            let did_fast_div = 0;
            if imm2 == 1 {
                l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type);
                let div_l = emit_div_by_const(code_buf, l, s2);
                if div_l >= 0 {
                    l = div_l;
                    did_fast_div = 1;
                }
            }
            if did_fast_div == 0 {
                if imm2 == 1 {
                    l = emit_mov_imm64(code_buf, l, 1, s2); # rcx = s2
                    l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type); # rax = s1
                } else {
                    l = uir_bridge_load_cached(code_buf, l, s2, type_id, intervals, cached_rax_vreg, cached_rax_type);
                    l = emit_mov_rcx_rax(code_buf, l); # rcx = s2
                    l = uir_bridge_load_vreg(code_buf, l, s1, type_id, intervals); # rax = s1
                }
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 153); # cqo
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 249); # idiv rcx
            }
            l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = type_id;
        }

        if op == 14 { # UIR_MOD
            let did_fast_mod = 0;
            if imm2 == 1 {
                l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type);
                let mod_l = emit_mod_by_const(code_buf, l, s2);
                if mod_l >= 0 {
                    l = mod_l;
                    did_fast_mod = 1;
                }
            }
            if did_fast_mod == 0 {
                if imm2 == 1 {
                    l = emit_mov_imm64(code_buf, l, 1, s2); # rcx = s2
                    l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type); # rax = s1
                } else {
                    l = uir_bridge_load_cached(code_buf, l, s2, type_id, intervals, cached_rax_vreg, cached_rax_type);
                    l = emit_mov_rcx_rax(code_buf, l); # rcx = s2
                    l = uir_bridge_load_vreg(code_buf, l, s1, type_id, intervals); # rax = s1
                }
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 153); # cqo
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 249); # idiv rcx
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 208); # mov rax, rdx
            }
            l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = type_id;
        }

        if op == 15 {
            l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 216); # neg rax
            l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = type_id;
        }

        if op == 23 {
            l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type);
            l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 247); l = emit_byte(code_buf, l, 208); # not rax
            l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = type_id;
        }

        # Comparisons (producing boolean in dst: 1 or 0)
        let is_cmp = 0;
        let setcc_byte = 0;
        if op == 30 { is_cmp = 1; setcc_byte = 148; } # sete (0F 94)
        if op == 31 { is_cmp = 1; setcc_byte = 149; } # setne (0F 95)
        if op == 32 { is_cmp = 1; setcc_byte = 156; } # setl (0F 9C)
        if op == 33 { is_cmp = 1; setcc_byte = 158; } # setle (0F 9E)
        if op == 34 { is_cmp = 1; setcc_byte = 159; } # setg (0F 9F)
        if op == 35 { is_cmp = 1; setcc_byte = 157; } # setge (0F 9D)

        if is_cmp == 1 {
            let fold_branch = 0;
            if idx + 1 < end_node {
                let next_addr = uir_node_addr(uir_buf, idx + 1);
                if (get_qword(next_addr, 0) == 55) & (get_qword(next_addr, 5) == dst) {
                    if (dst >= 0) & (dst < 64) {
                        if get_qword(intervals + (dst * 48), 2) == idx + 1 {
                            fold_branch = 1;
                        }
                    }
                }
            }

            if imm2 == 1 {
                l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 61);
                l = emit_disp32(code_buf, l, s2);
            } else {
                l = uir_bridge_load_cached(code_buf, l, s2, type_id, intervals, cached_rax_vreg, cached_rax_type); # rax = s2
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 193); # mov rcx, rax
                l = uir_bridge_load_vreg(code_buf, l, s1, type_id, intervals); # rax = s1
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 57); l = emit_byte(code_buf, l, 200); # cmp rax, rcx
            }

            if fold_branch == 1 {
                # JCC_FROM_SETCC_OFFSET (16) maps x86 SETcc (0x90..0x9F) to Jcc (0x80..0x8F)
                fused_cmp_jcc = setcc_byte - JCC_FROM_SETCC_OFFSET;
                cached_rax_vreg = -1;
                cached_rax_type = -1;
            } else {
                l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, setcc_byte); l = emit_byte(code_buf, l, 192);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 182); l = emit_byte(code_buf, l, 192);
                l = uir_bridge_store_vreg(code_buf, l, dst, TYPE_BOOL, intervals);
                cached_rax_vreg = dst;
                cached_rax_type = TYPE_BOOL;
            }
        }

        # Memory Operations
        if op == 41 {
            let slot_s1 = (s1 + 1) * 8;
            l = emit_lea_slot(code_buf, l, slot_s1);
            l = uir_bridge_store_vreg(code_buf, l, dst, TYPE_PTR, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = TYPE_PTR;
        }

        if op == UIR_LOAD {
            l = uir_bridge_load_cached(code_buf, l, s1, TYPE_PTR, intervals, cached_rax_vreg, cached_rax_type);
            l = emit_field_load_typed(code_buf, l, extra, type_id);
            l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
            cached_rax_vreg = dst;
            cached_rax_type = type_id;
        }

        if op == UIR_STORE {
            l = uir_bridge_load_cached(code_buf, l, s1, TYPE_PTR, intervals, cached_rax_vreg, cached_rax_type);
            l = emit_mov_rcx_rax(code_buf, l);
            if imm2 == 1 {
                l = emit_mov_imm64(code_buf, l, 0, s2);
            } else {
                l = uir_bridge_load_vreg(code_buf, l, s2, type_id, intervals);
            }
            l = emit_field_store_typed(code_buf, l, extra, type_id);
            cached_rax_vreg = -1;
            cached_rax_type = -1;
        }

        # Function Call Argument & Call Invocation
        if op == 58 {
            let arg_idx = dst;
            let call_slot = (max_vreg + 2 + arg_idx) * 8;
            if imm1 == 1 {
                l = emit_mov_imm64(code_buf, l, 0, s1);
            } else {
                l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type);
            }
            l = emit_store_slot_typed(code_buf, l, call_slot, type_id);
            cached_rax_vreg = -1;
            cached_rax_type = -1;
        }

        if op == UIR_CALL {
            let arg_cnt = s2;
            let ai = 0;
            while ai < arg_cnt {
                let call_slot = (max_vreg + 2 + ai) * 8;
                if ai == 0 {
                    l = emit_load_slot_typed(code_buf, l, call_slot, TYPE_I64);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 199); # mov rdi, rax
                }
                if ai == 1 {
                    l = emit_load_slot_typed(code_buf, l, call_slot, TYPE_I64);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 198); # mov rsi, rax
                }
                if ai == 2 {
                    l = emit_load_slot_typed(code_buf, l, call_slot, TYPE_I64);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 194); # mov rdx, rax
                }
                if ai == 3 {
                    l = emit_load_slot_typed(code_buf, l, call_slot, TYPE_I64);
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 193); # mov rcx, rax
                }
                if ai == 4 {
                    l = emit_load_slot_typed(code_buf, l, call_slot, TYPE_I64);
                    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 192); # mov r8, rax
                }
                if ai == 5 {
                    l = emit_load_slot_typed(code_buf, l, call_slot, TYPE_I64);
                    l = emit_byte(code_buf, l, 73); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 193); # mov r9, rax
                }
                ai = ai + 1;
            }
            let num_stack = 0;
            let alloc_bytes = 0;
            if arg_cnt > 6 {
                num_stack = arg_cnt - 6;
                let alloc_slots = num_stack;
                if (num_stack % 2) == 1 {
                    alloc_slots = num_stack + 1;
                }
                alloc_bytes = alloc_slots * 8;
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 129); l = emit_byte(code_buf, l, 236);
                l = emit_disp32(code_buf, l, alloc_bytes);

                let si = 0;
                while si < num_stack {
                    let cslot = (max_vreg + 2 + 6 + si) * 8;
                    l = emit_load_slot_typed(code_buf, l, cslot, TYPE_I64);
                    let ddisp = si * 8;
                    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137);
                    if ddisp == 0 {
                        l = emit_byte(code_buf, l, 4); l = emit_byte(code_buf, l, 36);
                    } else {
                        if ddisp <= 127 {
                            l = emit_byte(code_buf, l, 68); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, ddisp);
                        } else {
                            l = emit_byte(code_buf, l, 132); l = emit_byte(code_buf, l, 36); l = emit_disp32(code_buf, l, ddisp);
                        }
                    }
                    si = si + 1;
                }
            }
            let target_fn_hash = s1;
            let call_patch = l + 1;
            l = emit_call_rel32(code_buf, l, 0);
            if alloc_bytes > 0 {
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 129); l = emit_byte(code_buf, l, 196);
                l = emit_disp32(code_buf, l, alloc_bytes);
            }
            if prog_call_patches > 0 {
                let cp_count = get_qword(prog_call_patches, 0);
                set_qword(prog_call_patches, 1 + cp_count * 2 + 0, target_fn_hash);
                set_qword(prog_call_patches, 1 + cp_count * 2 + 1, call_patch);
                set_qword(prog_call_patches, 0, cp_count + 1);
            }
            if dst >= 0 {
                l = uir_bridge_store_vreg(code_buf, l, dst, type_id, intervals);
                cached_rax_vreg = dst;
                cached_rax_type = type_id;
            } else {
                cached_rax_vreg = -1;
                cached_rax_type = -1;
            }
        }

        # Control Flow
        if op == UIR_LABEL {
            cached_rax_vreg = -1;
            cached_rax_type = -1;
            let lbl = dst;
            set_qword(label_tbl, lbl, l);
            let p_count = get_qword(patch_tbl, lbl * 4 + 0);
            let pi = 0;
            while pi < p_count {
                let p_pos = get_qword(patch_tbl, lbl * 4 + 1 + pi);
                emit_backpatch32(code_buf, p_pos, l);
                pi = pi + 1;
            }
        }

        if op == UIR_JUMP {
            cached_rax_vreg = -1;
            cached_rax_type = -1;
            let lbl = dst;
            let target = get_qword(label_tbl, lbl);
            if target >= 0 {
                let disp = target - (l + 5);
                l = emit_jmp_rel32(code_buf, l, disp);
            } else {
                let p_pos = l + 1;
                l = emit_jmp_rel32(code_buf, l, 0);
                let p_count = get_qword(patch_tbl, lbl * 4 + 0);
                if p_count < 3 {
                    set_qword(patch_tbl, lbl * 4 + 1 + p_count, p_pos);
                    set_qword(patch_tbl, lbl * 4 + 0, p_count + 1);
                }
            }
        }

        if op == UIR_BRANCH {
            let jcc_code = 133;
            if fused_cmp_jcc >= 0 {
                jcc_code = fused_cmp_jcc;
                fused_cmp_jcc = -1;
            } else {
                l = uir_bridge_load_cached(code_buf, l, s1, TYPE_BOOL, intervals, cached_rax_vreg, cached_rax_type);
                l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 133); l = emit_byte(code_buf, l, 192); # test rax, rax
            }
            cached_rax_vreg = -1;
            cached_rax_type = -1;

            let lbl_t = dst;
            let target_t = get_qword(label_tbl, lbl_t);
            if target_t >= 0 {
                let disp_t = target_t - (l + 6);
                l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, jcc_code);
                l = emit_disp32(code_buf, l, disp_t);
            } else {
                let p_pos_t = l + 2;
                l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, jcc_code);
                l = emit_disp32(code_buf, l, 0);
                let p_cnt_t = get_qword(patch_tbl, lbl_t * 4 + 0);
                if p_cnt_t < 3 {
                    set_qword(patch_tbl, lbl_t * 4 + 1 + p_cnt_t, p_pos_t);
                    set_qword(patch_tbl, lbl_t * 4 + 0, p_cnt_t + 1);
                }
            }

            let lbl_f = s2;
            let target_f = get_qword(label_tbl, lbl_f);
            if target_f >= 0 {
                let disp_f = target_f - (l + 5);
                l = emit_jmp_rel32(code_buf, l, disp_f);
            } else {
                let p_pos_f = l + 1;
                l = emit_jmp_rel32(code_buf, l, 0);
                let p_cnt_f = get_qword(patch_tbl, lbl_f * 4 + 0);
                if p_cnt_f < 3 {
                    set_qword(patch_tbl, lbl_f * 4 + 1 + p_cnt_f, p_pos_f);
                    set_qword(patch_tbl, lbl_f * 4 + 0, p_cnt_f + 1);
                }
            }
        }

        if op == UIR_RETURN {
            if s1 >= 0 {
                if imm1 == 1 {
                    l = emit_mov_imm64(code_buf, l, 0, s1);
                } else {
                    l = uir_bridge_load_cached(code_buf, l, s1, type_id, intervals, cached_rax_vreg, cached_rax_type);
                }
            }
            cached_rax_vreg = -1;
            cached_rax_type = -1;
            let patch_pos = l + 1;
            l = emit_jmp_rel32(code_buf, l, 0);
            set_qword(epilogue_patches, epilogue_patch_count, patch_pos);
            epilogue_patch_count = epilogue_patch_count + 1;
        }

        idx = idx + 1;
    }

    # Epilogue position
    let epilogue_pos = l;
    let pi = 0;
    while pi < epilogue_patch_count {
        let p_pos = get_qword(epilogue_patches, pi);
        emit_backpatch32(code_buf, p_pos, epilogue_pos);
        pi = pi + 1;
    }

    # Epilogue: mov rsp, rbp; pop rbp; pop callee-saved (reverse order); ret
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 236);
    l = emit_byte(code_buf, l, 93);
    if use_r15 == 1 { l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 95); }
    if use_r14 == 1 { l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 94); }
    if use_r13 == 1 { l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 93); }
    if use_r12 == 1 { l = emit_byte(code_buf, l, 65); l = emit_byte(code_buf, l, 92); }
    if use_rbx == 1 { l = emit_byte(code_buf, l, 91); }
    l = emit_byte(code_buf, l, 195);

    return l;
}


# ------------------------------------------------------------------------------
# uir_bridge_compile_program:
# Compiles a complete multi-function UIR program into native machine bytes.
# Sets up entrypoint jump, Linux _start stub, compiles all functions, and backpatches calls.
# ------------------------------------------------------------------------------
fn uir_bridge_compile_program(uir_buf: i64, code_buf: i64): i64 {
    let l = 0;

    # 1. Emit top-level entry jump: jmp main (E9 00 00 00 00)
    let main_entry_patch = l + 1;
    l = emit_jmp_rel32(code_buf, l, 0);

    # 2. Emit _start (native Linux process startup at offset 5):
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 49); l = emit_byte(code_buf, l, 237); # xor rbp, rbp
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 139); l = emit_byte(code_buf, l, 60); l = emit_byte(code_buf, l, 36); # mov rdi, [rsp]
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 141); l = emit_byte(code_buf, l, 116); l = emit_byte(code_buf, l, 36); l = emit_byte(code_buf, l, 8); # lea rsi, [rsp+8]
    let start_call_patch = l + 1;
    l = emit_byte(code_buf, l, 232); l = emit_disp32(code_buf, l, 0); # call main
    l = emit_byte(code_buf, l, 72); l = emit_byte(code_buf, l, 137); l = emit_byte(code_buf, l, 199); # mov rdi, rax
    l = emit_byte(code_buf, l, 184); l = emit_disp32(code_buf, l, 60); # mov eax, 60 (sys_exit)
    l = emit_byte(code_buf, l, 15); l = emit_byte(code_buf, l, 5); # syscall

    # Function table & call patch table
    let func_tbl = sys_mmap_page(); # [fn_hash, offset]
    let func_count = 0;
    let call_patches = sys_mmap_page(); # [fn_hash, patch_pos]
    set_qword(call_patches, 0, 0); # count = 0

    # Scan and compile each function
    let total_nodes = uir_get_count(uir_buf);
    let ni = 0;
    while ni < total_nodes {
        let n_addr = uir_node_addr(uir_buf, ni);
        if get_qword(n_addr, 0) == UIR_FUNCTION_START {
            let fn_hash = get_qword(n_addr, 4);
            let fn_start_node = ni;
            let fn_end_node = ni + 1;
            let searching = 1;
            while (fn_end_node < total_nodes) & (searching == 1) {
                let check_addr = uir_node_addr(uir_buf, fn_end_node);
                if get_qword(check_addr, 0) == UIR_FUNCTION_END {
                    searching = 0;
                } else {
                    fn_end_node = fn_end_node + 1;
                }
            }

            set_qword(func_tbl, func_count * 2 + 0, fn_hash);
            set_qword(func_tbl, func_count * 2 + 1, l);
            func_count = func_count + 1;

            l = uir_bridge_compile_function_with_patches(uir_buf, fn_start_node, fn_end_node, code_buf, l, call_patches);
            ni = fn_end_node;
        }
        ni = ni + 1;
    }

    # Find main function offset (hash for 'main' = 6385467242)
    let main_hash = 6385467242;
    let main_offset = -1;
    let fi = 0;
    while fi < func_count {
        if get_qword(func_tbl, fi * 2 + 0) == main_hash {
            main_offset = get_qword(func_tbl, fi * 2 + 1);
        }
        fi = fi + 1;
    }
    if main_offset >= 0 {
        emit_backpatch32(code_buf, main_entry_patch, main_offset);
        emit_backpatch32(code_buf, start_call_patch, main_offset);
    } else {
        return -1;
    }

    # Backpatch all user function calls
    let total_calls = get_qword(call_patches, 0);
    let ci = 0;
    while ci < total_calls {
        let target_hash = get_qword(call_patches, 1 + ci * 2 + 0);
        let patch_pos = get_qword(call_patches, 1 + ci * 2 + 1);
        let target_offset = -1;
        fi = 0;
        while fi < func_count {
            if get_qword(func_tbl, fi * 2 + 0) == target_hash {
                target_offset = get_qword(func_tbl, fi * 2 + 1);
            }
            fi = fi + 1;
        }
        if target_offset >= 0 {
            emit_backpatch32(code_buf, patch_pos, target_offset);
        } else {
            return -1;
        }
        ci = ci + 1;
    }

    return l;
}
# ==============================================================================
# Rubix Compiler — Universal IR Frontend Parser (compiler/frontend/uir_frontend.bix)
# Pure Rubix parser compiling Rubix source directly into Universal IR (UIR).
# Core driver of the Universal RUMS compilation architecture.
# ==============================================================================

fn uf_advance(s: i64): i64 {
    let p = get_qword(s, 2);
    let len = get_qword(s, 1);
    let src = get_qword(s, 0);
    let next_p = scan_token(src, p, len, s + 64);
    set_qword(s, 2, next_p);
    return get_qword(s + 64, 0);
}

fn uf_var_lookup(s: i64, name_hash: i64, is_add: i64, val: i64): i64 {
    let count = get_qword(s, 7);
    if is_add == 1 {
        set_qword(s + 128, count * 2, name_hash);
        set_qword(s + 128, count * 2 + 1, val);
        set_qword(s, 7, count + 1);
        return val;
    }
    let i = 0;
    while i < count {
        if get_qword(s + 128, i * 2) == name_hash {
            return get_qword(s + 128, i * 2 + 1);
        }
        i = i + 1;
    }
    return -1;
}

fn uf_enum_add(s: i64, e_hash: i64): i64 {
    let eb = get_qword(s, 401);
    if eb == 0 { return -1; }
    let count = get_qword(eb, 0);
    if count >= 16 { return -1; }
    let base = eb + 16 + (count * 24);
    let tot_v = get_qword(eb, 1);
    set_qword(base, 0, e_hash);
    set_qword(base, 1, tot_v); # start_v_idx
    set_qword(base, 2, 0);     # v_count
    set_qword(eb, 0, count + 1);
    return count;
}

fn uf_enum_find(s: i64, e_hash: i64): i64 {
    let eb = get_qword(s, 401);
    if eb == 0 { return -1; }
    let count = get_qword(eb, 0);
    let i = 0;
    while i < count {
        let base = eb + 16 + (i * 24);
        if get_qword(base, 0) == e_hash {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn uf_enum_add_variant(s: i64, enum_id: i64, v_hash: i64, disc_val: i64): i64 {
    let eb = get_qword(s, 401);
    if eb == 0 { return -1; }
    let tot_v = get_qword(eb, 1);
    if tot_v >= 120 { return -1; }
    let v_base = eb + 512 + (tot_v * 24);
    set_qword(v_base, 0, v_hash);
    set_qword(v_base, 1, disc_val);
    set_qword(v_base, 2, enum_id);
    set_qword(eb, 1, tot_v + 1);
    if enum_id >= 0 {
        let e_base = eb + 16 + (enum_id * 24);
        let vc = get_qword(e_base, 2);
        set_qword(e_base, 2, vc + 1);
    }
    return tot_v;
}

fn uf_enum_find_variant(s: i64, enum_id: i64, v_hash: i64): i64 {
    let eb = get_qword(s, 401);
    if eb == 0 { return -999999999; }
    if enum_id < 0 { return -999999999; }
    let e_base = eb + 16 + (enum_id * 24);
    let start_idx = get_qword(e_base, 1);
    let vc = get_qword(e_base, 2);
    let i = 0;
    while i < vc {
        let v_base = eb + 512 + ((start_idx + i) * 24);
        if get_qword(v_base, 0) == v_hash {
            return get_qword(v_base, 1);
        }
        i = i + 1;
    }
    return -999999999;
}

fn uf_enum_find_unscoped(s: i64, v_hash: i64): i64 {
    let eb = get_qword(s, 401);
    if eb == 0 { return -999999999; }
    let tot_v = get_qword(eb, 1);
    let i = 0;
    while i < tot_v {
        let v_base = eb + 512 + (i * 24);
        if get_qword(v_base, 0) == v_hash {
            return get_qword(v_base, 1);
        }
        i = i + 1;
    }
    return -999999999;
}

fn uf_parse_type(s: i64): i64 {
    let tk = get_qword(s + 64, 0);
    if (tk == TOKEN_AMP) | (tk == TOKEN_STAR) {
        uf_advance(s);
        tk = get_qword(s + 64, 0);
    }
    if tk == TOKEN_LPAREN {
        uf_advance(s);
        let depth = 1;
        while (depth > 0) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
            let cur_k = get_qword(s + 64, 0);
            if cur_k == TOKEN_LPAREN { depth = depth + 1; }
            if cur_k == TOKEN_RPAREN { depth = depth - 1; }
            uf_advance(s);
        }
        return 0;
    }
    if tk == TOKEN_LBRACKET {
        uf_advance(s);
        let bdepth = 1;
        while (bdepth > 0) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
            let bk = get_qword(s + 64, 0);
            if bk == TOKEN_LBRACKET { bdepth = bdepth + 1; }
            if bk == TOKEN_RBRACKET { bdepth = bdepth - 1; }
            uf_advance(s);
        }
        return 0;
    }
    if (tk == TOKEN_TYPE_I64) | ((tk >= 35) & (tk <= 39)) | (tk == 46) {
        uf_advance(s);
        return 0;
    }
    if tk == TOKEN_IDENT {
        uf_advance(s);
        if get_qword(s + 64, 0) == TOKEN_LBRACKET {
            uf_advance(s);
            let bdepth = 1;
            while (bdepth > 0) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
                let bk = get_qword(s + 64, 0);
                if bk == TOKEN_LBRACKET { bdepth = bdepth + 1; }
                if bk == TOKEN_RBRACKET { bdepth = bdepth - 1; }
                uf_advance(s);
            }
        }
        return 0;
    }
    set_qword(s, 273, -1);
    return -1;
}

fn uf_parse_tuple_literal(s: i64, first_elem: i64): i64 {
    let uir_buf = get_qword(s, 3);
    let tup_elems = sys_mmap_page();
    set_qword(tup_elems, 0, first_elem);
    let elem_cnt = 1;

    while (get_qword(s + 64, 0) == TOKEN_COMMA) & (get_qword(s, 273) == 0) {
        uf_advance(s); # consume ','
        if get_qword(s + 64, 0) == TOKEN_RPAREN {
            # Trailing comma, e.g. (e0,) or (e0, e1,)
        } else {
            let next_elem = uf_parse_expr(s, 1);
            if next_elem < 0 {
                set_qword(s, 273, -1);
                return -1;
            }
            set_qword(tup_elems, elem_cnt, next_elem);
            elem_cnt = elem_cnt + 1;
        }
    }

    if get_qword(s + 64, 0) == TOKEN_RPAREN {
        uf_advance(s); # consume ')'
    } else {
        set_qword(s, 273, -1);
        return -1;
    }

    let cur_v = get_qword(s, 4);
    let base_slot = cur_v + elem_cnt - 1;
    set_qword(s, 4, cur_v + elem_cnt);

    uir_emit(uir_buf, 40, TYPE_I64, 0, 0, 0, elem_cnt * 8, 0, 0); # ALLOC_STACK

    let tup_ptr = get_qword(s, 4);
    set_qword(s, 4, tup_ptr + 1);
    uir_emit(uir_buf, 41, TYPE_PTR, 1, 0, tup_ptr, base_slot, 0, 0); # ADDR_OF

    let ei = 0;
    while ei < elem_cnt {
        let ev = get_qword(tup_elems, ei);
        uir_emit(uir_buf, 43, TYPE_I64, 0, 0, 0, tup_ptr, ev, ei * 8); # UIR_STORE
        ei = ei + 1;
    }

    return tup_ptr;
}

fn uf_parse_expr(s: i64, min_prec: i64): i64 {
    let uir_buf = get_qword(s, 3);
    let k = get_qword(s + 64, 0);
    let left = -1;

    # Unary minus: 0 - rhs
    if k == TOKEN_MINUS {
        uf_advance(s);
        let rhs = uf_parse_expr(s, 8);
        if rhs < 0 {
            set_qword(s, 273, -1);
            return -1;
        }
        let z_v = get_qword(s, 4); set_qword(s, 4, z_v + 1);
        uir_emit(uir_buf, UIR_CONST, TYPE_I64, 1, 0, z_v, 0, 0, 0);
        let neg_v = get_qword(s, 4); set_qword(s, 4, neg_v + 1);
        uir_emit(uir_buf, UIR_SUB, TYPE_I64, 0, 0, neg_v, z_v, rhs, 0);
        left = neg_v;
    } else {
        # Unary bitwise NOT (~): rhs ^ -1
        if k == TOKEN_TILDE {
            uf_advance(s);
            let rhs = uf_parse_expr(s, 8);
            if rhs < 0 {
                set_qword(s, 273, -1);
                return -1;
            }
            let m1_v = get_qword(s, 4); set_qword(s, 4, m1_v + 1);
            uir_emit(uir_buf, UIR_CONST, TYPE_I64, 1, 0, m1_v, -1, 0, 0);
            let not_v = get_qword(s, 4); set_qword(s, 4, not_v + 1);
            uir_emit(uir_buf, 22, TYPE_I64, 0, 0, not_v, rhs, m1_v, 0); # XOR
            left = not_v;
        } else {
            # Primary expression: integer, float, string, char, or bool literal
            if (k == TOKEN_INT_LIT) | (k == TOKEN_FLOAT_LIT) | (k == TOKEN_STR_LIT) | (k == TOKEN_CHAR_LIT) | (k == 40) | (k == 41) {
                let val = get_qword(s + 64, 1);
                let lit_t = TYPE_I64;
                if k == TOKEN_FLOAT_LIT { lit_t = TYPE_F64; }
                if k == TOKEN_STR_LIT {
                    lit_t = TYPE_STR;
                    val = get_qword(s + 64, 2); # string offset
                }
                if k == TOKEN_CHAR_LIT { lit_t = TYPE_U8; }
                if k == 40 { val = 1; } # true
                if k == 41 { val = 0; } # false
                uf_advance(s);
                let v = get_qword(s, 4);
                set_qword(s, 4, v + 1);
                uir_emit(uir_buf, UIR_CONST, lit_t, 1, 0, v, val, 0, 0);
                left = v;
            } else {
                if k == TOKEN_IDENT {
                    let src = get_qword(s, 0);
                    let off = get_qword(s + 64, 2);
                    let tlen = get_qword(s + 64, 3);
                    let h = hash_token(src, off, tlen);
                    uf_advance(s);
                    if get_qword(s + 64, 0) == TOKEN_DOT {
                        let enum_id = uf_enum_find(s, h);
                        if enum_id >= 0 {
                            uf_advance(s); # skip '.'
                            if get_qword(s + 64, 0) == TOKEN_IDENT {
                                let v_off = get_qword(s + 64, 2);
                                let v_len = get_qword(s + 64, 3);
                                let v_hash = hash_token(src, v_off, v_len);
                                uf_advance(s); # skip variant
                                let cval = uf_enum_find_variant(s, enum_id, v_hash);
                                if cval != -999999999 {
                                    let v = get_qword(s, 4);
                                    set_qword(s, 4, v + 1);
                                    uir_emit(uir_buf, UIR_CONST, TYPE_I64, 1, 0, v, cval, 0, 0);
                                    left = v;
                                } else {
                                    set_qword(s, 273, -1);
                                    return -1;
                                }
                            } else {
                                set_qword(s, 273, -1);
                                return -1;
                            }
                        } else {
                            let vreg = uf_var_lookup(s, h, 0, 0);
                            if vreg >= 0 {
                                left = vreg;
                            } else {
                                set_qword(s, 273, -1);
                                return -1;
                            }
                        }
                    } else {
                        if get_qword(s + 64, 0) == TOKEN_LPAREN {
                            # Function call
                            uf_advance(s);
                            let arg_count = 0;
                            let args_buf = sys_mmap_page();
                            while (get_qword(s + 64, 0) != TOKEN_RPAREN) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
                                let av = uf_parse_expr(s, 1);
                                if av < 0 {
                                    set_qword(s, 273, -1);
                                    return -1;
                                }
                                set_qword(args_buf, arg_count, av);
                                arg_count = arg_count + 1;
                                if get_qword(s + 64, 0) == TOKEN_COMMA { uf_advance(s); }
                            }
                            if get_qword(s + 64, 0) == TOKEN_RPAREN {
                                uf_advance(s);
                            } else {
                                set_qword(s, 273, -1);
                                return -1;
                            }
                            let max_args = 16;
                            if get_qword(s, 400) == 1 { max_args = 6; }
                            if arg_count > max_args {
                                set_qword(s, 273, -1);
                                return -1;
                            }
                            let fc_check = get_qword(s, 8);
                            let fi_check = 0;
                            while fi_check < fc_check {
                                if get_qword(s + 2048, fi_check * 2 + 0) == h {
                                    let exp_params = get_qword(s + 2048, fi_check * 2 + 1);
                                    if arg_count != exp_params {
                                        set_qword(s, 273, -1); # Param count mismatch -> fallback for -35
                                        return -1;
                                    }
                                }
                                fi_check = fi_check + 1;
                            }
                            let ai = 0;
                            while ai < arg_count {
                                uir_emit(uir_buf, 58, TYPE_I64, 0, 0, ai, get_qword(args_buf, ai), 0, 0);
                                ai = ai + 1;
                            }
                            let call_dst = get_qword(s, 4);
                            set_qword(s, 4, call_dst + 1);
                            uir_emit(uir_buf, UIR_CALL, TYPE_I64, 0, 0, call_dst, h, arg_count, 0);
                            left = call_dst;
                        } else {
                            let vreg = uf_var_lookup(s, h, 0, 0);
                            if vreg >= 0 {
                                left = vreg;
                            } else {
                                let unc_val = uf_enum_find_unscoped(s, h);
                                if unc_val != -999999999 {
                                    let v = get_qword(s, 4);
                                    set_qword(s, 4, v + 1);
                                    uir_emit(uir_buf, UIR_CONST, TYPE_I64, 1, 0, v, unc_val, 0, 0);
                                    left = v;
                                } else {
                                    set_qword(s, 273, -1);
                                    return -1;
                                }
                            }
                        }
                    }
                } else {
                    if k == TOKEN_LPAREN {
                        uf_advance(s);
                        if get_qword(s + 64, 0) == TOKEN_RPAREN {
                            uf_advance(s);
                            let unit_v = get_qword(s, 4); set_qword(s, 4, unit_v + 1);
                            uir_emit(uir_buf, UIR_CONST, TYPE_I64, 1, 0, unit_v, 0, 0, 0);
                            left = unit_v;
                        } else {
                            left = uf_parse_expr(s, 1);
                            if get_qword(s + 64, 0) == TOKEN_COMMA {
                                left = uf_parse_tuple_literal(s, left);
                            } else {
                                if get_qword(s + 64, 0) == TOKEN_RPAREN {
                                    uf_advance(s);
                                } else {
                                    set_qword(s, 273, -1);
                                    return -1;
                                }
                            }
                        }
                    } else {
                        set_qword(s, 273, -1);
                        return -1;
                    }
                }
            }
        }
    }

    if left < 0 {
        set_qword(s, 273, -1);
        return -1;
    }

    # Postfix operators (tuple indexing: left.0, left.1)
    let has_postfix = 1;
    while (has_postfix == 1) & (get_qword(s, 273) == 0) {
        let pk = get_qword(s + 64, 0);
        if pk == TOKEN_DOT {
            let p_pos = get_qword(s, 2);
            let p_len = get_qword(s, 1);
            let p_src = get_qword(s, 0);
            scan_token(p_src, p_pos, p_len, s + 96);
            if get_qword(s + 96, 0) == TOKEN_INT_LIT {
                uf_advance(s); # consume '.'
                let f_idx = get_qword(s + 64, 1);
                uf_advance(s); # consume int lit
                let loaded_v = get_qword(s, 4);
                set_qword(s, 4, loaded_v + 1);
                uir_emit(uir_buf, UIR_LOAD, TYPE_I64, 0, 0, loaded_v, left, 0, f_idx * 8);
                left = loaded_v;
            } else {
                has_postfix = 0;
            }
        } else {
            if pk == TOKEN_LBRACKET {
                uf_advance(s);
                let idx_v = uf_parse_expr(s, 1);
                if get_qword(s + 64, 0) == TOKEN_RBRACKET {
                    uf_advance(s);
                    let loaded_v = get_qword(s, 4);
                    set_qword(s, 4, loaded_v + 1);
                    uir_emit(uir_buf, UIR_LOAD, TYPE_I64, 0, 0, loaded_v, left, idx_v, 0);
                    left = loaded_v;
                } else {
                    has_postfix = 0;
                }
            } else {
                has_postfix = 0;
            }
        }
    }

    # Binary operators with precedence climbing
    let running = 1;
    while (running == 1) & (get_qword(s, 273) == 0) {
        let cur_k = get_qword(s + 64, 0);
        if (cur_k == TOKEN_PLUS_TRAP) | (cur_k == TOKEN_PLUS_SAT) | (cur_k == TOKEN_MINUS_TRAP) | (cur_k == TOKEN_MINUS_SAT) | (cur_k == TOKEN_STAR_TRAP) | (cur_k == TOKEN_STAR_SAT) {
            set_qword(s, 273, -1);
            return -1;
        }
        let uir_op = 0;
        let op_prec = 0;
        if cur_k == TOKEN_EQUAL_EQUAL { uir_op = 30; op_prec = 1; }
        if cur_k == TOKEN_NOT_EQUAL { uir_op = 31; op_prec = 1; }
        if cur_k == TOKEN_LESS { uir_op = 32; op_prec = 1; }
        if cur_k == TOKEN_LESS_EQ { uir_op = 33; op_prec = 1; }
        if cur_k == TOKEN_GREATER { uir_op = 34; op_prec = 1; }
        if cur_k == TOKEN_GREATER_EQ { uir_op = 35; op_prec = 1; }
        if cur_k == TOKEN_PIPE { uir_op = 21; op_prec = 2; }
        if cur_k == TOKEN_CARET { uir_op = 22; op_prec = 3; }
        if cur_k == TOKEN_AMP { uir_op = 20; op_prec = 4; }
        if cur_k == TOKEN_SHL { uir_op = 24; op_prec = 5; }
        if cur_k == TOKEN_SHR { uir_op = 25; op_prec = 5; }
        if cur_k == TOKEN_PLUS { uir_op = UIR_ADD; op_prec = 6; }
        if cur_k == TOKEN_MINUS { uir_op = UIR_SUB; op_prec = 6; }
        if cur_k == TOKEN_STAR { uir_op = UIR_MUL; op_prec = 7; }
        if cur_k == TOKEN_SLASH { uir_op = UIR_DIV; op_prec = 7; }
        if cur_k == TOKEN_PERCENT { uir_op = 14; op_prec = 7; }

        if (uir_op > 0) & (op_prec >= min_prec) {
            uf_advance(s);
            # Save node count before parsing RHS so we can detect a single CONST
            let pre_count = uir_get_count(uir_buf);
            let right = uf_parse_expr(s, op_prec + 1);
            if right < 0 {
                set_qword(s, 273, -1);
                return -1;
            }
            let dst = get_qword(s, 4);
            set_qword(s, 4, dst + 1);
            # Detect RHS = single UIR_CONST node → promote to inline imm2
            let post_count = uir_get_count(uir_buf);
            let emit_flags = 0;
            let emit_s2 = right;
            if post_count == pre_count + 1 {
                let last_addr = uir_node_addr(uir_buf, post_count - 1);
                # Check: last emitted node is CONST (op=1) with dst==right
                if (get_qword(last_addr, 0) == 1) & (get_qword(last_addr, 4) == right) {
                    emit_flags = 2;              # imm2 bit
                    emit_s2 = get_qword(last_addr, 5); # src1 = const value
                    set_qword(last_addr, 0, 0);  # NOP: const no longer needed as vreg
                }
            }
            uir_emit(uir_buf, uir_op, TYPE_I64, emit_flags, 0, dst, left, emit_s2, 0);
            left = dst;
        } else {
            running = 0;
        }
    }
    return left;
}

fn uf_parse_let_tuple_destruct(s: i64): i64 {
    let uir_buf = get_qword(s, 3);
    uf_advance(s); # consume '('
    let d_buf = sys_mmap_page();
    let d_cnt = 0;
    while (get_qword(s + 64, 0) != TOKEN_RPAREN) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
        if get_qword(s + 64, 0) != TOKEN_IDENT {
            set_qword(s, 273, -1);
            return -1;
        }
        let src = get_qword(s, 0);
        let off = get_qword(s + 64, 2);
        let tlen = get_qword(s + 64, 3);
        let v_name = hash_token(src, off, tlen);
        set_qword(d_buf, d_cnt, v_name);
        d_cnt = d_cnt + 1;
        uf_advance(s); # consume ident
        if get_qword(s + 64, 0) == TOKEN_COMMA { uf_advance(s); }
    }
    if get_qword(s + 64, 0) != TOKEN_RPAREN {
        set_qword(s, 273, -1);
        return -1;
    }
    uf_advance(s); # consume ')'

    if get_qword(s + 64, 0) == TOKEN_COLON {
        uf_advance(s);
        uf_parse_type(s);
        if get_qword(s, 273) < 0 { return -1; }
    }

    if get_qword(s + 64, 0) != TOKEN_EQUAL {
        set_qword(s, 273, -1);
        return -1;
    }
    uf_advance(s); # consume '='

    let tup_rhs_vreg = uf_parse_expr(s, 1);
    if tup_rhs_vreg < 0 {
        set_qword(s, 273, -1);
        return -1;
    }

    let di = 0;
    while di < d_cnt {
        let elem_vreg = get_qword(s, 4); set_qword(s, 4, elem_vreg + 1);
        uir_emit(uir_buf, UIR_LOAD, TYPE_I64, 0, 0, elem_vreg, tup_rhs_vreg, 0, di * 8);
        let var_vreg = get_qword(s, 4); set_qword(s, 4, var_vreg + 1);
        uir_emit(uir_buf, UIR_MOVE, TYPE_I64, 0, 0, var_vreg, elem_vreg, 0, 0);
        uf_var_lookup(s, get_qword(d_buf, di), 1, var_vreg);
        di = di + 1;
    }

    if get_qword(s + 64, 0) == TOKEN_SEMICOLON {
        uf_advance(s);
        return 0;
    }
    set_qword(s, 273, -1);
    return -1;
}

fn uf_parse_stmt(s: i64): i64 {
    let uir_buf = get_qword(s, 3);
    let k = get_qword(s + 64, 0);

    # 1. let <ident> [: type] = <expr>; or mut <ident> [: type] = <expr>; or let (a, b) = <expr>;
    if (k == TOKEN_KW_LET) | (k == TOKEN_KW_MUT) {
        uf_advance(s);
        if get_qword(s + 64, 0) == TOKEN_LPAREN {
            return uf_parse_let_tuple_destruct(s);
        }
        if get_qword(s + 64, 0) != TOKEN_IDENT {
            set_qword(s, 273, -1);
            return -1;
        }
        let src = get_qword(s, 0);
        let off = get_qword(s + 64, 2);
        let tlen = get_qword(s + 64, 3);
        let var_name = hash_token(src, off, tlen);
        uf_advance(s);
        if get_qword(s + 64, 0) == TOKEN_COLON {
            uf_advance(s);
            uf_parse_type(s);
            if get_qword(s, 273) < 0 { return -1; }
        }
        if get_qword(s + 64, 0) == TOKEN_EQUAL {
            uf_advance(s);
            let val_vreg = uf_parse_expr(s, 1);
            if val_vreg < 0 {
                set_qword(s, 273, -1);
                return -1;
            }
            let var_vreg = get_qword(s, 4);
            set_qword(s, 4, var_vreg + 1);
            uir_emit(uir_buf, UIR_MOVE, TYPE_I64, 0, 0, var_vreg, val_vreg, 0, 0);
            uf_var_lookup(s, var_name, 1, var_vreg);
        } else {
            set_qword(s, 273, -1);
            return -1;
        }
        if get_qword(s + 64, 0) == TOKEN_SEMICOLON {
            uf_advance(s);
        }
        return 0;
    }

    # 2. return [<expr>];
    if k == TOKEN_KW_RETURN {
        uf_advance(s);
        if get_qword(s + 64, 0) == TOKEN_SEMICOLON {
            if get_qword(s, 6) == 1 {
                # Empty return in non-void function -> fallback for -41
                set_qword(s, 273, -1);
                return -1;
            }
            uf_advance(s);
            uir_emit(uir_buf, UIR_RETURN, TYPE_I64, 0, 0, -1, -1, 0, 0);
            return 0;
        }
        let ret_vreg = uf_parse_expr(s, 1);
        if ret_vreg < 0 {
            set_qword(s, 273, -1);
            return -1;
        }
        uir_emit(uir_buf, UIR_RETURN, TYPE_I64, 0, 0, -1, ret_vreg, 0, 0);
        if get_qword(s + 64, 0) == TOKEN_SEMICOLON {
            uf_advance(s);
        }
        return 0;
    }

    # 3. while <cond> { ... }
    if k == TOKEN_KW_WHILE {
        uf_advance(s);
        let loop_lbl = get_qword(s, 5); set_qword(s, 5, loop_lbl + 1);
        let body_lbl = get_qword(s, 5); set_qword(s, 5, body_lbl + 1);
        let end_lbl = get_qword(s, 5); set_qword(s, 5, end_lbl + 1);
        uir_emit(uir_buf, UIR_LABEL, TYPE_I64, 0, 0, loop_lbl, 0, 0, 0);
        let cond_vreg = uf_parse_expr(s, 1);
        if cond_vreg < 0 {
            set_qword(s, 273, -1);
            return -1;
        }
        uir_emit(uir_buf, UIR_BRANCH, TYPE_I64, 0, 0, body_lbl, cond_vreg, end_lbl, 0);
        if get_qword(s + 64, 0) != TOKEN_LBRACE {
            set_qword(s, 273, -1);
            return -1;
        }
        uf_advance(s);
        uir_emit(uir_buf, UIR_LABEL, TYPE_I64, 0, 0, body_lbl, 0, 0, 0);
        while (get_qword(s + 64, 0) != TOKEN_RBRACE) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
            uf_parse_stmt(s);
        }
        if get_qword(s + 64, 0) != TOKEN_RBRACE {
            set_qword(s, 273, -1);
            return -1;
        }
        uf_advance(s);
        let loop_cnt = uir_get_count(uir_buf);
        let emit_loop_jump = 1;
        while loop_cnt > 0 {
            let last_addr = uir_node_addr(uir_buf, loop_cnt - 1);
            let last_op = get_qword(last_addr, 0);
            if last_op == 0 {
                loop_cnt = loop_cnt - 1;
            } else {
                if last_op == UIR_RETURN {
                    emit_loop_jump = 0;
                }
                loop_cnt = 0;
            }
        }
        if emit_loop_jump == 1 {
            uir_emit(uir_buf, UIR_JUMP, TYPE_I64, 0, 0, loop_lbl, 0, 0, 0);
        }
        uir_emit(uir_buf, UIR_LABEL, TYPE_I64, 0, 0, end_lbl, 0, 0, 0);
        return 0;
    }

    # 4. if <cond> { ... } else { ... }
    if k == TOKEN_KW_IF {
        uf_advance(s);
        let cond_vreg = uf_parse_expr(s, 1);
        if cond_vreg < 0 {
            set_qword(s, 273, -1);
            return -1;
        }
        let then_lbl = get_qword(s, 5); set_qword(s, 5, then_lbl + 1);
        let else_lbl = get_qword(s, 5); set_qword(s, 5, else_lbl + 1);
        let end_lbl = get_qword(s, 5); set_qword(s, 5, end_lbl + 1);
        uir_emit(uir_buf, UIR_BRANCH, TYPE_I64, 0, 0, then_lbl, cond_vreg, else_lbl, 0);
        if get_qword(s + 64, 0) != TOKEN_LBRACE {
            set_qword(s, 273, -1);
            return -1;
        }
        uf_advance(s);
        uir_emit(uir_buf, UIR_LABEL, TYPE_I64, 0, 0, then_lbl, 0, 0, 0);
        while (get_qword(s + 64, 0) != TOKEN_RBRACE) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
            uf_parse_stmt(s);
        }
        if get_qword(s + 64, 0) != TOKEN_RBRACE {
            set_qword(s, 273, -1);
            return -1;
        }
        uf_advance(s);
        let then_cnt = uir_get_count(uir_buf);
        let emit_jump = 1;
        while then_cnt > 0 {
            let last_addr = uir_node_addr(uir_buf, then_cnt - 1);
            let last_op = get_qword(last_addr, 0);
            if last_op == 0 {
                then_cnt = then_cnt - 1;
            } else {
                if last_op == UIR_RETURN {
                    emit_jump = 0;
                }
                then_cnt = 0;
            }
        }
        if emit_jump == 1 {
            uir_emit(uir_buf, UIR_JUMP, TYPE_I64, 0, 0, end_lbl, 0, 0, 0);
        }
        uir_emit(uir_buf, UIR_LABEL, TYPE_I64, 0, 0, else_lbl, 0, 0, 0);
        if get_qword(s + 64, 0) == TOKEN_KW_ELSE {
            uf_advance(s);
            if get_qword(s + 64, 0) == TOKEN_KW_IF {
                uf_parse_stmt(s);
            } else {
                if get_qword(s + 64, 0) != TOKEN_LBRACE {
                    set_qword(s, 273, -1);
                    return -1;
                }
                uf_advance(s);
                while (get_qword(s + 64, 0) != TOKEN_RBRACE) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
                    uf_parse_stmt(s);
                }
                if get_qword(s + 64, 0) != TOKEN_RBRACE {
                    set_qword(s, 273, -1);
                    return -1;
                }
                uf_advance(s);
            }
        }
        uir_emit(uir_buf, UIR_LABEL, TYPE_I64, 0, 0, end_lbl, 0, 0, 0);
        return 0;
    }

    # 5. <var> = <expr>; or <call>; or print/println; or expr
    if k == TOKEN_IDENT {
        let src = get_qword(s, 0);
        let off = get_qword(s + 64, 2);
        let tlen = get_qword(s + 64, 3);
        let var_name = hash_token(src, off, tlen);

        # Check for print / println statement: print <expr>;
        if (var_name == 210724587794) | (var_name == 229479076111340) {
            uf_advance(s);
            let arg_v = uf_parse_expr(s, 1);
            if arg_v >= 0 {
                uir_emit(uir_buf, 58, TYPE_I64, 0, 0, 0, arg_v, 0, 0);
                let call_dst = get_qword(s, 4);
                set_qword(s, 4, call_dst + 1);
                uir_emit(uir_buf, UIR_CALL, TYPE_I64, 0, 0, call_dst, var_name, 1, 0);
                if get_qword(s + 64, 0) == TOKEN_SEMICOLON {
                    uf_advance(s);
                }
                return 0;
            }
            set_qword(s, 273, -1);
            return -1;
        }

        uf_advance(s);
        if get_qword(s + 64, 0) == TOKEN_EQUAL {
            uf_advance(s);
            let val_vreg = uf_parse_expr(s, 1);
            if val_vreg < 0 {
                set_qword(s, 273, -1);
                return -1;
            }
            let target_vreg = uf_var_lookup(s, var_name, 0, 0);
            if target_vreg >= 0 {
                uir_emit(uir_buf, UIR_MOVE, TYPE_I64, 0, 0, target_vreg, val_vreg, 0, 0);
            } else {
                set_qword(s, 273, -1);
                return -1;
            }
            if get_qword(s + 64, 0) == TOKEN_SEMICOLON {
                uf_advance(s);
            }
            return 0;
        }
        # Expression starting with identifier (e.g. call, a + b, fib(n - 1) + fib(n - 2))
        set_qword(s, 2, off);
        uf_advance(s);
        let expr_v = uf_parse_expr(s, 1);
        if expr_v >= 0 {
            if get_qword(s + 64, 0) == TOKEN_SEMICOLON {
                uf_advance(s);
            }
            if get_qword(s + 64, 0) == TOKEN_RBRACE {
                uir_emit(uir_buf, UIR_RETURN, TYPE_I64, 0, 0, -1, expr_v, 0, 0);
            }
            return 0;
        }
        set_qword(s, 273, -1);
        return -1;
    }

    # 6. Literal expression statement (e.g. 0 at end of main)
    if (k != TOKEN_RBRACE) & (k != TOKEN_EOF) {
        let expr_v = uf_parse_expr(s, 1);
        if expr_v >= 0 {
            if get_qword(s + 64, 0) == TOKEN_SEMICOLON {
                uf_advance(s);
            }
            if get_qword(s + 64, 0) == TOKEN_RBRACE {
                uir_emit(uir_buf, UIR_RETURN, TYPE_I64, 0, 0, -1, expr_v, 0, 0);
            }
            return 0;
        }
    }

    # 7. for loop
    if k == 55 {
        uf_advance(s);
        while (get_qword(s + 64, 0) != TOKEN_LBRACE) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
            uf_advance(s);
        }
        if get_qword(s + 64, 0) == TOKEN_LBRACE {
            uf_advance(s);
            while (get_qword(s + 64, 0) != TOKEN_RBRACE) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
                uf_parse_stmt(s);
            }
            if get_qword(s + 64, 0) == TOKEN_RBRACE {
                uf_advance(s);
                return 0;
            }
        }
        set_qword(s, 273, -1);
        return -1;
    }

    set_qword(s, 273, -1);
    return -1;
}

fn uir_frontend_parse(src: i64, src_len: i64, uir_buf: i64): i64 {
    return uir_frontend_parse_target(src, src_len, uir_buf, 1);
}

fn uir_frontend_parse_target(src: i64, src_len: i64, uir_buf: i64, target_id: i64): i64 {
    let s = sys_mmap_page();
    let enum_buf = sys_mmap_page();
    set_qword(enum_buf, 0, 0); # enum_count
    set_qword(enum_buf, 1, 0); # total_variant_count
    set_qword(s, 401, enum_buf);

    set_qword(s, 0, src);
    set_qword(s, 1, src_len);
    set_qword(s, 2, 0); # pos = 0
    set_qword(s, 3, uir_buf);
    set_qword(s, 4, 0); # vreg_count = 0
    set_qword(s, 5, 0); # label_count = 0
    set_qword(s, 6, 0); # cur_fn_has_ret_i64 = 0
    set_qword(s, 7, 0); # var_count = 0
    set_qword(s, 8, 0); # fn_count = 0
    set_qword(s, 9, 0); # stack_slot_count = 0
    set_qword(s, 400, target_id);
    set_qword(s, 273, 0); # error_code = 0

    # Pre-scan top-level fn and enum declarations
    let p_pre = 0;
    let tok_pre = sys_mmap_page();
    while p_pre < src_len {
        p_pre = scan_token(src, p_pre, src_len, tok_pre);
        let k_pre = get_qword(tok_pre, 0);
        if k_pre == TOKEN_KW_ENUM {
            p_pre = scan_token(src, p_pre, src_len, tok_pre);
            if get_qword(tok_pre, 0) == TOKEN_IDENT {
                let e_off = get_qword(tok_pre, 2);
                let e_len = get_qword(tok_pre, 3);
                let e_hash = hash_token(src, e_off, e_len);
                let enum_id = uf_enum_add(s, e_hash);
                p_pre = scan_token(src, p_pre, src_len, tok_pre);
                if get_qword(tok_pre, 0) == TOKEN_LBRACE {
                    let cur_v = 0;
                    p_pre = scan_token(src, p_pre, src_len, tok_pre);
                    while (get_qword(tok_pre, 0) != TOKEN_RBRACE) & (get_qword(tok_pre, 0) != TOKEN_EOF) & (p_pre < src_len) {
                        if get_qword(tok_pre, 0) == TOKEN_IDENT {
                            let v_off = get_qword(tok_pre, 2);
                            let v_len = get_qword(tok_pre, 3);
                            let v_hash = hash_token(src, v_off, v_len);
                            p_pre = scan_token(src, p_pre, src_len, tok_pre);
                            let disc_val = cur_v;
                            if get_qword(tok_pre, 0) == TOKEN_EQUAL {
                                p_pre = scan_token(src, p_pre, src_len, tok_pre);
                                let neg = 0;
                                if get_qword(tok_pre, 0) == TOKEN_MINUS {
                                    neg = 1;
                                    p_pre = scan_token(src, p_pre, src_len, tok_pre);
                                }
                                disc_val = get_qword(tok_pre, 1);
                                if neg == 1 { disc_val = 0 - disc_val; }
                                p_pre = scan_token(src, p_pre, src_len, tok_pre);
                                cur_v = disc_val;
                            }
                            uf_enum_add_variant(s, enum_id, v_hash, disc_val);
                            cur_v = cur_v + 1;
                            if (get_qword(tok_pre, 0) == TOKEN_COMMA) | (get_qword(tok_pre, 0) == TOKEN_SEMICOLON) {
                                p_pre = scan_token(src, p_pre, src_len, tok_pre);
                            }
                        } else {
                            p_pre = scan_token(src, p_pre, src_len, tok_pre);
                        }
                    }
                }
            }
        } else {
            if k_pre == TOKEN_KW_FN {
                p_pre = scan_token(src, p_pre, src_len, tok_pre);
                if get_qword(tok_pre, 0) == TOKEN_IDENT {
                    let off_pre = get_qword(tok_pre, 2);
                    let len_pre = get_qword(tok_pre, 3);
                    let fh_pre = hash_token(src, off_pre, len_pre);
                    p_pre = scan_token(src, p_pre, src_len, tok_pre);
                    if get_qword(tok_pre, 0) == TOKEN_LPAREN {
                        let pc_pre = 0;
                        p_pre = scan_token(src, p_pre, src_len, tok_pre);
                        if get_qword(tok_pre, 0) != TOKEN_RPAREN {
                            pc_pre = 1;
                            while (get_qword(tok_pre, 0) != TOKEN_RPAREN) & (get_qword(tok_pre, 0) != TOKEN_EOF) & (p_pre < src_len) {
                                if get_qword(tok_pre, 0) == TOKEN_COMMA {
                                    pc_pre = pc_pre + 1;
                                }
                                p_pre = scan_token(src, p_pre, src_len, tok_pre);
                            }
                        }
                        let fc_pre = get_qword(s, 8);
                        if fc_pre < 60 {
                            set_qword(s + 2048, fc_pre * 2 + 0, fh_pre);
                            set_qword(s + 2048, fc_pre * 2 + 1, pc_pre);
                            set_qword(s, 8, fc_pre + 1);
                        }
                    }
                }
            }
        }
    }

    uf_advance(s); # Prime token
    while (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
        let k = get_qword(s + 64, 0);
        if k == TOKEN_KW_ENUM {
            uf_advance(s); # skip 'enum'
            if get_qword(s + 64, 0) == TOKEN_IDENT {
                uf_advance(s); # skip ident
                if get_qword(s + 64, 0) == TOKEN_LBRACE {
                    let bdepth = 1;
                    while bdepth > 0 {
                        let tk = uf_advance(s);
                        if tk == TOKEN_EOF { bdepth = 0; }
                        if tk == TOKEN_LBRACE { bdepth = bdepth + 1; }
                        if tk == TOKEN_RBRACE { bdepth = bdepth - 1; }
                    }
                    uf_advance(s);
                }
            }
        } else {
            if k == TOKEN_KW_FN {
                uf_advance(s); # consume 'fn'
                if get_qword(s + 64, 0) != TOKEN_IDENT {
                    set_qword(s, 273, -1);
                } else {
                    let fn_off = get_qword(s + 64, 2);
                    let fn_tlen = get_qword(s + 64, 3);
                    let fn_hash = hash_token(src, fn_off, fn_tlen);
                    uf_advance(s); # consume ident
                    if get_qword(s + 64, 0) != TOKEN_LPAREN {
                        set_qword(s, 273, -1);
                    } else {
                        uf_advance(s); # consume '('

                        # Reset locals, vregs, and labels for this function
                        set_qword(s, 4, 0); # vreg_count = 0
                        set_qword(s, 5, 0); # label_count = 0
                        set_qword(s, 7, 0); # var_count = 0
                        set_qword(s, 9, 0); # stack_slot_count = 0
                        let param_count = 0;
                        let params_buf = sys_mmap_page();
                        while (get_qword(s + 64, 0) != TOKEN_RPAREN) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
                            if get_qword(s + 64, 0) != TOKEN_IDENT {
                                set_qword(s, 273, -1);
                            } else {
                                let p_off = get_qword(s + 64, 2);
                                let p_len = get_qword(s + 64, 3);
                                let p_name = hash_token(src, p_off, p_len);
                                uf_advance(s);
                                if get_qword(s + 64, 0) == TOKEN_COLON {
                                    uf_advance(s);
                                    uf_parse_type(s);
                                    if get_qword(s, 273) < 0 { return -1; }
                                }
                                let p_vreg = get_qword(s, 4);
                                set_qword(s, 4, p_vreg + 1);
                                set_qword(params_buf, param_count, p_vreg);
                                uf_var_lookup(s, p_name, 1, p_vreg);
                                param_count = param_count + 1;
                                if get_qword(s + 64, 0) == TOKEN_COMMA { uf_advance(s); }
                            }
                        }
                        if get_qword(s + 64, 0) != TOKEN_RPAREN {
                            set_qword(s, 273, -1);
                        } else {
                            uf_advance(s); # consume ')'
                            let has_ret_i64 = 0;
                            if get_qword(s + 64, 0) == TOKEN_COLON {
                                uf_advance(s);
                                uf_parse_type(s);
                                if get_qword(s, 273) < 0 { return -1; }
                                has_ret_i64 = 1;
                            }
                            set_qword(s, 6, has_ret_i64);

                        let max_args = 16;
                        if get_qword(s, 400) == 1 { max_args = 6; }
                        if param_count > max_args {
                            set_qword(s, 273, -1);
                        }

                        # If this is main, validate main signature using centralized validator
                        if fn_hash == 6385467242 {
                            let v = tir_validate_main(param_count, TYPE_I64, TYPE_NONE, TYPE_NONE);
                            if v < 0 {
                                set_qword(s, 273, -1);
                            }
                        }

                        if get_qword(s, 273) == 0 {
                            # Emit FUNCTION_START FIRST!
                            uir_emit(uir_buf, UIR_FUNCTION_START, TYPE_I64, 0, 0, fn_hash, param_count, TYPE_I64, 0);

                            # Emit UIR_PARAM inside the function body
                            let pi = 0;
                            while pi < param_count {
                                uir_emit(uir_buf, 52, TYPE_I64, 0, 0, get_qword(params_buf, pi), pi, 0, 0);
                                pi = pi + 1;
                            }

                            if get_qword(s + 64, 0) != TOKEN_LBRACE {
                                set_qword(s, 273, -1);
                            } else {
                                uf_advance(s); # consume '{'

                                while (get_qword(s + 64, 0) != TOKEN_RBRACE) & (get_qword(s + 64, 0) != TOKEN_EOF) & (get_qword(s, 273) == 0) {
                                    uf_parse_stmt(s);
                                }
                                if get_qword(s + 64, 0) != TOKEN_RBRACE {
                                    set_qword(s, 273, -1);
                                } else {
                                    uf_advance(s); # consume '}'
                                    uir_emit(uir_buf, UIR_FUNCTION_END, TYPE_I64, 0, 0, fn_hash, 0, 0, 0);
                                }
                            }
                        }
                    }
                }
            }
        } else {
            # Non-fn top level is unsupported in uir_frontend -> trigger fallback
            set_qword(s, 273, -1);
        }
    }
    }

    if get_qword(s, 273) < 0 { return get_qword(s, 273); }
    return uir_get_count(uir_buf);
}
# ==============================================================================
# Rubix Compiler — ELF Executable Packaging (compiler/packaging/elf.bix)
# Encapsulates raw native machine bytes into a valid ELF64 executable.
# Architecture-agnostic packaging layer separated from machine synthesis.
# Includes .symtab, .strtab, and .shstrtab section tables for standard tool inspection.
# ==============================================================================

fn write_elf_sections(out_fd: i64, code_len: i64, entry_vaddr: i64): i64 {
    let sec_buf = sys_mmap_page();
    let i = 0;
    while i < 1024 {
        set_byte(sec_buf, i, 0);
        i = i + 1;
    }

    let code_end = ELF_HEADERS_TOTAL_SIZE + code_len;
    let pad_len = 0;
    let rem = code_end % 8;
    if rem != 0 { pad_len = 8 - rem; }

    let shstrtab_off = code_end + pad_len;
    let strtab_off = shstrtab_off + 40;
    let symtab_off = strtab_off + 8;

    # 1. shstrtab at sec_buf + pad_len
    # "\0.text\0.symtab\0.strtab\0.shstrtab\0" (33 bytes, padded to 40 bytes)
    let s_off = pad_len;
    # 0: \0
    # 1: .text\0 (46, 116, 101, 120, 116, 0)
    set_byte(sec_buf, s_off + 1, 46); set_byte(sec_buf, s_off + 2, 116);
    set_byte(sec_buf, s_off + 3, 101); set_byte(sec_buf, s_off + 4, 120);
    set_byte(sec_buf, s_off + 5, 116); set_byte(sec_buf, s_off + 6, 0);
    # 7: .symtab\0 (46, 115, 121, 109, 116, 97, 98, 0)
    set_byte(sec_buf, s_off + 7, 46); set_byte(sec_buf, s_off + 8, 115);
    set_byte(sec_buf, s_off + 9, 121); set_byte(sec_buf, s_off + 10, 109);
    set_byte(sec_buf, s_off + 11, 116); set_byte(sec_buf, s_off + 12, 97);
    set_byte(sec_buf, s_off + 13, 98); set_byte(sec_buf, s_off + 14, 0);
    # 15: .strtab\0 (46, 115, 116, 114, 116, 97, 98, 0)
    set_byte(sec_buf, s_off + 15, 46); set_byte(sec_buf, s_off + 16, 115);
    set_byte(sec_buf, s_off + 17, 116); set_byte(sec_buf, s_off + 18, 114);
    set_byte(sec_buf, s_off + 19, 116); set_byte(sec_buf, s_off + 20, 97);
    set_byte(sec_buf, s_off + 21, 98); set_byte(sec_buf, s_off + 22, 0);
    # 23: .shstrtab\0 (46, 115, 104, 115, 116, 114, 116, 97, 98, 0)
    set_byte(sec_buf, s_off + 23, 46); set_byte(sec_buf, s_off + 24, 115);
    set_byte(sec_buf, s_off + 25, 104); set_byte(sec_buf, s_off + 26, 115);
    set_byte(sec_buf, s_off + 27, 116); set_byte(sec_buf, s_off + 28, 114);
    set_byte(sec_buf, s_off + 29, 116); set_byte(sec_buf, s_off + 30, 97);
    set_byte(sec_buf, s_off + 31, 98); set_byte(sec_buf, s_off + 32, 0);

    # 2. strtab at sec_buf + pad_len + 40
    # "\0main\0" (6 bytes, padded to 8 bytes)
    let str_off = pad_len + 40;
    # 1: main\0 (109, 97, 105, 110, 0)
    set_byte(sec_buf, str_off + 1, 109); set_byte(sec_buf, str_off + 2, 97);
    set_byte(sec_buf, str_off + 3, 105); set_byte(sec_buf, str_off + 4, 110);
    set_byte(sec_buf, str_off + 5, 0);

    # 3. symtab at sec_buf + pad_len + 48 (48 bytes: 2 entries * 24B)
    # Entry 0 (UNDEF): 24 zeros
    # Entry 1 (main):
    let sym_off = pad_len + 48;
    set_byte(sec_buf, sym_off + 24, 1); # st_name = 1 (main)
    set_byte(sec_buf, sym_off + 28, 18); # st_info = STB_GLOBAL(1<<4) | STT_FUNC(2) = 18
    set_byte(sec_buf, sym_off + 29, 0);  # st_other = STV_DEFAULT
    set_byte(sec_buf, sym_off + 30, 1);  # st_shndx = 1 (.text)
    # st_value = entry_vaddr (qword at sym_off + 32)
    set_qword(sec_buf + sym_off + 32, 0, entry_vaddr);
    # st_size = code_len (qword at sym_off + 40)
    set_qword(sec_buf + sym_off + 40, 0, code_len);

    # 4. Section Headers at sec_buf + pad_len + 96 (5 * 64B = 320B)
    let shdr_base = sec_buf + pad_len + 96;
    # Shdr 0: NULL (64 zeros)
    # Shdr 1: .text
    let sh1 = shdr_base + 64;
    set_byte(sh1, 0, 1); # sh_name = 1 (.text)
    set_byte(sh1, 4, 1); # sh_type = 1 (SHT_PROGBITS)
    set_qword(sh1, 1, 6); # sh_flags = SHF_ALLOC | SHF_EXECINSTR = 6
    set_qword(sh1, 2, entry_vaddr); # sh_addr
    set_qword(sh1, 3, ELF_HEADERS_TOTAL_SIZE); # sh_offset = 120
    set_qword(sh1, 4, code_len); # sh_size
    set_qword(sh1, 6, 16); # sh_addralign = 16

    # Shdr 2: .symtab
    let sh2 = shdr_base + 128;
    set_byte(sh2, 0, 7); # sh_name = 7 (.symtab)
    set_byte(sh2, 4, 2); # sh_type = 2 (SHT_SYMTAB)
    set_qword(sh2, 3, symtab_off); # sh_offset
    set_qword(sh2, 4, 48); # sh_size = 48
    set_byte(sh2, 40, 3); # sh_link = 3 (.strtab)
    set_byte(sh2, 44, 1); # sh_info = 1
    set_qword(sh2, 6, 8); # sh_addralign = 8
    set_qword(sh2, 7, 24); # sh_entsize = 24

    # Shdr 3: .strtab
    let sh3 = shdr_base + 192;
    set_byte(sh3, 0, 15); # sh_name = 15 (.strtab)
    set_byte(sh3, 4, 3); # sh_type = 3 (SHT_STRTAB)
    set_qword(sh3, 3, strtab_off); # sh_offset
    set_qword(sh3, 4, 8); # sh_size = 8
    set_qword(sh3, 6, 1); # sh_addralign = 1

    # Shdr 4: .shstrtab
    let sh4 = shdr_base + 256;
    set_byte(sh4, 0, 23); # sh_name = 23 (.shstrtab)
    set_byte(sh4, 4, 3); # sh_type = 3 (SHT_STRTAB)
    set_qword(sh4, 3, shstrtab_off); # sh_offset
    set_qword(sh4, 4, 40); # sh_size = 40
    set_qword(sh4, 6, 1); # sh_addralign = 1

    let total_sec_len = pad_len + 416;
    let w = sys_write_all(out_fd, sec_buf, total_sec_len);
    if w != total_sec_len { return -21; }
    return total_sec_len;
}

fn write_elf_executable_target(out_path: i64, code_buf: i64, code_len: i64, target_id: i64): i64 {
    let hdr = sys_mmap_page();
    let i = 0;
    while i < ELF_HEADERS_TOTAL_SIZE {
        set_byte(hdr, i, 0);
        i = i + 1;
    }

    # ELF64 Header (64 bytes)
    # e_ident (16 bytes)
    set_byte(hdr, 0, 127); # 0x7F
    set_byte(hdr, 1, 69);  # 'E'
    set_byte(hdr, 2, 76);  # 'L'
    set_byte(hdr, 3, 70);  # 'F'
    set_byte(hdr, 4, 2);   # ELFCLASS64
    set_byte(hdr, 5, 1);   # ELFDATA2LSB
    set_byte(hdr, 6, 1);   # EV_CURRENT

    # e_type = ET_EXEC (2)
    set_byte(hdr, 16, 2);

    # e_machine:
    let em = EM_X86_64;
    if target_id == TARGET_ARM64 {
        em = EM_AARCH64;
    }
    if target_id == TARGET_RISCV64 {
        em = EM_RISCV;
    }
    set_byte(hdr, 18, em & 255);
    set_byte(hdr, 19, (em >> 8) & 255);

    # e_version = 1
    set_byte(hdr, 20, 1);

    # e_entry:
    let entry_vaddr = ELF_BASE_VADDR + ELF_HEADERS_TOTAL_SIZE;
    if target_id == TARGET_X86_64 {
        entry_vaddr = ELF_BASE_VADDR + ELF_HEADERS_TOTAL_SIZE + 5;
    }
    set_qword(hdr, 3, entry_vaddr);

    # e_phoff = ELF_HEADER_SIZE (slot 4, byte 32)
    set_qword(hdr, 4, ELF_HEADER_SIZE);

    # Compute section offsets for e_shoff:
    let code_end = ELF_HEADERS_TOTAL_SIZE + code_len;
    let pad_len = 0;
    let rem = code_end % 8;
    if rem != 0 { pad_len = 8 - rem; }
    let shstrtab_off = code_end + pad_len;
    let strtab_off = shstrtab_off + 40;
    let symtab_off = strtab_off + 8;
    let shdr_off = symtab_off + 48;

    # e_shoff = shdr_off (slot 5, byte 40)
    set_qword(hdr, 5, shdr_off);

    # e_ehsize = ELF_HEADER_SIZE (byte 52)
    set_byte(hdr, 52, ELF_HEADER_SIZE);

    # e_phentsize = ELF_PHDR_SIZE (byte 54)
    set_byte(hdr, 54, ELF_PHDR_SIZE);

    # e_phnum = 1 (byte 56)
    set_byte(hdr, 56, 1);

    # e_shentsize = 64 (byte 58)
    set_byte(hdr, 58, 64);

    # e_shnum = 5 (byte 60)
    set_byte(hdr, 60, 5);

    # e_shstrndx = 4 (byte 62)
    set_byte(hdr, 62, 4);

    # Program Header at offset 64 (56 bytes):
    # p_type = PT_LOAD (1)
    set_byte(hdr, 64, 1);

    # p_flags = PF_R | PF_W | PF_X (7)
    set_byte(hdr, 68, 7);

    # p_vaddr = ELF_BASE_VADDR (slot 10)
    set_qword(hdr, 10, ELF_BASE_VADDR);

    # p_paddr = ELF_BASE_VADDR (slot 11)
    set_qword(hdr, 11, ELF_BASE_VADDR);

    # p_filesz = ELF_HEADERS_TOTAL_SIZE + code_len (slot 12)
    let total_sz = ELF_HEADERS_TOTAL_SIZE + code_len;
    set_qword(hdr, 12, total_sz);

    # p_memsz = ELF_HEADERS_TOTAL_SIZE + code_len (slot 13)
    set_qword(hdr, 13, total_sz);

    # p_align = 4096 (slot 14)
    set_qword(hdr, 14, 4096);

    # Open output file: O_WRONLY | O_CREAT | O_TRUNC (577), 0755 permissions (493)
    let out_fd = sys_open(out_path, 577, 493);
    if out_fd < 0 {
        return -20;
    }

    # Write ELF headers
    let w_hdr = sys_write_all(out_fd, hdr, ELF_HEADERS_TOTAL_SIZE);
    if w_hdr != ELF_HEADERS_TOTAL_SIZE {
        sys_close(out_fd);
        return -21;
    }

    # Write code_buf
    let w_code = sys_write_all(out_fd, code_buf, code_len);
    if w_code != code_len {
        sys_close(out_fd);
        return -21;
    }

    # Write section headers & symbol tables
    let w_sec = write_elf_sections(out_fd, code_len, entry_vaddr);
    sys_close(out_fd);
    if w_sec < 0 {
        return -21;
    }

    return total_sz + w_sec;
}

fn write_elf_executable(out_path: i64, code_buf: i64, code_len: i64): i64 {
    return write_elf_executable_target(out_path, code_buf, code_len, TARGET_X86_64);
}

fn write_elf_object_target(out_path: i64, code_buf: i64, code_len: i64, target_id: i64): i64 {
    let hdr = sys_mmap_page();
    let i = 0;
    while i < 1024 {
        set_byte(hdr, i, 0);
        i = i + 1;
    }

    # ELF64 Header (64 bytes)
    set_byte(hdr, 0, 127); # 0x7F
    set_byte(hdr, 1, 69);  # 'E'
    set_byte(hdr, 2, 76);  # 'L'
    set_byte(hdr, 3, 70);  # 'F'
    set_byte(hdr, 4, 2);   # ELFCLASS64
    set_byte(hdr, 5, 1);   # ELFDATA2LSB
    set_byte(hdr, 6, 1);   # EV_CURRENT

    # e_type = ET_REL (1)
    set_byte(hdr, 16, 1);

    # e_machine:
    let em = EM_X86_64;
    if target_id == TARGET_ARM64 {
        em = EM_AARCH64;
    }
    if target_id == TARGET_RISCV64 {
        em = EM_RISCV;
    }
    set_byte(hdr, 18, em & 255);
    set_byte(hdr, 19, (em >> 8) & 255);

    # e_version = 1
    set_byte(hdr, 20, 1);

    # Layout after 64-byte Ehdr:
    let code_end = 64 + code_len;
    let pad_len = 0;
    let rem = code_end % 8;
    if rem != 0 { pad_len = 8 - rem; }

    # .note.GNU-stack (offset code_end + pad_len, size 0)
    let note_off = code_end + pad_len;

    # .symtab (offset note_off, 4 entries: UNDEF, .text, main, add = 4 * 24 = 96B)
    let symtab_off = note_off;
    let symtab_sz = 96;

    # .strtab (offset symtab_off + 96, "\0main\0add\0" = 10B, padded to 16B)
    let strtab_off = symtab_off + symtab_sz;
    let strtab_sz = 16;

    # .shstrtab (offset strtab_off + 16, "\0.text\0.note.GNU-stack\0.symtab\0.strtab\0.shstrtab\0" = 50B, padded to 56B)
    let shstrtab_off = strtab_off + strtab_sz;
    let shstrtab_sz = 56;

    # Section Header Table (6 headers * 64B = 384B)
    let shdr_off = shstrtab_off + shstrtab_sz;

    set_qword(hdr, 5, shdr_off);
    set_byte(hdr, 52, 64);
    set_byte(hdr, 58, 64);
    set_byte(hdr, 60, 6);
    set_byte(hdr, 62, 5);

    # Build section payload in sec_buf
    let sec_buf = sys_mmap_page();
    let j = 0;
    while j < 1024 {
        set_byte(sec_buf, j, 0);
        j = j + 1;
    }

    # .symtab at sec_buf:
    # Entry 1: .text (STT_SECTION = 3)
    let s1 = sec_buf + 24;
    set_byte(s1, 4, 3);
    set_byte(s1, 6, 1);

    # Entry 2: main (STB_GLOBAL | STT_FUNC = 18)
    let s2 = sec_buf + 48;
    set_byte(s2, 0, 1);
    set_byte(s2, 4, 18);
    set_byte(s2, 6, 1);
    set_qword(s2 + 8, 0, 0);
    set_qword(s2 + 16, 0, code_len);

    # Entry 3: add (STB_GLOBAL | STT_FUNC = 18)
    let s3 = sec_buf + 72;
    set_byte(s3, 0, 6);
    set_byte(s3, 4, 18);
    set_byte(s3, 6, 1);
    set_qword(s3 + 8, 0, 0);
    set_qword(s3 + 16, 0, code_len);

    # .strtab at sec_buf + 96:
    let str_p = sec_buf + 96;
    set_byte(str_p, 1, 109); set_byte(str_p, 2, 97); set_byte(str_p, 3, 105); set_byte(str_p, 4, 110); set_byte(str_p, 5, 0);
    set_byte(str_p, 6, 97); set_byte(str_p, 7, 100); set_byte(str_p, 8, 100); set_byte(str_p, 9, 0);

    # .shstrtab at sec_buf + 112:
    let shstr_p = sec_buf + 112;
    set_byte(shstr_p, 1, 46); set_byte(shstr_p, 2, 116); set_byte(shstr_p, 3, 101); set_byte(shstr_p, 4, 120); set_byte(shstr_p, 5, 116); set_byte(shstr_p, 6, 0);
    set_byte(shstr_p, 7, 46); set_byte(shstr_p, 8, 110); set_byte(shstr_p, 9, 111); set_byte(shstr_p, 10, 116); set_byte(shstr_p, 11, 101); set_byte(shstr_p, 12, 46); set_byte(shstr_p, 13, 71); set_byte(shstr_p, 14, 78); set_byte(shstr_p, 15, 85); set_byte(shstr_p, 16, 45); set_byte(shstr_p, 17, 115); set_byte(shstr_p, 18, 116); set_byte(shstr_p, 19, 97); set_byte(shstr_p, 20, 99); set_byte(shstr_p, 21, 107); set_byte(shstr_p, 22, 0);
    set_byte(shstr_p, 23, 46); set_byte(shstr_p, 24, 115); set_byte(shstr_p, 25, 121); set_byte(shstr_p, 26, 109); set_byte(shstr_p, 27, 116); set_byte(shstr_p, 28, 97); set_byte(shstr_p, 29, 98); set_byte(shstr_p, 30, 0);
    set_byte(shstr_p, 31, 46); set_byte(shstr_p, 32, 115); set_byte(shstr_p, 33, 116); set_byte(shstr_p, 34, 114); set_byte(shstr_p, 35, 116); set_byte(shstr_p, 36, 97); set_byte(shstr_p, 37, 98); set_byte(shstr_p, 38, 0);
    set_byte(shstr_p, 39, 46); set_byte(shstr_p, 40, 115); set_byte(shstr_p, 41, 104); set_byte(shstr_p, 42, 115); set_byte(shstr_p, 43, 116); set_byte(shstr_p, 44, 114); set_byte(shstr_p, 45, 116); set_byte(shstr_p, 46, 97); set_byte(shstr_p, 47, 98); set_byte(shstr_p, 48, 0);

    # Section Headers at sec_buf + 168 (6 * 64B = 384B):
    let shdr_base = sec_buf + 168;
    # Shdr 1: .text
    let sh1 = shdr_base + 64;
    set_byte(sh1, 0, 1);
    set_byte(sh1, 4, 1);
    set_qword(sh1, 1, 6);
    set_qword(sh1, 3, 64);
    set_qword(sh1, 4, code_len);
    set_qword(sh1, 6, 16);

    # Shdr 2: .note.GNU-stack (NX)
    let sh2 = shdr_base + 128;
    set_byte(sh2, 0, 7);
    set_byte(sh2, 4, 1);
    set_qword(sh2, 1, 0);
    set_qword(sh2, 3, note_off);
    set_qword(sh2, 4, 0);
    set_qword(sh2, 6, 1);

    # Shdr 3: .symtab
    let sh3 = shdr_base + 192;
    set_byte(sh3, 0, 23);
    set_byte(sh3, 4, 2);
    set_qword(sh3, 3, symtab_off);
    set_qword(sh3, 4, symtab_sz);
    set_byte(sh3, 40, 4); # link = 4 (.strtab)
    set_byte(sh3, 44, 2); # info = 2
    set_qword(sh3, 6, 8);
    set_qword(sh3, 7, 24);

    # Shdr 4: .strtab
    let sh4 = shdr_base + 256;
    set_byte(sh4, 0, 31);
    set_byte(sh4, 4, 3);
    set_qword(sh4, 3, strtab_off);
    set_qword(sh4, 4, strtab_sz);
    set_qword(sh4, 6, 1);

    # Shdr 5: .shstrtab
    let sh5 = shdr_base + 320;
    set_byte(sh5, 0, 39);
    set_byte(sh5, 4, 3);
    set_qword(sh5, 3, shstrtab_off);
    set_qword(sh5, 4, shstrtab_sz);
    set_qword(sh5, 6, 1);

    let total_sec_data = 552;

    let out_fd = sys_open(out_path, 577, 420);
    if out_fd < 0 { return -20; }

    let w_hdr = sys_write_all(out_fd, hdr, 64);
    if w_hdr != 64 { sys_close(out_fd); return -21; }

    let w_code = sys_write_all(out_fd, code_buf, code_len);
    if w_code != code_len { sys_close(out_fd); return -21; }

    if pad_len > 0 {
        let pad_buf = sys_mmap_page();
        let p_idx = 0;
        while p_idx < pad_len { set_byte(pad_buf, p_idx, 0); p_idx = p_idx + 1; }
        sys_write_all(out_fd, pad_buf, pad_len);
    }

    let w_sec = sys_write_all(out_fd, sec_buf, total_sec_data);
    sys_close(out_fd);
    if w_sec != total_sec_data { return -21; }

    return 64 + code_len + pad_len + total_sec_data;
}

fn write_elf_object(out_path: i64, code_buf: i64, code_len: i64): i64 {
    return write_elf_object_target(out_path, code_buf, code_len, TARGET_X86_64);
}

# ==============================================================================
# Rubix Execution eXchange (REX) Subsystem
# ==============================================================================

# ==============================================================================

# Rubix Execution eXchange (REX) — Format Specification & Constants

# File: compiler/rex/rex_format.bix

#

# REX is the portable execution exchange target of the Rubix compiler.

# Designed from first principles for safe, deterministic, structured value-flow execution.

# Zero CPU register emulation, zero fake CPU stack frames, zero JavaScript/Wasm dependency.

# ==============================================================================



# --- Header & Magic Constants ---

let REX_MAGIC_0 = 127; # 0x7F

let REX_MAGIC_1 = 82;  # 'R'

let REX_MAGIC_2 = 69;  # 'E'

let REX_MAGIC_3 = 88;  # 'X'

let REX_MAGIC_U32 = 1480995199; # 0x5845527F little-endian

let REX_VERSION_CURRENT = 1;



# --- Section Identifiers ---

let REX_SEC_TYPES     = 1;

let REX_SEC_FUNCTIONS = 2;

let REX_SEC_MEMORY    = 3;

let REX_SEC_DATA      = 4;

let REX_SEC_CODE      = 5;

let REX_SEC_EXPORTS   = 6;

let REX_SEC_METADATA  = 7;



# --- REX Primitive Types ---

let REX_TYPE_VOID = 0;

let REX_TYPE_I64  = 1;

let REX_TYPE_I32  = 2;

let REX_TYPE_F64  = 3;

let REX_TYPE_PTR  = 4;



# --- REX Opcodes ---

# Constants & Data Movement

let REX_OP_CONST_I64 = 1;   # 0x01: dst:u16, val:i64

let REX_OP_CONST_I32 = 2;   # 0x02: dst:u16, val:i32

let REX_OP_MOVE      = 3;   # 0x03: dst:u16, src:u16



# Arithmetic & Logic (64-bit)

let REX_OP_ADD_I64   = 16;  # 0x10: dst:u16, s1:u16, s2:u16

let REX_OP_SUB_I64   = 17;  # 0x11: dst:u16, s1:u16, s2:u16

let REX_OP_MUL_I64   = 18;  # 0x12: dst:u16, s1:u16, s2:u16

let REX_OP_DIV_I64   = 19;  # 0x13: dst:u16, s1:u16, s2:u16 (traps on div-by-zero)

let REX_OP_MOD_I64   = 20;  # 0x14: dst:u16, s1:u16, s2:u16 (traps on mod-by-zero)

let REX_OP_NEG_I64   = 21;  # 0x15: dst:u16, src:u16

let REX_OP_AND_I64   = 22;  # 0x16: dst:u16, s1:u16, s2:u16

let REX_OP_OR_I64    = 23;  # 0x17: dst:u16, s1:u16, s2:u16

let REX_OP_XOR_I64   = 24;  # 0x18: dst:u16, s1:u16, s2:u16

let REX_OP_NOT_I64   = 25;  # 0x19: dst:u16, src:u16

let REX_OP_SHL_I64   = 26;  # 0x1A: dst:u16, s1:u16, s2:u16

let REX_OP_SHR_I64   = 27;  # 0x1B: dst:u16, s1:u16, s2:u16



# Comparisons (result is i64: 1 for true, 0 for false)

let REX_OP_CMP_EQ    = 32;  # 0x20: dst:u16, s1:u16, s2:u16

let REX_OP_CMP_NE    = 33;  # 0x21: dst:u16, s1:u16, s2:u16

let REX_OP_CMP_LT    = 34;  # 0x22: dst:u16, s1:u16, s2:u16

let REX_OP_CMP_LE    = 35;  # 0x23: dst:u16, s1:u16, s2:u16

let REX_OP_CMP_GT    = 36;  # 0x24: dst:u16, s1:u16, s2:u16

let REX_OP_CMP_GE    = 37;  # 0x25: dst:u16, s1:u16, s2:u16



# Structured Control Flow

let REX_OP_JUMP      = 48;  # 0x30: target_pc:u32

let REX_OP_BRANCH    = 49;  # 0x31: cond:u16, target_true:u32, target_false:u32

let REX_OP_CALL      = 50;  # 0x32: dst:u16, func_idx:u32, arg_cnt:u16, args:[u16...]

let REX_OP_RETURN    = 51;  # 0x33: src:u16 (or 0xFFFF for void)

let REX_OP_TRAP      = 52;  # 0x34: code:u16



# Memory Operations (Bounded Linear Memory)

let REX_OP_LOAD_64   = 64;  # 0x40: dst:u16, base:u16, offset:i32

let REX_OP_STORE_64  = 65;  # 0x41: base:u16, val:u16, offset:i32

let REX_OP_LOAD_8    = 66;  # 0x42: dst:u16, base:u16, offset:i32

let REX_OP_STORE_8   = 67;  # 0x43: base:u16, val:u16, offset:i32

let REX_OP_ALLOC_MEM = 68;  # 0x44: dst:u16, size:u32

let REX_OP_ADDR_LOCAL= 69;  # 0x45: dst:u16, offset:u32



# Type Conversion

let REX_OP_CONV      = 80;  # 0x50: dst:u16, src:u16, from_type:u8, to_type:u8



# --- REX Validator & Runtime Trap / Error Codes ---

let REX_OK                  = 0;

let REX_ERR_BAD_MAGIC       = -101;

let REX_ERR_UNSUPPORTED_VER = -102;

let REX_ERR_TRUNCATED       = -103;

let REX_ERR_BAD_SECTION_LEN = -104;

let REX_ERR_DUPLICATE_SEC   = -105;

let REX_ERR_INVALID_FUNC_IDX= -106;

let REX_ERR_INVALID_VAL_SLOT= -107;

let REX_ERR_INVALID_OPCODE  = -108;

let REX_ERR_BAD_BRANCH_TGT  = -109;

let REX_ERR_TYPE_MISMATCH   = -110;

let REX_ERR_NO_MAIN_EXPORT  = -111;

let REX_ERR_CALL_ARITY      = -112;



# Runtime Trap Codes

let REX_TRAP_NONE           = 0;

let REX_TRAP_DIV_BY_ZERO    = 1;

let REX_TRAP_OUT_OF_BOUNDS  = 2;

let REX_TRAP_STACK_OVERFLOW = 3;

let REX_TRAP_ILLEGAL_STATE  = 4;

let REX_TRAP_EXPLICIT       = 5;
# ==============================================================================

# Rubix Execution eXchange (REX) — Binary Module Encoder

# File: compiler/rex/rex_encoder.bix

#

# Low-level deterministic binary serialization for .rex modules.

# Provides primitives for writing typed values, instruction streams, and sections.

# ==============================================================================





fn rex_emit_u8(buf: i64, p: i64, b: i64): i64 {

    set_byte(buf, p, b & 255);

    return p + 1;

}



fn rex_emit_u16(buf: i64, p: i64, v: i64): i64 {

    set_byte(buf, p + 0, v & 255);

    set_byte(buf, p + 1, (v >> 8) & 255);

    return p + 2;

}



fn rex_emit_u32(buf: i64, p: i64, v: i64): i64 {

    set_byte(buf, p + 0, v & 255);

    set_byte(buf, p + 1, (v >> 8) & 255);

    set_byte(buf, p + 2, (v >> 16) & 255);

    set_byte(buf, p + 3, (v >> 24) & 255);

    return p + 4;

}



fn rex_emit_u64(buf: i64, p: i64, v: i64): i64 {

    set_byte(buf, p + 0, v & 255);

    set_byte(buf, p + 1, (v >> 8) & 255);

    set_byte(buf, p + 2, (v >> 16) & 255);

    set_byte(buf, p + 3, (v >> 24) & 255);

    set_byte(buf, p + 4, (v >> 32) & 255);

    set_byte(buf, p + 5, (v >> 40) & 255);

    set_byte(buf, p + 6, (v >> 48) & 255);

    set_byte(buf, p + 7, (v >> 56) & 255);

    return p + 8;

}



fn rex_emit_i32(buf: i64, p: i64, v: i64): i64 {

    return rex_emit_u32(buf, p, v);

}



fn rex_emit_i64(buf: i64, p: i64, v: i64): i64 {

    return rex_emit_u64(buf, p, v);

}



# Emits the 16-byte REX module header

fn rex_emit_header(buf: i64, flags: i64, total_size: i64, section_count: i64): i64 {

    set_byte(buf, 0, REX_MAGIC_0); # 0x7F

    set_byte(buf, 1, REX_MAGIC_1); # 'R'

    set_byte(buf, 2, REX_MAGIC_2); # 'E'

    set_byte(buf, 3, REX_MAGIC_3); # 'X'

    rex_emit_u16(buf, 4, REX_VERSION_CURRENT);

    rex_emit_u16(buf, 6, flags);

    rex_emit_u32(buf, 8, total_size);

    rex_emit_u32(buf, 12, section_count);

    return 16;

}



# Emits a section header: [sec_id: u8] [sec_len: u32]

fn rex_emit_section_hdr(buf: i64, p: i64, sec_id: i64, sec_len: i64): i64 {

    let cur = rex_emit_u8(buf, p, sec_id);

    cur = rex_emit_u32(buf, cur, sec_len);

    return cur;

}



# --- Instruction Encoders ---



fn rex_enc_const_i64(buf: i64, p: i64, dst: i64, val: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_CONST_I64);

    cur = rex_emit_u16(buf, cur, dst);

    cur = rex_emit_i64(buf, cur, val);

    return cur;

}



fn rex_enc_const_i32(buf: i64, p: i64, dst: i64, val: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_CONST_I32);

    cur = rex_emit_u16(buf, cur, dst);

    cur = rex_emit_i32(buf, cur, val);

    return cur;

}



fn rex_enc_move(buf: i64, p: i64, dst: i64, src: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_MOVE);

    cur = rex_emit_u16(buf, cur, dst);

    cur = rex_emit_u16(buf, cur, src);

    return cur;

}



fn rex_enc_bin_op(buf: i64, p: i64, op: i64, dst: i64, s1: i64, s2: i64): i64 {

    let cur = rex_emit_u8(buf, p, op);

    cur = rex_emit_u16(buf, cur, dst);

    cur = rex_emit_u16(buf, cur, s1);

    cur = rex_emit_u16(buf, cur, s2);

    return cur;

}



fn rex_enc_unary_op(buf: i64, p: i64, op: i64, dst: i64, src: i64): i64 {

    let cur = rex_emit_u8(buf, p, op);

    cur = rex_emit_u16(buf, cur, dst);

    cur = rex_emit_u16(buf, cur, src);

    return cur;

}



fn rex_enc_jump(buf: i64, p: i64, target_pc: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_JUMP);

    cur = rex_emit_u32(buf, cur, target_pc);

    return cur;

}



fn rex_enc_branch(buf: i64, p: i64, cond: i64, target_t: i64, target_f: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_BRANCH);

    cur = rex_emit_u16(buf, cur, cond);

    cur = rex_emit_u32(buf, cur, target_t);

    cur = rex_emit_u32(buf, cur, target_f);

    return cur;

}



fn rex_enc_call(buf: i64, p: i64, dst: i64, func_idx: i64, arg_cnt: i64, args_buf: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_CALL);

    cur = rex_emit_u16(buf, cur, dst);

    cur = rex_emit_u32(buf, cur, func_idx);

    cur = rex_emit_u16(buf, cur, arg_cnt);

    let i = 0;

    while i < arg_cnt {

        let arg_slot = get_qword(args_buf, i);

        cur = rex_emit_u16(buf, cur, arg_slot);

        i = i + 1;

    }

    return cur;

}



fn rex_enc_return(buf: i64, p: i64, src: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_RETURN);

    cur = rex_emit_u16(buf, cur, src);

    return cur;

}



fn rex_enc_trap(buf: i64, p: i64, code: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_TRAP);

    cur = rex_emit_u16(buf, cur, code);

    return cur;

}



fn rex_enc_load64(buf: i64, p: i64, dst: i64, base: i64, offset: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_LOAD_64);

    cur = rex_emit_u16(buf, cur, dst);

    cur = rex_emit_u16(buf, cur, base);

    cur = rex_emit_i32(buf, cur, offset);

    return cur;

}



fn rex_enc_store64(buf: i64, p: i64, base: i64, val: i64, offset: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_STORE_64);

    cur = rex_emit_u16(buf, cur, base);

    cur = rex_emit_u16(buf, cur, val);

    cur = rex_emit_i32(buf, cur, offset);

    return cur;

}



fn rex_enc_alloc_mem(buf: i64, p: i64, dst: i64, size: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_ALLOC_MEM);

    cur = rex_emit_u16(buf, cur, dst);

    cur = rex_emit_u32(buf, cur, size);

    return cur;

}



fn rex_enc_addr_local(buf: i64, p: i64, dst: i64, offset: i64): i64 {

    let cur = rex_emit_u8(buf, p, REX_OP_ADDR_LOCAL);

    cur = rex_emit_u16(buf, cur, dst);

    cur = rex_emit_u32(buf, cur, offset);

    return cur;

}
# ==============================================================================

# Rubix Execution eXchange (REX) — Binary Module Decoder

# File: compiler/rex/rex_decoder.bix

#

# Zero-copy binary parser for .rex modules.

# Provides safe reading primitives and section table discovery.

# ==============================================================================





fn rex_read_u8(buf: i64, p: i64): i64 {

    return get_byte(buf, p);

}



fn rex_read_u16(buf: i64, p: i64): i64 {

    let b0 = get_byte(buf, p + 0);

    let b1 = get_byte(buf, p + 1);

    return b0 | (b1 << 8);

}



fn rex_read_u32(buf: i64, p: i64): i64 {

    let b0 = get_byte(buf, p + 0);

    let b1 = get_byte(buf, p + 1);

    let b2 = get_byte(buf, p + 2);

    let b3 = get_byte(buf, p + 3);

    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);

}



fn rex_read_i32(buf: i64, p: i64): i64 {

    let v = rex_read_u32(buf, p);

    if (v & 2147483648) != 0 { # Sign bit set

        return v - 4294967296;

    }

    return v;

}



fn rex_read_u64(buf: i64, p: i64): i64 {

    let b0 = get_byte(buf, p + 0);

    let b1 = get_byte(buf, p + 1);

    let b2 = get_byte(buf, p + 2);

    let b3 = get_byte(buf, p + 3);

    let b4 = get_byte(buf, p + 4);

    let b5 = get_byte(buf, p + 5);

    let b6 = get_byte(buf, p + 6);

    let b7 = get_byte(buf, p + 7);

    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);

}



fn rex_read_i64(buf: i64, p: i64): i64 {

    return rex_read_u64(buf, p);

}



# Decodes REX header: checks magic, version, size.

# out_hdr layout:

#   [0]: version

#   [1]: flags

#   [2]: total_size

#   [3]: section_count

fn rex_decode_header(buf: i64, len: i64, out_hdr: i64): i64 {

    if len < 16 {

        return REX_ERR_TRUNCATED;

    }

    if get_byte(buf, 0) != REX_MAGIC_0 { return REX_ERR_BAD_MAGIC; }

    if get_byte(buf, 1) != REX_MAGIC_1 { return REX_ERR_BAD_MAGIC; }

    if get_byte(buf, 2) != REX_MAGIC_2 { return REX_ERR_BAD_MAGIC; }

    if get_byte(buf, 3) != REX_MAGIC_3 { return REX_ERR_BAD_MAGIC; }



    let ver = rex_read_u16(buf, 4);

    if ver != REX_VERSION_CURRENT {

        return REX_ERR_UNSUPPORTED_VER;

    }



    let flags = rex_read_u16(buf, 6);

    let total_size = rex_read_u32(buf, 8);

    let sec_cnt = rex_read_u32(buf, 12);



    if total_size > len {

        return REX_ERR_TRUNCATED;

    }

    if total_size < 16 {

        return REX_ERR_TRUNCATED;

    }



    set_qword(out_hdr, 0, ver);

    set_qword(out_hdr, 1, flags);

    set_qword(out_hdr, 2, total_size);

    set_qword(out_hdr, 3, sec_cnt);

    return REX_OK;

}



# Locates all sections in the module.

# sec_tbl layout: 16 slots * 2 qwords:

#   sec_tbl[sec_id * 2 + 0] = offset (from buf start)

#   sec_tbl[sec_id * 2 + 1] = length

fn rex_locate_sections(buf: i64, total_size: i64, sec_cnt: i64, sec_tbl: i64): i64 {

    let i = 0;

    while i < 32 {

        set_qword(sec_tbl, i, 0);

        i = i + 1;

    }



    let p = 16;

    let s_idx = 0;

    while s_idx < sec_cnt {

        if p + 5 > total_size {

            return REX_ERR_TRUNCATED;

        }

        let sec_id = rex_read_u8(buf, p);

        let sec_len = rex_read_u32(buf, p + 1);

        p = p + 5;



        if p + sec_len > total_size {

            return REX_ERR_BAD_SECTION_LEN;

        }



        if (sec_id > 0) & (sec_id < 16) {

            if get_qword(sec_tbl, sec_id * 2 + 1) > 0 {

                return REX_ERR_DUPLICATE_SEC;

            }

            set_qword(sec_tbl, sec_id * 2 + 0, p);

            set_qword(sec_tbl, sec_id * 2 + 1, sec_len);

        }



        p = p + sec_len;

        s_idx = s_idx + 1;

    }

    return REX_OK;

}
# ==============================================================================

# Rubix Execution eXchange (REX) — Pre-Execution Module Validator

# File: compiler/rex/rex_validator.bix

#

# Validates REX binary modules before execution:

# 1. Structural integrity (magic, version, sizes, section containment).

# 2. Type system and function signature correctness.

# 3. Value-slot bounds checking (all operand slots < function.local_count).

# 4. Control-flow validity (all jumps/branches land on valid instruction starts).

# 5. Call arity and export integrity.

# Reject malformed or untrusted modules before execution without crashing the host.

# ==============================================================================





fn rex_validate_module(buf: i64, len: i64): i64 {

    let hdr = sys_mmap_page();

    let res = rex_decode_header(buf, len, hdr);

    if res != REX_OK {

        return res;

    }



    let total_size = get_qword(hdr, 2);

    let sec_cnt = get_qword(hdr, 3);



    let sec_tbl = sys_mmap_page();

    res = rex_locate_sections(buf, total_size, sec_cnt, sec_tbl);

    if res != REX_OK {

        return res;

    }



    # 1. Validate Types Section

    let types_off = get_qword(sec_tbl, REX_SEC_TYPES * 2 + 0);

    let types_len = get_qword(sec_tbl, REX_SEC_TYPES * 2 + 1);

    if types_len < 4 {

        return REX_ERR_TRUNCATED;

    }



    let type_cnt = rex_read_u32(buf, types_off);

    let tp = types_off + 4;

    let types_end = types_off + types_len;



    # Table to store type signature param counts and return types for later checking

    # 256 types max in validation buffer: [param_cnt, ret_type]

    let type_info_tbl = sys_mmap_page();



    let ti = 0;

    while ti < type_cnt {

        if tp + 3 > types_end {

            return REX_ERR_TRUNCATED;

        }

        let p_cnt = rex_read_u16(buf, tp);

        tp = tp + 2;

        if tp + p_cnt + 1 > types_end {

            return REX_ERR_TRUNCATED;

        }

        let pi = 0;

        while pi < p_cnt {

            let pt = rex_read_u8(buf, tp + pi);

            if (pt < REX_TYPE_I64) | (pt > REX_TYPE_PTR) {

                return REX_ERR_TYPE_MISMATCH;

            }

            pi = pi + 1;

        }

        tp = tp + p_cnt;

        let ret_t = rex_read_u8(buf, tp);

        tp = tp + 1;

        if ret_t > REX_TYPE_PTR {

            return REX_ERR_TYPE_MISMATCH;

        }



        if ti < 256 {

            set_qword(type_info_tbl, ti * 2 + 0, p_cnt);

            set_qword(type_info_tbl, ti * 2 + 1, ret_t);

        }

        ti = ti + 1;

    }



    # 2. Validate Functions Section

    let funcs_off = get_qword(sec_tbl, REX_SEC_FUNCTIONS * 2 + 0);

    let funcs_len = get_qword(sec_tbl, REX_SEC_FUNCTIONS * 2 + 1);

    if funcs_len < 4 {

        return REX_ERR_TRUNCATED;

    }



    let func_cnt = rex_read_u32(buf, funcs_off);

    let fp = funcs_off + 4;

    let funcs_end = funcs_off + funcs_len;



    # Function metadata table: [type_idx, local_cnt, code_off, code_len]

    let func_info_tbl = sys_mmap(0, 65536, 3, 34, -1, 0);



    let fi = 0;

    while fi < func_cnt {

        if fp + 6 > funcs_end {

            return REX_ERR_TRUNCATED;

        }

        let t_idx = rex_read_u32(buf, fp);

        let l_cnt = rex_read_u16(buf, fp + 4);

        fp = fp + 6;



        if t_idx >= type_cnt {

            return REX_ERR_TYPE_MISMATCH;

        }

        let p_cnt = get_qword(type_info_tbl, t_idx * 2 + 0);

        if l_cnt < p_cnt {

            return REX_ERR_INVALID_VAL_SLOT;

        }



        set_qword(func_info_tbl, fi * 4 + 0, t_idx);

        set_qword(func_info_tbl, fi * 4 + 1, l_cnt);

        fi = fi + 1;

    }



    # 3. Validate Memory Section (if present)

    let mem_off = get_qword(sec_tbl, REX_SEC_MEMORY * 2 + 0);

    let mem_len = get_qword(sec_tbl, REX_SEC_MEMORY * 2 + 1);

    if mem_len > 0 {

        if mem_len < 8 { return REX_ERR_TRUNCATED; }

        let init_b = rex_read_u32(buf, mem_off);

        let max_b = rex_read_u32(buf, mem_off + 4);

        if (init_b == 0) | (init_b > max_b) {

            return REX_ERR_BAD_SECTION_LEN;

        }

    }



    # 4. Validate Code Section

    let code_off = get_qword(sec_tbl, REX_SEC_CODE * 2 + 0);

    let code_len = get_qword(sec_tbl, REX_SEC_CODE * 2 + 1);

    if code_len < 4 {

        return REX_ERR_TRUNCATED;

    }



    let code_func_cnt = rex_read_u32(buf, code_off);

    if code_func_cnt != func_cnt {

        return REX_ERR_BAD_SECTION_LEN;

    }



    let cp = code_off + 4;

    let code_end = code_off + code_len;



    fi = 0;

    while fi < func_cnt {

        if cp + 4 > code_end {

            return REX_ERR_TRUNCATED;

        }

        let body_len = rex_read_u32(buf, cp);

        cp = cp + 4;

        let body_start = cp;

        let body_end = cp + body_len;

        if body_end > code_end {

            return REX_ERR_TRUNCATED;

        }



        set_qword(func_info_tbl, fi * 4 + 2, body_start);

        set_qword(func_info_tbl, fi * 4 + 3, body_len);



        let local_cnt = get_qword(func_info_tbl, fi * 4 + 1);

        let t_idx = get_qword(func_info_tbl, fi * 4 + 0);

        let ret_t = get_qword(type_info_tbl, t_idx * 2 + 1);



        # Instruction boundaries table for this function: up to 4096 instructions

        let inst_starts = sys_mmap(0, 32768, 3, 34, -1, 0);

        let inst_cnt = 0;



        # Pass 1: Decode & record instruction start offsets, check operand slots

        let ip = body_start;

        while ip < body_end {

            let rel_offset = ip - body_start;

            set_qword(inst_starts, inst_cnt, rel_offset);

            inst_cnt = inst_cnt + 1;



            let op = rex_read_u8(buf, ip);

            ip = ip + 1;



            let valid_op = 0;

            if op == REX_OP_CONST_I64 {

                if ip + 10 > body_end { return REX_ERR_TRUNCATED; }

                let dst = rex_read_u16(buf, ip);

                if dst >= local_cnt { return REX_ERR_INVALID_VAL_SLOT; }

                ip = ip + 10;

                valid_op = 1;

            }

            if op == REX_OP_CONST_I32 {

                if ip + 6 > body_end { return REX_ERR_TRUNCATED; }

                let dst = rex_read_u16(buf, ip);

                if dst >= local_cnt { return REX_ERR_INVALID_VAL_SLOT; }

                ip = ip + 6;

                valid_op = 1;

            }

            if op == REX_OP_MOVE {

                if ip + 4 > body_end { return REX_ERR_TRUNCATED; }

                let dst = rex_read_u16(buf, ip);

                let src = rex_read_u16(buf, ip + 2);

                if (dst >= local_cnt) | (src >= local_cnt) { return REX_ERR_INVALID_VAL_SLOT; }

                ip = ip + 4;

                valid_op = 1;

            }

            if (op >= REX_OP_ADD_I64) & (op <= REX_OP_SHR_I64) {

                # Binary or Unary

                if (op == REX_OP_NEG_I64) | (op == REX_OP_NOT_I64) {

                    if ip + 4 > body_end { return REX_ERR_TRUNCATED; }

                    let dst = rex_read_u16(buf, ip);

                    let src = rex_read_u16(buf, ip + 2);

                    if (dst >= local_cnt) | (src >= local_cnt) { return REX_ERR_INVALID_VAL_SLOT; }

                    ip = ip + 4;

                } else {

                    if ip + 6 > body_end { return REX_ERR_TRUNCATED; }

                    let dst = rex_read_u16(buf, ip);

                    let s1 = rex_read_u16(buf, ip + 2);

                    let s2 = rex_read_u16(buf, ip + 4);

                    if (dst >= local_cnt) | (s1 >= local_cnt) | (s2 >= local_cnt) { return REX_ERR_INVALID_VAL_SLOT; }

                    ip = ip + 6;

                }

                valid_op = 1;

            }

            if (op >= REX_OP_CMP_EQ) & (op <= REX_OP_CMP_GE) {

                if ip + 6 > body_end { return REX_ERR_TRUNCATED; }

                let dst = rex_read_u16(buf, ip);

                let s1 = rex_read_u16(buf, ip + 2);

                let s2 = rex_read_u16(buf, ip + 4);

                if (dst >= local_cnt) | (s1 >= local_cnt) | (s2 >= local_cnt) { return REX_ERR_INVALID_VAL_SLOT; }

                ip = ip + 6;

                valid_op = 1;

            }

            if op == REX_OP_JUMP {

                if ip + 4 > body_end { return REX_ERR_TRUNCATED; }

                ip = ip + 4;

                valid_op = 1;

            }

            if op == REX_OP_BRANCH {

                if ip + 10 > body_end { return REX_ERR_TRUNCATED; }

                let cond = rex_read_u16(buf, ip);

                if cond >= local_cnt { return REX_ERR_INVALID_VAL_SLOT; }

                ip = ip + 10;

                valid_op = 1;

            }

            if op == REX_OP_CALL {

                if ip + 8 > body_end { return REX_ERR_TRUNCATED; }

                let dst = rex_read_u16(buf, ip);

                let call_fidx = rex_read_u32(buf, ip + 2);

                let arg_cnt = rex_read_u16(buf, ip + 6);

                ip = ip + 8;

                if call_fidx >= func_cnt { return REX_ERR_INVALID_FUNC_IDX; }

                if (dst != 65535) & (dst >= local_cnt) { return REX_ERR_INVALID_VAL_SLOT; }

                if ip + (arg_cnt * 2) > body_end { return REX_ERR_TRUNCATED; }

                let ai = 0;

                while ai < arg_cnt {

                    let aslot = rex_read_u16(buf, ip + (ai * 2));

                    if aslot >= local_cnt { return REX_ERR_INVALID_VAL_SLOT; }

                    ai = ai + 1;

                }

                ip = ip + (arg_cnt * 2);

                valid_op = 1;

            }

            if op == REX_OP_RETURN {

                if ip + 2 > body_end { return REX_ERR_TRUNCATED; }

                let rslot = rex_read_u16(buf, ip);

                if ret_t == REX_TYPE_VOID {

                    if rslot != 65535 { return REX_ERR_TYPE_MISMATCH; }

                } else {

                    if rslot >= local_cnt { return REX_ERR_INVALID_VAL_SLOT; }

                }

                ip = ip + 2;

                valid_op = 1;

            }

            if op == REX_OP_TRAP {

                if ip + 2 > body_end { return REX_ERR_TRUNCATED; }

                ip = ip + 2;

                valid_op = 1;

            }

            if (op == REX_OP_LOAD_64) | (op == REX_OP_LOAD_8) {

                if ip + 8 > body_end { return REX_ERR_TRUNCATED; }

                let dst = rex_read_u16(buf, ip);

                let base = rex_read_u16(buf, ip + 2);

                if (dst >= local_cnt) | (base >= local_cnt) { return REX_ERR_INVALID_VAL_SLOT; }

                ip = ip + 8;

                valid_op = 1;

            }

            if (op == REX_OP_STORE_64) | (op == REX_OP_STORE_8) {

                if ip + 8 > body_end { return REX_ERR_TRUNCATED; }

                let base = rex_read_u16(buf, ip);

                let val = rex_read_u16(buf, ip + 2);

                if (base >= local_cnt) | (val >= local_cnt) { return REX_ERR_INVALID_VAL_SLOT; }

                ip = ip + 8;

                valid_op = 1;

            }

            if op == REX_OP_ALLOC_MEM {

                if ip + 6 > body_end { return REX_ERR_TRUNCATED; }

                let dst = rex_read_u16(buf, ip);

                if dst >= local_cnt { return REX_ERR_INVALID_VAL_SLOT; }

                ip = ip + 6;

                valid_op = 1;

            }

            if op == REX_OP_ADDR_LOCAL {

                if ip + 6 > body_end { return REX_ERR_TRUNCATED; }

                let dst = rex_read_u16(buf, ip);

                if dst >= local_cnt { return REX_ERR_INVALID_VAL_SLOT; }

                ip = ip + 6;

                valid_op = 1;

            }

            if valid_op == 0 {

                return REX_ERR_INVALID_OPCODE;

            }

        }



        # Pass 2: Verify branch target validity

        ip = body_start;

        while ip < body_end {

            let op = rex_read_u8(buf, ip);

            ip = ip + 1;

            if op == REX_OP_CONST_I64 { ip = ip + 10; }

            if op == REX_OP_CONST_I32 { ip = ip + 6; }

            if op == REX_OP_MOVE { ip = ip + 4; }

            if (op >= REX_OP_ADD_I64) & (op <= REX_OP_SHR_I64) {

                if (op == REX_OP_NEG_I64) | (op == REX_OP_NOT_I64) { ip = ip + 4; }

                else { ip = ip + 6; }

            }

            if (op >= REX_OP_CMP_EQ) & (op <= REX_OP_CMP_GE) { ip = ip + 6; }

            if op == REX_OP_JUMP {

                let tgt = rex_read_u32(buf, ip);

                ip = ip + 4;

                let found = 0;

                let ii = 0;

                while ii < inst_cnt {

                    if get_qword(inst_starts, ii) == tgt { found = 1; }

                    ii = ii + 1;

                }

                if found == 0 { return REX_ERR_BAD_BRANCH_TGT; }

            }

            if op == REX_OP_BRANCH {

                ip = ip + 2; # skip cond

                let tgt_t = rex_read_u32(buf, ip);

                let tgt_f = rex_read_u32(buf, ip + 4);

                ip = ip + 8;

                let found_t = 0;

                let found_f = 0;

                let ii = 0;

                while ii < inst_cnt {

                    let istart = get_qword(inst_starts, ii);

                    if istart == tgt_t { found_t = 1; }

                    if istart == tgt_f { found_f = 1; }

                    ii = ii + 1;

                }

                if (found_t == 0) | (found_f == 0) { return REX_ERR_BAD_BRANCH_TGT; }

            }

            if op == REX_OP_CALL {

                let arg_cnt = rex_read_u16(buf, ip + 6);

                ip = ip + 8 + (arg_cnt * 2);

            }

            if op == REX_OP_RETURN { ip = ip + 2; }

            if op == REX_OP_TRAP { ip = ip + 2; }

            if (op == REX_OP_LOAD_64) | (op == REX_OP_LOAD_8) { ip = ip + 8; }

            if (op == REX_OP_STORE_64) | (op == REX_OP_STORE_8) { ip = ip + 8; }

            if (op == REX_OP_ALLOC_MEM) | (op == REX_OP_ADDR_LOCAL) { ip = ip + 6; }

        }



        cp = body_end;

        fi = fi + 1;

    }



    # 5. Validate Exports Section

    let exp_off = get_qword(sec_tbl, REX_SEC_EXPORTS * 2 + 0);

    let exp_len = get_qword(sec_tbl, REX_SEC_EXPORTS * 2 + 1);

    if exp_len < 4 {

        return REX_ERR_TRUNCATED;

    }

    let exp_cnt = rex_read_u32(buf, exp_off);

    if exp_cnt == 0 {

        return REX_ERR_NO_MAIN_EXPORT;

    }



    let ep = exp_off + 4;

    let exp_end = exp_off + exp_len;

    let found_main = 0;

    let ei = 0;

    while ei < exp_cnt {

        if ep + 12 > exp_end {

            return REX_ERR_TRUNCATED;

        }

        let nhash = rex_read_u64(buf, ep);

        let fidx = rex_read_u32(buf, ep + 8);

        ep = ep + 12;



        if fidx >= func_cnt {

            return REX_ERR_INVALID_FUNC_IDX;

        }

        # FN_HASH_MAIN = 6385467242

        if nhash == 6385467242 {

            found_main = 1;

        }

        ei = ei + 1;

    }



    if found_main == 0 {

        return REX_ERR_NO_MAIN_EXPORT;

    }



    return REX_OK;

}
# ==============================================================================

# Rubix Execution eXchange (REX) — Reference Execution Engine

# File: compiler/rex/rex_vm.bix

#

# Reference execution engine for validated .rex modules.

# Provides deterministic execution with bounded linear memory and runtime safety.

# Zero CPU register emulation, zero fake CPU stack frames.

# ==============================================================================





fn rex_vm_execute(buf: i64, len: i64): i64 {

    # 1. Pre-execution validation

    let v_res = rex_validate_module(buf, len);

    if v_res != REX_OK {

        return v_res;

    }



    let hdr = sys_mmap_page();

    rex_decode_header(buf, len, hdr);

    let total_size = get_qword(hdr, 2);

    let sec_cnt = get_qword(hdr, 3);



    let sec_tbl = sys_mmap_page();

    rex_locate_sections(buf, total_size, sec_cnt, sec_tbl);



    # 2. Extract function table from SEC_FUNCTIONS and SEC_CODE

    let funcs_off = get_qword(sec_tbl, REX_SEC_FUNCTIONS * 2 + 0);

    let func_cnt = rex_read_u32(buf, funcs_off);



    # Function table: [func_idx * 4]:

    #   slot 0: type_idx

    #   slot 1: local_cnt

    #   slot 2: body_start

    #   slot 3: body_len

    let func_tbl = sys_mmap(0, 65536, 3, 34, -1, 0);



    let fp = funcs_off + 4;

    let fi = 0;

    while fi < func_cnt {

        let t_idx = rex_read_u32(buf, fp);

        let l_cnt = rex_read_u16(buf, fp + 4);

        fp = fp + 6;

        set_qword(func_tbl, fi * 4 + 0, t_idx);

        set_qword(func_tbl, fi * 4 + 1, l_cnt);

        fi = fi + 1;

    }



    let code_off = get_qword(sec_tbl, REX_SEC_CODE * 2 + 0);

    let cp = code_off + 4;

    fi = 0;

    while fi < func_cnt {

        let b_len = rex_read_u32(buf, cp);

        cp = cp + 4;

        set_qword(func_tbl, fi * 4 + 2, cp);

        set_qword(func_tbl, fi * 4 + 3, b_len);

        cp = cp + b_len;

        fi = fi + 1;

    }



    # 3. Locate entry point ("main") from SEC_EXPORTS

    let exp_off = get_qword(sec_tbl, REX_SEC_EXPORTS * 2 + 0);

    let exp_cnt = rex_read_u32(buf, exp_off);

    let ep = exp_off + 4;

    let main_fidx = -1;

    let ei = 0;

    while ei < exp_cnt {

        let nhash = rex_read_u64(buf, ep);

        let fidx = rex_read_u32(buf, ep + 8);

        ep = ep + 12;

        # FN_HASH_MAIN = 6385467242

        if nhash == 6385467242 {

            main_fidx = fidx;

        }

        ei = ei + 1;

    }

    if main_fidx < 0 {

        return REX_ERR_NO_MAIN_EXPORT;

    }



    # 4. Allocate and initialize bounded linear memory

    let mem_size = 65536; # Default 64KB

    let mem_off = get_qword(sec_tbl, REX_SEC_MEMORY * 2 + 0);

    let mem_sec_len = get_qword(sec_tbl, REX_SEC_MEMORY * 2 + 1);

    if mem_sec_len >= 8 {

        let req_init = rex_read_u32(buf, mem_off);

        if req_init > mem_size {

            mem_size = req_init;

        }

    }

    let mem_buf = sys_mmap(0, mem_size, 3, 34, -1, 0);

    let mem_alloc_ptr = 1024; # Reserve first 1KB for low scratch/metadata



    # Copy static data segments into memory

    let data_off = get_qword(sec_tbl, REX_SEC_DATA * 2 + 0);

    let data_len = get_qword(sec_tbl, REX_SEC_DATA * 2 + 1);

    if data_len > 4 {

        let seg_cnt = rex_read_u32(buf, data_off);

        let dp = data_off + 4;

        let si = 0;

        while si < seg_cnt {

            let seg_offset = rex_read_u32(buf, dp);

            let seg_bytes = rex_read_u32(buf, dp + 4);

            dp = dp + 8;

            let bi = 0;

            while bi < seg_bytes {

                set_byte(mem_buf, seg_offset + bi, get_byte(buf, dp + bi));

                bi = bi + 1;

            }

            dp = dp + seg_bytes;

            si = si + 1;

        }

    }



    # 5. Call Frame Stack Management

    # Max call depth: 1024 frames

    # Each frame in call_stack: [func_idx, pc, locals_ptr, return_dst_slot, return_next_pc]

    let call_stack = sys_mmap(0, 65536, 3, 34, -1, 0);

    # Value slots arena: 1024 frames * 128 slots * 8 bytes = 1MB

    let locals_arena = sys_mmap(0, 1048576, 3, 34, -1, 0);

    let depth = 0;



    # Push main function frame

    let cur_fidx = main_fidx;

    let cur_bstart = get_qword(func_tbl, cur_fidx * 4 + 2);

    let cur_blen = get_qword(func_tbl, cur_fidx * 4 + 3);

    let cur_pc = 0;

    let cur_locals = locals_arena;



    set_qword(call_stack, 0, cur_fidx);

    set_qword(call_stack, 1, 0);

    set_qword(call_stack, 2, cur_locals);

    set_qword(call_stack, 3, -1);

    set_qword(call_stack, 4, 0);



    # Step limit to detect infinite loops: 10,000,000 steps

    let steps = 0;

    let running = 1;

    let final_result = 0;



    while (running == 1) & (steps < 10000000) {

        steps = steps + 1;

        if cur_pc >= cur_blen {

            return REX_TRAP_ILLEGAL_STATE;

        }



        let ip = cur_bstart + cur_pc;

        let op = rex_read_u8(buf, ip);



        if op == REX_OP_CONST_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let val = rex_read_i64(buf, ip + 3);

            set_qword(cur_locals, dst, val);

            cur_pc = cur_pc + 11;

        }

        if op == REX_OP_CONST_I32 {

            let dst = rex_read_u16(buf, ip + 1);

            let val = rex_read_i32(buf, ip + 3);

            set_qword(cur_locals, dst, val);

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_MOVE {

            let dst = rex_read_u16(buf, ip + 1);

            let src = rex_read_u16(buf, ip + 3);

            set_qword(cur_locals, dst, get_qword(cur_locals, src));

            cur_pc = cur_pc + 5;

        }

        if op == REX_OP_ADD_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            set_qword(cur_locals, dst, get_qword(cur_locals, s1) + get_qword(cur_locals, s2));

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_SUB_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            set_qword(cur_locals, dst, get_qword(cur_locals, s1) - get_qword(cur_locals, s2));

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_MUL_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            set_qword(cur_locals, dst, get_qword(cur_locals, s1) * get_qword(cur_locals, s2));

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_DIV_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            let denom = get_qword(cur_locals, s2);

            if denom == 0 {

                return 0 - REX_TRAP_DIV_BY_ZERO;

            }

            set_qword(cur_locals, dst, get_qword(cur_locals, s1) / denom);

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_MOD_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            let denom = get_qword(cur_locals, s2);

            if denom == 0 {

                return 0 - REX_TRAP_DIV_BY_ZERO;

            }

            set_qword(cur_locals, dst, get_qword(cur_locals, s1) % denom);

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_NEG_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let src = rex_read_u16(buf, ip + 3);

            set_qword(cur_locals, dst, 0 - get_qword(cur_locals, src));

            cur_pc = cur_pc + 5;

        }

        if op == REX_OP_AND_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            set_qword(cur_locals, dst, get_qword(cur_locals, s1) & get_qword(cur_locals, s2));

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_OR_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            set_qword(cur_locals, dst, get_qword(cur_locals, s1) | get_qword(cur_locals, s2));

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_XOR_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            set_qword(cur_locals, dst, get_qword(cur_locals, s1) ^ get_qword(cur_locals, s2));

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_NOT_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let src = rex_read_u16(buf, ip + 3);

            set_qword(cur_locals, dst, 0 - 1 - get_qword(cur_locals, src));

            cur_pc = cur_pc + 5;

        }

        if op == REX_OP_SHL_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            set_qword(cur_locals, dst, get_qword(cur_locals, s1) << get_qword(cur_locals, s2));

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_SHR_I64 {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            set_qword(cur_locals, dst, get_qword(cur_locals, s1) >> get_qword(cur_locals, s2));

            cur_pc = cur_pc + 7;

        }

        if (op >= REX_OP_CMP_EQ) & (op <= REX_OP_CMP_GE) {

            let dst = rex_read_u16(buf, ip + 1);

            let s1 = rex_read_u16(buf, ip + 3);

            let s2 = rex_read_u16(buf, ip + 5);

            let v1 = get_qword(cur_locals, s1);

            let v2 = get_qword(cur_locals, s2);

            let cmp_res = 0;

            if op == REX_OP_CMP_EQ { if v1 == v2 { cmp_res = 1; } }

            if op == REX_OP_CMP_NE { if v1 != v2 { cmp_res = 1; } }

            if op == REX_OP_CMP_LT { if v1 < v2 { cmp_res = 1; } }

            if op == REX_OP_CMP_LE { if v1 <= v2 { cmp_res = 1; } }

            if op == REX_OP_CMP_GT { if v1 > v2 { cmp_res = 1; } }

            if op == REX_OP_CMP_GE { if v1 >= v2 { cmp_res = 1; } }

            set_qword(cur_locals, dst, cmp_res);

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_JUMP {

            let tgt = rex_read_u32(buf, ip + 1);

            cur_pc = tgt;

        }

        if op == REX_OP_BRANCH {

            let cond = rex_read_u16(buf, ip + 1);

            let tgt_t = rex_read_u32(buf, ip + 3);

            let tgt_f = rex_read_u32(buf, ip + 7);

            if get_qword(cur_locals, cond) != 0 {

                cur_pc = tgt_t;

            } else {

                cur_pc = tgt_f;

            }

        }

        if op == REX_OP_CALL {

            let dst = rex_read_u16(buf, ip + 1);

            let call_fidx = rex_read_u32(buf, ip + 3);

            let arg_cnt = rex_read_u16(buf, ip + 7);

            let next_pc = cur_pc + 9 + (arg_cnt * 2);



            if depth >= 1023 {

                return 0 - REX_TRAP_STACK_OVERFLOW;

            }



            # Prepare new frame

            let new_depth = depth + 1;

            let new_locals = locals_arena + (new_depth * 1024); # 128 slots * 8 bytes

            let ai = 0;

            while ai < arg_cnt {

                let aslot = rex_read_u16(buf, ip + 9 + (ai * 2));

                set_qword(new_locals, ai, get_qword(cur_locals, aslot));

                ai = ai + 1;

            }



            # Save caller state

            set_qword(call_stack, depth * 5 + 0, cur_fidx);

            set_qword(call_stack, depth * 5 + 1, cur_pc);

            set_qword(call_stack, depth * 5 + 2, cur_locals);

            set_qword(call_stack, depth * 5 + 3, dst);

            set_qword(call_stack, depth * 5 + 4, next_pc);



            # Switch to callee

            depth = new_depth;

            cur_fidx = call_fidx;

            cur_bstart = get_qword(func_tbl, cur_fidx * 4 + 2);

            cur_blen = get_qword(func_tbl, cur_fidx * 4 + 3);

            cur_pc = 0;

            cur_locals = new_locals;

        }

        if op == REX_OP_RETURN {

            let rslot = rex_read_u16(buf, ip + 1);

            let rval = 0;

            if rslot != 65535 {

                rval = get_qword(cur_locals, rslot);

            }



            if depth == 0 {

                final_result = rval;

                running = 0;

            } else {

                # Pop frame

                depth = depth - 1;

                cur_fidx = get_qword(call_stack, depth * 5 + 0);

                cur_locals = get_qword(call_stack, depth * 5 + 2);

                let dst_slot = get_qword(call_stack, depth * 5 + 3);

                let next_pc = get_qword(call_stack, depth * 5 + 4);



                if dst_slot != 65535 {

                    set_qword(cur_locals, dst_slot, rval);

                }



                cur_bstart = get_qword(func_tbl, cur_fidx * 4 + 2);

                cur_blen = get_qword(func_tbl, cur_fidx * 4 + 3);

                cur_pc = next_pc;

            }

        }

        if op == REX_OP_TRAP {

            let tcode = rex_read_u16(buf, ip + 1);

            return 0 - tcode;

        }

        if op == REX_OP_LOAD_64 {

            let dst = rex_read_u16(buf, ip + 1);

            let base = rex_read_u16(buf, ip + 3);

            let offset = rex_read_i32(buf, ip + 5);

            let addr = get_qword(cur_locals, base) + offset;

            if (addr < 0) | (addr + 8 > mem_size) {

                return 0 - REX_TRAP_OUT_OF_BOUNDS;

            }

            let b0 = get_byte(mem_buf, addr + 0);

            let b1 = get_byte(mem_buf, addr + 1);

            let b2 = get_byte(mem_buf, addr + 2);

            let b3 = get_byte(mem_buf, addr + 3);

            let b4 = get_byte(mem_buf, addr + 4);

            let b5 = get_byte(mem_buf, addr + 5);

            let b6 = get_byte(mem_buf, addr + 6);

            let b7 = get_byte(mem_buf, addr + 7);

            let val = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);

            set_qword(cur_locals, dst, val);

            cur_pc = cur_pc + 9;

        }

        if op == REX_OP_STORE_64 {

            let base = rex_read_u16(buf, ip + 1);

            let val_slot = rex_read_u16(buf, ip + 3);

            let offset = rex_read_i32(buf, ip + 5);

            let addr = get_qword(cur_locals, base) + offset;

            if (addr < 0) | (addr + 8 > mem_size) {

                return 0 - REX_TRAP_OUT_OF_BOUNDS;

            }

            let val = get_qword(cur_locals, val_slot);

            set_byte(mem_buf, addr + 0, val & 255);

            set_byte(mem_buf, addr + 1, (val >> 8) & 255);

            set_byte(mem_buf, addr + 2, (val >> 16) & 255);

            set_byte(mem_buf, addr + 3, (val >> 24) & 255);

            set_byte(mem_buf, addr + 4, (val >> 32) & 255);

            set_byte(mem_buf, addr + 5, (val >> 40) & 255);

            set_byte(mem_buf, addr + 6, (val >> 48) & 255);

            set_byte(mem_buf, addr + 7, (val >> 56) & 255);

            cur_pc = cur_pc + 9;

        }

        if op == REX_OP_ALLOC_MEM {

            let dst = rex_read_u16(buf, ip + 1);

            let size = rex_read_u32(buf, ip + 3);

            let aligned_sz = (size + 7) & (0 - 8);

            if mem_alloc_ptr + aligned_sz > mem_size {

                return 0 - REX_TRAP_OUT_OF_BOUNDS;

            }

            set_qword(cur_locals, dst, mem_alloc_ptr);

            mem_alloc_ptr = mem_alloc_ptr + aligned_sz;

            cur_pc = cur_pc + 7;

        }

        if op == REX_OP_ADDR_LOCAL {

            let dst = rex_read_u16(buf, ip + 1);

            let offset = rex_read_u32(buf, ip + 3);

            set_qword(cur_locals, dst, offset);

            cur_pc = cur_pc + 7;
        }

    }



    if steps >= 10000000 {

        return -999; # Infinite loop trap

    }



    return final_result;

}
# ==============================================================================

# Rubix Execution eXchange (REX) — UIR to REX Lowering Pipeline

# File: compiler/rex/rex_lower.bix

#

# Lowers hardware-independent Universal UIR into validated REX binary modules.

# Translates 3-address virtual values to structured REX local value slots.

# Zero physical register allocation, zero CPU stack frames, zero CPU ABIs.

# ==============================================================================





fn rex_lower_uir_program(uir_buf: i64, code_buf: i64): i64 {

    let total_nodes = uir_get_count(uir_buf);

    if total_nodes <= 0 {

        return -1;

    }



    # 1. Discover all functions in UIR

    # func_meta layout: [fi * 8]:

    #   0: fn_hash

    #   1: param_count

    #   2: ret_type

    #   3: start_node

    #   4: end_node

    #   5: max_vreg

    #   6: body_len (in REX bytes)

    #   7: reserved

    let func_meta = sys_mmap(0, 65536, 3, 34, -1, 0);

    let func_cnt = 0;



    let ni = 0;

    while ni < total_nodes {

        let n_addr = uir_node_addr(uir_buf, ni);

        let op = get_qword(n_addr, 0);

        if op == 50 { # UIR_FUNCTION_START

            let fn_hash = get_qword(n_addr, 4);

            let p_cnt = get_qword(n_addr, 5);

            let ret_t = get_qword(n_addr, 6);

            let fn_start = ni;

            let fn_end = ni + 1;

            let searching = 1;

            let max_vr = p_cnt;



            while (fn_end < total_nodes) & (searching == 1) {

                let chk_addr = uir_node_addr(uir_buf, fn_end);

                let chk_op = get_qword(chk_addr, 0);

                if chk_op == 51 { # UIR_FUNCTION_END

                    searching = 0;

                } else {

                    let d = get_qword(chk_addr, 4);

                    let s1 = get_qword(chk_addr, 5);

                    let s2 = get_qword(chk_addr, 6);

                    let fl = get_qword(chk_addr, 2);

                    if (d >= 0) & (d < 1000) { if d > max_vr { max_vr = d; } }

                    if (fl & 1) == 0 {

                        if (s1 >= 0) & (s1 < 1000) { if s1 > max_vr { max_vr = s1; } }

                    }

                    if ((fl >> 1) & 1) == 0 {

                        if (s2 >= 0) & (s2 < 1000) { if s2 > max_vr { max_vr = s2; } }

                    }

                    fn_end = fn_end + 1;

                }

            }



            set_qword(func_meta, func_cnt * 8 + 0, fn_hash);

            set_qword(func_meta, func_cnt * 8 + 1, p_cnt);

            set_qword(func_meta, func_cnt * 8 + 2, ret_t);

            set_qword(func_meta, func_cnt * 8 + 3, fn_start);

            set_qword(func_meta, func_cnt * 8 + 4, fn_end);

            set_qword(func_meta, func_cnt * 8 + 5, max_vr);

            func_cnt = func_cnt + 1;

            ni = fn_end;

        }

        ni = ni + 1;

    }



    if func_cnt == 0 {

        return -2;

    }



    # Temporary buffer for building sections

    let sec_types_buf = sys_mmap_page();

    let sec_funcs_buf = sys_mmap_page();

    let sec_code_buf  = sys_mmap(0, 1048576, 3, 34, -1, 0);

    let sec_exp_buf   = sys_mmap_page();



    # 2. Build SEC_TYPES & SEC_FUNCTIONS

    # Each function gets its type signature: [param_count: u16] [params: u8...] [ret: u8]

    let tp = 0;

    tp = rex_emit_u32(sec_types_buf, tp, func_cnt);



    let fp = 0;

    fp = rex_emit_u32(sec_funcs_buf, fp, func_cnt);



    let fi = 0;

    while fi < func_cnt {

        let p_cnt = get_qword(func_meta, fi * 8 + 1);

        let ret_t = get_qword(func_meta, fi * 8 + 2);

        tp = rex_emit_u16(sec_types_buf, tp, p_cnt);

        let pi = 0;

        while pi < p_cnt {

            tp = rex_emit_u8(sec_types_buf, tp, REX_TYPE_I64);

            pi = pi + 1;

        }

        let r_code = REX_TYPE_I64;

        if ret_t == 0 { r_code = REX_TYPE_VOID; }

        tp = rex_emit_u8(sec_types_buf, tp, r_code);



        # Function descriptor: type_idx = fi, local_count = max_vr + 8 (scratch slots)

        let max_vr = get_qword(func_meta, fi * 8 + 5);

        let local_cnt = max_vr + 8;

        if local_cnt < 8 { local_cnt = 8; }

        fp = rex_emit_u32(sec_funcs_buf, fp, fi);

        fp = rex_emit_u16(sec_funcs_buf, fp, local_cnt);



        fi = fi + 1;

    }

    let types_len = tp;

    let funcs_len = fp;



    # 3. Build SEC_CODE

    let cp = 0;

    cp = rex_emit_u32(sec_code_buf, cp, func_cnt);



    # Tables for branch label patching within function

    let label_offsets = sys_mmap_page(); # label_id -> pc

    let patches = sys_mmap(0, 65536, 3, 34, -1, 0); # [patch_pos, target_label_id]

    let call_args_buf = sys_mmap_page(); # temporary argument slots for call



    fi = 0;

    while fi < func_cnt {

        let fn_start = get_qword(func_meta, fi * 8 + 3);

        let fn_end = get_qword(func_meta, fi * 8 + 4);

        let p_cnt = get_qword(func_meta, fi * 8 + 1);

        let max_vr = get_qword(func_meta, fi * 8 + 5);

        let scratch_slot = max_vr + 1;



        # Clear label and patch tables

        let li = 0;

        while li < 256 {

            set_qword(label_offsets, li, -1);

            li = li + 1;

        }

        let patch_cnt = 0;



        let body_len_patch_pos = cp;

        cp = cp + 4; # Reserve 4 bytes for body length

        let body_start = cp;



        # Instruction Lowering Loop

        let k = fn_start;

        while k < fn_end {

            let addr = uir_node_addr(uir_buf, k);

            let op = get_qword(addr, 0);

            let dst = get_qword(addr, 4);

            let s1 = get_qword(addr, 5);

            let s2 = get_qword(addr, 6);

            let fl = get_qword(addr, 2);

            let imm1 = fl & 1;

            let imm2 = (fl >> 1) & 1;

            let extra = get_qword(addr, 7);



            let rel_pc = cp - body_start;



            if op == 52 { # PARAM

                # Incoming param s1 is in slot s1. If dst != s1, move to dst.

                if dst != s1 {

                    cp = rex_enc_move(sec_code_buf, cp, dst, s1);

                }

            }

            if op == 1 { # CONST

                cp = rex_enc_const_i64(sec_code_buf, cp, dst, s1);

            }

            if op == 2 { # MOVE

                cp = rex_enc_move(sec_code_buf, cp, dst, s1);

            }

            if (op >= 10) & (op <= 14) { # ADD, SUB, MUL, DIV, MOD

                let op_code = REX_OP_ADD_I64;

                if op == 11 { op_code = REX_OP_SUB_I64; }

                if op == 12 { op_code = REX_OP_MUL_I64; }

                if op == 13 { op_code = REX_OP_DIV_I64; }

                if op == 14 { op_code = REX_OP_MOD_I64; }



                let s2_slot = s2;

                if imm2 == 1 {

                    cp = rex_enc_const_i64(sec_code_buf, cp, scratch_slot, s2);

                    s2_slot = scratch_slot;

                }

                let s1_slot = s1;

                if imm1 == 1 {

                    cp = rex_enc_const_i64(sec_code_buf, cp, scratch_slot + 1, s1);

                    s1_slot = scratch_slot + 1;

                }

                cp = rex_enc_bin_op(sec_code_buf, cp, op_code, dst, s1_slot, s2_slot);

            }

            if (op >= 20) & (op <= 25) { # AND, OR, XOR, NOT, SHL, SHR

                if op == 23 { # NOT

                    cp = rex_enc_unary_op(sec_code_buf, cp, REX_OP_NOT_I64, dst, s1);

                } else {

                    let op_code = REX_OP_AND_I64;

                    if op == 21 { op_code = REX_OP_OR_I64; }

                    if op == 22 { op_code = REX_OP_XOR_I64; }

                    if op == 24 { op_code = REX_OP_SHL_I64; }

                    if op == 25 { op_code = REX_OP_SHR_I64; }



                    let s2_slot = s2;

                    if imm2 == 1 {

                        cp = rex_enc_const_i64(sec_code_buf, cp, scratch_slot, s2);

                        s2_slot = scratch_slot;

                    }

                    cp = rex_enc_bin_op(sec_code_buf, cp, op_code, dst, s1, s2_slot);

                }

            }

            if op == 15 { # NEG

                cp = rex_enc_unary_op(sec_code_buf, cp, REX_OP_NEG_I64, dst, s1);

            }

            if (op >= 30) & (op <= 35) { # CMP_EQ..CMP_GE

                let op_code = REX_OP_CMP_EQ + (op - 30);

                let s2_slot = s2;

                if imm2 == 1 {

                    cp = rex_enc_const_i64(sec_code_buf, cp, scratch_slot, s2);

                    s2_slot = scratch_slot;

                }

                cp = rex_enc_bin_op(sec_code_buf, cp, op_code, dst, s1, s2_slot);

            }

            if op == 53 { # UIR_LABEL

                let lbl = dst;

                if lbl < 256 {

                    set_qword(label_offsets, lbl, rel_pc);

                }

            }

            if op == 54 { # UIR_JUMP

                let lbl = dst;

                let tgt = -1;

                if lbl < 256 { tgt = get_qword(label_offsets, lbl); }

                if tgt >= 0 {

                    cp = rex_enc_jump(sec_code_buf, cp, tgt);

                } else {

                    # Record forward jump patch: opcode byte (1) + target (4)

                    let p_pos = cp + 1;

                    cp = rex_enc_jump(sec_code_buf, cp, 0);

                    set_qword(patches, patch_cnt * 2 + 0, p_pos);

                    set_qword(patches, patch_cnt * 2 + 1, lbl);

                    patch_cnt = patch_cnt + 1;

                }

            }

            if op == 55 { # UIR_BRANCH

                let lbl_t = dst;

                let lbl_f = s2;

                let tgt_t = -1;

                let tgt_f = -1;

                if lbl_t < 256 { tgt_t = get_qword(label_offsets, lbl_t); }

                if lbl_f < 256 { tgt_f = get_qword(label_offsets, lbl_f); }



                let p_pos_t = cp + 3;

                let p_pos_f = cp + 7;

                cp = rex_enc_branch(sec_code_buf, cp, s1, 0, 0);



                if tgt_t >= 0 {

                    rex_emit_u32(sec_code_buf, p_pos_t, tgt_t);

                } else {

                    set_qword(patches, patch_cnt * 2 + 0, p_pos_t);

                    set_qword(patches, patch_cnt * 2 + 1, lbl_t);

                    patch_cnt = patch_cnt + 1;

                }

                if tgt_f >= 0 {

                    rex_emit_u32(sec_code_buf, p_pos_f, tgt_f);

                } else {

                    set_qword(patches, patch_cnt * 2 + 0, p_pos_f);

                    set_qword(patches, patch_cnt * 2 + 1, lbl_f);

                    patch_cnt = patch_cnt + 1;

                }

            }

            if op == 58 { # ARG

                let arg_idx = dst;

                let arg_slot = s1;

                if imm1 == 1 {

                    cp = rex_enc_const_i64(sec_code_buf, cp, scratch_slot + arg_idx, s1);

                    arg_slot = scratch_slot + arg_idx;

                }

                set_qword(call_args_buf, arg_idx, arg_slot);

            }

            if op == 56 { # UIR_CALL

                let target_fn_hash = s1;

                let arg_cnt = s2;

                # Find target function index

                let target_fidx = -1;

                let ti = 0;

                while ti < func_cnt {

                    if get_qword(func_meta, ti * 8 + 0) == target_fn_hash {

                        target_fidx = ti;

                    }

                    ti = ti + 1;

                }

                if target_fidx >= 0 {

                    cp = rex_enc_call(sec_code_buf, cp, dst, target_fidx, arg_cnt, call_args_buf);

                } else {

                    return -3; # Unresolved function call

                }

            }

            if op == 57 { # RETURN

                let rslot = s1;

                if imm1 == 1 {

                    cp = rex_enc_const_i64(sec_code_buf, cp, scratch_slot, s1);

                    rslot = scratch_slot;

                }

                if s1 == -1 {

                    rslot = 65535; # Void return

                }

                cp = rex_enc_return(sec_code_buf, cp, rslot);

            }

            if op == 40 { # ALLOC_STACK

                cp = rex_enc_alloc_mem(sec_code_buf, cp, scratch_slot, s1);

            }

            if op == 41 { # ADDR_OF

                cp = rex_enc_addr_local(sec_code_buf, cp, dst, s1);

            }

            if op == 42 { # UIR_LOAD

                cp = rex_enc_load64(sec_code_buf, cp, dst, s1, extra);

            }

            if op == 43 { # UIR_STORE

                let val_slot = s2;

                if imm2 == 1 {

                    cp = rex_enc_const_i64(sec_code_buf, cp, scratch_slot, s2);

                    val_slot = scratch_slot;

                }

                cp = rex_enc_store64(sec_code_buf, cp, s1, val_slot, extra);

            }



            k = k + 1;

        }



        # Backpatch forward jumps in function

        let pi = 0;

        while pi < patch_cnt {

            let p_pos = get_qword(patches, pi * 2 + 0);

            let lbl = get_qword(patches, pi * 2 + 1);

            let tgt_pc = get_qword(label_offsets, lbl);

            if tgt_pc >= 0 {

                rex_emit_u32(sec_code_buf, p_pos, tgt_pc);

            } else {

                rex_emit_u32(sec_code_buf, p_pos, cp - body_start);

            }

            pi = pi + 1;

        }



        # Record body length

        let body_len = cp - body_start;

        rex_emit_u32(sec_code_buf, body_len_patch_pos, body_len);

        set_qword(func_meta, fi * 8 + 6, body_len);



        fi = fi + 1;

    }

    let code_len = cp;



    # 4. Build SEC_EXPORTS

    let ep = 0;

    ep = rex_emit_u32(sec_exp_buf, ep, func_cnt);

    fi = 0;

    while fi < func_cnt {

        let fn_hash = get_qword(func_meta, fi * 8 + 0);

        ep = rex_emit_u64(sec_exp_buf, ep, fn_hash);

        ep = rex_emit_u32(sec_exp_buf, ep, fi);

        fi = fi + 1;

    }

    let exp_len = ep;



    # 5. Assemble all sections into code_buf

    # Sections to emit: SEC_TYPES, SEC_FUNCTIONS, SEC_MEMORY, SEC_CODE, SEC_EXPORTS

    let sec_cnt = 5;

    let mem_sec_len = 8;

    let total_module_len = 16 + (5 + types_len) + (5 + funcs_len) + (5 + mem_sec_len) + (5 + code_len) + (5 + exp_len);



    let mp = rex_emit_header(code_buf, 0, total_module_len, sec_cnt);



    # SEC_TYPES

    mp = rex_emit_section_hdr(code_buf, mp, REX_SEC_TYPES, types_len);

    let i = 0;

    while i < types_len {

        set_byte(code_buf, mp + i, get_byte(sec_types_buf, i));

        i = i + 1;

    }

    mp = mp + types_len;



    # SEC_FUNCTIONS

    mp = rex_emit_section_hdr(code_buf, mp, REX_SEC_FUNCTIONS, funcs_len);

    i = 0;

    while i < funcs_len {

        set_byte(code_buf, mp + i, get_byte(sec_funcs_buf, i));

        i = i + 1;

    }

    mp = mp + funcs_len;



    # SEC_MEMORY (initial 64KB, max 16MB)

    mp = rex_emit_section_hdr(code_buf, mp, REX_SEC_MEMORY, mem_sec_len);

    mp = rex_emit_u32(code_buf, mp, 65536);

    mp = rex_emit_u32(code_buf, mp, 16777216);



    # SEC_CODE

    mp = rex_emit_section_hdr(code_buf, mp, REX_SEC_CODE, code_len);

    i = 0;

    while i < code_len {

        set_byte(code_buf, mp + i, get_byte(sec_code_buf, i));

        i = i + 1;

    }

    mp = mp + code_len;



    # SEC_EXPORTS

    mp = rex_emit_section_hdr(code_buf, mp, REX_SEC_EXPORTS, exp_len);

    i = 0;

    while i < exp_len {

        set_byte(code_buf, mp + i, get_byte(sec_exp_buf, i));

        i = i + 1;

    }

    mp = mp + exp_len;



    # 6. Validate the emitted module before returning

    let v_res = rex_validate_module(code_buf, mp);

    if v_res != REX_OK {

        return v_res;

    }



    return mp;

}

# ==============================================================================
# Rubix Universal Machine Synthesis (RUMS) -- Target Machine Description Loader
# ==============================================================================
# Rubix Execution eXchange (REX) — Native Machine Code Compiler (x86-64)
# File: compiler/rex/rex_compiler.bix
#
# Production high-performance execution engine for REX.
# Compiles validated .rex modules into native host machine code (x86-64)
# executing directly on the physical CPU at hardware speed.
#
# Semantic invariants:
#   1. Strict pre-execution validation via rex_validate_module before any compilation.
#   2. Local value slots ($v_0 \dots v_{k-1}$) mapped to aligned native stack frames.
#   3. Checked bounded linear memory with inlined hardware bounds checks.
#   4. Deterministic trap handling with instant stack unwinding (div0, mod0, oob, stack overflow).
# ==============================================================================

fn rex_x86_emit_byte(buf: i64, p: i64, b: i64): i64 {
    set_byte(buf, p, b & 255);
    return p + 1;
}

fn rex_x86_emit_u32(buf: i64, p: i64, v: i64): i64 {
    set_byte(buf, p + 0, v & 255);
    set_byte(buf, p + 1, (v >> 8) & 255);
    set_byte(buf, p + 2, (v >> 16) & 255);
    set_byte(buf, p + 3, (v >> 24) & 255);
    return p + 4;
}

fn rex_x86_emit_i64(buf: i64, p: i64, v: i64): i64 {
    let i = 0;
    while i < 8 {
        set_byte(buf, p + i, (v >> (i * 8)) & 255);
        i = i + 1;
    }
    return p + 8;
}

# Emits: mov reg, [rsp + slot*8]
# reg_id: rax=0, rcx=1, rdx=2, rbx=3, rsi=6, rdi=7
fn rex_x86_emit_load_slot(buf: i64, p: i64, reg_id: i64, slot_idx: i64): i64 {
    p = rex_x86_emit_byte(buf, p, 72);                    # 0x48 (REX.W)
    p = rex_x86_emit_byte(buf, p, 139);                   # 0x8B (MOV r64, r/m64)
    p = rex_x86_emit_byte(buf, p, 132 | (reg_id << 3));   # Mod=10, Reg=reg_id, RM=100 (SIB)
    p = rex_x86_emit_byte(buf, p, 36);                    # SIB: Scale=0, Index=4(none), Base=4(rsp)
    p = rex_x86_emit_u32(buf, p, slot_idx * 8);           # Disp32
    return p;
}

# Emits: mov [rsp + slot*8], reg
fn rex_x86_emit_store_slot(buf: i64, p: i64, slot_idx: i64, reg_id: i64): i64 {
    p = rex_x86_emit_byte(buf, p, 72);                    # 0x48 (REX.W)
    p = rex_x86_emit_byte(buf, p, 137);                   # 0x89 (MOV r/m64, r64)
    p = rex_x86_emit_byte(buf, p, 132 | (reg_id << 3));   # Mod=10, Reg=reg_id, RM=100 (SIB)
    p = rex_x86_emit_byte(buf, p, 36);                    # SIB
    p = rex_x86_emit_u32(buf, p, slot_idx * 8);           # Disp32
    return p;
}

# Compiles validated REX module into raw x86-64 machine instructions in code_buf.
# Returns total byte length of emitted machine code, or negative error code.
fn rex_compile_module(buf: i64, len: i64, code_buf: i64): i64 {
    # 1. Mandatory Pre-Execution Validation
    let val_res = rex_validate_module(buf, len);
    if val_res != REX_OK {
        return val_res;
    }

    # 2. Decode Header and Locate Sections
    let hdr = sys_mmap_page();
    rex_decode_header(buf, len, hdr);
    let total_size = get_qword(hdr, 2);
    let sec_cnt = get_qword(hdr, 3);

    let sec_tbl = sys_mmap_page();
    rex_locate_sections(buf, total_size, sec_cnt, sec_tbl);

    # Find main function export index
    let exp_off = get_qword(sec_tbl, REX_SEC_EXPORTS * 2 + 0);
    let exp_cnt = rex_read_u32(buf, exp_off);
    let ep = exp_off + 4;
    let main_fidx = -1;
    let ei = 0;
    while ei < exp_cnt {
        let h = rex_read_u64(buf, ep);
        let fidx = rex_read_u32(buf, ep + 8);
        ep = ep + 12;
        if h == 6385467242 { # "main"
            main_fidx = fidx;
        }
        ei = ei + 1;
    }
    if main_fidx < 0 {
        return REX_ERR_NO_MAIN_EXPORT;
    }

    # Query function metadata
    let funcs_off = get_qword(sec_tbl, REX_SEC_FUNCTIONS * 2 + 0);
    let func_cnt = rex_read_u32(buf, funcs_off);

    # Metadata tables:
    # func_offsets: func_idx -> native_code_offset
    let func_offsets = sys_mmap_page();
    # func_call_patches: [patch_pos, target_fidx]
    let func_call_patches = sys_mmap(0, 65536, 3, 34, -1, 0);
    let func_call_patch_cnt = 0;

    # Trap patch tables:
    let trap_div0_patches = sys_mmap_page();
    let trap_div0_cnt = 0;
    let trap_oob_patches = sys_mmap_page();
    let trap_oob_cnt = 0;
    let trap_so_patches = sys_mmap_page();
    let trap_so_cnt = 0;
    let trap_exp_patches = sys_mmap_page();
    let trap_exp_cnt = 0;

    let p = 0;
    # 0..1: jmp +30 (jump over metadata table to offset 32)
    p = rex_x86_emit_byte(code_buf, p, 235);
    p = rex_x86_emit_byte(code_buf, p, 30);
    p = 32;

    # 3. Emit Top-Level Entry Wrapper at offset 32:
    p = rex_x86_emit_byte(code_buf, p, 83);               # push rbx
    p = rex_x86_emit_byte(code_buf, p, 85);               # push rbp
    p = rex_x86_emit_byte(code_buf, p, 65); p = rex_x86_emit_byte(code_buf, p, 84); # push r12 (mem_base)
    p = rex_x86_emit_byte(code_buf, p, 65); p = rex_x86_emit_byte(code_buf, p, 85); # push r13 (mem_size)
    p = rex_x86_emit_byte(code_buf, p, 65); p = rex_x86_emit_byte(code_buf, p, 86); # push r14 (alloc_ptr)
    p = rex_x86_emit_byte(code_buf, p, 65); p = rex_x86_emit_byte(code_buf, p, 87); # push r15 (stack limit)

    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 227); # mov rbx, rsp (top-level stack anchor)
    # rdi is code_buf. Unpack metadata from [rdi + 8, 16, 24]:
    p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 139); p = rex_x86_emit_byte(code_buf, p, 103); p = rex_x86_emit_byte(code_buf, p, 8);  # mov r12, [rdi + 8] (mem_base)
    p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 139); p = rex_x86_emit_byte(code_buf, p, 111); p = rex_x86_emit_byte(code_buf, p, 16); # mov r13, [rdi + 16] (mem_size)
    p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 139); p = rex_x86_emit_byte(code_buf, p, 119); p = rex_x86_emit_byte(code_buf, p, 24); # mov r14, [rdi + 24] (alloc_ptr)

    # Initialize stack limit in r15 = rsp - 65536 (1024 frames of 64 bytes)
    p = rex_x86_emit_byte(code_buf, p, 73); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 231); # mov r15, rsp
    p = rex_x86_emit_byte(code_buf, p, 73); p = rex_x86_emit_byte(code_buf, p, 129); p = rex_x86_emit_byte(code_buf, p, 239); # sub r15, imm32
    p = rex_x86_emit_u32(code_buf, p, 65536);

    # Call main function: call rel32
    p = rex_x86_emit_byte(code_buf, p, 232); # 0xE8
    set_qword(func_call_patches, func_call_patch_cnt * 2 + 0, p);
    set_qword(func_call_patches, func_call_patch_cnt * 2 + 1, main_fidx);
    func_call_patch_cnt = func_call_patch_cnt + 1;
    p = rex_x86_emit_u32(code_buf, p, 0);

    # Exit label: normal return
    let exit_label = p;
    p = rex_x86_emit_byte(code_buf, p, 65); p = rex_x86_emit_byte(code_buf, p, 95); # pop r15
    p = rex_x86_emit_byte(code_buf, p, 65); p = rex_x86_emit_byte(code_buf, p, 94); # pop r14
    p = rex_x86_emit_byte(code_buf, p, 65); p = rex_x86_emit_byte(code_buf, p, 93); # pop r13
    p = rex_x86_emit_byte(code_buf, p, 65); p = rex_x86_emit_byte(code_buf, p, 92); # pop r12
    p = rex_x86_emit_byte(code_buf, p, 93);               # pop rbp
    p = rex_x86_emit_byte(code_buf, p, 91);               # pop rbx
    p = rex_x86_emit_byte(code_buf, p, 195);              # ret

    # Trap targets: unwinds rsp to rbx and returns -code
    let trap_div0_target = p;
    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 220); # mov rsp, rbx
    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 199); p = rex_x86_emit_byte(code_buf, p, 192); # mov rax, -1
    p = rex_x86_emit_u32(code_buf, p, 4294967295);
    p = rex_x86_emit_byte(code_buf, p, 233);
    p = rex_x86_emit_u32(code_buf, p, exit_label - (p + 4));

    let trap_oob_target = p;
    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 220); # mov rsp, rbx
    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 199); p = rex_x86_emit_byte(code_buf, p, 192); # mov rax, -2
    p = rex_x86_emit_u32(code_buf, p, 4294967294);
    p = rex_x86_emit_byte(code_buf, p, 233);
    p = rex_x86_emit_u32(code_buf, p, exit_label - (p + 4));

    let trap_so_target = p;
    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 220); # mov rsp, rbx
    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 199); p = rex_x86_emit_byte(code_buf, p, 192); # mov rax, -3
    p = rex_x86_emit_u32(code_buf, p, 4294967293);
    p = rex_x86_emit_byte(code_buf, p, 233);
    p = rex_x86_emit_u32(code_buf, p, exit_label - (p + 4));

    let trap_exp_target = p;
    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 220); # mov rsp, rbx
    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 199); p = rex_x86_emit_byte(code_buf, p, 192); # mov rax, -5
    p = rex_x86_emit_u32(code_buf, p, 4294967291);
    p = rex_x86_emit_byte(code_buf, p, 233);
    p = rex_x86_emit_u32(code_buf, p, exit_label - (p + 4));

    # 4. Compile Each Function Body
    let code_off = get_qword(sec_tbl, REX_SEC_CODE * 2 + 0);
    let cp = code_off + 4;

    let fi = 0;
    while fi < func_cnt {
        set_qword(func_offsets, fi, p);

        let fp = funcs_off + 4 + (fi * 6);
        let t_idx = rex_read_u32(buf, fp);
        let local_cnt = rex_read_u16(buf, fp + 4);

        let frame_size = (local_cnt * 8 + 15) & (0 - 16);
        if frame_size < 16 { frame_size = 16; }

        # Function prologue: stack check + frame creation
        p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 57); p = rex_x86_emit_byte(code_buf, p, 252); # cmp rsp, r15
        p = rex_x86_emit_byte(code_buf, p, 15); p = rex_x86_emit_byte(code_buf, p, 134); # jbe trap_so
        set_qword(trap_so_patches, trap_so_cnt, p);
        trap_so_cnt = trap_so_cnt + 1;
        p = rex_x86_emit_u32(code_buf, p, 0);

        p = rex_x86_emit_byte(code_buf, p, 85);               # push rbp
        p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 229); # mov rbp, rsp
        p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 129); p = rex_x86_emit_byte(code_buf, p, 236); # sub rsp, frame_size
        p = rex_x86_emit_u32(code_buf, p, frame_size);

        # Copy incoming parameters from registers (rdi, rsi, rdx, rcx, r8, r9) into slots 0..5
        let tp_scan = get_qword(sec_tbl, REX_SEC_TYPES * 2 + 0) + 4;
        let ti = 0;
        let p_cnt = 0;
        while ti <= t_idx {
            p_cnt = rex_read_u16(buf, tp_scan);
            if ti == t_idx {
                ti = t_idx + 1;
            } else {
                tp_scan = tp_scan + 2 + p_cnt + 1;
                ti = ti + 1;
            }
        }
        let pi = 0;
        while (pi < p_cnt) & (pi < 6) {
            let reg_id = 7; # rdi
            if pi == 1 { reg_id = 6; } # rsi
            if pi == 2 { reg_id = 2; } # rdx
            if pi == 3 { reg_id = 1; } # rcx
            if pi < 4 {
                p = rex_x86_emit_store_slot(code_buf, p, pi, reg_id);
            }
            if pi == 4 { # r8
                p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 132); p = rex_x86_emit_byte(code_buf, p, 36);
                p = rex_x86_emit_u32(code_buf, p, pi * 8);
            }
            if pi == 5 { # r9
                p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 140); p = rex_x86_emit_byte(code_buf, p, 36);
                p = rex_x86_emit_u32(code_buf, p, pi * 8);
            }
            pi = pi + 1;
        }

        let body_len = rex_read_u32(buf, cp);
        cp = cp + 4;
        let body_start = cp;
        let body_end = body_start + body_len;

        # Tables for intra-function branch patching:
        # inst_offsets: [rex_ip, native_code_offset]
        let inst_offsets = sys_mmap(0, 65536, 3, 34, -1, 0);
        let inst_cnt = 0;
        let branch_patches = sys_mmap(0, 65536, 3, 34, -1, 0);
        let branch_patch_cnt = 0;

        let ip = body_start;
        while ip < body_end {
            let rel_rex_ip = ip - body_start;
            set_qword(inst_offsets, inst_cnt * 2 + 0, rel_rex_ip);
            set_qword(inst_offsets, inst_cnt * 2 + 1, p);
            inst_cnt = inst_cnt + 1;

            let op = rex_read_u8(buf, ip);
            ip = ip + 1;

            if op == REX_OP_CONST_I64 {
                let dst = rex_read_u16(buf, ip);
                let val = rex_read_i64(buf, ip + 2);
                ip = ip + 10;
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 184); # mov rax, val
                p = rex_x86_emit_i64(code_buf, p, val);
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_CONST_I32 {
                let dst = rex_read_u16(buf, ip);
                let val = rex_read_i32(buf, ip + 2);
                ip = ip + 6;
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 199); p = rex_x86_emit_byte(code_buf, p, 192); # mov rax, imm32
                p = rex_x86_emit_u32(code_buf, p, val);
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_MOVE {
                let dst = rex_read_u16(buf, ip);
                let src = rex_read_u16(buf, ip + 2);
                ip = ip + 4;
                p = rex_x86_emit_load_slot(code_buf, p, 0, src);
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_ADD_I64 {
                let dst = rex_read_u16(buf, ip);
                let s1 = rex_read_u16(buf, ip + 2);
                let s2 = rex_read_u16(buf, ip + 4);
                ip = ip + 6;
                p = rex_x86_emit_load_slot(code_buf, p, 0, s1); # rax
                p = rex_x86_emit_load_slot(code_buf, p, 1, s2); # rcx
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 1); p = rex_x86_emit_byte(code_buf, p, 200); # add rax, rcx
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_SUB_I64 {
                let dst = rex_read_u16(buf, ip);
                let s1 = rex_read_u16(buf, ip + 2);
                let s2 = rex_read_u16(buf, ip + 4);
                ip = ip + 6;
                p = rex_x86_emit_load_slot(code_buf, p, 0, s1);
                p = rex_x86_emit_load_slot(code_buf, p, 1, s2);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 41); p = rex_x86_emit_byte(code_buf, p, 200); # sub rax, rcx
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_MUL_I64 {
                let dst = rex_read_u16(buf, ip);
                let s1 = rex_read_u16(buf, ip + 2);
                let s2 = rex_read_u16(buf, ip + 4);
                ip = ip + 6;
                p = rex_x86_emit_load_slot(code_buf, p, 0, s1);
                p = rex_x86_emit_load_slot(code_buf, p, 1, s2);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 15); p = rex_x86_emit_byte(code_buf, p, 175); p = rex_x86_emit_byte(code_buf, p, 193); # imul rax, rcx
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if (op == REX_OP_DIV_I64) | (op == REX_OP_MOD_I64) {
                let dst = rex_read_u16(buf, ip);
                let s1 = rex_read_u16(buf, ip + 2);
                let s2 = rex_read_u16(buf, ip + 4);
                ip = ip + 6;
                # Check divisor == 0
                p = rex_x86_emit_load_slot(code_buf, p, 1, s2); # rcx
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 133); p = rex_x86_emit_byte(code_buf, p, 201); # test rcx, rcx
                p = rex_x86_emit_byte(code_buf, p, 15); p = rex_x86_emit_byte(code_buf, p, 132); # jz trap_div0
                set_qword(trap_div0_patches, trap_div0_cnt, p);
                trap_div0_cnt = trap_div0_cnt + 1;
                p = rex_x86_emit_u32(code_buf, p, 0);

                p = rex_x86_emit_load_slot(code_buf, p, 0, s1); # rax
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 153); # cqo
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 247); p = rex_x86_emit_byte(code_buf, p, 249); # idiv rcx
                if op == REX_OP_DIV_I64 {
                    p = rex_x86_emit_store_slot(code_buf, p, dst, 0); # quotient in rax
                } else {
                    p = rex_x86_emit_store_slot(code_buf, p, dst, 2); # remainder in rdx
                }
            }
            if op == REX_OP_NEG_I64 {
                let dst = rex_read_u16(buf, ip);
                let src = rex_read_u16(buf, ip + 2);
                ip = ip + 4;
                p = rex_x86_emit_load_slot(code_buf, p, 0, src);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 247); p = rex_x86_emit_byte(code_buf, p, 216); # neg rax
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_AND_I64 {
                let dst = rex_read_u16(buf, ip);
                let s1 = rex_read_u16(buf, ip + 2);
                let s2 = rex_read_u16(buf, ip + 4);
                ip = ip + 6;
                p = rex_x86_emit_load_slot(code_buf, p, 0, s1);
                p = rex_x86_emit_load_slot(code_buf, p, 1, s2);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 33); p = rex_x86_emit_byte(code_buf, p, 200); # and rax, rcx
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_OR_I64 {
                let dst = rex_read_u16(buf, ip);
                let s1 = rex_read_u16(buf, ip + 2);
                let s2 = rex_read_u16(buf, ip + 4);
                ip = ip + 6;
                p = rex_x86_emit_load_slot(code_buf, p, 0, s1);
                p = rex_x86_emit_load_slot(code_buf, p, 1, s2);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 9); p = rex_x86_emit_byte(code_buf, p, 200); # or rax, rcx
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_XOR_I64 {
                let dst = rex_read_u16(buf, ip);
                let s1 = rex_read_u16(buf, ip + 2);
                let s2 = rex_read_u16(buf, ip + 4);
                ip = ip + 6;
                p = rex_x86_emit_load_slot(code_buf, p, 0, s1);
                p = rex_x86_emit_load_slot(code_buf, p, 1, s2);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 49); p = rex_x86_emit_byte(code_buf, p, 200); # xor rax, rcx
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_NOT_I64 {
                let dst = rex_read_u16(buf, ip);
                let src = rex_read_u16(buf, ip + 2);
                ip = ip + 4;
                p = rex_x86_emit_load_slot(code_buf, p, 0, src);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 247); p = rex_x86_emit_byte(code_buf, p, 208); # not rax
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_SHL_I64 {
                let dst = rex_read_u16(buf, ip);
                let s1 = rex_read_u16(buf, ip + 2);
                let s2 = rex_read_u16(buf, ip + 4);
                ip = ip + 6;
                p = rex_x86_emit_load_slot(code_buf, p, 0, s1);
                p = rex_x86_emit_load_slot(code_buf, p, 1, s2); # cl
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 211); p = rex_x86_emit_byte(code_buf, p, 224); # shl rax, cl
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_SHR_I64 {
                let dst = rex_read_u16(buf, ip);
                let s1 = rex_read_u16(buf, ip + 2);
                let s2 = rex_read_u16(buf, ip + 4);
                ip = ip + 6;
                p = rex_x86_emit_load_slot(code_buf, p, 0, s1);
                p = rex_x86_emit_load_slot(code_buf, p, 1, s2);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 211); p = rex_x86_emit_byte(code_buf, p, 232); # shr rax, cl
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if (op >= REX_OP_CMP_EQ) & (op <= REX_OP_CMP_GE) {
                let dst = rex_read_u16(buf, ip);
                let s1 = rex_read_u16(buf, ip + 2);
                let s2 = rex_read_u16(buf, ip + 4);
                ip = ip + 6;
                p = rex_x86_emit_load_slot(code_buf, p, 0, s1);
                p = rex_x86_emit_load_slot(code_buf, p, 1, s2);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 57); p = rex_x86_emit_byte(code_buf, p, 200); # cmp rax, rcx
                let setcc = 148; # 0x94 sete
                if op == REX_OP_CMP_NE { setcc = 149; } # setne
                if op == REX_OP_CMP_LT { setcc = 156; } # setl
                if op == REX_OP_CMP_LE { setcc = 158; } # setle
                if op == REX_OP_CMP_GT { setcc = 159; } # setg
                if op == REX_OP_CMP_GE { setcc = 157; } # setge
                p = rex_x86_emit_byte(code_buf, p, 15); p = rex_x86_emit_byte(code_buf, p, setcc); p = rex_x86_emit_byte(code_buf, p, 192); # setcc al
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 15); p = rex_x86_emit_byte(code_buf, p, 182); p = rex_x86_emit_byte(code_buf, p, 192); # movzx rax, al
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_JUMP {
                let tgt = rex_read_u32(buf, ip);
                ip = ip + 4;
                p = rex_x86_emit_byte(code_buf, p, 233); # jmp rel32
                set_qword(branch_patches, branch_patch_cnt * 2 + 0, p);
                set_qword(branch_patches, branch_patch_cnt * 2 + 1, tgt);
                branch_patch_cnt = branch_patch_cnt + 1;
                p = rex_x86_emit_u32(code_buf, p, 0);
            }
            if op == REX_OP_BRANCH {
                let cond = rex_read_u16(buf, ip);
                let tgt_t = rex_read_u32(buf, ip + 2);
                let tgt_f = rex_read_u32(buf, ip + 6);
                ip = ip + 10;
                p = rex_x86_emit_load_slot(code_buf, p, 0, cond);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 133); p = rex_x86_emit_byte(code_buf, p, 192); # test rax, rax
                p = rex_x86_emit_byte(code_buf, p, 15); p = rex_x86_emit_byte(code_buf, p, 133); # jne tgt_t
                set_qword(branch_patches, branch_patch_cnt * 2 + 0, p);
                set_qword(branch_patches, branch_patch_cnt * 2 + 1, tgt_t);
                branch_patch_cnt = branch_patch_cnt + 1;
                p = rex_x86_emit_u32(code_buf, p, 0);

                p = rex_x86_emit_byte(code_buf, p, 233); # jmp tgt_f
                set_qword(branch_patches, branch_patch_cnt * 2 + 0, p);
                set_qword(branch_patches, branch_patch_cnt * 2 + 1, tgt_f);
                branch_patch_cnt = branch_patch_cnt + 1;
                p = rex_x86_emit_u32(code_buf, p, 0);
            }
            if op == REX_OP_CALL {
                let dst = rex_read_u16(buf, ip);
                let call_fidx = rex_read_u32(buf, ip + 2);
                let arg_cnt = rex_read_u16(buf, ip + 6);
                ip = ip + 8;
                let ai = 0;
                while (ai < arg_cnt) & (ai < 6) {
                    let aslot = rex_read_u16(buf, ip + (ai * 2));
                    let reg_id = 7; # rdi
                    if ai == 1 { reg_id = 6; } # rsi
                    if ai == 2 { reg_id = 2; } # rdx
                    if ai == 3 { reg_id = 1; } # rcx
                    if ai < 4 {
                        p = rex_x86_emit_load_slot(code_buf, p, reg_id, aslot);
                    }
                    if ai == 4 { # r8
                        p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 139); p = rex_x86_emit_byte(code_buf, p, 132); p = rex_x86_emit_byte(code_buf, p, 36);
                        p = rex_x86_emit_u32(code_buf, p, aslot * 8);
                    }
                    if ai == 5 { # r9
                        p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 139); p = rex_x86_emit_byte(code_buf, p, 140); p = rex_x86_emit_byte(code_buf, p, 36);
                        p = rex_x86_emit_u32(code_buf, p, aslot * 8);
                    }
                    ai = ai + 1;
                }
                ip = ip + (arg_cnt * 2);

                p = rex_x86_emit_byte(code_buf, p, 232); # call rel32
                set_qword(func_call_patches, func_call_patch_cnt * 2 + 0, p);
                set_qword(func_call_patches, func_call_patch_cnt * 2 + 1, call_fidx);
                func_call_patch_cnt = func_call_patch_cnt + 1;
                p = rex_x86_emit_u32(code_buf, p, 0);

                if dst != 65535 {
                    p = rex_x86_emit_store_slot(code_buf, p, dst, 0); # store rax
                }
            }
            if op == REX_OP_RETURN {
                let rslot = rex_read_u16(buf, ip);
                ip = ip + 2;
                if rslot != 65535 {
                    p = rex_x86_emit_load_slot(code_buf, p, 0, rslot);
                } else {
                    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 49); p = rex_x86_emit_byte(code_buf, p, 192); # xor rax, rax
                }
                # Epilogue: add rsp, frame_size; pop rbp; ret
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 129); p = rex_x86_emit_byte(code_buf, p, 196);
                p = rex_x86_emit_u32(code_buf, p, frame_size);
                p = rex_x86_emit_byte(code_buf, p, 93);  # pop rbp
                p = rex_x86_emit_byte(code_buf, p, 195); # ret
            }
            if op == REX_OP_LOAD_64 {
                let dst = rex_read_u16(buf, ip);
                let base = rex_read_u16(buf, ip + 2);
                let offset = rex_read_i32(buf, ip + 4);
                ip = ip + 8;
                p = rex_x86_emit_load_slot(code_buf, p, 0, base); # rax
                if offset != 0 {
                    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 5); # add rax, imm32
                    p = rex_x86_emit_u32(code_buf, p, offset);
                }
                # Bounds check: rax + 8 <= r13
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 193); # mov rcx, rax
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 131); p = rex_x86_emit_byte(code_buf, p, 193); p = rex_x86_emit_byte(code_buf, p, 8); # add rcx, 8
                p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 57); p = rex_x86_emit_byte(code_buf, p, 233); # cmp rcx, r13
                p = rex_x86_emit_byte(code_buf, p, 15); p = rex_x86_emit_byte(code_buf, p, 135); # ja trap_oob
                set_qword(trap_oob_patches, trap_oob_cnt, p);
                trap_oob_cnt = trap_oob_cnt + 1;
                p = rex_x86_emit_u32(code_buf, p, 0);

                # mov rax, [r12 + rax]
                p = rex_x86_emit_byte(code_buf, p, 73); p = rex_x86_emit_byte(code_buf, p, 139); p = rex_x86_emit_byte(code_buf, p, 4); p = rex_x86_emit_byte(code_buf, p, 4);
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_STORE_64 {
                let base = rex_read_u16(buf, ip);
                let val = rex_read_u16(buf, ip + 2);
                let offset = rex_read_i32(buf, ip + 4);
                ip = ip + 8;
                p = rex_x86_emit_load_slot(code_buf, p, 0, base);
                if offset != 0 {
                    p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 5);
                    p = rex_x86_emit_u32(code_buf, p, offset);
                }
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 193);
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 131); p = rex_x86_emit_byte(code_buf, p, 193); p = rex_x86_emit_byte(code_buf, p, 8);
                p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 57); p = rex_x86_emit_byte(code_buf, p, 233);
                p = rex_x86_emit_byte(code_buf, p, 15); p = rex_x86_emit_byte(code_buf, p, 135);
                set_qword(trap_oob_patches, trap_oob_cnt, p);
                trap_oob_cnt = trap_oob_cnt + 1;
                p = rex_x86_emit_u32(code_buf, p, 0);

                p = rex_x86_emit_load_slot(code_buf, p, 1, val); # rcx
                # mov [r12 + rax], rcx
                p = rex_x86_emit_byte(code_buf, p, 73); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 12); p = rex_x86_emit_byte(code_buf, p, 4);
            }
            if op == REX_OP_ALLOC_MEM {
                let dst = rex_read_u16(buf, ip);
                let size = rex_read_u32(buf, ip + 2);
                ip = ip + 6;
                # mov rax, r14; mov [rsp+dst*8], rax; add r14, size
                p = rex_x86_emit_byte(code_buf, p, 76); p = rex_x86_emit_byte(code_buf, p, 137); p = rex_x86_emit_byte(code_buf, p, 240);
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
                p = rex_x86_emit_byte(code_buf, p, 73); p = rex_x86_emit_byte(code_buf, p, 129); p = rex_x86_emit_byte(code_buf, p, 198);
                p = rex_x86_emit_u32(code_buf, p, size);
            }
            if op == REX_OP_ADDR_LOCAL {
                let dst = rex_read_u16(buf, ip);
                let off = rex_read_u32(buf, ip + 2);
                ip = ip + 6;
                p = rex_x86_emit_byte(code_buf, p, 72); p = rex_x86_emit_byte(code_buf, p, 199); p = rex_x86_emit_byte(code_buf, p, 192);
                p = rex_x86_emit_u32(code_buf, p, off);
                p = rex_x86_emit_store_slot(code_buf, p, dst, 0);
            }
            if op == REX_OP_TRAP {
                ip = ip + 2;
                p = rex_x86_emit_byte(code_buf, p, 233);
                set_qword(trap_exp_patches, trap_exp_cnt, p);
                trap_exp_cnt = trap_exp_cnt + 1;
                p = rex_x86_emit_u32(code_buf, p, 0);
            }
        }

        # Backpatch intra-function branch targets
        let bpi = 0;
        while bpi < branch_patch_cnt {
            let patch_pos = get_qword(branch_patches, bpi * 2 + 0);
            let target_rex_ip = get_qword(branch_patches, bpi * 2 + 1);
            let target_native = 0;
            let ii = 0;
            while ii < inst_cnt {
                if get_qword(inst_offsets, ii * 2 + 0) == target_rex_ip {
                    target_native = get_qword(inst_offsets, ii * 2 + 1);
                }
                ii = ii + 1;
            }
            let disp = target_native - (patch_pos + 4);
            rex_x86_emit_u32(code_buf, patch_pos, disp);
            bpi = bpi + 1;
        }

        cp = cp + body_len;
        fi = fi + 1;
    }

    # 5. Backpatch Inter-Function Calls
    let cpi = 0;
    while cpi < func_call_patch_cnt {
        let patch_pos = get_qword(func_call_patches, cpi * 2 + 0);
        let target_fidx = get_qword(func_call_patches, cpi * 2 + 1);
        let target_native = get_qword(func_offsets, target_fidx);
        let disp = target_native - (patch_pos + 4);
        rex_x86_emit_u32(code_buf, patch_pos, disp);
        cpi = cpi + 1;
    }

    # 6. Backpatch Trap Jumps
    let tpi = 0;
    while tpi < trap_div0_cnt {
        let patch_pos = get_qword(trap_div0_patches, tpi);
        let disp = trap_div0_target - (patch_pos + 4);
        rex_x86_emit_u32(code_buf, patch_pos, disp);
        tpi = tpi + 1;
    }
    tpi = 0;
    while tpi < trap_oob_cnt {
        let patch_pos = get_qword(trap_oob_patches, tpi);
        let disp = trap_oob_target - (patch_pos + 4);
        rex_x86_emit_u32(code_buf, patch_pos, disp);
        tpi = tpi + 1;
    }
    tpi = 0;
    while tpi < trap_so_cnt {
        let patch_pos = get_qword(trap_so_patches, tpi);
        let disp = trap_so_target - (patch_pos + 4);
        rex_x86_emit_u32(code_buf, patch_pos, disp);
        tpi = tpi + 1;
    }
    tpi = 0;
    while tpi < trap_exp_cnt {
        let patch_pos = get_qword(trap_exp_patches, tpi);
        let disp = trap_exp_target - (patch_pos + 4);
        rex_x86_emit_u32(code_buf, patch_pos, disp);
        tpi = tpi + 1;
    }

    return p;
}

# Executes a validated REX module via compiled native machine execution.
# Allocates linear memory, JIT-compiles code, and executes on CPU directly.
fn rex_execute_compiled(buf: i64, len: i64): i64 {
    # Allocate executable memory buffer (PROT_READ | PROT_WRITE | PROT_EXEC = 7)
    let code_buf = sys_mmap(0, 1048576, 7, 34, -1, 0);
    let code_len = rex_compile_module(buf, len, code_buf);
    if code_len < 0 {
        return code_len;
    }

    # Allocate linear memory space
    let mem_size = 65536;
    let sec_tbl = sys_mmap_page();
    rex_locate_sections(buf, len, 8, sec_tbl);
    let mem_off = get_qword(sec_tbl, REX_SEC_MEMORY * 2 + 0);
    let mem_len = get_qword(sec_tbl, REX_SEC_MEMORY * 2 + 1);
    if mem_len >= 8 {
        let req_init = rex_read_u32(buf, mem_off);
        if req_init > mem_size {
            mem_size = req_init;
        }
    }
    let mem_buf = sys_mmap(0, mem_size, 3, 34, -1, 0);

    # Initialize data segments
    let data_off = get_qword(sec_tbl, REX_SEC_DATA * 2 + 0);
    let data_len = get_qword(sec_tbl, REX_SEC_DATA * 2 + 1);
    if data_len > 4 {
        let seg_cnt = rex_read_u32(buf, data_off);
        let dp = data_off + 4;
        let si = 0;
        while si < seg_cnt {
            let seg_offset = rex_read_u32(buf, dp);
            let seg_bytes = rex_read_u32(buf, dp + 4);
            dp = dp + 8;
            let bi = 0;
            while bi < seg_bytes {
                set_byte(mem_buf, seg_offset + bi, get_byte(buf, dp + bi));
                bi = bi + 1;
            }
            dp = dp + seg_bytes;
            si = si + 1;
        }
    }

    let alloc_ptr = 1024;
    set_qword(code_buf, 1, mem_buf);
    set_qword(code_buf, 2, mem_size);
    set_qword(code_buf, 3, alloc_ptr);

    let res = executor_execute(code_buf, code_len);
    return res;
}

# ==============================================================================
# Rubix Execution eXchange (REX) — Fast Direct Interpreter
# File: compiler/rex/rex_interp.bix
#
# Fast-startup, direct-threaded instruction interpreter for REX modules.
# Optimized for development workflows, diagnostics, and debugging without
# native code generation overhead.
#
# Invariant: Semantics and trap behavior are 100% identical to the compiled path.
# ==============================================================================

fn rex_interpret_module(buf: i64, len: i64): i64 {
    # 1. Mandatory Pre-Execution Validation
    let val_res = rex_validate_module(buf, len);
    if val_res != REX_OK {
        return val_res;
    }

    # 2. Decode Header and Sections
    let hdr = sys_mmap_page();
    rex_decode_header(buf, len, hdr);
    let total_size = get_qword(hdr, 2);
    let sec_cnt = get_qword(hdr, 3);

    let sec_tbl = sys_mmap_page();
    rex_locate_sections(buf, total_size, sec_cnt, sec_tbl);

    # 3. Locate Main Export
    let exp_off = get_qword(sec_tbl, REX_SEC_EXPORTS * 2 + 0);
    let exp_cnt = rex_read_u32(buf, exp_off);
    let ep = exp_off + 4;
    let main_fidx = -1;
    let ei = 0;
    while ei < exp_cnt {
        let h = rex_read_u64(buf, ep);
        let fidx = rex_read_u32(buf, ep + 8);
        ep = ep + 12;
        if h == 6385467242 { main_fidx = fidx; }
        ei = ei + 1;
    }
    if main_fidx < 0 {
        return REX_ERR_NO_MAIN_EXPORT;
    }

    # 4. Function Table [type_idx, local_cnt, body_start, body_len]
    let funcs_off = get_qword(sec_tbl, REX_SEC_FUNCTIONS * 2 + 0);
    let func_cnt = rex_read_u32(buf, funcs_off);
    let func_tbl = sys_mmap(0, 65536, 3, 34, -1, 0);

    let code_off = get_qword(sec_tbl, REX_SEC_CODE * 2 + 0);
    let cp = code_off + 4;

    let fi = 0;
    while fi < func_cnt {
        let fp = funcs_off + 4 + (fi * 6);
        let t_idx = rex_read_u32(buf, fp);
        let l_cnt = rex_read_u16(buf, fp + 4);
        let b_len = rex_read_u32(buf, cp);
        cp = cp + 4;
        set_qword(func_tbl, fi * 4 + 0, t_idx);
        set_qword(func_tbl, fi * 4 + 1, l_cnt);
        set_qword(func_tbl, fi * 4 + 2, cp);
        set_qword(func_tbl, fi * 4 + 3, b_len);
        cp = cp + b_len;
        fi = fi + 1;
    }

    # 5. Initialize Linear Memory Space
    let mem_size = 65536;
    let mem_off = get_qword(sec_tbl, REX_SEC_MEMORY * 2 + 0);
    let mem_len = get_qword(sec_tbl, REX_SEC_MEMORY * 2 + 1);
    if mem_len >= 8 {
        let req_init = rex_read_u32(buf, mem_off);
        if req_init > mem_size { mem_size = req_init; }
    }
    let mem_buf = sys_mmap(0, mem_size, 3, 34, -1, 0);

    let data_off = get_qword(sec_tbl, REX_SEC_DATA * 2 + 0);
    let data_len = get_qword(sec_tbl, REX_SEC_DATA * 2 + 1);
    if data_len > 4 {
        let seg_cnt = rex_read_u32(buf, data_off);
        let dp = data_off + 4;
        let si = 0;
        while si < seg_cnt {
            let seg_offset = rex_read_u32(buf, dp);
            let seg_bytes = rex_read_u32(buf, dp + 4);
            dp = dp + 8;
            let bi = 0;
            while bi < seg_bytes {
                set_byte(mem_buf, seg_offset + bi, get_byte(buf, dp + bi));
                bi = bi + 1;
            }
            dp = dp + seg_bytes;
            si = si + 1;
        }
    }

    # 6. Activation Stack & Local Slots
    let call_stack = sys_mmap(0, 65536, 3, 34, -1, 0);
    let locals_arena = sys_mmap(0, 1048576, 3, 34, -1, 0);
    let depth = 0;

    let cur_fidx = main_fidx;
    let cur_bstart = get_qword(func_tbl, cur_fidx * 4 + 2);
    let cur_blen = get_qword(func_tbl, cur_fidx * 4 + 3);
    let cur_pc = 0;
    let cur_locals = locals_arena;

    set_qword(call_stack, 0, cur_fidx);
    set_qword(call_stack, 1, 0);
    set_qword(call_stack, 2, cur_locals);
    set_qword(call_stack, 3, -1);
    set_qword(call_stack, 4, 0);

    let running = 1;
    let final_result = 0;
    let steps = 0;

    while (running == 1) & (steps < 20000000) {
        steps = steps + 1;
        if cur_pc >= cur_blen { return 0 - REX_TRAP_ILLEGAL_STATE; }

        let ip = cur_bstart + cur_pc;
        let op = rex_read_u8(buf, ip);

        if op == REX_OP_CONST_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let val = rex_read_i64(buf, ip + 3);
            set_qword(cur_locals, dst, val);
            cur_pc = cur_pc + 11;
        }
        if op == REX_OP_CONST_I32 {
            let dst = rex_read_u16(buf, ip + 1);
            let val = rex_read_i32(buf, ip + 3);
            set_qword(cur_locals, dst, val);
            cur_pc = cur_pc + 7;
        }
        if op == REX_OP_MOVE {
            let dst = rex_read_u16(buf, ip + 1);
            let src = rex_read_u16(buf, ip + 3);
            set_qword(cur_locals, dst, get_qword(cur_locals, src));
            cur_pc = cur_pc + 5;
        }
        if op == REX_OP_ADD_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let s1 = rex_read_u16(buf, ip + 3);
            let s2 = rex_read_u16(buf, ip + 5);
            set_qword(cur_locals, dst, get_qword(cur_locals, s1) + get_qword(cur_locals, s2));
            cur_pc = cur_pc + 7;
        }
        if op == REX_OP_SUB_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let s1 = rex_read_u16(buf, ip + 3);
            let s2 = rex_read_u16(buf, ip + 5);
            set_qword(cur_locals, dst, get_qword(cur_locals, s1) - get_qword(cur_locals, s2));
            cur_pc = cur_pc + 7;
        }
        if op == REX_OP_MUL_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let s1 = rex_read_u16(buf, ip + 3);
            let s2 = rex_read_u16(buf, ip + 5);
            set_qword(cur_locals, dst, get_qword(cur_locals, s1) * get_qword(cur_locals, s2));
            cur_pc = cur_pc + 7;
        }
        if (op == REX_OP_DIV_I64) | (op == REX_OP_MOD_I64) {
            let dst = rex_read_u16(buf, ip + 1);
            let s1 = rex_read_u16(buf, ip + 3);
            let s2 = rex_read_u16(buf, ip + 5);
            let denom = get_qword(cur_locals, s2);
            if denom == 0 { return 0 - REX_TRAP_DIV_BY_ZERO; }
            if op == REX_OP_DIV_I64 {
                set_qword(cur_locals, dst, get_qword(cur_locals, s1) / denom);
            } else {
                set_qword(cur_locals, dst, get_qword(cur_locals, s1) % denom);
            }
            cur_pc = cur_pc + 7;
        }
        if op == REX_OP_NEG_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let src = rex_read_u16(buf, ip + 3);
            set_qword(cur_locals, dst, 0 - get_qword(cur_locals, src));
            cur_pc = cur_pc + 5;
        }
        if op == REX_OP_AND_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let s1 = rex_read_u16(buf, ip + 3);
            let s2 = rex_read_u16(buf, ip + 5);
            set_qword(cur_locals, dst, get_qword(cur_locals, s1) & get_qword(cur_locals, s2));
            cur_pc = cur_pc + 7;
        }
        if op == REX_OP_OR_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let s1 = rex_read_u16(buf, ip + 3);
            let s2 = rex_read_u16(buf, ip + 5);
            set_qword(cur_locals, dst, get_qword(cur_locals, s1) | get_qword(cur_locals, s2));
            cur_pc = cur_pc + 7;
        }
        if op == REX_OP_XOR_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let s1 = rex_read_u16(buf, ip + 3);
            let s2 = rex_read_u16(buf, ip + 5);
            set_qword(cur_locals, dst, get_qword(cur_locals, s1) ^ get_qword(cur_locals, s2));
            cur_pc = cur_pc + 7;
        }
        if op == REX_OP_NOT_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let src = rex_read_u16(buf, ip + 3);
            set_qword(cur_locals, dst, 0 - 1 - get_qword(cur_locals, src));
            cur_pc = cur_pc + 5;
        }
        if op == REX_OP_SHL_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let s1 = rex_read_u16(buf, ip + 3);
            let s2 = rex_read_u16(buf, ip + 5);
            set_qword(cur_locals, dst, get_qword(cur_locals, s1) << get_qword(cur_locals, s2));
            cur_pc = cur_pc + 7;
        }
        if op == REX_OP_SHR_I64 {
            let dst = rex_read_u16(buf, ip + 1);
            let s1 = rex_read_u16(buf, ip + 3);
            let s2 = rex_read_u16(buf, ip + 5);
            set_qword(cur_locals, dst, get_qword(cur_locals, s1) >> get_qword(cur_locals, s2));
            cur_pc = cur_pc + 7;
        }
        if (op >= REX_OP_CMP_EQ) & (op <= REX_OP_CMP_GE) {
            let dst = rex_read_u16(buf, ip + 1);
            let s1 = rex_read_u16(buf, ip + 3);
            let s2 = rex_read_u16(buf, ip + 5);
            let v1 = get_qword(cur_locals, s1);
            let v2 = get_qword(cur_locals, s2);
            let cmp_res = 0;
            if op == REX_OP_CMP_EQ { if v1 == v2 { cmp_res = 1; } }
            if op == REX_OP_CMP_NE { if v1 != v2 { cmp_res = 1; } }
            if op == REX_OP_CMP_LT { if v1 < v2 { cmp_res = 1; } }
            if op == REX_OP_CMP_LE { if v1 <= v2 { cmp_res = 1; } }
            if op == REX_OP_CMP_GT { if v1 > v2 { cmp_res = 1; } }
            if op == REX_OP_CMP_GE { if v1 >= v2 { cmp_res = 1; } }
            set_qword(cur_locals, dst, cmp_res);
            cur_pc = cur_pc + 7;
        }
        if op == REX_OP_JUMP {
            cur_pc = rex_read_u32(buf, ip + 1);
        }
        if op == REX_OP_BRANCH {
            let cond = rex_read_u16(buf, ip + 1);
            let tgt_t = rex_read_u32(buf, ip + 3);
            let tgt_f = rex_read_u32(buf, ip + 7);
            if get_qword(cur_locals, cond) != 0 {
                cur_pc = tgt_t;
            } else {
                cur_pc = tgt_f;
            }
        }
        if op == REX_OP_CALL {
            let dst = rex_read_u16(buf, ip + 1);
            let call_fidx = rex_read_u32(buf, ip + 3);
            let arg_cnt = rex_read_u16(buf, ip + 7);
            let next_pc = cur_pc + 9 + (arg_cnt * 2);

            if depth >= 1023 { return 0 - REX_TRAP_STACK_OVERFLOW; }

            let new_depth = depth + 1;
            let new_locals = locals_arena + (new_depth * 1024);
            let ai = 0;
            while ai < arg_cnt {
                let aslot = rex_read_u16(buf, ip + 9 + (ai * 2));
                set_qword(new_locals, ai, get_qword(cur_locals, aslot));
                ai = ai + 1;
            }

            set_qword(call_stack, depth * 5 + 0, cur_fidx);
            set_qword(call_stack, depth * 5 + 1, cur_pc);
            set_qword(call_stack, depth * 5 + 2, cur_locals);
            set_qword(call_stack, depth * 5 + 3, dst);
            set_qword(call_stack, depth * 5 + 4, next_pc);

            depth = new_depth;
            cur_fidx = call_fidx;
            cur_bstart = get_qword(func_tbl, cur_fidx * 4 + 2);
            cur_blen = get_qword(func_tbl, cur_fidx * 4 + 3);
            cur_pc = 0;
            cur_locals = new_locals;
        }
        if op == REX_OP_RETURN {
            let rslot = rex_read_u16(buf, ip + 1);
            let rval = 0;
            if rslot != 65535 { rval = get_qword(cur_locals, rslot); }

            if depth == 0 {
                final_result = rval;
                running = 0;
            } else {
                depth = depth - 1;
                cur_fidx = get_qword(call_stack, depth * 5 + 0);
                cur_locals = get_qword(call_stack, depth * 5 + 2);
                let dst_slot = get_qword(call_stack, depth * 5 + 3);
                let next_pc = get_qword(call_stack, depth * 5 + 4);
                if dst_slot != 65535 { set_qword(cur_locals, dst_slot, rval); }
                cur_bstart = get_qword(func_tbl, cur_fidx * 4 + 2);
                cur_blen = get_qword(func_tbl, cur_fidx * 4 + 3);
                cur_pc = next_pc;
            }
        }
        if op == REX_OP_TRAP {
            let tcode = rex_read_u16(buf, ip + 1);
            return 0 - tcode;
        }
        if op == REX_OP_LOAD_64 {
            let dst = rex_read_u16(buf, ip + 1);
            let base = rex_read_u16(buf, ip + 3);
            let offset = rex_read_i32(buf, ip + 5);
            let addr = get_qword(cur_locals, base) + offset;
            if (addr < 0) | (addr + 8 > mem_size) { return 0 - REX_TRAP_OUT_OF_BOUNDS; }
            let b0 = get_byte(mem_buf, addr + 0);
            let b1 = get_byte(mem_buf, addr + 1);
            let b2 = get_byte(mem_buf, addr + 2);
            let b3 = get_byte(mem_buf, addr + 3);
            let b4 = get_byte(mem_buf, addr + 4);
            let b5 = get_byte(mem_buf, addr + 5);
            let b6 = get_byte(mem_buf, addr + 6);
            let b7 = get_byte(mem_buf, addr + 7);
            let val = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
            set_qword(cur_locals, dst, val);
            cur_pc = cur_pc + 9;
        }
        if op == REX_OP_STORE_64 {
            let base = rex_read_u16(buf, ip + 1);
            let val_slot = rex_read_u16(buf, ip + 3);
            let offset = rex_read_i32(buf, ip + 5);
            let addr = get_qword(cur_locals, base) + offset;
            if (addr < 0) | (addr + 8 > mem_size) { return 0 - REX_TRAP_OUT_OF_BOUNDS; }
            let val = get_qword(cur_locals, val_slot);
            set_byte(mem_buf, addr + 0, val & 255);
            set_byte(mem_buf, addr + 1, (val >> 8) & 255);
            set_byte(mem_buf, addr + 2, (val >> 16) & 255);
            set_byte(mem_buf, addr + 3, (val >> 24) & 255);
            set_byte(mem_buf, addr + 4, (val >> 32) & 255);
            set_byte(mem_buf, addr + 5, (val >> 40) & 255);
            set_byte(mem_buf, addr + 6, (val >> 48) & 255);
            set_byte(mem_buf, addr + 7, (val >> 56) & 255);
            cur_pc = cur_pc + 9;
        }
        if op == REX_OP_ALLOC_MEM {
            let dst = rex_read_u16(buf, ip + 1);
            let sz = rex_read_u32(buf, ip + 3);
            let p_alloc = get_qword(mem_buf, 0); # alloc ptr stored in low word
            if p_alloc < 1024 { p_alloc = 1024; }
            set_qword(cur_locals, dst, p_alloc);
            set_qword(mem_buf, 0, p_alloc + sz);
            cur_pc = cur_pc + 7;
        }
        if op == REX_OP_ADDR_LOCAL {
            let dst = rex_read_u16(buf, ip + 1);
            let off = rex_read_u32(buf, ip + 3);
            set_qword(cur_locals, dst, off);
            cur_pc = cur_pc + 7;
        }
    }

    return final_result;
}


let REX_MODE_COMPILED  = 1;
let REX_MODE_INTERPRET = 2;
let REX_MODE_VM        = 3;

fn rex_execute(buf: i64, len: i64, mode: i64): i64 {
    if mode == REX_MODE_INTERPRET {
        return rex_interpret_module(buf, len);
    }
    if mode == REX_MODE_VM {
        return rex_vm_execute(buf, len);
    }
    return rex_execute_compiled(buf, len);
}

# File: compiler/rums/machdesc.bix
# Pure Rubix implementation reading, parsing, and validating .machine files.
# Exposes deterministic target machine query API to RUMS synthesizer & regalloc.
# Zero external tools, zero JSON, zero external assemblers/linkers.
# ==============================================================================

# ------------------------------------------------------------------------------
# Byte Emission Primitives (Architecture-Agnostic)
# ------------------------------------------------------------------------------
fn mach_emit_byte(buf: i64, p: i64, b: i64): i64 {
    set_byte(buf, p, b & 255);
    return p + 1;
}

fn mach_emit_u32(buf: i64, p: i64, w: i64): i64 {
    set_byte(buf, p + 0, w & 255);
    set_byte(buf, p + 1, (w >> 8) & 255);
    set_byte(buf, p + 2, (w >> 16) & 255);
    set_byte(buf, p + 3, (w >> 24) & 255);
    return p + 4;
}

fn mach_emit_disp32(buf: i64, p: i64, v: i64): i64 {
    return mach_emit_u32(buf, p, v);
}

fn mach_read_u32(buf: i64, p: i64): i64 {
    let b0 = get_byte(buf, p + 0);
    let b1 = get_byte(buf, p + 1);
    let b2 = get_byte(buf, p + 2);
    let b3 = get_byte(buf, p + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

fn riscv_encode_jal(rd: i64, disp: i64): i64 {
    let imm20 = (disp >> 20) & 1;
    let imm10_1 = (disp >> 1) & 1023;
    let imm11 = (disp >> 11) & 1;
    let imm19_12 = (disp >> 12) & 255;
    let imm_bits = (imm20 << 31) | (imm10_1 << 21) | (imm11 << 20) | (imm19_12 << 12);
    return imm_bits | (rd << 7) | 111;
}

fn riscv_encode_bne(s1: i64, s2: i64, disp: i64): i64 {
    let imm12 = (disp >> 12) & 1;
    let imm10_5 = (disp >> 5) & 63;
    let imm4_1 = (disp >> 1) & 15;
    let imm11 = (disp >> 11) & 1;
    let imm_bits = (imm12 << 31) | (imm10_5 << 25) | (imm4_1 << 8) | (imm11 << 7);
    return imm_bits | (s2 << 20) | (s1 << 15) | (1 << 12) | 99;
}

# ------------------------------------------------------------------------------
# String & Identifier Helper
# ------------------------------------------------------------------------------
fn mach_tok_eq(buf: i64, s: str): i64 {
    let slen = string_length(s);
    let i = 0;
    while i < slen {
        if get_byte(buf, i) != (s[i] as i64) { return 0; }
        i = i + 1;
    }
    if get_byte(buf, slen) != 0 { return 0; }
    return 1;
}

fn mach_str_copy(dst: i64, src: i64): i64 {
    let i = 0;
    while i < 15 {
        let b = get_byte(src, i);
        set_byte(dst, i, b);
        if b == 0 { return i; }
        i = i + 1;
    }
    set_byte(dst, 15, 0);
    return 15;
}

fn mach_find_reg_id(names_buf: i64, reg_count: i64, name_tok: i64): i64 {
    let i = 0;
    while i < reg_count {
        let entry = names_buf + (i * 16);
        let is_match = 1;
        let p = 0;
        while (p < 16) & (is_match == 1) {
            let b1 = get_byte(entry, p);
            let b2 = get_byte(name_tok, p);
            if b1 != b2 { is_match = 0; }
            if (b1 == 0) & (b2 == 0) { p = 16; }
            p = p + 1;
        }
        if is_match == 1 { return i; }
        i = i + 1;
    }
    return -1;
}

# ------------------------------------------------------------------------------
# Lexer / Tokenizer for .machine Syntax
# ------------------------------------------------------------------------------
fn mach_is_delim(b: i64): i64 {
    if (b == 32) | (b == 9) | (b == 10) | (b == 13) { return 1; }
    if (b == 59) | (b == 58) | (b == 44) { return 1; } # ';' ':' ','
    if (b == 123) | (b == 125) { return 1; } # '{' '}'
    if (b == 91) | (b == 93) { return 1; } # '[' ']'
    if (b == 40) | (b == 41) { return 1; } # '(' ')'
    return 0;
}

fn mach_next_token(src: i64, pos: i64, len: i64, tok_buf: i64, tok_info: i64): i64 {
    let p = pos;
    # Skip whitespace and comments
    let running = 1;
    while running == 1 {
        if p >= len {
            set_byte(tok_buf, 0, 0);
            set_qword(tok_info, 0, 0); # EOF
            return len;
        }
        let b = get_byte(src, p);
        if (b == 32) | (b == 9) | (b == 10) | (b == 13) {
            p = p + 1;
        } else {
            if b == 35 { # '#' comment
                p = p + 1;
                while (p < len) & (get_byte(src, p) != 10) {
                    p = p + 1;
                }
            } else {
                running = 0;
            }
        }
    }

    if p >= len {
        set_byte(tok_buf, 0, 0);
        set_qword(tok_info, 0, 0);
        return len;
    }

    let b = get_byte(src, p);

    # Single-char punctuation
    if (b == 59) | (b == 58) | (b == 44) | (b == 123) | (b == 125) | (b == 91) | (b == 93) | (b == 40) | (b == 41) {
        set_byte(tok_buf, 0, b);
        set_byte(tok_buf, 1, 0);
        set_qword(tok_info, 0, b);
        return p + 1;
    }

    # Word or Number
    let wp = 0;
    let is_num = 1;
    if (b < 48) | (b > 57) { is_num = 0; }

    while p < len {
        let cb = get_byte(src, p);
        if (mach_is_delim(cb) == 1) | (cb == 35) {
            # Delimiter reached
            set_byte(tok_buf, wp, 0);
            if is_num == 1 {
                set_qword(tok_info, 0, 2); # NUMBER
            } else {
                set_qword(tok_info, 0, 1); # IDENT
            }
            return p;
        }
        if wp < 31 {
            set_byte(tok_buf, wp, cb);
            wp = wp + 1;
        }
        p = p + 1;
    }

    set_byte(tok_buf, wp, 0);
    if is_num == 1 {
        set_qword(tok_info, 0, 2);
    } else {
        set_qword(tok_info, 0, 1);
    }
    return p;
}

fn mach_parse_int(tok_buf: i64): i64 {
    let v = 0;
    let i = 0;
    if (get_byte(tok_buf, 0) == 48) & ((get_byte(tok_buf, 1) == 120) | (get_byte(tok_buf, 1) == 88)) {
        i = 2;
        while get_byte(tok_buf, i) != 0 {
            let b = get_byte(tok_buf, i);
            let d = -1;
            if (b >= 48) & (b <= 57) { d = b - 48; }
            if (b >= 65) & (b <= 70) { d = b - 65 + 10; }
            if (b >= 97) & (b <= 102) { d = b - 97 + 10; }
            if d >= 0 {
                v = (v << 4) | d;
            } else {
                return v;
            }
            i = i + 1;
        }
        return v;
    }
    while get_byte(tok_buf, i) != 0 {
        let b = get_byte(tok_buf, i);
        if (b >= 48) & (b <= 57) {
            v = v * 10 + (b - 48);
        }
        i = i + 1;
    }
    return v;
}

# ------------------------------------------------------------------------------
# Model Buffer Initialization & Parsing
# ------------------------------------------------------------------------------
fn machdesc_init(model: i64): i64 {
    # Zero model page (4096 bytes)
    let i = 0;
    while i < 512 {
        set_qword(model, i, 0);
        i = i + 1;
    }
    set_qword(model, 0, 1296122696); # Magic: 0x4D414348 ("MACH")
    set_qword(model, 7, 1);          # Default version = 1
    set_qword(model, 13, -1);        # No link register default
    return 0;
}

fn machdesc_parse(src: i64, src_len: i64, model: i64): i64 {
    machdesc_init(model);

    let tok_buf = sys_mmap_page();
    let tok_info = sys_mmap_page();
    let names_buf = sys_mmap_page(); # register names storage (32 * 16 bytes)

    let p = 0;
    while p < src_len {
        p = mach_next_token(src, p, src_len, tok_buf, tok_info);
        let kind = get_qword(tok_info, 0);
        if kind == 0 { p = src_len; } # EOF

        # 1. Section: target <name> { ... }
        if (kind == 1) & (mach_tok_eq(tok_buf, "target") == 1) {
            p = mach_next_token(src, p, src_len, tok_buf, tok_info); # target name
            let tid = 0;
            if mach_tok_eq(tok_buf, "x86_64") == 1 {
                tid = 1;
                set_qword(model, 15, 4);  # sp_reg = rsp (4)
                set_qword(model, 17, 1);  # target_type = CPU (1)
                set_qword(model, 18, 1);  # regalloc_required = 1
                set_qword(model, 19, 1);  # machine_frame_required = 1
                set_qword(model, 20, 1);  # output_format = ELF (1)
                set_qword(model, 21, 11); # scratch_reg = r11 (11)
            }
            if mach_tok_eq(tok_buf, "arm64") == 1 {
                tid = 2;
                set_qword(model, 15, 31); # sp_reg = x31 (31)
                set_qword(model, 17, 1);  # target_type = CPU (1)
                set_qword(model, 18, 1);  # regalloc_required = 1
                set_qword(model, 19, 1);  # machine_frame_required = 1
                set_qword(model, 20, 1);  # output_format = ELF (1)
                set_qword(model, 21, 16); # scratch_reg = x16 (16)
                set_qword(model, 80, 0);
                set_qword(model, 81, 5);
                set_qword(model, 82, 16);
                set_qword(model, 83, 3596551104);
                set_qword(model, 84, 2852127712);
                set_qword(model, 85, 3531603968);
                set_qword(model, 86, 2);
                set_qword(model, 87, 2847898621);
                set_qword(model, 88, 2432697341);
                set_qword(model, 95, 2);
                set_qword(model, 96, 2831252477);
                set_qword(model, 97, 3596551104);
            }
            if mach_tok_eq(tok_buf, "riscv64") == 1 {
                tid = 3;
                set_qword(model, 15, 2);  # sp_reg = x2 (2)
                set_qword(model, 17, 1);  # target_type = CPU (1)
                set_qword(model, 18, 1);  # regalloc_required = 1
                set_qword(model, 19, 1);  # machine_frame_required = 1
                set_qword(model, 20, 1);  # output_format = ELF (1)
                set_qword(model, 21, 31); # scratch_reg = x31 (31)
                set_qword(model, 80, 7);
                set_qword(model, 81, 15);
                set_qword(model, 82, 20);
                set_qword(model, 83, 32871);
                set_qword(model, 84, 19);
                set_qword(model, 85, 19);
                set_qword(model, 86, 4);
                set_qword(model, 87, 4279238931);
                set_qword(model, 88, 16909475);
                set_qword(model, 89, 8522787);
                set_qword(model, 90, 16843027);
                set_qword(model, 95, 4);
                set_qword(model, 96, 8523827);
                set_qword(model, 97, 135303);
                set_qword(model, 98, 16843027);
                set_qword(model, 99, 32871);
            }
            if mach_tok_eq(tok_buf, "rex") == 1 {
                tid = 4;
                set_qword(model, 15, 0); # sp_reg = 0
                set_qword(model, 17, 2); # target_type = PORTABLE (2)
                set_qword(model, 18, 0); # regalloc_required = 0
                set_qword(model, 19, 0); # machine_frame_required = 0
                set_qword(model, 20, 2); # output_format = REX (2)
                set_qword(model, 21, 0); # scratch_reg = 0
            }
            if mach_tok_eq(tok_buf, "synthetic") == 1 {
                tid = 99;
                set_qword(model, 15, 5); # sp_reg = 5
                set_qword(model, 17, 1); # target_type = CPU (1)
                set_qword(model, 18, 1); # regalloc_required = 1
                set_qword(model, 19, 0); # machine_frame_required = 0
                set_qword(model, 20, 3); # output_format = RAW (3)
                set_qword(model, 21, 4); # scratch_reg = 4
                set_qword(model, 80, 0);
                set_qword(model, 81, 8);
                set_qword(model, 82, 16);
                set_qword(model, 83, 251658240);
                set_qword(model, 84, 16777216);
                set_qword(model, 85, 67108864);
                set_qword(model, 86, 0);
                set_qword(model, 95, 0);
            }
            set_qword(model, 1, tid);

            p = mach_next_token(src, p, src_len, tok_buf, tok_info); # '{'
            let in_target = 1;
            while (p < src_len) & (in_target == 1) {
                p = mach_next_token(src, p, src_len, tok_buf, tok_info);
                if get_qword(tok_info, 0) == 125 { # '}'
                    in_target = 0;
                } else {
                    if mach_tok_eq(tok_buf, "word_size") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # val
                        set_qword(model, 2, mach_parse_int(tok_buf));
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                    }
                    if mach_tok_eq(tok_buf, "machine_format_version") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # val
                        set_qword(model, 7, mach_parse_int(tok_buf));
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                    }
                    if mach_tok_eq(tok_buf, "stack_alignment") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # val
                        set_qword(model, 4, mach_parse_int(tok_buf));
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                    }
                    if mach_tok_eq(tok_buf, "instruction_width") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # val
                        set_qword(model, 6, mach_parse_int(tok_buf));
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                    }
                }
            }
        }

        # 2. Section: registers { reg <id> <name> <role> <callee_saved> <class>; ... }
        if (kind == 1) & (mach_tok_eq(tok_buf, "registers") == 1) {
            p = mach_next_token(src, p, src_len, tok_buf, tok_info); # '{'
            let in_regs = 1;
            while (p < src_len) & (in_regs == 1) {
                p = mach_next_token(src, p, src_len, tok_buf, tok_info);
                if get_qword(tok_info, 0) == 125 { # '}'
                    in_regs = 0;
                } else {
                    if mach_tok_eq(tok_buf, "reg") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # id
                        let rid = mach_parse_int(tok_buf);
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # name
                        mach_str_copy(names_buf + (rid * 16), tok_buf);

                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # role
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # callee_saved
                        let cs = 0;
                        if mach_tok_eq(tok_buf, "true") == 1 { cs = 1; }
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # class
                        let cls = 0;
                        if mach_tok_eq(tok_buf, "special") == 1 { cls = 1; }
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'

                        # Record register in model
                        let rcnt = get_qword(model, 8);
                        if rid >= rcnt { set_qword(model, 8, rid + 1); }
                        let rbase = model + 1024 + (rid * 32);
                        set_qword(rbase, 0, rid);
                        set_qword(rbase, 2, cs);
                        set_qword(rbase, 3, cls);
                    }
                }
            }
        }

        # 3. Section: calling_convention <name> { ... }
        if (kind == 1) & (mach_tok_eq(tok_buf, "calling_convention") == 1) {
            p = mach_next_token(src, p, src_len, tok_buf, tok_info); # name
            p = mach_next_token(src, p, src_len, tok_buf, tok_info); # '{'
            let in_cc = 1;
            while (p < src_len) & (in_cc == 1) {
                p = mach_next_token(src, p, src_len, tok_buf, tok_info);
                if get_qword(tok_info, 0) == 125 { # '}'
                    in_cc = 0;
                } else {
                    if mach_tok_eq(tok_buf, "args") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # '['
                        let arg_cnt = 0;
                        let in_args = 1;
                        while (p < src_len) & (in_args == 1) {
                            p = mach_next_token(src, p, src_len, tok_buf, tok_info);
                            if get_qword(tok_info, 0) == 93 { # ']'
                                in_args = 0;
                            } else {
                                if get_qword(tok_info, 0) != 44 { # not comma
                                    let rid = mach_find_reg_id(names_buf, get_qword(model, 8), tok_buf);
                                    if rid >= 0 {
                                        set_qword(model, 32 + arg_cnt, rid);
                                        arg_cnt = arg_cnt + 1;
                                    }
                                }
                            }
                        }
                        set_qword(model, 9, arg_cnt);
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                    }

                    if mach_tok_eq(tok_buf, "return_reg") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # reg name
                        let rid = mach_find_reg_id(names_buf, get_qword(model, 8), tok_buf);
                        set_qword(model, 10, rid);
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                    }

                    if mach_tok_eq(tok_buf, "scratch_pool") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # '['
                        let sc_cnt = 0;
                        let in_pool = 1;
                        while (p < src_len) & (in_pool == 1) {
                            p = mach_next_token(src, p, src_len, tok_buf, tok_info);
                            if get_qword(tok_info, 0) == 93 { # ']'
                                in_pool = 0;
                            } else {
                                if get_qword(tok_info, 0) != 44 { # not comma
                                    let rid = mach_find_reg_id(names_buf, get_qword(model, 8), tok_buf);
                                    if rid >= 0 {
                                        set_qword(model, 48 + sc_cnt, rid);
                                        sc_cnt = sc_cnt + 1;
                                    }
                                }
                            }
                        }
                        set_qword(model, 11, sc_cnt);
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                    }

                    if mach_tok_eq(tok_buf, "link_register") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # reg name
                        let rid = mach_find_reg_id(names_buf, get_qword(model, 8), tok_buf);
                        set_qword(model, 13, rid);
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                    }

                    if mach_tok_eq(tok_buf, "frame_pointer") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # reg name
                        let rid = mach_find_reg_id(names_buf, get_qword(model, 8), tok_buf);
                        set_qword(model, 14, rid);
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                    }
                }
            }
        }

        # 4. Section: patterns { pattern <name>(...) { cost: N; ... } ... }
        if (kind == 1) & (mach_tok_eq(tok_buf, "patterns") == 1) {
            p = mach_next_token(src, p, src_len, tok_buf, tok_info); # '{'
            let in_pats = 1;
            while (p < src_len) & (in_pats == 1) {
                p = mach_next_token(src, p, src_len, tok_buf, tok_info);
                if get_qword(tok_info, 0) == 125 { # '}'
                    in_pats = 0;
                } else {
                    if mach_tok_eq(tok_buf, "pattern") == 1 {
                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # pattern name
                        let pat_id = 0;
                        if mach_tok_eq(tok_buf, "MOV_REG_REG") == 1 { pat_id = 1; }
                        if (mach_tok_eq(tok_buf, "MOV_REG_IMM") == 1) | (mach_tok_eq(tok_buf, "MOV_REG_IMM64") == 1) { pat_id = 2; }
                        if mach_tok_eq(tok_buf, "ADD_REG_REG") == 1 { pat_id = 10; }
                        if mach_tok_eq(tok_buf, "SUB_REG_REG") == 1 { pat_id = 11; }
                        if mach_tok_eq(tok_buf, "AND_REG_REG") == 1 { pat_id = 20; }
                        if (mach_tok_eq(tok_buf, "OR_REG_REG") == 1) | (mach_tok_eq(tok_buf, "ORR_REG_REG") == 1) { pat_id = 21; }
                        if (mach_tok_eq(tok_buf, "XOR_REG_REG") == 1) | (mach_tok_eq(tok_buf, "EOR_REG_REG") == 1) { pat_id = 22; }
                        if mach_tok_eq(tok_buf, "RET") == 1 { pat_id = 57; }

                        # Skip parameter list: (...)
                        while (p < src_len) & (get_qword(tok_info, 0) != 41) { # ')'
                            p = mach_next_token(src, p, src_len, tok_buf, tok_info);
                        }

                        p = mach_next_token(src, p, src_len, tok_buf, tok_info); # '{'
                        let pat_cost = 1;
                        let pat_lat = 1;
                        let pat_enc = 0;
                        let in_pat = 1;
                        while (p < src_len) & (in_pat == 1) {
                            p = mach_next_token(src, p, src_len, tok_buf, tok_info);
                            if get_qword(tok_info, 0) == 125 { # '}'
                                in_pat = 0;
                            } else {
                                if mach_tok_eq(tok_buf, "cost") == 1 {
                                    p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                                    p = mach_next_token(src, p, src_len, tok_buf, tok_info); # val
                                    pat_cost = mach_parse_int(tok_buf);
                                    p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                                }
                                if mach_tok_eq(tok_buf, "latency") == 1 {
                                    p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                                    p = mach_next_token(src, p, src_len, tok_buf, tok_info); # val
                                    pat_lat = mach_parse_int(tok_buf);
                                    p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ';'
                                }
                                if mach_tok_eq(tok_buf, "encoding_u32") == 1 {
                                    p = mach_next_token(src, p, src_len, tok_buf, tok_info); # ':'
                                    p = mach_next_token(src, p, src_len, tok_buf, tok_info); # val
                                    pat_enc = mach_parse_int(tok_buf);
                                    while (p < src_len) & (get_qword(tok_info, 0) != 59) {
                                        p = mach_next_token(src, p, src_len, tok_buf, tok_info);
                                    }
                                }
                            }
                        }

                        # Store pattern in model
                        let pcnt = get_qword(model, 16);
                        let pbase = model + 2048 + (pcnt * 64);
                        set_qword(pbase, 0, pat_id);
                        set_qword(pbase, 1, pat_cost);
                        set_qword(pbase, 2, pat_lat);
                        set_qword(pbase, 3, pat_enc);
                        set_qword(model, 16, pcnt + 1);
                    }
                }
            }
        }
    }

    return 0;
}

# ------------------------------------------------------------------------------
# Model Validation
# ------------------------------------------------------------------------------
fn machdesc_validate(model: i64): i64 {
    if get_qword(model, 0) != 1296122696 { return -10; } # Bad magic
    if get_qword(model, 7) != 1 { return -10; }          # Unsupported version
    let wsz = get_qword(model, 2);
    if (wsz != 4) & (wsz != 8) { return -11; }           # Unsupported word size
    let ttype = get_qword(model, 17);
    if ttype == 2 {
        # Portable target (e.g. REX): validated!
        return 0;
    }
    let rcnt = get_qword(model, 8);
    if rcnt <= 0 { return -12; }                         # No registers
    let ret_reg = get_qword(model, 10);
    if (ret_reg < 0) | (ret_reg >= rcnt) { return -14; } # Invalid return register
    let sc_cnt = get_qword(model, 11);
    if sc_cnt <= 0 { return -15; }                       # Empty scratch pool
    let pcnt = get_qword(model, 16);
    if pcnt <= 0 { return -16; }                         # No patterns
    return 0;                                            # Valid!
}

fn mach_read_all(fd: i64, buf: i64, max_len: i64): i64 {
    if fd < 0 { return -10; }
    if max_len <= 0 { return 0; }
    let total = 0;
    let running = 1;
    while running == 1 {
        let remaining = max_len - total;
        if remaining <= 0 {
            running = 0;
        } else {
            let n = sys_read(fd, buf + total, remaining);
            if n == 0 {
                running = 0;
            } else {
                if n < 0 {
                    if n == -4 {
                        # EINTR: retry
                    } else {
                        return n;
                    }
                } else {
                    total = total + n;
                }
            }
        }
    }
    return total;
}

# ------------------------------------------------------------------------------
# High-Level File Loader
# ------------------------------------------------------------------------------
fn machdesc_load_file(path_ptr: i64, model: i64): i64 {
    let fd = sys_open(path_ptr, 0, 0);
    if fd < 0 {
        let alt_buf = sys_mmap_page();
        # Try "rubix/" + path_ptr
        set_byte(alt_buf, 0, 114);
        set_byte(alt_buf, 1, 117);
        set_byte(alt_buf, 2, 98);
        set_byte(alt_buf, 3, 105);
        set_byte(alt_buf, 4, 120);
        set_byte(alt_buf, 5, 47);
        let p = 0;
        while get_byte(path_ptr, p) != 0 {
            set_byte(alt_buf, 6 + p, get_byte(path_ptr, p));
            p = p + 1;
        }
        set_byte(alt_buf, 6 + p, 0);
        fd = sys_open(alt_buf, 0, 0);
        if fd < 0 {
            # Try "../" + path_ptr
            set_byte(alt_buf, 0, 46);
            set_byte(alt_buf, 1, 46);
            set_byte(alt_buf, 2, 47);
            let p2 = 0;
            while get_byte(path_ptr, p2) != 0 {
                set_byte(alt_buf, 3 + p2, get_byte(path_ptr, p2));
                p2 = p2 + 1;
            }
            set_byte(alt_buf, 3 + p2, 0);
            fd = sys_open(alt_buf, 0, 0);
        }
        sys_munmap(alt_buf, 4096);
    }
    if fd < 0 {
        return -1; # File not found
    }
    let file_buf = sys_mmap(0, 65536, 3, 34, -1, 0);
    let n = mach_read_all(fd, file_buf, 65536);
    sys_close(fd);
    if n <= 0 {
        return -2; # Read failed or empty
    }
    set_byte(file_buf, n, 0);

    let parse_res = machdesc_parse(file_buf, n, model);
    if parse_res < 0 {
        return parse_res;
    }

    let val_res = machdesc_validate(model);
    if val_res < 0 {
        return val_res;
    }

    return 0;
}

# ------------------------------------------------------------------------------
# Target Machine Query API
# ------------------------------------------------------------------------------
fn mach_model_get_target_id(model: i64): i64 {
    return get_qword(model, 1);
}

fn mach_model_get_target_type(model: i64): i64 {
    return get_qword(model, 17);
}

fn mach_model_needs_regalloc(model: i64): i64 {
    return get_qword(model, 18);
}

fn mach_model_needs_machine_frame(model: i64): i64 {
    return get_qword(model, 19);
}

fn mach_model_get_output_format(model: i64): i64 {
    return get_qword(model, 20);
}

fn mach_model_get_sp_reg(model: i64): i64 {
    return get_qword(model, 15);
}

fn mach_model_get_scratch_reg(model: i64): i64 {
    return get_qword(model, 21);
}

fn mach_model_get_word_size(model: i64): i64 {
    return get_qword(model, 2);
}

fn mach_model_get_instruction_width(model: i64): i64 {
    return get_qword(model, 6);
}

fn mach_model_get_reg_count(model: i64): i64 {
    return get_qword(model, 8);
}

fn mach_model_get_scratch_pool(model: i64, pool_buf: i64): i64 {
    let cnt = get_qword(model, 11);
    let i = 0;
    while i < cnt {
        set_qword(pool_buf, i, get_qword(model, 48 + i));
        i = i + 1;
    }
    return cnt;
}

fn mach_model_get_abi_arg_reg(model: i64, arg_idx: i64): i64 {
    let cnt = get_qword(model, 9);
    if (arg_idx >= 0) & (arg_idx < cnt) {
        return get_qword(model, 32 + arg_idx);
    }
    return -1;
}

fn mach_model_get_abi_return_reg(model: i64): i64 {
    return get_qword(model, 10);
}

fn mach_model_pattern_cost(model: i64, pat_id: i64): i64 {
    let pcnt = get_qword(model, 16);
    let i = 0;
    while i < pcnt {
        let pbase = model + 2048 + (i * 64);
        if get_qword(pbase, 0) == pat_id {
            return get_qword(pbase, 1);
        }
        i = i + 1;
    }
    return 1; # Default cost 1
}

fn mach_model_pattern_encoding(model: i64, pat_id: i64): i64 {
    let pcnt = get_qword(model, 16);
    let i = 0;
    while i < pcnt {
        let pbase = model + 2048 + (i * 64);
        if get_qword(pbase, 0) == pat_id {
            return get_qword(pbase, 3);
        }
        i = i + 1;
    }
    return 0;
}

# ------------------------------------------------------------------------------
# Model-Driven Machine Byte Synthesis
# ------------------------------------------------------------------------------
fn x86_rex(w: i64, r: i64, b: i64): i64 {
    let rex = 64;
    if w == 1 { rex = rex | 8; }
    if r >= 8 { rex = rex | 4; }
    if b >= 8 { rex = rex | 1; }
    return rex;
}

fn mach_model_emit_prologue(model: i64, code_buf: i64, cur: i64, frame_sz: i64): i64 {
    let tid = get_qword(model, 1);
    if tid == 2 {
        let p = mach_emit_u32(code_buf, cur, 2847898621); # STP x29, x30, [sp, #-16]!
        p = mach_emit_u32(code_buf, p, 2432697341);       # MOV x29, sp
        if frame_sz > 0 {
            p = mach_emit_u32(code_buf, p, 3506438144 | ((frame_sz & 4095) << 10) | (31 << 5) | 31);
        }
        return p;
    }
    if tid == 3 {
        let sz = frame_sz;
        if sz < 16 { sz = 16; }
        let addi_sp = 19 | (((0 - sz) & 4095) << 20) | (2 << 15) | (2 << 7);
        let p = mach_emit_u32(code_buf, cur, addi_sp);
        let off_ra = sz - 8;
        let sd_ra = 35 | (((off_ra >> 5) & 127) << 25) | (1 << 20) | (2 << 15) | (3 << 12) | ((off_ra & 31) << 7);
        p = mach_emit_u32(code_buf, p, sd_ra);
        let off_s0 = sz - 16;
        let sd_s0 = 35 | (((off_s0 >> 5) & 127) << 25) | (8 << 20) | (2 << 15) | (3 << 12) | ((off_s0 & 31) << 7);
        p = mach_emit_u32(code_buf, p, sd_s0);
        let addi_s0 = 19 | ((sz & 4095) << 20) | (2 << 15) | (8 << 7);
        p = mach_emit_u32(code_buf, p, addi_s0);
        return p;
    }
    if tid == 99 {
        return cur;
    }
    # x86-64
    let p = cur;
    p = mach_emit_byte(code_buf, p, 85);
    p = mach_emit_byte(code_buf, p, 72); p = mach_emit_byte(code_buf, p, 137); p = mach_emit_byte(code_buf, p, 229);
    p = mach_emit_byte(code_buf, p, 72); p = mach_emit_byte(code_buf, p, 129); p = mach_emit_byte(code_buf, p, 236);
    p = mach_emit_disp32(code_buf, p, frame_sz);
    return p;
}

fn mach_model_emit_epilogue(model: i64, code_buf: i64, cur: i64, frame_sz: i64): i64 {
    let tid = get_qword(model, 1);
    if tid == 2 {
        let p = cur;
        if frame_sz > 0 {
            p = mach_emit_u32(code_buf, p, 2432696320 | ((frame_sz & 4095) << 10) | (31 << 5) | 31);
        }
        p = mach_emit_u32(code_buf, p, 2831252477); # LDP x29, x30, [sp], #16
        p = mach_emit_u32(code_buf, p, 3596551104); # RET
        return p;
    }
    if tid == 3 {
        let sz = frame_sz;
        if sz < 16 { sz = 16; }
        let off_s0 = sz - 16;
        let ld_s0 = 3 | ((off_s0 & 4095) << 20) | (2 << 15) | (3 << 12) | (8 << 7);
        let p = mach_emit_u32(code_buf, cur, ld_s0);
        let off_ra = sz - 8;
        let ld_ra = 3 | ((off_ra & 4095) << 20) | (2 << 15) | (3 << 12) | (1 << 7);
        p = mach_emit_u32(code_buf, p, ld_ra);
        let addi_sp = 19 | ((sz & 4095) << 20) | (2 << 15) | (2 << 7);
        p = mach_emit_u32(code_buf, p, addi_sp);
        p = mach_emit_u32(code_buf, p, 32871); # RET
        return p;
    }
    if tid == 99 {
        return mach_emit_u32(code_buf, cur, 251658240);
    }
    # x86-64
    let p = cur;
    p = mach_emit_byte(code_buf, p, 72); p = mach_emit_byte(code_buf, p, 137); p = mach_emit_byte(code_buf, p, 236);
    p = mach_emit_byte(code_buf, p, 93);
    p = mach_emit_byte(code_buf, p, 195);
    return p;
}

fn mach_model_emit_bin_op(model: i64, code_buf: i64, cur: i64, op: i64, dst: i64, s1: i64, s2: i64): i64 {
    let tid = get_qword(model, 1);
    if tid == 2 {
        if op == 10 { return mach_emit_u32(code_buf, cur, 2332033024 | (s2 << 16) | (s1 << 5) | dst); }
        if op == 11 { return mach_emit_u32(code_buf, cur, 3405774848 | (s2 << 16) | (s1 << 5) | dst); }
        if op == 12 { return mach_emit_u32(code_buf, cur, 2600500224 | (s2 << 16) | (s1 << 5) | dst); }
        if op == 20 { return mach_emit_u32(code_buf, cur, 2315255808 | (s2 << 16) | (s1 << 5) | dst); }
        if op == 21 { return mach_emit_u32(code_buf, cur, 2852126720 | (s2 << 16) | (s1 << 5) | dst); }
        if op == 22 { return mach_emit_u32(code_buf, cur, 3388997632 | (s2 << 16) | (s1 << 5) | dst); }
        if op == 24 { return mach_emit_u32(code_buf, cur, 2596282368 | (s2 << 16) | (s1 << 5) | dst); }
        if op == 25 { return mach_emit_u32(code_buf, cur, 2596284416 | (s2 << 16) | (s1 << 5) | dst); }
    }
    if tid == 3 {
        if op == 10 { return mach_emit_u32(code_buf, cur, 51 | (s2 << 20) | (s1 << 15) | (dst << 7)); }
        if op == 11 { return mach_emit_u32(code_buf, cur, 1073741875 | (s2 << 20) | (s1 << 15) | (dst << 7)); }
        if op == 12 { return mach_emit_u32(code_buf, cur, 33554483 | (s2 << 20) | (s1 << 15) | (dst << 7)); }
        if op == 20 { return mach_emit_u32(code_buf, cur, 28723 | (s2 << 20) | (s1 << 15) | (dst << 7)); }
        if op == 21 { return mach_emit_u32(code_buf, cur, 24627 | (s2 << 20) | (s1 << 15) | (dst << 7)); }
        if op == 22 { return mach_emit_u32(code_buf, cur, 16435 | (s2 << 20) | (s1 << 15) | (dst << 7)); }
        if op == 24 { return mach_emit_u32(code_buf, cur, 4147 | (s2 << 20) | (s1 << 15) | (dst << 7)); }
        if op == 25 { return mach_emit_u32(code_buf, cur, 1073762355 | (s2 << 20) | (s1 << 15) | (dst << 7)); }
    }
    if tid == 99 {
        let base_op = mach_model_pattern_encoding(model, op);
        if base_op == 0 {
            if op == 10 { base_op = 33554432; }
            if op == 11 { base_op = 50331648; }
        }
        let dst_shift = get_qword(model, 80);
        let s1_shift = get_qword(model, 81);
        let s2_shift = get_qword(model, 82);
        let word = base_op | (s2 << s2_shift) | (s1 << s1_shift) | (dst << dst_shift);
        return mach_emit_u32(code_buf, cur, word);
    }
    # x86-64
    let p = cur;
    let s2_reg = s2;
    if dst == s2 {
        # Commutative: ADD(10), IMUL(12), AND(20), OR(21), XOR(22)
        if (op == 10) | (op == 12) | (op == 20) | (op == 21) | (op == 22) {
            if op == 12 { # IMUL
                p = mach_emit_byte(code_buf, p, x86_rex(1, dst, s1));
                p = mach_emit_byte(code_buf, p, 15);
                p = mach_emit_byte(code_buf, p, 175);
                p = mach_emit_byte(code_buf, p, 192 + ((dst & 7) * 8) + (s1 & 7));
                return p;
            }
            let opcode_byte = 1;
            if op == 20 { opcode_byte = 33; }
            if op == 21 { opcode_byte = 9;  }
            if op == 22 { opcode_byte = 49; }
            p = mach_emit_byte(code_buf, p, x86_rex(1, s1, dst));
            p = mach_emit_byte(code_buf, p, opcode_byte);
            p = mach_emit_byte(code_buf, p, 192 + ((s1 & 7) * 8) + (dst & 7));
            return p;
        }
        # Non-commutative (SUB, SHL, SAR): save s2 into scratch reg 11
        p = mach_emit_byte(code_buf, p, x86_rex(1, s2, 11));
        p = mach_emit_byte(code_buf, p, 137);
        p = mach_emit_byte(code_buf, p, 192 + ((s2 & 7) * 8) + 3);
        s2_reg = 11;
    }

    if dst != s1 {
        p = mach_emit_byte(code_buf, p, x86_rex(1, s1, dst));
